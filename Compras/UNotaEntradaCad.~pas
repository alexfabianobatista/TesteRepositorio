      // -- Código inserido para filtrar notas por finalidade
      if trim(FNotaEntradaParam.FmFinalidade2.MeFinalidade.Text) = '' then
      begin
        QConferencia.SetVariable(':TABELAS', Null);
        QConferencia.SetVariable(':FINALIDADE', 'AND 1 = 1')
      end
