  inherited;
  Modelo := DMNotaEntrada.QNotaEntradaCOD_SERIE_MODELO.Value;;
  if Modelo <> '55' then
    FNotaImpressao.EmiteNF(DMNotaEntrada.QNotaEntradaCOD_NOTA_CAB.Value)
