    if (not DMNotaEntrada.QNotaEntradaDESC_CHAVE_ACESSO.IsNull) then
      with DMNfe do
      begin
        SetaNfe(DMNotaEntrada.QNotaEntradaDESC_CHAVE_ACESSO.Value, True);
        if QNfeind_aprovado.Value then
        begin
          if FNfEletronicaLoteCons = nil then
