                Imp.WriteXY(3 * coluna, linha, 'R$ ' + Copy(FormatFloat('#,##0.00', CdEtiqNotaVAL_VAREJO.Value), 1, 15));
            end;

            CdEtiqNota.Next;
            if coluna = wNumColunas - 1 then
            begin
              if posicao = 1 then
              begin
                inc(linha);
                posicao := 2;
                CdEtiqNota.RecNo := RecNoAnterior - 1;
              end
              else if posicao = 2 then
              begin
                inc(linha);
                posicao := 3;
                CdEtiqNota.RecNo := RecNoAnterior - 1;
              end
              else if posicao = 3 then
              begin
                posicao := 1;
                inc(linha, 2);
              end;
              coluna := 0;
            end
            else
            begin
              if (coluna = 0) then
                RecNoAnterior := CdEtiqNota.RecNo;

              if CdEtiqNota.Eof then
              begin
                if posicao = 1 then
                begin
                  inc(linha);
                  posicao := 2;
                  CdEtiqNota.RecNo := RecNoAnterior - 1;
                end
                else if posicao = 2 then
                begin
                  inc(linha);
                  posicao := 3;
                  CdEtiqNota.RecNo := RecNoAnterior - 1;
                end
                else if posicao = 3 then
                begin

                end;
                coluna := 0;
              end
              else
              begin

                Inc(coluna);
              end;
            end;
          end;
          Imp.FechaImpressora;
        end;
    end;
  end;
end;

