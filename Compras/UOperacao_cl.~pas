procedure TDMOperacao.QOperacaoAfterInsert(DataSet: TDataSet);
begin
  QOperacaoCod_Operacao.Value := DMOracle.Sequencia('OPERACAO');
  QOperacaoIND_SERVICO.Value := 'N';
  QOperacaoIND_PROMISSORIA.Value := 'N';
end;

procedure TDMOperacao.QOperacaoAfterPost(DataSet: TDataSet);
begin
  QOperacao.SetVariable('PK',QOperacaoCod_Operacao.Value);
end;

procedure TDMOperacao.QOperacaoAfterOpen(DataSet: TDataSet);
begin
  QBCCredito.Open;
  QSerieModeloCons.Open;
  QCstCofins.Open;
  QCstpis.Open;
end;

procedure TDMOperacao.QOperacaoBeforePost(DataSet: TDataSet);
begin
  //Bloquear cadastrar operações de saida que atualizam o custo, pois notas de venda não devem atualizar o custo.
  //Na volta da confirmação o problema piora pois o custo é atualizado denovo.
  //Verificar como fica na devolução. por Alessandro 11/04/13.
  if (QOperacaoIND_TIPO_OPERACAO.Value = 'S') and (QOperacaoIND_CUSTO.Value = 'S') then
    raise Exception.Create('Não é possível atualizar o custo nas notas de saida.');

  // Verificar se CST de PIS e COFINS são do Mesmo tipo que a Operação
  if Trim(QOperacaoCOD_CST_PIS.Value) <> '' then
  begin
    if ((StrToInt(QOperacaoCOD_CST_PIS.Value) < 50) and (QOperacaoIND_TIPO_OPERACAO.Value <> 'S')) then
      raise Exception.Create('Informar PIS de Entrada para Operação de Entrada');
    if ((StrToInt(QOperacaoCOD_CST_PIS.Value) > 50) and (QOperacaoIND_TIPO_OPERACAO.Value <> 'E')) then
      raise Exception.Create('Informar PIS de Saída para Operação de Saída');
  end;

  if Trim(QOperacaoCOD_CST_COFINS.Value) <> '' then
  begin
    if ((StrToInt(QOperacaoCOD_CST_COFINS.Value) < 50) and (QOperacaoIND_TIPO_OPERACAO.Value <> 'S')) then
      raise Exception.Create('Informar COFINS de Entrada para Operação de Entrada');
    if ((StrToInt(QOperacaoCOD_CST_COFINS.Value) > 50) and (QOperacaoIND_TIPO_OPERACAO.Value <> 'E')) then
      raise Exception.Create('Informar COFINS de Saída para Operação de Saída');
  end;

  if dmoperacao.QOperacaoIND_TIPO_OPERACAO.Text = 'S' then
    DMOperacao.QOperacaoIND_CUSTO_NOTA.Text := 'E';

// Feito para contornar o problema de tributação estar com o número 0. Alex 06/10/2023
  if QOperacaoCOD_TRIBUTACAO.Text = '0' then
    QOperacaoCOD_TRIBUTACAO.Clear;

  QOperacaoCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
end;

procedure TDMOperacao.QOperacaoAfterEdit(DataSet: TDataSet);
begin
  // Feito para contornar o problema de tributação estar com o número 0
  if QOperacaoCOD_TRIBUTACAO.Text = '0' then
    QOperacaoCOD_TRIBUTACAO.Clear;
end;

procedure TDMOperacao.QOperacaoBeforeEdit(DataSet: TDataSet);
begin
  QOperacaoCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
end;

procedure TDMOperacao.QOperacaoBeforeInsert(DataSet: TDataSet);
begin
  QOperacaoCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
end;

