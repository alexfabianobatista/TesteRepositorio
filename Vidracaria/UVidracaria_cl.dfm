  object QMaterialCons: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  DISTINCT(TB_MATERIAL.COD_PECA),'
      '  TB_MATERIAL.COD_PEDIDO,'
      '  TB_MATERIAL.IND_REPOSICAO,'
      '  TB_MATERIAL.COD_PEDIDO_ITEM,'
