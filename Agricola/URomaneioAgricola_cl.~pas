Procedure TDMRomaneioAgricola.QRomConsFixarCalcFields(DataSet: TDataSet);
Var wEmbalagem : String;
Begin
  QRomConsFixarsaldo_fixar.value := QRomConsFixarsQuantidade_Fixar.Value - QRomConsFixarsQuantidade_Fixado.Value - QRomConsFixarsQuantidade_bloqueado_Fixar.Value;
//  If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'AB' then
  QRomConsFixarsaldo_fixar.value := QRomConsFixarsaldo_fixar.value - QRomConsFixarSQUANTIDADE_PENHOR.Value;
  QRomConsFixarSaldo_Consumo.value := QRomConsFixarsQuant_Consumo.Value - QRomConsFixarsQuant_Dev_Consumo.Value - QRomConsFixarsQuantidade_bloqueado_Consumo.Value;
  wEmbalagem := DMOracle.BuscaNome('SELECT NUM_CONVERTE_FARDO FROM TB_PRODUTO',
                'COD_PRODUTO = '+QRomConsFixarCod_Produto.text);
  If wEmbalagem <> '' Then
  Begin
    QRomConsFixarsFixar_Sacas.Value := QRomConsFixarsQuantidade_Fixar.Value / StrToFloat(wEmbalagem);
    QRomConsFixarsFixado_Sacas.Value := QRomConsFixarsQuantidade_Fixado.Value / StrToFloat(wEmbalagem);
    QRomConsFixarsSaldo_Sacas.Value := QRomConsFixarsaldo_fixar.value / StrToFloat(wEmbalagem);
    QRomConsFixarsBloqueado_Sacas.Value := QRomConsFixarsQuantidade_bloqueado_Fixar.Value / StrToFloat(wEmbalagem);
  End;
End;

procedure TDMRomaneioAgricola.QRomaneioCOD_PRODUTOValidate(Sender: TField);
var
  wDesc,wUmidade : String;
  wInd : Integer;
begin
  If ((QRomaneioIND_TIPO_ROMANEIO.Value <> 'PESAGEM PA') and (DMParamSistema.CodEmpresa <> 'INOVAR')) or
              ((DMParamSistema.CodEmpresa = 'INOVAR') and (QRomaneioIND_TIPO_ROMANEIO.Value = 'ROMANEIO'))  Then //Entrar somente se for romaneio para Inovar. Solicitacao Andrio. Suporte(13064). Junior -21/08/2019
  Begin
    wUmidade := QRomaneioPERC_UMIDADE.text;
    for Wind:=1 to Length(trim(QRomaneioPERC_UMIDADE.text)) do
       if wUmidade[wInd] = ',' then
          wUmidade[wInd] := '.';
    wDesc := '';
    if (QRomaneioCod_Produto.value > 0) And
       (wUmidade <> '') Then
     Begin
       With DMDescontoProdutor Do
       Begin
         QDescontoProdutorCons.Close;
         QDescontoProdutorCons.SetVariable('Cliente',QRomaneioCod_Cadastro.Value);
         QDescontoProdutorCons.SetVariable('Produto',QRomaneioCod_Produto.Value);
         QDescontoProdutorCons.SetVariable('Dt_Validade',Trunc(DMOracle.DataServ));  // passei a colocar este campo porque estava pegando cadastro de desconto vencido
         QDescontoProdutorCons.Open;
         If Not (QDescontoProdutorCons.Eof) Then
           If QDescontoProdutorConsDt_Validade.Value >= DMOracle.DataServ Then
            Begin
              If (QRomaneioPERC_UMIDADE.Value < QDescontoProdutorConsPerc_Base.Value) Then
                 wDesc := '0'
              Else
                Begin
                  If (QRomaneioPERC_UMIDADE.Value > QDescontoProdutorConsPerc_Base.Value) Then
                    If (QRomaneioPERC_UMIDADE.Value > QDescontoProdutorConsPerc_Ate.Value) Then
                       wDesc := FloatToStr((QDescontoProdutorConsPerc_Ate.Value - QDescontoProdutorConsPerc_Base.Value) * QDescontoProdutorConsPERC_MULTIPLICADOR.Value)
                    Else
                       wDesc := FloatToStr((QRomaneioPERC_UMIDADE.Value - QDescontoProdutorConsPerc_Base.Value) * QDescontoProdutorConsPERC_MULTIPLICADOR.Value);
                  If (QRomaneioPERC_UMIDADE.Value > QDescontoProdutorConsPerc_Base1.Value) Then
                    If (QRomaneioPERC_UMIDADE.Value > QDescontoProdutorConsPerc_Ate1.Value) Then
                       wDesc :=  FloatToStr(StrToFloat(wDesc) + (QDescontoProdutorConsPerc_Ate1.Value - QDescontoProdutorConsPerc_Base1.Value) * QDescontoProdutorConsPERC_MULTIPLICADOR1.Value)
                    else
                       wDesc :=  FloatToStr(StrToFloat(wDesc) + (QRomaneioPERC_UMIDADE.Value - QDescontoProdutorConsPerc_Base1.Value) * QDescontoProdutorConsPERC_MULTIPLICADOR1.Value);
                  If (QRomaneioPERC_UMIDADE.Value >= QDescontoProdutorConsPerc_Base2.Value) Then
                    If (QRomaneioPERC_UMIDADE.Value > QDescontoProdutorConsPerc_Ate2.Value) Then
                       wDesc :=  FloatToStr(StrToFloat(wDesc) + (QDescontoProdutorConsPerc_Ate2.Value - QDescontoProdutorConsPerc_Base2.Value) * QDescontoProdutorConsPERC_MULTIPLICADOR2.Value)
                    Else
                       wDesc :=  FloatToStr(StrToFloat(wDesc) + (QRomaneioPERC_UMIDADE.Value - QDescontoProdutorConsPerc_Base2.Value) * QDescontoProdutorConsPERC_MULTIPLICADOR2.Value);
                End;
              If DMDescontoProdutor.QDescontoProdutorConsPERC_TOLERA_IMPUREZA.Text <> '' Then
                 QBalancaPerc_Tolera_Impureza.Value := DMDescontoProdutor.QDescontoProdutorConsPERC_TOLERA_IMPUREZA.Value;
            End;
       End;
      If (wDesc = '') And (wUmidade <> '') And (DMParamSistema.QParamSistemaCOD_EMPRESA.Value <> 'ROGERIOALV') Then
       Begin
         wDesc := DMOracle.BuscaNome('SELECT PERC_DESCONTO FROM TB_DESCONTO_AGRICOLA','COD_PRODUTO = '+QRomaneioCod_Produto.text+' AND PERC_UMIDADE ='+wUmidade+' AND COD_FILIAL ='+QRomaneioCod_Filial.text);
         If wDesc = '' Then
            Raise Exception.Create ('Percentual de Umidade Não Permitido');
       End;
     End;
    if wDesc <> '' then
      QRomaneioPerc_desconto.Value:=StrToFloat(wDesc);
  //  Else
  //    QRomaneioPerc_desconto.Value:=0;
  end;
end;

procedure TDMRomaneioAgricola.QRCadastroCalcFields(DataSet: TDataSet);
var wPeso_Produto:real;
    wDesconto   :Real;
begin
  wPeso_Produto := QRCadastroQT_Rateio.Value;
  CalculoDesconto(wPeso_Produto,
                  QRCadastroPerc_Desconto.Value,
                  QRCadastroPerc_Ardidos.Value,
                  QRCadastroPerc_Umidade.Value,
                  QRCadastroPerc_Impureza.Value,
                  QRCadastroPerc_Avariado.Value,
                  QRCadastroPerc_Quebrados.Value,
                  QRCadastroPerc_Diversos.Value,
                  QRCadastroCod_Romaneio_Agricola.Value,
                  QRCadastroCod_Produto.Value,
                  QRCadastroPerc_Triguilho.Value,
                  QRCadastroPerc_Tolera_Ardidos.Value,
                  QRCadastroPerc_Tolera_Impureza.Value,
                  QRCadastroPerc_Tolera_Avariado.Value,
                  QRCadastroPerc_Beneficiado.Value,
                  wLiquido,
                  wDesc_Romaneio); // este campo nao esta sendo utilizado nesta rotina
  QRCadastroSqt_Peso_Liquido.Value := wLiquido;
  wDesconto := QRCadastroPERC_DESCONTO.value;
  if wDesconto <> 0 then
     QRCadastroSqt_Umidade.Value := round(wPeso_Produto * wDesconto / 100);

  if ((QRCadastroPerc_Ardidos.Value - QRCadastroPerc_Tolera_Ardidos.Value) >  0) then
     QRCadastroSqt_ardidos.Value := round(wPeso_Produto * (QRCadastroPerc_Ardidos.Value - QRCadastroPerc_Tolera_Ardidos.Value) / 100);

  if ((QRCadastroPerc_Impureza.value - QRCadastroPerc_Tolera_Impureza.Value) > 0) then
     QRCadastroSqt_impureza.Value := round(wPeso_Produto * (QRCadastroPerc_Impureza.Value - QRCadastroPerc_Tolera_Impureza.Value) / 100);

  if ((QRCadastroPerc_Avariado.value - QRCadastroPerc_Tolera_Avariado.Value) > 0) then
     QRCadastroSqt_avariado.Value := round(wPeso_Produto * (QRCadastroPerc_Avariado.Value - QRCadastroPerc_Tolera_Avariado.Value) / 100);

  if QRCadastroPerc_Quebrados.Value > 0 then
     QRCadastroSqt_Triguilho_Quebrados.Value := round(wPeso_Produto * QRCadastroPerc_Quebrados.Value / 100);

  if QRCadastroPerc_Triguilho.Value > 0 then
     QRCadastroSqt_Triguilho_Quebrados.Value := round(QRCadastroSqt_Triguilho_Quebrados.Value +
                                               wPeso_Produto * QRCadastroPerc_Triguilho.Value / 100);
  if QRCadastroPerc_Diversos.Value > 0 then
   Begin
     QRCadastroSqt_Outros.Value := QRCadastroPerc_Diversos.Value;
     QRCadastroSqt_Diversos.Value := QRCadastroPerc_Diversos.Value;
   End;

end;

