procedure TDMRomaneioAgricola.QrRomEmissaoCalcFields(DataSet: TDataSet);
var wDesconto:String;
begin
  With DMProdutoAgricola do
  Begin
    QProdutoAgricola.Close;
    QProdutoAgricola.setVariable('PK',DmRomaneioAgricola.QrRomEmissaoCod_Produto.Value);
    QProdutoAgricola.Open;
  End;
  QRRomEmissaoPesoBalanca.Value := QRRomemissaoQT_Peso_Bruto.Value - QRRomEmissaoQt_tara.Value;
  wDesconto := DmOracle.BuscaNome('SELECT PERC_DESCONTO FROM TB_ROMANEIO_AGRICOLA', 'COD_ROMANEIO_AGRICOLA = ' + FloattoStr(QrRomEmissaoCod_Romaneio_Agricola.Value));
  if wDesconto <> '' then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'GRASEL')  Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CEREAIS') Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'NUTRI')   Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO')   Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CITY')    Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ALEOESTE') or (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'ESPIGAO') or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'BMG')   Then
//      If QrRomEmissaoCod_Cadastro.Value = QrRomEmissaoCod_Cadastro_Romaneio.Value Then
         QrRomEmissaoUmidade.Value := round(QRRomEmissaoPesoBalanca.Value * strtoFloat(wDesconto) / 100)
//      Else
//         QrRomEmissaoUmidade.Value := round(QRRomEmissaoQt_Rateio.Value * strtoFloat(wDesconto) / 100)
    Else
      QrRomEmissaoUmidade.Value := round(QRRomEmissaoQt_Rateio.Value * strtoFloat(wDesconto) / 100);

  if ((QrRomEmissaoPerc_Ardidos.Value  - QrRomEmissaoPerc_Tolera_Ardidos.Value) >  0) then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'GRASEL') Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CEREAIS') Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'NUTRI')  Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO')   Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CITY')   Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ALEOESTE')or (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'ESPIGAO') or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'BMG')  Then
//      If QrRomEmissaoCod_Cadastro.Value = QrRomEmissaoCod_Cadastro_Romaneio.Value Then
        QrRomEmissaoArdidos.Value := round(QRRomEmissaoPesoBalanca.Value * (QrRomEmissaoPerc_Ardidos.Value - QrRomEmissaoPerc_Tolera_Ardidos.Value) / 100)
//      else
//        QrRomEmissaoArdidos.Value := round(QRRomEmissaoQt_Rateio.Value * (QrRomEmissaoPerc_Ardidos.Value - QrRomEmissaoPerc_Tolera_Ardidos.Value) / 100)
    else
       QrRomEmissaoArdidos.Value := round(QRRomEmissaoQt_Rateio.Value * (QrRomEmissaoPerc_Ardidos.Value - QrRomEmissaoPerc_Tolera_Ardidos.Value) / 100);

  If ((QrRomEmissaoPerc_Impureza.Value - QrRomEmissaoPerc_Tolera_Impureza.Value) > 0) then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'GRASEL') Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CEREAIS') Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'NUTRI')  Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO')   Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CITY')   Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ALEOESTE')or (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'ESPIGAO') or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'BMG')   Then
//      If QrRomEmissaoCod_Cadastro.Value = QrRomEmissaoCod_Cadastro_Romaneio.Value Then
         QrRomEmissaoImpureza.Value := round(QRRomEmissaoPesoBalanca.Value * (QrRomEmissaoPerc_Impureza.Value - QrRomEmissaoPerc_Tolera_Impureza.Value) / 100)
//      Else
//         QrRomEmissaoImpureza.Value := round(QRRomEmissaoQt_Rateio.Value * (QrRomEmissaoPerc_Impureza.Value - QrRomEmissaoPerc_Tolera_Impureza.Value) / 100)
    Else
      QrRomEmissaoImpureza.Value := round(QRRomEmissaoQt_Rateio.Value * (QrRomEmissaoPerc_Impureza.Value - QrRomEmissaoPerc_Tolera_Impureza.Value) / 100);

  if ((QrRomEmissaoPerc_Avariado.Value - QrRomEmissaoPerc_Tolera_Avariado.Value) > 0) then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'GRASEL') Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CEREAIS') Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'NUTRI')  Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO')   Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CITY')   Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ALEOESTE')or (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'ESPIGAO') or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'BMG')   Then
//      If QrRomEmissaoCod_Cadastro.Value = QrRomEmissaoCod_Cadastro_Romaneio.Value Then
         QrRomEmissaoAvariados.Value := round(QRRomEmissaoPesoBalanca.Value * (QrRomEmissaoPerc_Avariado.Value - QrRomEmissaoPerc_Tolera_Avariado.Value) / 100)
//      else
//         QrRomEmissaoAvariados.Value := round(QRRomEmissaoQt_Rateio.Value * (QrRomEmissaoPerc_Avariado.Value - QrRomEmissaoPerc_Tolera_Avariado.Value) / 100)
    else
       QrRomEmissaoAvariados.Value := round(QRRomEmissaoQt_Rateio.Value * (QrRomEmissaoPerc_Avariado.Value - QrRomEmissaoPerc_Tolera_Avariado.Value) / 100);

  If QrRomEmissaoPerc_Quebrados.Value > 0 then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'GRASEL') Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CEREAIS') Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'NUTRI')  Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO')   Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CITY')   Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ALEOESTE')or (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'ESPIGAO') or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'BMG')   Then
//      If QrRomEmissaoCod_Cadastro.Value = QrRomEmissaoCod_Cadastro_Romaneio.Value Then
        QrRomEmissaoQuebrados.Value := round(QRRomEmissaoPesoBalanca.Value * QrRomEmissaoPerc_Quebrados.Value / 100)
//      Else
//        QrRomEmissaoQuebrados.Value := round(QRRomEmissaoQt_Rateio.Value * QrRomEmissaoPerc_Quebrados.Value / 100)
    Else
       QrRomEmissaoQuebrados.Value := round(QRRomEmissaoQt_Rateio.Value * QrRomEmissaoPerc_Quebrados.Value / 100);

  if QrRomEmissaoPerc_Diversos.Value > 0 then
    QrRomEmissaoDiversos.Value := QrRomEmissaoPerc_Diversos.Value;

  if QrRomEmissaoPerc_Triguilho.Value > 0 then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'GRASEL') Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CEREAIS') Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'NUTRI')  Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO')   Or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'CITY')   Or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ALEOESTE')or (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'ESPIGAO') or
       (DMParamSistema.QParamSistemaCod_Empresa.Value = 'BMG')  Then
//      If QrRomEmissaoCod_Cadastro.Value = QrRomEmissaoCod_Cadastro_Romaneio.Value Then
         QrRomEmissaoTriguilho.Value := round(QRRomEmissaoPesoBalanca.Value * QrRomEmissaoPerc_Triguilho.Value / 100)
//      Else
//         QrRomEmissaoTriguilho.Value := round(QRRomEmissaoQt_Rateio.Value * QrRomEmissaoPerc_Triguilho.Value / 100)
    Else
       QrRomEmissaoTriguilho.Value := round(QRRomEmissaoQt_Rateio.Value * QrRomEmissaoPerc_Triguilho.Value / 100);

  // este calculo serve para impressao da quantidade liquida no romaneio e os calculos acima servem para impressao dos descontos no romaneio
  CalculoDesconto(QRRomEmissaoQt_Rateio.Value,
                  QRRomEmissaoPerc_Desconto.Value,
                  QRRomEmissaoPerc_Ardidos.Value,
                  QRRomEmissaoPerc_Umidade.Value,
                  QRRomEmissaoPerc_Impureza.Value,
                  QRRomEmissaoPerc_Avariado.Value,
                  QRRomEmissaoPerc_Quebrados.Value,
                  QRRomEmissaoPerc_Diversos.Value,
                  QRRomEmissaoCod_Romaneio_Agricola.Value,
                  QRRomEmissaoCod_Produto.Value,
                  QRRomEmissaoPerc_Triguilho.Value,
                  QRRomEmissaoPerc_Tolera_Ardidos.Value,
                  QRRomEmissaoPerc_Tolera_Impureza.Value,
                  QRRomEmissaoPerc_Tolera_Avariado.Value,
                  QRRomEmissaoPerc_Beneficiado.Value,
                  wLiquido,
                  wDesc_Romaneio); // este campo nao esta sendo utilizado nesta rotina


  QrRomEmissaoTotalDesconto.Value := QrRomEmissaoUmidade.Value + QrRomEmissaoArdidos.Value +
                                     QrRomEmissaoImpureza.Value + QrRomEmissaoAvariados.Value +
                                     QrRomEmissaoQuebrados.Value + QrRomEmissaoDiversos.Value;
//                                     QrRomEmissaoTriguilho.Value;
  QrRomEmissaoLiquido.Value := QRRomEmissaoQt_Rateio.Value - wDesc_Romaneio;

  QrRomEmissaoDesc_Usuario.Value := DmOracle.BuscaNome('SELECT NOME FROM TB_USUARIO', 'COD_USUARIO = ' + FloattoStr(QrRomEmissaoCod_Usuario.Value), True);

  If QrRomEmissaoPerc_Impureza.Value > QrRomEmissaoPerc_Tolera_Impureza.Value Then
     QrRomEmissaoPerc_liq_Impureza.Value := QrRomEmissaoPerc_Impureza.Value - QrRomEmissaoPerc_Tolera_Impureza.Value;
  If QrRomEmissaoPerc_Ardidos.Value > QrRomEmissaoPerc_Tolera_Ardidos.Value Then
     QrRomEmissaoPerc_liq_Ardidos.Value := QrRomEmissaoPerc_Ardidos.Value - QrRomEmissaoPerc_Tolera_Ardidos.Value;
  If QrRomEmissaoPerc_Avariado.Value > QrRomEmissaoPerc_Tolera_Avariado.Value Then
     QrRomEmissaoPerc_liq_Avariado.Value := QrRomEmissaoPerc_Avariado.Value - QrRomEmissaoPerc_Tolera_Avariado.Value;
  QrRomEmissaoDesc_mensagem.Value := DMOracle.BuscaNome('SELECT DESC_MENSAGEM FROM TB_MENSAGEM','COD_MENSAGEM = ' +FloatToStr(QrRomEmissaoCod_Mensagem.VALUE),True);
End;

procedure TDMRomaneioAgricola.QrRomDescontoCalcFields(DataSet: TDataSet);
var wPeso_Produto, wDesconto :real;
    wPadrao : String;
begin
  With DMProdutoAgricola do
  Begin
    QProdutoAgricola.Close;
    QProdutoAgricola.setVariable('PK',QrRomDescontoCod_Produto.Value);
    QProdutoAgricola.Open;
  End;
  QrRomDescontoQt_Peso_Bruto.Value := 0;
  QrRomDescontoQt_Tara.Value := 0;
  If QrRomDescontoCod_Cadastro_Romaneio.Value = QrRomDescontoCod_Cadastro.Value Then
   Begin
     QrRomDescontoQt_Peso_Bruto.Value :=QrRomDescontoQt_Peso_Bruto_Sql.value;
     QrRomDescontoQt_Tara.Value :=QrRomDescontoQt_Tara_Sql.value;
   End;
  wPeso_Produto := QRRomDescontoQT_Rateio.Value;
  If (QrRomDescontoIND_TIPO_ROMANEIO.Value = 'PESAGEM EN') Or
     (QrRomDescontoIND_TIPO_ROMANEIO.Value = 'PESAGEM SA') Then
    Begin
      wPadrao := '';
      If QrRomDescontoCOD_CONTRATO_VEND.Text <> '' Then
         wPadrao := DMOracle.BuscaNome('SELECT COD_PADRAO_DESCONTO_PRODUTO FROM TB_CONTRATO_VEND','COD_CONTRATO_VEND = '+QrRomDescontoCOD_CONTRATO_VEND.Text);
      If QRRomaneioCOD_CONTRATO_PJURIDICA.Text <> '' Then
         wPadrao := DMOracle.BuscaNome('SELECT COD_PADRAO_DESCONTO_PRODUTO FROM TB_CONTRATO_PJURIDICA','COD_CONTRATO_PJURIDICA = '+QrRomDescontoCOD_CONTRATO_PJURIDICA.Text);
      wLiquido := wPeso_Produto; //serve no caso de nao ter sido informado padrao de desconto - ai peso liquido é o peso de balanca
      If wPadrao <> '' Then
         CalculoDesconto_Saida( wPeso_Produto,
                            QrRomDescontoPerc_ardidos.Value,
                            QrRomDescontoPerc_Umidade.Value,
                            QrRomDescontoPerc_Impureza.Value,
                            QrRomDescontoPerc_Avariado.Value,
                            QrRomDescontoPerc_Quebrados.Value,
                            QrRomDescontoPerc_Triguilho.Value,
                            StrToInt(wPadrao),
                            wLiquido, wDesconto);
      QRRomDescontoLiquido.Value := wLiquido;

      // esta acessando a tabela no calculo do desconto saida
      If QrRomDescontoPerc_Umidade.Value > DMPadraoProduto.QPadraoDescontoProdutoNUM_UMIDADE_TOLERANCIA.Value Then
        QrRomDescontoUmidade.Value := wPeso_Produto * ((QrRomDescontoPerc_Umidade.Value - DMPadraoProduto.QPadraoDescontoProdutoNUM_UMIDADE_TOLERANCIA.Value) * DMPadraoProduto.QPadraoDescontoProdutoNUM_UMIDADE_DESCONTO.Value) / 100;

      If QrRomDescontoPerc_ardidos.Value > DMPadraoProduto.QPadraoDescontoProdutoNUM_ARDIDOS_TOLERANCIA.Value Then
        QrRomDescontoArdidos.Value := wPeso_Produto * ((QrRomDescontoPerc_ardidos.Value - DMPadraoProduto.QPadraoDescontoProdutoNUM_ARDIDOS_TOLERANCIA.Value) * DMPadraoProduto.QPadraoDescontoProdutoNUM_ARDIDOS_DESCONTO.Value) / 100;

      If QrRomDescontoPerc_Impureza.value > DMPadraoProduto.QPadraoDescontoProdutoNUM_IMPUREZA_TOLERANCIA.Value Then
        QrRomDescontoImpureza.Value := wPeso_Produto * ((QrRomDescontoPerc_Impureza.value - DMPadraoProduto.QPadraoDescontoProdutoNUM_IMPUREZA_TOLERANCIA.Value) * DMPadraoProduto.QPadraoDescontoProdutoNUM_IMPUREZA_DESCONTO.Value) / 100;

      If QrRomDescontoPerc_Avariado.Value > DMPadraoProduto.QPadraoDescontoProdutoNUM_AVARIADO_TOLERANCIA.Value Then
        QrRomDescontoOutros.Value := wPeso_Produto * ((QrRomDescontoPerc_Avariado.Value - DMPadraoProduto.QPadraoDescontoProdutoNUM_AVARIADO_TOLERANCIA.Value) * DMPadraoProduto.QPadraoDescontoProdutoNUM_AVARIADO_DESCONTO.Value) / 100;

      If QrRomDescontoPerc_Quebrados.Value > DMPadraoProduto.QPadraoDescontoProdutoNUM_QUEBRADO_TOLERANCIA.Value Then
        QrRomDescontoTriguilho_Quebrados.Value := wPeso_Produto * ((QrRomDescontoPerc_Quebrados.Value - DMPadraoProduto.QPadraoDescontoProdutoNUM_QUEBRADO_TOLERANCIA.Value) * DMPadraoProduto.QPadraoDescontoProdutoNUM_QUEBRADO_DESCONTO.Value) / 100;

      If QrRomDescontoPerc_Triguilho.Value > DMPadraoProduto.QPadraoDescontoProdutoNUM_TRIGUILHO_TOLERANCIA.Value Then
        QrRomDescontoTriguilho_Quebrados.Value := wPeso_Produto * ((QrRomDescontoPerc_Triguilho.Value - DMPadraoProduto.QPadraoDescontoProdutoNUM_TRIGUILHO_TOLERANCIA.Value) * DMPadraoProduto.QPadraoDescontoProdutoNUM_TRIGUILHO_DESCONTO.Value) / 100;
    End
  Else
    Begin
      CalculoDesconto(wPeso_Produto,
                      QRRomDescontoPerc_Desconto.Value,
                      QRRomDescontoPerc_Ardidos.Value,
                      QRRomDescontoPerc_Umidade.Value,
                      QRRomDescontoPerc_Impureza.Value,
                      QRRomDescontoPerc_Avariado.Value,
                      QRRomDescontoPerc_Quebrados.Value,
                      QRRomDescontoPerc_Diversos.Value,
                      QRRomDescontoCod_Romaneio_Agricola.Value,
                      QRRomDescontoCod_Produto.Value,
                      QRRomDescontoPerc_Triguilho.Value,
                      QRRomDescontoPerc_Tolera_Ardidos.Value,
                      QRRomDescontoPerc_Tolera_Impureza.Value,
                      QRRomDescontoPerc_Tolera_Avariado.Value,
                      QRRomDescontoPerc_Beneficiado.Value,
                      wLiquido,
                      wDesc_Romaneio); // este campo nao esta sendo utilizado nesta rotina
      QRRomDescontoLiquido.Value := wLiquido;
      wDesconto := QRRomDescontoPERC_DESCONTO.value;
      if wDesconto <> 0 then
         QrRomDescontoUmidade.Value := round(wPeso_Produto * wDesconto / 100);

      if ((QrRomDescontoPerc_Ardidos.Value - DMProdutoAgricola.QProdutoAgricolaPerc_Tolera_Ardidos.Value) >  0) then
         QrRomDescontoArdidos.Value := round(wPeso_Produto * (QrRomDescontoPerc_Ardidos.Value - QrRomDescontoPerc_Tolera_Ardidos.Value) / 100);

      if ((QrRomDescontoPerc_Impureza.value - DMProdutoAgricola.QProdutoAgricolaPerc_Tolera_Impureza.Value) > 0) then
         QrRomDescontoImpureza.Value := round(wPeso_Produto * (QrRomDescontoPerc_Impureza.Value - QrRomDescontoPerc_Tolera_Impureza.Value) / 100);

      if ((QrRomDescontoPerc_Avariado.value - DMProdutoAgricola.QProdutoAgricolaPerc_Tolera_Avariado.Value) > 0) then
         QrRomDescontoOutros.Value := round(wPeso_Produto * (QrRomDescontoPerc_Avariado.Value - QrRomDescontoPerc_Tolera_Avariado.Value) / 100);

      if QrRomDescontoPerc_Quebrados.Value > 0 then
         QrRomDescontoTriguilho_Quebrados.Value := round(wPeso_Produto * QrRomDescontoPerc_Quebrados.Value / 100);
      if QrRomDescontoPerc_Triguilho.Value > 0 then
         QrRomDescontoTriguilho_Quebrados.Value := round(QrRomDescontoTriguilho_Quebrados.Value +
                                                   wPeso_Produto * QrRomDescontoPerc_Triguilho.Value / 100);
      if QrRomDescontoPerc_Diversos.Value > 0 then
         QrRomDescontoOutros.Value := QrRomDescontoPerc_Diversos.Value;
    End;
end;

Procedure TDMRomaneioAgricola.NotaAgricola;
var
   wPeso_Produto:real;
   wTotalItem : Real;
   wArdidos   : Real;
   wImpureza  : Real;
   wQuebrados : Real;
begin
  wArdidos := 0;
  wImpureza := 0;
  wPeso_Produto := QRRomNotaQT_Rateio.Value;
  CalculoDesconto(wPeso_Produto,
                  QRRomNotaPerc_Desconto.Value,
                  QRRomNotaPerc_Ardidos.Value,
                  QRRomNotaPerc_Umidade.Value,
                  QRRomNotaPerc_Impureza.Value,
                  QRRomNotaPerc_Avariado.Value,
                  QRRomNotaPerc_Quebrados.Value,
                  QRRomNotaPerc_Diversos.Value,
                  QRRomNotaCod_Romaneio_Agricola.Value,
                  QRRomNotaCod_Produto.Value,
                  QRRomNotaPerc_Triguilho.Value,
                  QRRomNotaPerc_Tolera_Ardidos.Value,
                  QRRomNotaPerc_Tolera_Impureza.Value,
                  QRRomNotaPerc_Tolera_Avariado.Value,
                  QRRomNotaPerc_Beneficiado.Value,
                  wLiquido,
                  wDesc_Romaneio); // este campo nao esta sendo utilizado nesta rotina

  if (QRRomNotaInd_Tipo_Produto.Value <> 'COMERCIAL')           And
     (QRRomNotaDesc_Unidade.Value     =  'T')                   And
     (DMParamSistema.QParamSistemaCod_Empresa.Value = 'TOFECO') Then
     wLiquido := wLiquido / 1000;

  wTotalItem := wLiquido * QRRomNotaVal_Varejo.Value;

  If (DMParamSistema.QParamSistemaCod_Empresa.Value <> 'TOFECO') Then
     if (QRRomNotaNum_Embalagem.Value     > 0)           and
        (QRRomNotaInd_Tipo_Produto.Value <> 'COMERCIAL') then
         wTotalItem := wTotalItem / QRRomNotaNum_Embalagem.Value;

  // consiste para verificar se quebrou o codigo cliente
  if QRRomNotaCod_Cadastro.Value <> QRNotaCod_Cadastro.Value then
     IncluiNotaCab
  else
  Begin
    QRNota.Edit;
    If Length(Trim(QrNotaOBS.Value)) < 55 Then
      QrNotaOBS.Value := QrNotaOBS.Value + ', ' + FloatToStr(QRRomNotaNum_Romaneio.Value)
    else
      QrNotaOBS_COMPLEMENTO.Value := QrNotaOBS_COMPLEMENTO.Value + ', ' + FloatToStr(QRRomNotaNum_Romaneio.Value);
    if (DMParamSistema.CodEmpresa = 'TOFECO') and (not QrRomNotaNUM_NOTA_PRODUTOR.IsNull) then
      QrNotaOBS_COMPLEMENTO.Value := QrNotaOBS_COMPLEMENTO.Value + ', NR NOTA PRODUTOR ' +
        QrRomNotaNUM_NOTA_PRODUTOR.Text;
    QRNota.Post;
  end;
  // chama procedure para incluir ou atualizaritem

  IncluiNotaItem(wLiquido,wTotalItem,QrRomNotaCod_Produto.Value,QrRomNotaPerc_Ph.Value,QrRomNotaVal_Varejo.Value,QRRomNotaPerc_Beneficiado.Value);
  with DMNotaEntrada do
  begin
    if (not QrRomNotaNUM_NOTA_PRODUTOR.IsNull) and
       (not QrRomNotaCOD_CADASTRO.IsNull) and
       (QrNotaCOD_SERIE_MODELO.Value = '55') then
    begin
      try
        QNotaReferenciada.Close;
        QNotaReferenciada.SetVariable('COD_NOTA_CAB', QrNotaCOD_NOTA_CAB.Value);
        QNotaReferenciada.Open;

        while not QNotaReferenciada.Eof do
          QNotaReferenciada.Delete;

        QNotaReferenciadaInsert.Close;
        QNotaReferenciadaInsert.SetVariable('COD_NOTA_CAB'
          , QrNotaCOD_NOTA_CAB.Value);
        QNotaReferenciadaInsert.SetVariable('NUM_NOTA'
          , QrRomNotaNUM_NOTA_PRODUTOR.AsInteger);
        QNotaReferenciadaInsert.SetVariable('COD_CADASTRO'
          , QrNotaCOD_CADASTRO.Value);
        QNotaReferenciadaInsert.SetVariable('COD_SERIE'
          , QrNotaCOD_SERIE.Value);
        QNotaReferenciadaInsert.SetVariable('COD_SERIE_MODELO'
          , QrNotaCOD_SERIE.Value);
        QNotaReferenciadaInsert.SetVariable('DT_EMISSAO'
          , QrNotaDT_EMISSAO.Value);
        QNotaReferenciadaInsert.Open;
                 
//        QNotaReferenciada.Insert;
//        QNotaReferenciadaCOD_NOTA_CAB.Value :=  QrNotaCOD_NOTA_CAB.Value;
//        QNotaReferenciadaNUM_NOTA.Value := QrRomNotaNUM_NOTA_PRODUTOR.AsInteger;
//        QNotaReferenciadaCOD_CADASTRO.Value := QrNotaCOD_CADASTRO.Value;
//        QNotaReferenciadaCOD_SERIE.Value := QrNotaCOD_SERIE.Value;
//        QNotaReferenciadaCOD_SERIE_MODELO.Value := QrNotaCOD_SERIE_MODELO.Value;
//        QNotaReferenciadaDT_EMISSAO.Value := QrNotaDT_EMISSAO.Value;
//        QNotaReferenciada.Post;

      except
        QNotaReferenciadaInsert.Cancel;
        QNotaReferenciada.Cancel;
      end;
    end;
  end;
  // esta rotina serve para controlar o contas a pagar de freteiro e arranquio
  If DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'TOFECO' Then
   Begin
     If QrRomNotaCod_Transportadora.Text <> '' Then   // aqui é para os freteiros - para gerar o contas a pagar
      Begin
        If (not ClFreteiro.Locate('Cod_Cadastro;Dt_Vencto;Cod_Nota_Cab', VarArrayOf([QrRomNotaCod_Cadastro.Text,QrRomNotaDt_Vencto_Frete.Text,QrNotaCod_Nota_Cab.Text]),[])) Then
         Begin
           ClFreteiro.Append;
           ClFreteiroCod_Cadastro.Value := QrRomNotaCod_Cadastro.Value;
           ClFreteiroVl_Frete.Value := wLiquido * QrRomNotaVl_Frete.Value;  // 1000;
           ClFreteiroDesc_Obs.Value := 'Romaneios Nr. ' + QrRomNotaNum_Romaneio.Text;
           ClFreteiroDt_Vencto.Value := QrRomNotaDt_Vencto_Frete.Value;
           ClFreteiroCod_Nota_Cab.Value := QrNotaCod_Nota_Cab.Value;
           ClFreteiro.Post;
         End
        Else
         Begin
           ClFreteiro.Edit;
           ClFreteiroVl_Frete.Value := ClFreteiroVl_Frete.Value + wLiquido * QrRomNotaVl_Frete.Value;  // 1000;
           ClFreteiroDesc_Obs.Value := ClFreteiroDesc_Obs.Value + ', ' + QrRomNotaNum_Romaneio.Text;
           ClFreteiro.Post;
         End;
      End;
     If QrRomNotaCod_Arranquio.Text <> '' Then  // aqui é para o arranquio - para gerar o contas a pagar
      Begin
        If (not ClArranquio.Locate('Cod_Cadastro;Dt_Vencto;Cod_Nota_Cab', VarArrayOf([QrRomNotaCod_Cadastro.Text,QrRomNotaDt_Vencto_Frete.Text,QrNotaCod_Nota_Cab.Text]),[])) Then
         Begin
           ClArranquio.Append;
           ClArranquioCod_Cadastro.Value := QrRomNotaCod_Cadastro.Value;
           ClArranquioVl_Arranquio.Value := wLiquido * QrRomNotaVl_Arranquio.Value;   // 1000;
           ClArranquioDesc_Obs.Value := 'Romaneios Nr. ' + QrRomNotaNum_Romaneio.Text;
           ClArranquioDt_Vencto.Value := QrRomNotaDt_Vencto_Arranquio.Value;
           ClArranquioCod_Nota_Cab.Value := QrNotaCod_Nota_Cab.Value;
           ClArranquio.Post;
         End
        Else
         Begin
           ClArranquio.Edit;
           ClArranquioVl_Arranquio.Value := ClArranquioVl_Arranquio.Value + wLiquido * QrRomNotaVl_Arranquio.Value;  // 1000;
           ClArranquioDesc_Obs.Value := ClArranquioDesc_Obs.Value + ', ' + QrRomNotaNum_Romaneio.Text;
           ClArranquio.Post;
         End;
      End;
   End;

  // esta rotina serve para atualizar o campo SITUACAO do rateio para informar que ja foi atualizado este rateio
  QRRateioAtualiza.close;
  QRRateioAtualiza.SetVariable('ROMANEIO',QrRomNotaCod_Romaneio_Agricola.Value);
  QRRateioAtualiza.SetVariable('CADASTRO',QrRomNotaCod_Cadastro.Value);
  QRRateioAtualiza.ExecSql;
  // esta rotina serve para calcular os descontos dos produtos para atualizar estoque
  if DMParamSistema.QParamSistemaCod_Produto_Ardidos.Value > 0 then
     if QrRomNotaPerc_Ardidos.Value >  0 then
     Begin
       wArdidos := wArdidos + round(QRRomNotaQT_Rateio.Value * QrRomNotaPerc_Ardidos.Value / 100);
       DMEstoque.AtualizaEstoque(StrToInt(QrNotaCod_Operacao.Text),
                                 StrToInt(QrNotaCod_Filial.Text),
                                 DMParamSistema.QParamSistemaCod_Produto_Ardidos.Value,
                                 1,
                                 wArdidos,
                                 0,
                                 QrNotaDt_Recebimento.Value,
                                 0 );
     end;
  if DMParamSistema.QParamSistemaCod_Produto_Impureza.Value > 0 then
     if QrRomNotaPerc_Impureza.value > 0 then
     Begin
       wImpureza := wImpureza + round(QRRomNotaQT_Rateio.Value * QrRomNotaPerc_Impureza.Value / 100);
       DMEstoque.AtualizaEstoque(Trunc(QrNotaCod_Operacao.Value),
                                 Trunc(QrNotaCod_Filial.Value),
                                 DMParamSistema.QParamSistemaCod_Produto_Impureza.Value,
                                 1,
                                 wImpureza,
                                 0,
                                 QrNotaDt_Recebimento.Value,
                                 0 );
     end;
  if DMParamSistema.QParamSistemaCod_Produto_Quebrados.Value > 0 then
     if QrRomNotaPerc_Quebrados.Value > 0 then
     begin
       with DMProduto do
       begin
         QProduto.close;
         QProduto.SetVariable('PK',DMParamSistema.QParamSistemaCod_Produto_Quebrados.Value);
         QProduto.Open;
       end;
       wQuebrados := Round(QRRomNotaQT_Rateio.Value * QrRomNotaPerc_Quebrados.Value / 100);
       wTotalItem := wQuebrados * DMProduto.QprodutoVal_Varejo.Value;
       If DMProduto.QProdutoNum_Embalagem.Value > 0 then
          wTotalItem := wTotalItem / DMProduto.QProdutoNum_Embalagem.Value;
       IncluiNotaItem(wQuebrados,wTotalItem,DMParamSistema.QParamSistemaCod_Produto_Quebrados.Value,0,DMProduto.QprodutoVal_Varejo.Value,0);
     end;
  if DMParamSistema.QParamSistemaCod_Produto_Triguilho.Value > 0 then
     if QrRomNotaPerc_Triguilho.Value > 0 then
     begin
       If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO') Or
          (DMParamSistema.QParamSistemaCod_Empresa.Value = 'AB') Then
        Begin
         If QrRomNotaCod_Cadastro.Value = QrRomNotaCod_Cadastro_Romaneio.Value Then
            Rateio_Triguilho(QrRomNotaQt_Peso_Romaneio.Value); //Somente gera triguilho quando for o cadastro principal nao faz rateio de triguilho
        end                        //este 100 representa 100 por cento
       Else
        Rateio_Triguilho(QRRomNotaQT_Rateio.Value);
     End;
End;

procedure TDMRomaneioAgricola.Rateio_Triguilho(wQtPeso : Real);
Var wTriguilho,wTotalItem : Real;
Begin
  with DMProduto do
  begin
    QProduto.close;
    QProduto.SetVariable('PK',DMParamSistema.QParamSistemaCod_Produto_Triguilho.Value);
    QProduto.Open;
  end;
  wTriguilho := round(wQtPeso * QrRomNotaPerc_Triguilho.Value / 100);
  wTotalItem := wTriguilho * DMProduto.QprodutoVal_Varejo.Value;
  If DMProduto.QProdutoNum_Embalagem.Value > 0 then
     wTotalItem := wTotalItem / DMProduto.QProdutoNum_Embalagem.Value;
  IncluiNotaItem(wTriguilho,wTotalItem,DMParamSistema.QParamSistemaCod_Produto_Triguilho.Value,0,DMProduto.QprodutoVal_Varejo.Value,0);
end;

procedure TDMRomaneioAgricola.FinalizaNota;
var wTotalNota, wQtde, wTotPis,wTotCofins : Real;
begin
  wTotalNota := 0;
  wTotPis := 0;
  wTotCofins := 0;
  QrNotaItem.Close;
  QrNotaItem.Open;
  QrNotaItem.First;
  While not QrNotaItem.Eof do
  begin
    if QrNotaItemPERC_BENEFICIADO.value<>0 then
      wQtde:=round(QrNotaItemQt_Quantidade.Value*(QrNotaItemPERC_BENEFICIADO.value)/100)
    else
      wQtde:=round(QrNotaItemQt_Quantidade.Value);
    DMEstoque.AtualizaEstoque(Trunc(QrNotaCod_Operacao.Value),
                              Trunc(QrNotaCod_Filial.Value),
                              Trunc(QrNotaItemCod_Produto.Value),
                              1,
                              wqtde,
                              QrNotaItemVal_Custo.Value,
                              QrNotaDt_Recebimento.Value,
                              0 );
    wTotalNota := wTotalNota + QrNotaItemVal_Total.Value;
    wTotPis := wTotPis + QrNotaItemVal_Pis.Value;
    wTotCofins := wTotCofins + QrNotaItemVal_Confins.Value;
    QrNotaItem.next;
  end;
  With DMOperacao do
  begin
//    QOperacao.Close;  // mudado pelo Cesar esta acessando a tabela de operacao no inicio da rotina de emissao de romaneios
//    QOperacao.SetVariable('Pk',QrNotaCod_Operacao.Value);
//    QOperacao.Open;
    // Valor da Nota
    DMPlanilha.GravaLanc('NFE',
                         QrNotaCod_Nota_Cab.Value,
                         FloatToStr(QrNotaNum_Nota.Value)+'-'+QrNotaCod_Serie.Value + '-' + DmCadastro.QCadastroNome.Value,
                         QrNotaCod_Filial.Value,
                         QOperacaoCod_Contabil_Val_Nota_Cred.Value,
                         'CREDITO',
                         QrNotaCod_Cadastro.Value,
                         QOperacaoCod_Historico_Contabil.Value,
                         wTotalNota,
                         QrNotaDt_Recebimento.Value,
