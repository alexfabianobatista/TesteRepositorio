          (QBalancaPerc_Impureza.Value > QProdutoAgricolaPerc_Max_Impureza_Com_Desc.Value)) then
        raise Exception.create('Percentual de Impureza Não Permitido');

      if (QBalancaPerc_Impureza.Value > 0) and
         ((QBalancaPerc_Impureza.Value < QProdutoAgricolaPerc_Max_Impureza_Sem_Desc.Value) or
          (QBalancaPerc_Impureza.Value > QProdutoAgricolaPerc_Max_Impureza_Com_Desc.Value)) then
        raise Exception.create('Percentual de Impureza Não Permitido');

      if (QBalancaPerc_Avariado.Value > 0) and
         ((QBalancaPerc_Avariado.Value < QProdutoAgricolaPerc_Max_Avaria_Sem_Desc.Value) or
          (QBalancaPerc_Avariado.Value > QProdutoAgricolaPerc_Max_Avaria_Com_Desc.Value)) then
        raise Exception.create('Percentual de Avariados Não Permitido');

      if (QBalancaPerc_Quebrados.Value > 0) and
         ((QBalancaPerc_Quebrados.Value < QProdutoAgricolaPerc_Max_Quebra_Sem_Desc.Value) or
          (QBalancaPerc_Quebrados.Value > QProdutoAgricolaPerc_Max_Quebra_Com_Desc.Value)) then
        raise Exception.create('Percentual de Quebrados Não Permitido');

      if (QBalancaPerc_Ph.Value > 0) and
         ((QBalancaPerc_Ph.Value < QProdutoAgricolaPerc_Max_Ph_Sem_Desc.Value) or
          (QBalancaPerc_Ph.Value > QProdutoAgricolaPerc_Max_Ph_Com_Desc.Value)) then
        raise Exception.create('Percentual de PH Não Permitido');
    end;
  end;
End;

