  If (QBalancaQT_PESO_CHEGADA.Value > 0) And (QBalancaQT_PESO_SAIDA.Value > 0) Then
   Begin
     wSaldo :=DMOracle.Buscanome('SELECT qt_quantidade - qt_movimento from tb_obra_contrato_produto,tb_obra_contrato',
          'tb_obra_contrato_produto.cod_obra_contrato=tb_obra_contrato.cod_obra_contrato and Cod_Obra = '+QBalancaCod_Obra.Text +
          ' and cod_produto='+QBalancaCod_Produto.Text);
     If wSaldo = ''  Then
        ShowMessage('Produto não liberado para esta obra')
     Else   
        If QBalancaqt_peso_balanca.Value > StrToFloat(wSaldo) Then
           ShowMessage('Quantidade esta maior que saldo de contrato');
     //        Raise exception.Create('Produto não liberado para esta obra'); -- retirado a pedido da Lani (Cesar 13/03/2017)
//        Raise exception.Create('Quantidade esta maior que saldo de contrato'); -- retirado a pedido da Lani (Cesar 13/03/2017)
   End;
End;

Procedure TDMRomaneioAgricola.ValidaRomaneio;
Begin
  With DMProdutoAgricola do
  begin
    QProdutoAgricola.Close;
    QProdutoAgricola.setVariable('PK',QBalancaCod_Produto.Value);
    QProdutoAgricola.Open;

    if QBalancaIND_TIPO.Value <> 'Diversos' then
    begin
      if (QBalancaPerc_Umidade.Value > 0) and ((QBalancaPerc_Umidade.Value < QProdutoAgricolaPerc_Max_Umidade_Sem_Desc.Value) or (QRomaneioPerc_Umidade.Value > QProdutoAgricolaPerc_Max_Umidade_Com_Desc.Value)) then
        raise Exception.create('Percentual de Umidade Não Permitido');

      if (QBalancaPerc_Ardidos.Value > 0) and
         ((QBalancaPerc_Ardidos.Value < QProdutoAgricolaPerc_Max_Ardidos_Sem_Desc.Value) or
          (QBalancaPerc_Ardidos.Value > QProdutoAgricolaPerc_Max_Ardidos_Com_Desc.Value)) then
