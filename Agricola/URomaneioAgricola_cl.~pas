procedure TDMRomaneioAgricola.IncluiNotaCab;
var
  wDescObra : String;
begin
  wDescObra := '';
  QRNota.Insert;
  QrNotaCOD_NOTA_CAB.Value := DMOracle.Sequencia('NOTA');
  QrNotaCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
  QrNotaCOD_FILIAL.Value := QrRomNotaCod_Filial.Value;
  QrNotaCOD_TRANSPORTE.Value := 1;
{  if QrRomNotaIND_FIXAR_CONSUMO.Value = 'F' THEN  // comentado pelo Cesar estou acessando a tabela de operacao no inicio da rotina de emissao de romaneios
     QrNotaCOD_OPERACAO.Value := StrToInt(DMOracle.BuscaNome('SELECT COD_OPERACAO_AFIXAR FROM TB_PRODUTO_AGRICOLA','COD_PRODUTO = '+FRRomNotaParam.MeProduto.Text))
  else
     QrNotaCOD_OPERACAO.Value := StrToInt(DMOracle.BuscaNome('SELECT COD_OPERACAO_AFIXAR_CONSUMO FROM TB_PRODUTO_AGRICOLA','COD_PRODUTO = '+FRRomNotaParam.MeProduto.Text));
}
  QrNotaCOD_OPERACAO.Value := DMOperacao.QOperacaoCod_Operacao.Value;
  QrNotaCOD_ESTADO.Value := QrRomNotaCod_Estado.Value;
  QrNotaCOD_CADASTRO.Value :=QrRomNotaCod_Cadastro.Value;
  If (QrRomNotaCod_Cadastro_Parceiro.Value <> 0) And (QrRomNotaCod_Cadastro_Parceiro.Text <> '') Then
     QrNotaCOD_CADASTRO_Parceiro.Value :=QrRomNotaCod_Cadastro_Parceiro.Value;
  If DMParamSistema.QParamSistemaCod_Empresa.Value = 'TOFECO' Then
  begin
    QrNotaCOD_SERIE.Value := DMOperacao.QOperacaoCod_Serie.Value;
    QrNotaCOD_SERIE_MODELO.Value := DMOperacao.QOperacaoCOD_SERIE_MODELO.Value;
  end
  Else
  begin
     QrNotaCOD_SERIE.Value := DMOracle.BuscaNome('SELECT COD_SERIE FROM TB_FILIAL',
      'COD_FILIAL = ' + QrRomNotaCod_Filial.Text);
     QrNotaCOD_SERIE_MODELO.Value := DMOracle.BuscaNome('SELECT COD_SERIE_MODELO FROM TB_FILIAL',
      'COD_FILIAL = ' + QrRomNotaCod_Filial.Text);
  end;

  if QrNotaCOD_SERIE.IsNull then
    Raise Exception.Create('A série para nota fiscal não foi cadastrada');
  if QrNotaCOD_SERIE_MODELO.IsNull then
    Raise Exception.Create('O modelo da série para nota fiscal não foi cadastrada');
    
  QrNotaNUM_NOTA.Value := DMSerie.NumeroSerie(QrRomNotaCod_Filial.Value,QrNotaCOD_SERIE.Value,
    QrNotaCOD_SERIE_MODELO.Value);
  QrNotaCOD_MENSAGEM.Text := DMOperacao.QOperacaoCod_Mensagem.Text;
    // DMOracle.BuscaNome('SELECT COD_MENSAGEM FROM TB_OPERACAO','COD_OPERACAO = '+QrNotaCOD_OPERACAO.Text);
  QrNotaIND_SITUACAO.Value :='2';
  If DMParamSistema.QParamSistemaCod_Empresa.Value = 'TOFECO' Then
     QrNotaIND_CONDICAO_PAGTO.Value :='2'
  Else
     QrNotaIND_CONDICAO_PAGTO.Value := fCondicaoPagto;
  QrNotaDT_EMISSAO.Value :=DMOracle.Dataserv;
  QrNotaDT_MOVIMENTO.Value :=DMOracle.DataHoraserv;
  QrNotaDT_RECEBIMENTO.Value :=DMOracle.Dataserv;
  QrNotaVAL_DESPESAS.Value :=0;
  QrNotaIND_ENTRADA_SAIDA.Value :='E';
  QrNotaVAL_FRETE.Value :=0;
  QrNotaVAL_DESCONTO.Value :=0;
  QrNotaIND_TIPO_FRETE.Value :='CIF';
  QrNotaCOD_DEPARTAMENTO.Value := DMUsuario.CodDepartamentoUsuario;
  if (QrRomNotaCOD_OBRA.Text <> '') then
    wDescObra := DMOracle.BuscaNome('SELECT DESC_OBRA FROM TB_OBRA', 'COD_OBRA = ' + QrRomNotaCOD_OBRA.Text);

    QrNotaOBS.Value := 'Cfe. Romaneio nr. ' + FloatToStr(QRRomNotaNum_Romaneio.Value) + ' ' + wDescObra;

  QrNotaDT_USUARIO.Value :=DMOracle.DataHoraserv;
  QRNota.Post;
end;

procedure TDMRomaneioAgricola.IncluiNotaItem(wQuant, wTotal, wCodProduto, wPh, wUnitario, wBeneficiado : Real);
Var wLote : Real;
wCstPis: String;
wCstCofins: String;
wCstIPI: String;
wMsgCompl: String;
wAliqPis, wAliqCofins: Real;
wPisImposto, wCofinsImposto: Boolean;
executador: TExecutador;
wSql: String;
begin
  wLote := 1;
  wMsgCompl := '';
  if wPh <> 0 Then
  begin
    // Jogar PH nas informações adicionais do item da nota - Djeison A. S. - 19/09/2013
    wMsgCompl := 'PH: ' + FloatToStr(wPh);
//     wLote := wPh;
     If DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO' Then
      Begin
        If wPh >= 78 Then
           wLote := 1;
        If (wPh = 75) or (wPh = 76) or (wPh = 77) Then
           wLote := 2;
        If (wPh = 70) or (wPh = 71) or (wPh = 72) or (wPh = 73) or (wPh = 74) Then
           wLote := 3;
      End;
   End;

  QRNotaItem.Close;
  QRNotaItem.SetVariable('COD_NOTA_CAB',QRNotaCod_Nota_Cab.Value);
  QRNotaItem.Open;
  // foi retirado para deixar um item para cada Romaneio - para colocar o numero da nota fiscal do produtor no item - exigencia da receita estadual
//  if (not QRnotaItem.Locate('Cod_Produto;Cod_Lote_Tipo', VarArrayOf([wCodProduto,wLote]),[])) Or
//     (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO')  then  // PARA O MOINHO É UM ITEM DA NOTA PARA CADA ROMANEIO //
//  begin
    QrNotaItem.Insert;
      QrNotaItemCOD_NOTA_ITEM.Value := DMOracle.Sequencia('NOTA_ITEM');
      QrNotaItemCOD_NOTA_CAB.Value := QRNotaCod_Nota_Cab.Value;
      QrNotaItemCOD_TRIBUTACAO.Value := QrRomNotaCod_Tributacao.Value;
      QrNotaItemQT_QUANTIDADE.Value := wQuant;
      QrNotaItemVAL_TOTAL.Value := wTotal;
      QrNotaItemPERC_IPI.Value :=0;
      QrNotaItemPERC_COMISSAO.Value :=0;
      QrNotaItemCOD_PRODUTO.Value := wCodProduto;
      QrNotaItemCOD_LOTE_TIPO.Value :=Trunc(wLote);
      QrNotaItemDESC_INF_ADICIONAL.Value := wMsgCompl;
      QrNotaItemVAL_DESCONTO.Value :=0;
      QrNotaItemVAL_DESPESAS.Value :=0;
      QrNotaItemVAL_FRETE.Value :=0;
      QrNotaItemPERC_DESCONTO.Value :=0;
      QrNotaItemPerc_BENEFICIADO.Value:=QrRomNotaPERC_QUEBRADOS_ARROZ.value+QrRomNotaPERC_INTEIROS_ARROZ.value;
      QrNotaItemVAL_IPI.Value :=0;
      QrNotaItemVAL_UNITARIO.Value :=wUnitario;
      QrNotaItemVAL_ICM_BASE.Value :=0;
      QrNotaItemVAL_ICM.Value :=0;
      QrNotaItemIND_CLASS_IPI.Value :='5';
      QrNotaItemVAL_CUSTO.Value :=wTotal;
      QrNotaItemCOD_ROMANEIO_AGRICOLA.Value := QrRomNotaCod_Romaneio_Agricola.Value;
      QrNotaItemNUM_NOTA_PRODUTOR.Text := QrRomNotaNUM_NOTA_PRODUTOR.Text;
      QrNotaItemPERC_BENEFICIADO.Value := wBeneficiado;
{  end
  else
  begin
    QRNotaItem.Edit;
      QrNotaItemQT_QUANTIDADE.Value := QrNotaItemQT_QUANTIDADE.Value + wQuant;
      QrNotaItemVAL_TOTAL.Value :=QrNotaItemVAL_TOTAL.Value + wTotal;
      QrNotaItemVAL_CUSTO.Value :=QrNotaItemVAL_TOTAL.Value;
  end;  }
    wCstPis := DMOracle.FastSelect('NVL(COD_CST_PIS,0)','TB_PRODUTO','COD_PRODUTO = '+
    QrNotaItemCOD_PRODUTO.Text);
  wCstCofins := DMOracle.FastSelect('NVL(COD_CST_COFINS,0)','TB_PRODUTO','COD_PRODUTO = '+
    QrNotaItemCOD_PRODUTO.Text);
  wCstIPI := DMOracle.FastSelect('NVL(COD_CST_IPI,0)','TB_PRODUTO','COD_PRODUTO = '+
    QrNotaItemCOD_PRODUTO.Text);

    //Não estava indo o cod_cst_pis/cofins/ipi para os itens da nota de entrada. Junior 04/12/2013
    if wCstPis <> '0' then
      QrNotaItemCOD_CST_PIS.Value    := wCstPis;
    if wCstCofins <> '0' then
      QrNotaItemCOD_CST_COFINS.Value := wCstCofins;
    if wcstIPI <> '0' then
      QrNotaItemCOD_CST_IPI.Value    := wCstIPI;
    //--------------------------------------------------------------------------
  executador := TExecutador.Create;
  executador.Limpa;
  wSql := '';
  wPisImposto := False;
  wCofinsImposto := False;
  if not (StrToInt(wCstPis) in [61,65,70,71,72,73,74,0]) then
  begin
    wAliqPis := 0;
    if QRomaneioImposto.RecordCount > 0 then
    begin
      QRomaneioImposto.First;
      while not QRomaneioImposto.Eof do
      begin
        if Pos(QRomaneioImpostonome_imposto.Value,'PIS') > 0 then
        begin
          wAliqPis := QRomaneioImpostoperc_aliq.Value;
          wPisImposto := true;
          break;
        end
        else
          wPisImposto := false;
        QRomaneioImposto.Next;
      end;
    end;
    if wAliqPis = 0 then
      wAliqPis := DMParamSistema.QParamSistemaPerc_Pis.Value;
    If DMOperacao.QOperacaoPerc_Base_Pis.Value > 0 Then
       QrNotaItemVal_Pis.Value := RoundTo((QrNotaItemVal_Total.Value  *
             (DMOperacao.QOperacaoPerc_Base_Pis.Value / 100) * wAliqPis) /100,-2);
    if wPisImposto then
    begin
      with DMNotaEntrada do
      begin
        wSql := 'INSERT INTO TB_NOTA_IMPOSTO_SERVICO VALUES(SQNOTA_IMPOSTO_SERVICO.NEXTVAL,'+
          QrNotaCOD_NOTA_CAB.Text+','+
          QRomaneioImpostoCOD_IMPOSTO.Text+','+
          QuotedStr(Copy(QrNotaDT_MOVIMENTO.Text,1,10))+','+
          Bib.TrocaVirgulaPorPonto(FloatToStr(QrNotaItemVal_Pis.Value))+')'; 

        executador.Adiciona(wSql);
        executador.Executar(true,false);
      end;
    end;
  end;

  if not (StrToInt(wCstCofins) in [61,65,70,71,72,73,74,0]) then
  begin
    wAliqCofins := 0;
    if QRomaneioImposto.RecordCount > 0 then
    begin
      QRomaneioImposto.First;
      while not QRomaneioImposto.Eof do
      begin
        if Pos(QRomaneioImpostonome_imposto.Value,'COFINS') > 0 then
        begin
          wAliqCofins := QRomaneioImpostoperc_aliq.Value;
          wCofinsImposto := true;
          break;
        end
        else
          wCofinsImposto := false;
        QRomaneioImposto.Next;
      end;
    end;
    if wAliqCofins = 0 then
      wAliqCofins := DMParamSistema.QParamSistemaPerc_Cofins.Value;
    If DMOperacao.QOperacaoPerc_Base_Cofins.Value > 0 Then
       QrNotaItemVal_Confins.Value := RoundTo((QrNotaItemVal_Total.Value  *
             (DMOperacao.QOperacaoPerc_Base_Cofins.Value / 100) * wAliqCofins) /100,-2);
    if wCofinsImposto then
    begin
      with DMNotaEntrada do
      begin
        wSql := 'INSERT INTO TB_NOTA_IMPOSTO_SERVICO VALUES(SQNOTA_IMPOSTO_SERVICO.NEXTVAL,'+
          QrNotaCOD_NOTA_CAB.Text+','+
          QRomaneioImpostoCOD_IMPOSTO.Text+','+
          QuotedStr(Copy(QrNotaDT_MOVIMENTO.Text,1,10))+','+
          Bib.TrocaVirgulaPorPonto(FloatToStr(QrNotaItemVal_Confins.Value))+')';

        executador.Adiciona(wSql);
        executador.Executar(true,false);
      end;
    end;
  end;
  //QrNotaItemDESC_INF_ADICIONAL.Value := DMNotaSaida.GeraInfAdicionalItem(QrNotaItem);
  QRNotaItem.Post;
  If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'TOFECO')  then
   Begin
     QrNota.Edit;
     QrNotaVal_Funrural.Value := DMNotaEntrada.CalculaFunrural(QrNotaItemCod_Produto.Value,
                                    QrNotaCod_Operacao.Value,
                                    QrNotaCod_Cadastro.Value,
                                    QrNotaItemVal_Total.Value);
     QrNota.Post;
   End;
End;

