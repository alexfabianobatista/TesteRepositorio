procedure TDMRomaneioAgricola.QrRateioCalcFields(DataSet: TDataSet);
var wPesoProduto,wLiquido,wDesconto : Real;
    wPadrao : String;
begin
  wPesoProduto := QRRateioQT_Rateio.Value;
  wLiquido := 0;
  wDesconto := 0;
  If (QRRomaneioIND_TIPO_ROMANEIO.Value = 'PESAGEM EN') Or
     (QRRomaneioIND_TIPO_ROMANEIO.Value = 'PESAGEM SA') Then
    Begin
      wPadrao := '';
      If QRRomaneioCOD_CONTRATO_VEND.Text <> '' Then
         wPadrao := DMOracle.BuscaNome('SELECT COD_PADRAO_DESCONTO_PRODUTO FROM TB_CONTRATO_VEND','COD_CONTRATO_VEND = '+QRRomaneioCOD_CONTRATO_VEND.Text);
      If QRRomaneioCOD_CONTRATO_PJURIDICA.Text <> '' Then
         wPadrao := DMOracle.BuscaNome('SELECT COD_PADRAO_DESCONTO_PRODUTO FROM TB_CONTRATO_PJURIDICA','COD_CONTRATO_PJURIDICA = '+QRRomaneioCOD_CONTRATO_PJURIDICA.Text);
      If wPadrao <> '' Then
         CalculoDesconto_Saida( wPesoProduto,
                            QRRomaneioPerc_ardidos.Value,
                            QRRomaneioPerc_Umidade.Value,
                            QRRomaneioPerc_Impureza.Value,
                            QRRomaneioPerc_Avariado.Value,
                            QRRomaneioPerc_Quebrados.Value,
                            QRRomaneioPerc_Triguilho.Value,
                            StrToInt(wPadrao),
                            wLiquido, wDesconto);
    End
  Else
     CalculoDesconto(wPesoProduto,
                  QRRomaneioPerc_Desconto.Value,
                  QRRomaneioPerc_Ardidos.Value,
                  QRRomaneioPerc_Umidade.Value,
                  QRRomaneioPerc_Impureza.Value,
                  QRRomaneioPerc_Avariado.Value,
                  QRRomaneioPerc_Quebrados.Value,
                  QRRomaneioPerc_Diversos.Value,
                  QRRomaneioCod_Romaneio_Agricola.Value,
                  QRRomaneioCod_Produto.Value,
                  QRRomaneioPerc_Triguilho.Value,
                  QRRomaneioPerc_Tolera_Ardidos.Value,
                  QRRomaneioPerc_Tolera_Impureza.Value,
                  QRRomaneioPerc_Tolera_Avariado.Value,
                  QRRomaneioPerc_Beneficiado.Value,
                  wLiquido,
                  wDesconto);
  QRRateioLiquido.Value := wLiquido;
  QRRateioDesconto.Value := wDesconto;
end;

