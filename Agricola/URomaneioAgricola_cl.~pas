  QRomaneioInd_Condicao_Pagto.Value := '1';
  QRomaneioVAL_KM_DISTANCIA.Value := QBalancaVAL_KM_DISTANCIA.Value;
  QRomaneioVAL_PRECO_TARIFA.Value := QBalancaVAL_PRECO_TARIFA.Value;
  QRomaneioVAL_TOTAL_TARIFA.Value := (QBalancaqt_peso_balanca.Value/1000) * QBalancaVAL_KM_DISTANCIA.Value * QBalancaVAL_PRECO_TARIFA.Value;
  If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'ITATIBA')
    or (DMParamSistema.QParamSistemaCod_Empresa.Value = 'RAMBO') Then
  Begin
    QRomaneioCod_Operacao.Value := 3;
    wPreco := DMOracle.Buscanome('SELECT VAL_PRECO FROM TB_CADASTRO_PRECO','COD_CADASTRO = '+QBalancaCod_Cadastro.Text + ' And COD_PRODUTO = ' + QBalancaCod_Produto.Text);
    If wPreco = '' Then
      wPreco := '0'+DMOracle.Buscanome('SELECT VAL_VAREJO FROM TB_PRODUTO','COD_PRODUTO = ' + QBalancaCod_Produto.Text);
    QRomaneioVal_Preco_Venda.Value := StrToFloat(wPreco);   
  End;
end;

procedure TDMRomaneioAgricola.QBalancaBeforePost(DataSet: TDataSet);
var wCodigo, wCodOrdemChegada : integer;
  wAux: String;
begin
  DMOracle.ValidaFilial(QBalancaCOD_FILIAL.Text);
  pCameraPesagem := True;

  DmUsuario.Checar_Filial_Usuario( Trim(QBalancaCOD_FILIAL.Text),'AGRICOLA');
  If QBalancaDt_Primeira_Pesagem.Text = '' Then
     QBalancaDt_Primeira_Pesagem.Value := DMOracle.DataHoraServ
  Else
     QBalancaDt_Segunda_Pesagem.Value := DMOracle.DataHoraServ;
  QBalancaPerc_Beneficiado.Value := QBalancaPerc_Inteiro_Arroz.Value + QBalancaPerc_Quebrado_Arroz.Value;
  QBalancaDt_Referencia.Value := DMOracle.DataServ;
  If QBalancaIND_TIPO.Value = 'Romaneio' Then
     ValidaRomaneio;
  If QBalancaCod_Obra.Text <> '' Then  // César - para SR 23/01/2017
     ValidaQuantidade;
  QBalancaCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
{Criado para controlar a ordem da chegada para a pesagem, solicitado pela Inovar. Alex 18/08/2025}
  if (DMParamSistema.QParamSistemaIND_CONTROLA_ORDEM_CHEGADA.Value = 'S') then
  begin
    wCodOrdemChegada := 0;
    if (QBalancaCOD_ORDEM_CHEGADA.Text = '') and (QBalancaDT_REFERENCIA.Text <> '') then
    begin
      wAux := DMOracle.FastSelect('MAX(COD_ORDEM_CHEGADA)','TB_BALANCA','COD_ORDEM_CHEGADA IS NOT NULL AND DT_REFERENCIA = ' + chr(39) + QBalancaDT_REFERENCIA.Text + chr(39) ) ;
      if (wAux <> '') then
      begin
        wCodOrdemChegada := StrToInt(wAux);
        wCodOrdemChegada := wCodOrdemChegada + 1 ;
      end
      else
       wCodOrdemChegada := 1;
      QBalancaCOD_ORDEM_CHEGADA.Value := wCodOrdemChegada;
    end;
  end;
end;

Procedure TDMRomaneioAgricola.RateiaRomaneio;
Var wTotal:Integer;
Begin
  // **** Faz o Rateio do Romaneio ***
  QRateio.First;
  wTotal := 0;
  While not QRateio.Eof do
  begin
    wTotal := wTotal + QRateioQt_Rateio.Value;
    QRateio.Next;
  end;
  If wTotal > (QRomaneioQt_Peso_Bruto.Value - QRomaneioQt_Tara.Value) then
    raise exception.Create ('Peso Rateio Maior Quantidade Romaneio');
  If wtotal < (QRomaneioQt_Peso_Bruto.Value - QRomaneioQt_Tara.Value) then
  Begin
    wTotal := (QRomaneioQt_Peso_Bruto.Value - QRomaneioQt_Tara.Value) - wTotal;
    if QRateio.Locate('Cod_Cadastro', QRomaneioCod_Cadastro.Value, []) then
    begin
      QRateio.Edit;
      wTotal := wTotal + QRateioQt_Rateio.Value;
    end
    else
      QRateio.Insert;
    QRateioQt_Rateio.Value := wTotal;
    QRateioCod_Cadastro.Value := QRomaneioCod_Cadastro.Value;
    QRateioPerc_Rateio.Value := 0;
    QRateio.Post;
  End;
End;

