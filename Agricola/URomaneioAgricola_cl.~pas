    // contabilizacao do COFINS
    DMPlanilha.GravaLanc('NFE',
                         QrNotaCod_Nota_Cab.Value,
                         FloatToStr(QrNotaNum_Nota.Value)+'-'+QrNotaCod_Serie.Value + '-' + DmCadastro.QCadastroNome.Value,
