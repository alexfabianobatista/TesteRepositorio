Procedure TDMRomaneioAgricola.QRomaneioBeforePost(DataSet: TDataSet);
var wVal : string;
begin
  DMOracle.ValidaFilial(QRomaneioCOD_FILIAL.Text);
  If QRomaneioNum_Romaneio.Value = 0 then
    If (DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO') Then
       QRomaneioNum_Romaneio.Value := DMSequencia.Sequencia(StrToInt(QRomaneioCod_Filial.Text),'ROMANEIO')
    else
       If QRomaneioInd_Tipo_Romaneio.Value = 'ROMANEIO' then
         QRomaneioNum_Romaneio.Value := DMSequencia.Sequencia(StrToInt(QRomaneioCod_Filial.Text),'ROMANEIO')
       Else
         QRomaneioNum_Romaneio.Value := DMSequencia.Sequencia(StrToInt(QRomaneioCod_Filial.Text),'PESAGEM');
  If QRomaneioNum_Ticket.Value = 0 then
     QRomaneioNum_Ticket.Value := DMSequencia.Sequencia(StrToInt(QRomaneioCod_Filial.Text),'TICKET');
  If QRomaneio.State <> dsInsert then
    RateiaRomaneio;

  If (DMParamSistema.QParamSistemaCod_Empresa.Value <> 'CEREAIS') And
     (DMParamSistema.QParamSistemaCod_Empresa.Value <> 'ITATIBA') AND
     (DMParamSistema.QParamSistemaCod_Empresa.Value <> 'RAMBO')   Then
   Begin
     //verifica se o cadastro possui CPF
     wVal := DMOracle.BuscaNome('SELECT COD_ESTADO FROM TB_CADASTRO ', ' COD_CADASTRO = ' + QRomaneioCOD_CADASTRO.Text);
     If wVal <> 'EX'Then
      Begin
        wVal := DMOracle.BuscaNome('SELECT NUM_CGC_CPF FROM TB_CADASTRO ', ' COD_CADASTRO = ' + QRomaneioCOD_CADASTRO.Text);
        if (wVal = '') then
          raise Exception.Create('Cadastro sem CPF');
      End;
     //fim cpf
   End;
  if DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'INOVAR' then
  begin
    If QRomaneioInd_Tipo_Romaneio.Value = 'ROMANEIO' then
      if (QRomaneio_Fitas.Eof) and (QRomaneioCOD_PRODUTO.Value = 2) then
      begin
        MessageDlg('Resultado Intacta não informado', mtError, [mbOk], 0);
        abort;
      end;
  end;
  QRomaneioCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
End;

Procedure TDMRomaneioAgricola.QRRomaneioPesagemCalcFields(
  DataSet: TDataSet);
Var wPeso_Produto :Real;
    wCod_Desconto : String;
Begin
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'ROMANEIO' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'ROMANEIO';
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'ROMANEIO S' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'ROMANEIO SEMENTE';
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM EN' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'ENTRADA';
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM SA' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'SAIDA';
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM PA' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'PESAGEM PARTICULAR';
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'TRANSF SAI' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'TRANSFERENCIA SAIDA';
  If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'TRANSF ENT' Then
     QRRomaneioPesagemDesc_Tipo.Value := 'TRANSFERENCIA ENTRADA';
{  With DMProdutoAgricola do
  Begin
    QProdutoAgricola.Close;
    QProdutoAgricola.setVariable('PK',QRRomaneioPesagemCod_Produto.Value);
    QProdutoAgricola.Open;
  End;   }
  wPeso_Produto := QRRomaneioPesagemQt_Peso_Bruto.Value - QRRomaneioPesagemQt_Tara.Value;
  If (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'ROMANEIO') Or
     (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'ROMANEIO S') Or
     (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'TRANSF ENT') Or
     (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'TRANSF SAI') Or
     (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM PA') Then
     CalculoDesconto(wPeso_Produto,
                  QRRomaneioPesagemPerc_Desconto.Value,
                  QRRomaneioPesagemPerc_Ardidos.Value,
                  QRRomaneioPesagemPerc_Umidade.Value,
                  QRRomaneioPesagemPerc_Impureza.Value,
                  QRRomaneioPesagemPerc_Avariado.Value,
                  QRRomaneioPesagemPerc_Quebrados.Value,
                  QRRomaneioPesagemPerc_Diversos.Value,
                  QRRomaneioPesagemCod_Romaneio_Agricola.Value,
                  QRRomaneioPesagemCod_Produto.Value,
                  QRRomaneioPesagemPerc_Triguilho.Value,
                  QRRomaneioPesagemPerc_Tolera_Ardidos.Value,
                  QRRomaneioPesagemPerc_Tolera_Impureza.Value,
                  QRRomaneioPesagemPerc_Tolera_Avariado.Value,
                  QRRomaneioPesagemPerc_Beneficiado.Value,
                  wLiquido,
                  wDesc_Romaneio) // este campo nao esta sendo utilizado nesta rotina
  Else
    Begin
      If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM SA' Then
         If QRRomaneioPesagemCOD_CONTRATO_VEND.Text <> '' Then
            wCod_Desconto := DMOracle.BuscaNome('SELECT COD_PADRAO_DESCONTO_PRODUTO FROM TB_CONTRATO_VEND','COD_CONTRATO_VEND = '+QRRomaneioPesagemCOD_CONTRATO_VEND.Text);
      If QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM EN' Then
         If QRRomaneioPesagemCOD_CONTRATO_PJURIDICA.Text <> '' Then
            wCod_Desconto := DMOracle.BuscaNome('SELECT COD_PADRAO_DESCONTO_PRODUTO FROM TB_CONTRATO_PJURIDICA','COD_CONTRATO_PJURIDICA = '+QRRomaneioPesagemCOD_CONTRATO_PJURIDICA.Text);
      If wCod_Desconto = ''  Then  // colocado pelo César porque estavam deixando em branco no moinho
         wCod_Desconto := '1';
      With DMRomaneioAgricola do
      Begin
        CalculoDesconto_Saida(wPeso_Produto,
                              QRRomaneioPesagemPerc_ardidos.Value,
                              QRRomaneioPesagemPerc_Umidade.Value,
                              QRRomaneioPesagemPerc_Impureza.Value,
                              QRRomaneioPesagemPerc_Avariado.Value,
                              QRRomaneioPesagemPerc_Quebrados.Value,
                              QRRomaneioPesagemPerc_Triguilho.Value,
                              StrToInt(wCod_Desconto),
                              wLiquido, wDesc_Romaneio);
      End;
    End;
  QRRomaneioPesagemQt_Triguilho.Value := 0;
  If QRRomaneioPesagemPerc_Triguilho.Value > 0 Then
     QRRomaneioPesagemQt_Triguilho.Value := wPeso_Produto * QRRomaneioPesagemPerc_Triguilho.Value / 100;
  QRRomaneioPesagemQT_Liquido.Value := wLiquido;
  QRRomaneioPesagemQt_Desconto.Value := wPeso_Produto - QRRomaneioPesagemQt_Liquido.Value - QRRomaneioPesagemQt_Triguilho.Value;
  If (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'PESAGEM SA') Or
     (QRRomaneioPesagemInd_Tipo_Romaneio.Value = 'TRANSF SAI') Then
     QRRomaneioPesagemQT_Liquido.Value := QRRomaneioPesagemQT_Liquido.Value * -1;
End;

