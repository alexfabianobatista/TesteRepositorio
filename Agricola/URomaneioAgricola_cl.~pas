procedure TDMRomaneioAgricola.excluiPesagensRenda(pCodBalanca: integer);
begin
  with DMOracle do
  begin
    try
      ExecutaSql('DELETE FROM TB_PESAGEM_RENDA WHERE COD_BALANCA = '
        + intToStr(pCodBalanca), true);
    Except on e: Exception do
    begin
      MessageDlg('Não foi possível excluir pesagens de renda.'
        + #13#10
        + e.message
        , mtError, [mbOk], 0);
        abort;
    end;
    end;
  end;
end;

procedure TDMRomaneioAgricola.QBalancaBeforeDelete(DataSet: TDataSet);
begin
  excluiPesagensRenda(QBalancaCOD_BALANCA.Value);
  pCameraPesagem := False;
end;

procedure TDMRomaneioAgricola.QrRomEmissaoAfterOpen(DataSet: TDataSet);
begin
  if QrRomEmissao.Eof then
    Exit;
  if (not QRomaneio_Fitas.Eof) and (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'INOVAR') then
  begin
    QRomaneio_Fitas.First;
    while not QRomaneio_Fitas.Eof do
    begin
      if QrRomEmissaoDESC_OBSERVACAO.Value <> '' then
      begin
        QrRomEmissao.Edit;
        QrRomEmissaoDESC_OBSERVACAO.Value := QrRomEmissaoDESC_OBSERVACAO.Value +
          chr(13) + chr(10) +
          'RESULTADO INTACTA: ' + QRomaneio_FitasIND_RESULTADO.Value;
        QrRomEmissao.Post;
      end
      else
      begin
        QrRomEmissao.Edit;
        QrRomEmissaoDESC_OBSERVACAO.Value :=
          'RESULTADO INTACTA: ' + QRomaneio_FitasIND_RESULTADO.Value;
        QrRomEmissao.Post;
      end;
      QRomaneio_Fitas.Next;
    end;
  end;
end;

