begin
  QRomaneioCod_Filial.Value := DMUsuario.CodFilialUsuario;
  QRomaneioPERC_PH.Value:=0;
  QRomaneioDesc_Observacao.Value := wObservacao;
  If Not (QBalanca.Eof) Then  // Somente pode fazer um romaneio com pesagem que ainda nao foi utilizada em romaneio
    If DMOracle.Buscanome('SELECT COD_ROMANEIO_AGRICOLA FROM TB_ROMANEIO_AGRICOLA','COD_BALANCA = '+FloatToStr(QBalancaCOD_Balanca.Value)) = '' Then
     Begin
       QRomaneioCod_Filial.Value := QBalancaCod_Filial.Value;
       If QBalancaQt_Peso_Chegada.Value > QBalancaQt_Peso_Saida.Value Then
       begin
         QRomaneioQt_Peso_Bruto.Value := QBalancaQt_Peso_Chegada.Value;
         QRomaneioQt_Tara.Value := QBalancaQt_Peso_Saida.Value;
         QRomaneioDT_PRIMEIRA_PESAGEM.Value := QBalancaDT_PRIMEIRA_PESAGEM.Value;
         QRomaneioDT_SEGUNDA_PESAGEM.Value := QBalancaDT_SEGUNDA_PESAGEM.Value;
       end
       else
       begin
         QRomaneioQt_Peso_Bruto.Value := QBalancaQt_Peso_Saida.Value;
         QRomaneioQt_Tara.Value :=  QBalancaQt_Peso_Chegada.Value;
         QRomaneioDT_SEGUNDA_PESAGEM.Value := QBalancaDT_PRIMEIRA_PESAGEM.Value;
         QRomaneioDT_PRIMEIRA_PESAGEM.Value := QBalancaDT_SEGUNDA_PESAGEM.Value;
       end;
       If QBalancaInd_Tipo.Value = 'Romaneio' Then
          QRomaneioIND_TIPO_ROMANEIO.Value := 'ROMANEIO';
       If QBalancaInd_Tipo.Value = 'Pesagem Entrada' then
          QRomaneioIND_TIPO_ROMANEIO.Value := 'PESAGEM EN';
       If QBalancaInd_Tipo.Value = 'Pesagem Saída' then
          QRomaneioIND_TIPO_ROMANEIO.Value := 'PESAGEM SA';
       If QBalancaInd_Tipo.Value = 'Diversos' Then
          QRomaneioIND_TIPO_ROMANEIO.Value := 'PESAGEM PA';
       If QBalancaInd_Tipo.Value = 'Transf Entrada' Then
          QRomaneioIND_TIPO_ROMANEIO.Value := 'TRANSF ENT';
       If QBalancaInd_Tipo.Value = 'Transf Saida' Then
          QRomaneioIND_TIPO_ROMANEIO.Value := 'TRANSF SAI';
       QRomaneioDesc_Placa.Value := QBalancaDesc_Placa.Value;
       QRomaneioDesc_Placa_Carreta1.Value := QBalancaDesc_Placa_Carreta.Value;
       QRomaneioCod_Cadastro.Value := QBalancaCod_Cadastro.Value;
       QRomaneioCod_Balanca.Value := QBalancaCod_Balanca.Value;
       QRomaneioPERC_UMIDADE.Value:=QBalancaPERC_UMIDADE.Value;
       QRomaneioPERC_DESCONTO.Value:=QBalancaPERC_DESCONTO.Value;
       QRomaneioCod_Produto.Value := QBalancaCod_Produto.Value;
       QRomaneioPERC_ARDIDOS.Value:=QBalancaPERC_ARDIDOS.Value;
       QRomaneioPERC_IMPUREZA.Value:=QBalancaPERC_IMPUREZA.Value;
       QRomaneioPERC_AVARIADO.Value:=QBalancaPERC_AVARIADO.Value;
       QRomaneioPERC_TOLERA_ARDIDOS.Value := QBalancaPERC_TOLERA_ARDIDOS.Value;
       QRomaneioPERC_TOLERA_AVARIADO.Value := QBalancaPERC_TOLERA_AVARIADO.Value;
       QRomaneioPERC_BENEFICIADO.Value := QBalancaPERC_BENEFICIADO.Value;
       QRomaneioPERC_INTEIRO_ARROZ.Value := QBalancaPERC_INTEIRO_ARROZ.Value;
       QRomaneioPERC_QUEBRADO_ARROZ.Value := QBalancaPERC_QUEBRADO_ARROZ.Value;
       If (QBalancaInd_Tipo.Value = 'Transf Entrada') Or
          (QBalancaInd_Tipo.Value = 'Transf Saida') Then     // FOI O VILSON QUEM SOLICITOU NAS TRANSFERENCIAS NAO TER IMPUREZA - CESAR ALTEROU
        Begin
          QRomaneioPERC_TOLERA_IMPUREZA.Value := 0;
        End
       Else
        Begin
          QRomaneioPERC_TOLERA_IMPUREZA.Value := QBalancaPERC_TOLERA_IMPUREZA.Value;
        End;
       QRomaneioPERC_QUEBRADOS.Value:=QBalancaPERC_QUEBRADOS.Value;
       QRomaneioPERC_TRIGUILHO.Value:=QBalancaPERC_TRIGUILHO.Value;
       QRomaneioVAL_PESAGEM.Value:=QBalancaVAL_PESAGEM.Value;
       QRomaneioPERC_PH.Value := QBalancaPerc_Ph.Value;
       QRomaneioDESC_OBSERVACAO.Value := QBalancaDESC_OBSERVACAO.Value;
       QRomaneioDESC_CONTRATO.Value := QBalancaDESC_CONTRATO.Value;
       QRomaneioCod_Contrato_Vend.Text := QBalancaCod_Contrato_Vend.Text;
       QRomaneioCod_Contrato_PJuridica.Text := QBalancaCod_Contrato_PJuridica.Text;
       QRomaneioNome_Motorista.Value := QBalancaNome_Motorista.Value;
       QRomaneioNum_Nota_Produtor.Text := QBalancaNum_Nota_Produtor.Text;
       QRomaneioCod_Obra.Text := QBalancaCod_Obra.Text;
       With DMOracle do
       Begin
         QExecSQL.Close;
         QExecSQL.SQL.Clear;
         wComando := 'UPDATE TB_BALANCA SET Ind_Situacao = ' + Chr(39) + 'F' + Chr(39);
         wComando := wComando + ' WHERE COD_BALANCA = '+FloatToStr(QBalancaCod_Balanca.Value);
         QExecSQL.SQL.Add(wComando);
         QExecSQL.ExecSQL;
       End;
       QPesagemRenda.Close;
       QPesagemRenda.SetVariable('FK', QBalancaCOD_BALANCA.Value);
       QPesagemRenda.Open;
       if QPesagemRenda.RecordCount > 0 then
       begin
         wValPesagemRenda := 0;
         while not QPesagemRenda.Eof do
         begin
           wValPesagemRenda :=  wValPesagemRenda +
             QPesagemRendaQT_PESO_RENDA.Value;
           QPesagemRenda.Next;
         end;
         // Média da renda
         QRomaneioPERC_RENDA.Text :=  formatFloat('#0.00',
           wValPesagemRenda / QPesagemRenda.RecordCount);
       end;
     End;
  QRomaneioPERC_DIVERSOS.Value:=0;
  QRomaneioDt_Emissao.Value := DMOracle.DataServ;
  QRomaneioDt_Movimento.Value := DMOracle.DataHoraServ;
  QRomaneioNUM_ROMANEIO.Value:=0;
  If QBalancaInd_Tipo.Value = 'Romaneio' Then
    If DMParamSistema.QparamSistemaCod_Mensagem.Text <> '' Then
