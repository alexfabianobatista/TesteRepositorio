procedure TDMRomaneioAgricola.QRRomaneios_no_PeriodoCalcFields(
  DataSet: TDataSet);
var wDesconto :String;
begin
{  With DMProdutoAgricola do
  Begin
    QProdutoAgricola.Close;
    QProdutoAgricola.setVariable('PK',DMRomaneioAgricola.QRRomaneios_no_PeriodoCOD_PRODUTO.Value);
    QProdutoAgricola.Open;
  End;   }
  QRRomaneios_no_PeriodoPesoBalanca.Value := QRRomaneios_no_PeriodoQT_PESO_BRUTO.Value - QRRomaneios_no_PeriodoQT_TARA.Value;
  wDesconto := DmOracle.BuscaNome('SELECT PERC_DESCONTO FROM TB_ROMANEIO_AGRICOLA', 'COD_ROMANEIO_AGRICOLA = ' + FloatToStr(QRRomaneios_no_PeriodoCOD_ROMANEIO_AGRICOLA.Value));
  if wDesconto <> '' then
    QRRomaneios_no_PeriodoUmidade.Value := round(QRRomaneios_no_PeriodoQT_RATEIO.Value * strtoFloat(wDesconto) / 100);

  if ((QRRomaneios_no_PeriodoPERC_ARDIDOS.Value  - QRRomaneios_no_PeriodoPerc_Tolera_Ardidos.Value) >  0) then
    QRRomaneios_no_PeriodoArdidos.Value := round(QRRomaneios_no_PeriodoQT_RATEIO.Value * (QRRomaneios_no_PeriodoPERC_ARDIDOS.Value - QRRomaneios_no_PeriodoPerc_Tolera_Ardidos.Value) / 100);

  if ((QRRomaneios_no_PeriodoPERC_IMPUREZA.Value - QRRomaneios_no_PeriodoPerc_Tolera_Impureza.Value) > 0) then
    QRRomaneios_no_PeriodoImpureza.Value := round(QRRomaneios_no_PeriodoQT_RATEIO.Value * (QRRomaneios_no_PeriodoPERC_IMPUREZA.Value - QRRomaneios_no_PeriodoPerc_Tolera_Impureza.Value) / 100);

  if ((QRRomaneios_no_PeriodoPERC_AVARIADO.Value - QRRomaneios_no_PeriodoPerc_Tolera_Avariado.Value) > 0) then
    QRRomaneios_no_PeriodoAvariados.Value := round(QRRomaneios_no_PeriodoQT_RATEIO.Value * (QRRomaneios_no_PeriodoPERC_AVARIADO.Value - QRRomaneios_no_PeriodoPerc_Tolera_Avariado.Value) / 100);

  if QRRomaneios_no_PeriodoPERC_QUEBRADOS.Value > 0 then
    QRRomaneios_no_PeriodoQuebrados.Value := round(QRRomaneios_no_PeriodoQT_RATEIO.Value * QRRomaneios_no_PeriodoPERC_QUEBRADOS.Value / 100);

  if QRRomaneios_no_PeriodoPERC_DIVERSOS.Value > 0 then
    QRRomaneios_no_PeriodoDiversos.Value := QRRomaneios_no_PeriodoPERC_DIVERSOS.Value;

  if QRRomaneios_no_PeriodoPERC_TRIGUILHO.Value > 0 then
    QRRomaneios_no_PeriodoTriguilho.Value := round(QRRomaneios_no_PeriodoQT_RATEIO.Value * QRRomaneios_no_PeriodoPERC_TRIGUILHO.Value / 100);

  QRRomaneios_no_PeriodoTotalDesconto.Value := QRRomaneios_no_PeriodoUmidade.Value + QRRomaneios_no_PeriodoArdidos.Value +
                      QRRomaneios_no_PeriodoImpureza.Value + QRRomaneios_no_PeriodoAvariados.Value +
                      QRRomaneios_no_PeriodoQuebrados.Value + QRRomaneios_no_PeriodoDiversos.Value;

  QRRomaneios_no_PeriodoLiquido.Value := QRRomaneios_no_PeriodoQT_RATEIO.Value - QRRomaneios_no_PeriodoTotalDesconto.Value - QRRomaneios_no_PeriodoTriguilho.Value;
  if QRRomaneios_no_PeriodoIND_SITUACAO.Value = 'A' then
    QRRomaneios_no_Periododesc_situacao.Value := 'ABERTO';
  if QRRomaneios_no_PeriodoIND_SITUACAO.Value = 'E' then
    QRRomaneios_no_Periododesc_situacao.Value := 'EMITIDO ROMANEIO';
  if QRRomaneios_no_PeriodoIND_SITUACAO.Value = 'N' then
    QRRomaneios_no_Periododesc_situacao.Value := 'EMITIDO NOTA';
  if QRRomaneios_no_PeriodoIND_SITUACAO.Value = 'C' then
    QRRomaneios_no_Periododesc_situacao.Value := 'CANCELADO';
End;

