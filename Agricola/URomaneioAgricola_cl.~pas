Procedure TDMRomaneioAgricola.CalculoDesconto_Saida( wPesoBalanca,
                                                     wPerc_ardidos,
                                                     wPerc_Umidade,
                                                     wPerc_Impureza,
                                                     wPerc_Avariado,
                                                     wPerc_Quebrados,
                                                     wPerc_Triguilho : Real;
                                                     wDescontoPadraoProduto : Integer;
                                                     Var wLiquido, wDesconto : Real);
Var
    wPercDescLiquido : Real;
begin
  DMPadraoProduto.QPadraoDescontoProduto.Close;
  DMPadraoProduto.QPadraoDescontoProduto.SetVariable('Pk',wDescontoPadraoProduto);
  DMPadraoProduto.QPadraoDescontoProduto.Open;

  wDesconto := 0;

  If wPerc_Umidade > DMPadraoProduto.QPadraoDescontoProdutoNUM_UMIDADE_TOLERANCIA.Value Then
  Begin
    wPercDescLiquido := wPerc_Umidade - DMPadraoProduto.QPadraoDescontoProdutoNUM_UMIDADE_TOLERANCIA.Value;
    wPercDescLiquido := wPercDescLiquido * DMPadraoProduto.QPadraoDescontoProdutoNUM_UMIDADE_DESCONTO.Value;
    wDesconto :=  round(wPesoBalanca * wPercDescLiquido / 100);
  End;

  If wPerc_ardidos > DMPadraoProduto.QPadraoDescontoProdutoNUM_ARDIDOS_TOLERANCIA.Value Then
  Begin
    wPercDescLiquido := wPerc_ardidos - DMPadraoProduto.QPadraoDescontoProdutoNUM_ARDIDOS_TOLERANCIA.Value;
    wPercDescLiquido := wPercDescLiquido * DMPadraoProduto.QPadraoDescontoProdutoNUM_ARDIDOS_DESCONTO.Value;
    wDesconto := wDesconto + round(wPesoBalanca * wPercDescLiquido / 100);
  End;

  If wPerc_Impureza > DMPadraoProduto.QPadraoDescontoProdutoNUM_IMPUREZA_TOLERANCIA.Value Then
  Begin
    wPercDescLiquido := wPerc_Impureza - DMPadraoProduto.QPadraoDescontoProdutoNUM_IMPUREZA_TOLERANCIA.Value;
    wPercDescLiquido := wPercDescLiquido * DMPadraoProduto.QPadraoDescontoProdutoNUM_IMPUREZA_DESCONTO.Value;
    wDesconto := wDesconto + round(wPesoBalanca * wPercDescLiquido / 100);
  End;

  If wPerc_Avariado > DMPadraoProduto.QPadraoDescontoProdutoNUM_AVARIADO_TOLERANCIA.Value Then
  Begin
    wPercDescLiquido := wPerc_Avariado - DMPadraoProduto.QPadraoDescontoProdutoNUM_AVARIADO_TOLERANCIA.Value;
    wPercDescLiquido := wPercDescLiquido * DMPadraoProduto.QPadraoDescontoProdutoNUM_AVARIADO_DESCONTO.Value;
    wDesconto := wDesconto + round(wPesoBalanca * wPercDescLiquido / 100);
  End;

  If wPerc_Quebrados > DMPadraoProduto.QPadraoDescontoProdutoNUM_QUEBRADO_TOLERANCIA.Value Then
  Begin
    wPercDescLiquido := wPerc_Quebrados - DMPadraoProduto.QPadraoDescontoProdutoNUM_QUEBRADO_TOLERANCIA.Value;
    wPercDescLiquido := wPercDescLiquido * DMPadraoProduto.QPadraoDescontoProdutoNUM_QUEBRADO_DESCONTO.Value;
    wDesconto := wDesconto + round(wPesoBalanca * wPercDescLiquido / 100);
  End;

  If wPerc_Triguilho > DMPadraoProduto.QPadraoDescontoProdutoNUM_TRIGUILHO_TOLERANCIA.Value Then
  Begin
    wPercDescLiquido := wPerc_Triguilho - DMPadraoProduto.QPadraoDescontoProdutoNUM_TRIGUILHO_TOLERANCIA.Value;
    wPercDescLiquido := wPercDescLiquido * DMPadraoProduto.QPadraoDescontoProdutoNUM_TRIGUILHO_DESCONTO.Value;
    wDesconto := wDesconto + round(wPesoBalanca * wPercDescLiquido / 100);
  End;

  wLiquido := wPesoBalanca - round(wDesconto);

End;



procedure TDMRomaneioAgricola.QBalancaCalcFields(DataSet: TDataSet);
