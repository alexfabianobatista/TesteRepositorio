  //wNotaSeparada := false;
  //if (DMParamSistema.QParamSistemaIND_OS_NOTA_SEPARADA.AsString = 'S') then
  //  wNotaSeparada := (MessageDlg('Deseja emitir nota de serviço separada?', mtConfirmation, [mbYes, mbNo], 0) = mrYes)
