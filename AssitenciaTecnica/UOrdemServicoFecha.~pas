          QItemNFCOD_CFOP.Value := Item.FCFOP;

        QItemNFCOD_PRODUTO.Value := Item.FCodProduto;
        QItemNFQT_QUANTIDADE.Value := Item.FQtQuantidade;
        QItemNFVAL_UNITARIO.Value := Item.FValUn;
