  inherited QConsulta: TIBQuery
    SQL.Strings = (
      'select'
      '  i.codveiculo,'
      '  i.dscveiculo,'
      '  e.codvendedor,'
      '  e.nome,'
      '  e.comissao as perc_comissao,'
      '  i.valorvenda,'
      '  (e.comissao * i.valorvenda / 100) as valor_comissao'
      'from tb_venda v'
      'inner join tb_vendedor e on v.codvendedor = e.codvendedor'
      'inner join tb_veiculo i on v.codveiculo = i.codveiculo'
      'where v.dtvenda between :DATAINI and :DATAFIN'
      'and i.valorvenda >= :VALORVENDA'
      'and (e.comissao * i.valorvenda / 100) >= :VALORCOMISSAO'
      'and (v.codvendedor = :CODVENDEDOR or :CODVENDEDOR = 0)'
      'and (v.codveiculo = :CODVEICULO or :CODVEICULO = 0)'
      'order by e.codvendedor, e.nome')
    Left = 40
    Top = 208
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DATAINI'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DATAFIN'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'VALORVENDA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'VALORCOMISSAO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODVENDEDOR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODVENDEDOR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODVEICULO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODVEICULO'
        ParamType = ptUnknown
      end>
