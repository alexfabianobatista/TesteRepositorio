  inherited IBU: TIBUpdateSQL
    RefreshSQL.Strings = (
      'Select '
      '  CODCIDADE,'
      '  DSCCIDADE,'
      '  CODESTADO'
      'from Tb_Cidade '
      'where'
      '  CODCIDADE = :CODCIDADE')
    ModifySQL.Strings = (
      'update Tb_Cidade'
      'set'
      '  CODCIDADE = :CODCIDADE,'
      '  DSCCIDADE = :DSCCIDADE,'
      '  CODESTADO = :CODESTADO'
      'where'
      '  CODCIDADE = :OLD_CODCIDADE')
    InsertSQL.Strings = (
      'insert into Tb_Cidade'
      '  (CODCIDADE, DSCCIDADE, CODESTADO)'
      'values'
      '  (:CODCIDADE, :DSCCIDADE, :CODESTADO)')
    DeleteSQL.Strings = (
      'delete from Tb_Cidade'
      'where'
      '  CODCIDADE = :OLD_CODCIDADE')
  end
