  inherited IBU: TIBUpdateSQL
    RefreshSQL.Strings = (
      'Select '
      '  COD_SABOR,'
      '  DESC_SABOR,'
      '  VLR_INTEGRAL,'
      '  COD_TIPO_PRODUTO'
      'from TB_SABOR '
      'where'
      '  COD_SABOR = :COD_SABOR')
    ModifySQL.Strings = (
      'update TB_SABOR'
      'set'
      '  COD_SABOR = :COD_SABOR,'
      '  COD_TIPO_PRODUTO = :COD_TIPO_PRODUTO,'
      '  DESC_SABOR = :DESC_SABOR,'
      '  VLR_INTEGRAL = :VLR_INTEGRAL'
      'where'
      '  COD_SABOR = :OLD_COD_SABOR')
    InsertSQL.Strings = (
      'insert into TB_SABOR'
      '  (COD_SABOR, COD_TIPO_PRODUTO, DESC_SABOR, VLR_INTEGRAL)'
      'values'
      '  (:COD_SABOR, :COD_TIPO_PRODUTO, :DESC_SABOR, :VLR_INTEGRAL)')
    DeleteSQL.Strings = (
      'delete from TB_SABOR'
      'where'
      '  COD_SABOR = :OLD_COD_SABOR')
  end
