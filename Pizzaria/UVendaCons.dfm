  object QConsultaItens: TIBQuery
    Database = DmSistema.DbSistema
    Transaction = DmSistema.TSistema
    OnCalcFields = QConsultaItensCalcFields
    DataSource = DsConsulta
    SQL.Strings = (
      'select'
      '  i.*,'
      '  p.desc_produto'
      'from'
      '  tb_venda_item i'
      'inner join tb_venda v on i.cod_venda = v.cod_venda'
      'inner join tb_cliente c on v.cod_cliente = c.cod_cliente'
      'inner join tb_operador o on v.cod_operador = o.cod_operador'
      'inner join tb_produto p on i.cod_produto = p.cod_produto'
      
        'left join tb_tipo_produto t on p.cod_tipo_produto = t.cod_tipo_p' +
        'roduto'
      'where'
      '(  :venda_completa = 1'
      'or'
      '('
      '    (v.cod_cliente = :Pcod_cliente or :Pcod_cliente = 0)'
      '  and'
      '    (v.cod_operador = :Pcod_operador or :Pcod_operador = 0)'
      '  and'
      '    (v.dt_venda between :Pdt_venda_ini and :Pdt_venda_fin)'
      '  and'
      
        '    (p.cod_tipo_produto = :Pcod_tipo_produto or :Pcod_tipo_produ' +
        'to = 0)'
      '  and'
      
        '    ((:Ptaxa = 0 and v.val_taxa_total > 0) or (:Ptaxa = 1 and v.' +
        'val_taxa_total <= 0) or (:Ptaxa = 2))'
      '))'
      'and'
      '  i.COD_VENDA = :COD_VENDA'
      'order by'
      '  p.desc_produto')
    UpdateObject = UConsulta
    Left = 40
    Top = 280
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'venda_completa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_operador'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_operador'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pdt_venda_ini'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pdt_venda_fin'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_tipo_produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_tipo_produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ptaxa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ptaxa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ptaxa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'COD_VENDA'
        ParamType = ptUnknown
      end>
