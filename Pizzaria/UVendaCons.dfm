        Name = 'Pdt_venda_fin'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_tipo_produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Pcod_tipo_produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ptaxa'
        ParamType = ptUnknown
      end
