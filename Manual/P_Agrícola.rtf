\par \page }{\cs16\super +{\footnote \pard\plain \s15\nowidctlpar\widctlpar\adjustright \fs20\lang1046\cgrid {\cs16\super +}{ Forma_Opera\'e7\'e3o_Sistema}}k{\footnote \pard\plain \s15\nowidctlpar\widctlpar\adjustright \fs20\lang1046\cgrid {\cs16\super k}{
