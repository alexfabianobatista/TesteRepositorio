            QContaReceber.Next;
          end;
          QContaReceber.Close;
          if (DMParamSistema.CodEmpresa = 'FRIGOPIES') then  //FRIGOPIES somente assinatura.
          begin
            QRMemoPrazo.Lines.Append('Assinatura:_____________________________________' + chr(13)+chr(10));
            QRMemoPrazo.Lines.Append('OBRIGADO PELA PREFERÊNCIA.' + chr(13)+chr(10) + chr(13)+chr(10) + chr(13)+chr(10));
            QRMemoPrazo.Lines.Append('=======================================================');
          end else
          begin
            QRMemoPrazo.Lines.Append('Reconhecemos a exatidão desta venda na importância');
            QRMemoPrazo.Lines.Append('acima que pagarei(emos) a ');
            QRMemoPrazo.Lines.Append(QRPedidoEspelhoNOME_FILIAL.Value);
            QRMemoPrazo.Lines.Append('ou a sua ordem no(s) vencimento(s) acima indicados.');
            QRMemoPrazo.Lines.Append('Afirmo ter recebido a(s) mercadoria(s) acima indicada(s).');
            QRMemoPrazo.Lines.Append('Data do Aceite: ' + QNFE_EmiteDT_EMISSAO.Text + ' CPF:' + QNFE_EmiteNUM_CGC_CPF.Text +chr(13)+chr(10) + chr(13)+chr(10));
            QRMemoPrazo.Lines.Append('Assinatura:_____________________________________' + chr(13)+chr(10));
            QRMemoPrazo.Lines.Append('Relatório Gerencial.');
          end;
        end
        else
        begin
          QRBand1.Height  := 155;
          QRCBPrazo.Height := 0;
        end;

        wIndexImpressoraPadrao := Printer.PrinterIndex;
        if DMUsuario.ImpressoraPadraoNFCe <> '' then
        begin
          if pos('\\', DMUsuario.ImpressoraPadraoNFCe) > 0 then
            Printer.PrinterIndex :=
            Printer.Printers.IndexOf(Bib.PegaImpressoraPorNomeRede(DMUsuario.ImpressoraPadraoNFCe))
        else
          Printer.PrinterIndex := Printer.Printers.IndexOf(DMUsuario.ImpressoraPadraoNFCe);
        end;
        FRPedido40Colunas.QRPrimario.PrinterSettings.PrinterIndex := Printer.PrinterIndex;
        QRPrimario.Print;

        QRExprSQtde.Enabled := True;
        FRPedido40Colunas.Free;
        FRPedido40Colunas := Nil;
      end;
    end;
  end;
end;

