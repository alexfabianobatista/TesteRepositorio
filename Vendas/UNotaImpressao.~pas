    wCondicao : String;
Begin
  wCont := 0;
  Imp.WriteXY(0, wCont, 'Via Caixa Nr.: '+DMNotaSaida.QNFE_EmiteNUM_NOTA.Text);
  Imp.WriteXY(8, wCont, 'Via Estoque.:       '+DMNotaSaida.QNFE_EmiteNUM_NOTA.Text);
  wCont := wCont + 1;
