        QRM1.Lines.Clear;
        QRM2.Lines.Clear;
        QRM3.Lines.Clear;
        QRMCliente.Lines.Clear;
        QRMemoPrazo.Lines.Clear;
        QRMEnderecoFilial.Lines.Clear;

