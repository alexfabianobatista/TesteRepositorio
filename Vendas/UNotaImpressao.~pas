  // *** OBS - Colocar Posicao X em Centimetros
  // *** wNotaGlobal Controla a quebra de continuação
  with DMNotaSaida do
  begin
    wNotaGlobal := 0;
    wCont := 0;
    wTotalServicos := 0;
    while wNotaGlobal < 2 do
    begin
      wCont := 4;

      Imp.WriteXY(17.5, wCont,Bib.AjustaStrContrario(QNFE_EmiteCOD_ORDEM_SERVICO_CAB.Text,10,'0'));
