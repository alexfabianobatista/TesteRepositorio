procedure TFNotaImpressao.EmiteNovoValeProduto;
begin
  with DMDevolucaoTroca do
  begin
    QValeProduto.Close;
    QValeProduto.ClearVariables;
    QValeProduto.SetVariable('COD_NOTA_CAB_ANTERIOR', DMNotaSaida.QNotaSaidaCOD_NOTA_CAB.Value);
    QValeProduto.Open;

    if QValeProduto.RecordCount > 0 then
    begin       
      if MessageDlg('Deseja reemitir o Vale Compras nº '+ QValeProdutoCOD_VALE_PRODUTO.Text +'?',
          mtConfirmation,[mbYes,mbNo],0) <> mrYes then
        Abort;
      emitirValeProduto(QValeProdutoCOD_VALE_PRODUTO.Value);
    end
    else
    begin
      if DMNotaSaida.QSomaValessval_novo_vale_compras.Value > 0 then
      begin
        QValeProdutoValida.Close;
        QValeProdutoValida.ClearVariables;
        QValeProdutoValida.SetVariable('COD_NOTA_CAB_TROCA', DMNotaSaida.QNotaSaidaCOD_NOTA_CAB.Value);
        QValeProdutoValida.SetVariable('TIPO_VALE', 'VALE-COMPRAS');
        QValeProdutoValida.Open;
        
        DMOracle.DBCemapa.StartTransaction;
        QValeProduto.Insert;
        QValeProdutoCOD_NOTA_CAB.Value := QValeProdutoValidaCOD_NOTA_CAB.Value;
        QValeProdutoCOD_FILIAL.Value := DMNotaSaida.QNotaSaidaCOD_FILIAL.Value;
        QValeProdutoDESC_TIPO_VALE.Value := 'VALE-COMPRAS';
        QValeProdutoCOD_NOTA_CAB_DEV.Value := QValeProdutoValidaCOD_NOTA_CAB_DEV.Value;
        QValeProdutoCOD_CADASTRO.Value := QValeProdutoValidaCOD_CADASTRO.Value;
        QValeProdutoCOD_NOTA_CAB_ANTERIOR.Value := DMNotaSaida.QNotaSaidaCOD_NOTA_CAB.Value;
        QValeProdutoVAL_VALOR_BAIXADO.Value := 0;
        QValeProdutoVAL_VALE_PRODUTO.Value := DMNotaSaida.pValorNovoValeCompras;
        QValeProdutoDT_EMISSAO.Value := DMOracle.DataServ;
        QValeProdutoIND_SITUACAO_VALE_PRESENTE.Value := 2; //emitido
        QValeProduto.Post;
        DMOracle.DBCemapa.Commit;
        if MessageDlg('Deseja imprimir o novo Vale Compras nº ' +
          QValeProdutoCOD_VALE_PRODUTO.Text + '?',mtConfirmation,[mbYes,mbNo],0) = mrYes then
          emitirValeProduto(QValeProdutoCOD_VALE_PRODUTO.Value);
      end;
      if DMNotaSaida.QSomaValessval_novo_vale_presente.Value > 0 then
      begin
        QValeProdutoValida.Close;
        QValeProdutoValida.ClearVariables;
        QValeProdutoValida.SetVariable('COD_NOTA_CAB_TROCA', DMNotaSaida.QNotaSaidaCOD_NOTA_CAB.Value);
        QValeProdutoValida.SetVariable('TIPO_VALE', 'VALE-PRESENTE');
        QValeProdutoValida.Open;
        DMOracle.DBCemapa.StartTransaction;
        QValeProduto.Insert;
        QValeProdutoCOD_FILIAL.Value := DMNotaSaida.QNotaSaidaCOD_FILIAL.Value;
        QValeProdutoDESC_TIPO_VALE.Value := 'VALE-PRESENTE';
        QValeProdutoCOD_NOTA_CAB_ANTERIOR.Value := DMNotaSaida.QNotaSaidaCOD_NOTA_CAB.Value;
        QValeProdutoCOD_CADASTRO.Value := QValeProdutoValidaCOD_CADASTRO.Value;
        QValeProdutoVAL_VALOR_BAIXADO.Value := 0;
        QValeProdutoVAL_VALE_PRODUTO.Value := DMNotaSaida.pValorNovoValePresente;
        QValeProdutoDT_EMISSAO.Value := DMOracle.DataServ;
        QValeProdutoIND_FORMA_PGTO_VALE_PRESENTE.Value := QValeProdutoValidaIND_FORMA_PGTO_VALE_PRESENTE.Value;
        QValeProdutoIND_SITUACAO_VALE_PRESENTE.Value := 2; //emitido
        QValeProduto.Post;
        DMOracle.DBCemapa.Commit;
        if MessageDlg('Deseja imprimir o novo Vale Presente nº ' +
          QValeProdutoCOD_VALE_PRODUTO.Text + '?',mtConfirmation,[mbYes,mbNo],0) = mrYes then
          emitirValeProduto(QValeProdutoCOD_VALE_PRODUTO.Value);
      end;    
    end;
  end;
end;

procedure TFNotaImpressao.emitirValeProduto(CodValeProduto: Integer);
var wIndexImpressoraPadrao, i: Integer;
    wFRValeProduto: TFTRelSimples;
begin
  with DMDevolucaoTroca do
  begin
    QRValeProduto.Close;
    QRValeProduto.SetVariable('COD_VALE_PRODUTO', CodValeProduto);
    QRValeProduto.Open;

    wIndexImpressoraPadrao := Printer.PrinterIndex;
    if DMUsuario.ImpressoraPadraoValeProduto <> '' then
    begin
      if pos('\\', DMUsuario.ImpressoraPadraoValeProduto) > 0 then
        Printer.PrinterIndex :=
          Printer.Printers.IndexOf(Bib.PegaImpressoraPorNomeRede(DMUsuario.ImpressoraPadraoValeProduto))
      else
        Printer.PrinterIndex := Printer.Printers.IndexOf(DMUsuario.ImpressoraPadraoValeProduto);
    end;
    if Printer.PageWidth > 1700 then
    begin
      if FRValeProdutoNormal = nil then
        FRValeProdutoNormal := TFRValeProdutoNormal.Create(Application);
      FRValeProdutoNormal.QRPrimario.PrinterSettings.PrinterIndex := Printer.PrinterIndex;
      wFRValeProduto := FRValeProdutoNormal;
    end
    else
    begin
      if FRValeProduto48Colunas = nil then
        FRValeProduto48Colunas := TFRValeProduto48Colunas.Create(Application);
      FRValeProduto48Colunas.QRPrimario.PrinterSettings.PrinterIndex := Printer.PrinterIndex;
      if QRValeProdutoIND_FORMA_PGTO_VALE_PRESENTE.Value = 2 then
      begin
        FRValeProduto48Colunas.pSegundaVia := True;
        FRValeProduto48Colunas.QRPrimario.Print;
      end;
      FRValeProduto48Colunas.pSegundaVia := False;
      wFRValeProduto := FRValeProduto48Colunas;
    end;

    wFRValeProduto.QRPrimario.Print;
    Bib.MessageDlgCustomizado('O Vale foi impresso com sucesso?',mtConfirmation,
      [mbYes, mbNo,mbOk],['Sim','Não','Visualizar']);
  end;
end;

procedure TFNotaImpressao.NF_LACTOMIL;
var
  totalTributos, totalProdutos : Real;
begin
  // *** Emissão de Nota Fiscal para a LACTOMIL-SERRANÓPOLIS
  // *** OBS - Colocar Posicao X em Centimetros
  // *** wNotaGlobal Controla a quebra de continuação
  with DMNotaSaida do
  begin
    wNotaGlobal := 0;
    wCont := 0;
    while wNotaGlobal < 2 do
    begin
      wCont := 18;
      if wNotaGlobal = 1 then
        Imp.WriteXY(10.1, wCont, 'CONTINUACAO');
      wNotaGlobal := 2;
  
      Imp.WriteXY(17, wCont, FormatDateTime('dd',QNFE_EmiteDT_EMISSAO.Value));
      Imp.WriteXY(18, wCont, FormatDateTime('mm',QNFE_EmiteDT_EMISSAO.Value));
      Imp.WriteXY(19, wCont, FormatDateTime('yyyy',QNFE_EmiteDT_EMISSAO.Value));
      wCont := wCont + 3;
      Imp.WriteXY(17, wCont, QNFE_EmiteDT_EMISSAO.Text);
      wCont := wCont + 4;
      Imp.WriteXY(18, wCont, FormatDateTime('hh:mm',Now));
      wCont := wCont + 5;
      Imp.WriteXY(1.1, wCont, QNFE_EmiteNOME.Value);
      Imp.WriteXY(13, wCont, QNFE_EmiteNUM_CGC_CPF.Value);
      wCont := wCont + 3;
      Imp.WriteXY(1.1, wCont, QNFE_EmiteDESC_ENDERECO.Value);
      Imp.WriteXY(9, wCont, QNFE_EmiteDESC_BAIRRO.Value);
      Imp.WriteXY(14, wCont, QNFE_EmiteDESC_CEP.Value);
      wCont := wCont + 3;
      Imp.WriteXY(1.1, wCont, QNFE_EmiteDESC_CIDADE.Value);
      Imp.WriteXY(5.5, wCont, QNFE_EmiteDESC_TELEFONE.Value);
      Imp.WriteXY(8.7, wCont, QNFE_EmiteCOD_ESTADO.Value);
      Imp.WriteXY(12.7, wCont, QNFE_EmiteNUM_INSCRICAO.Value);

      // **** Itens de produtos ****
      wCont := wCont + 8;
      wContLinha := 0;
      // somente pode posicionar no inicio do arquivo a primeira vez
      if wNotaGlobal = 0 then
        QNFE_EmiteIt.First;
      while not QNFE_EmiteIT.Eof do
      begin
        Inc(wCont);
        Inc(wcontLinha);
        Imp.WriteXY(8, wCont, Bib.NumToTexto(QNFE_EmiteITQT_Quantidade.Value, 0, 8));
        Imp.WriteXY(10.5, wCont, bib.Extenso(QNFE_EmiteITQT_Quantidade.Value,'NADA'));
        //Imp.WriteXY(17.5, wCont, QNFE_EmiteITDesc_Unidade.Value);
        QNFE_EmiteIT.Next;

        if wContLinha = 19 then
        begin
          wNotaGlobal := 1;
          Imp.WriteXY(15.3, 38, 'CONTINUA');
          Imp.SaltaPagina;
          Break;
        end;
      end;
    end;
    // *** Final dos Itens ****
    wCont := 57;
    if Trim(QNFE_Emitenome_transp.Value) = '' then
      Imp.WriteXY(1.1, wCont, QNFE_EmiteDesc_Transportadora.Value)
    else
      Imp.WriteXY(1.1, wCont, QNFE_Emitenome_transp.Value);

    Imp.WriteXY(12.2, wCont, QNFE_EmiteDesc_Placa.Value);
    Imp.WriteXY(16, wCont, QNFE_Emitecgc_transp.Value);
    wCont := wCont + 3;
    Imp.WriteXY(1.1, wCont, QNFE_Emiteend_transp.Value);
    Imp.WriteXY(10, wCont, QNFE_Emitecidade_transp.Value);
    Imp.WriteXY(16, wCont, QNFE_Emiteinsc_transp.Value);
    wCont := wCont + 8;

    IMP_OBS_CORPO_NOTA(1, wCont);
    {Imp.WriteXY(0.2, wCont, QNFE_EmiteOBS.Value);
    Inc(wCont);
    if Trim(QNFE_EmiteOBS_COMPLEMENTO.Value) <> '' then
    begin
      Imp.WriteXY(0.2, wCont, QNFE_EmiteOBS_COMPLEMENTO.Value);
      Inc(wCont);
    end;
    if Trim(QNFE_EmiteDesc_Mensagem.Value) <> '' then
    begin
      Imp.WriteXY(0.2, wCont, QNFE_EmiteDesc_Mensagem.Value);
      Inc(wCont);
    end;
    if Trim(QNFE_EmiteDesc_COMPLEMENTO.Value) <> '' then
    begin
      Imp.WriteXY(0.2, wCont, QNFE_EmiteDesc_COMPLEMENTO.Value);
      Inc(wCont)
    end;}

    if wCont < 61 then
      wCont := 61;
  end;

end;

procedure TFNotaImpressao.NF_FURGOES;
