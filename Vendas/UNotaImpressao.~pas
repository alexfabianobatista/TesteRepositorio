      if wNotaGlobal = 0 then
        QNFE_EmiteIt.First;
      while not QNFE_EmiteIT.Eof do
      begin
        wCont := wCont + 1;

        Imp.WriteXY(0, wCont, Bib.NumToTexto(QNFE_EmiteITQT_Quantidade.Value, 2, 5));
        Imp.WriteXY(1, wCont, QNFE_EmiteITDesc_Produto.Value +
          Bib.ift(QNFE_EmiteItDESC_INF_ADICIONAL.Value = '', '',' - '+ QNFE_EmiteItDESC_INF_ADICIONAL.Value));
        if(QNFE_EmiteItIND_TIPO_PRODUTO.Value = 'SERVIÇO') then
        begin
          Imp.WriteXY(15.2, wCont, Bib.NumToTexto(QNFE_EmiteITVal_Unitario.Value, 2, 11));
          wTotalServicos := wTotalServicos + QNFE_EmiteItVAL_TOTAL.Value;
        end
        else
          Imp.WriteXY(10.5, wCont, Bib.NumToTexto(QNFE_EmiteITVal_Unitario.Value, 2, 11));
        Imp.WriteXY(17, wCont, Bib.NumToTexto(QNFE_EmiteITVal_Total.Value, 2, 19));

        QNFE_EmiteIT.Next;
        if(wCont = 56) then
        begin
          wNotaGlobal := 1;
          Imp.WriteXY(17, 63, 'CONTINUA...');
          Imp.SaltaPagina;
          Break;
        end;
      end;
    end;
    wCont := wCont + 2;
    if(QNFE_EmiteVAL_AVISTA.Value > 0) then
    begin
      Imp.WriteXY(1, wCont, 'Valor Entrada: R$' + FormatFloat('#,##0.00', QNFE_EmiteVAL_AVISTA.Value));
      wCont := wCont + 1;
    end;
    Imp.WriteXY(1, wCont, 'Obs: '+QNFE_EmiteOBS.Value);
    wCont := 57; //Alterado para 55 pois segundo o Caio estava cortando quando imprimia com muitos itens. Alex 24/10/2022.
    //wCont := 55;
    Imp.WriteXY(17, wCont, Bib.NumToTexto(wtotal_produtos - wTotalServicos, 2, 19));
    wCont := wCont + 2;
    Imp.WriteXY(17, wCont, Bib.NumToTexto(wTotalServicos, 2, 19));
    wCont := wCont + 2; //3
    {Imp.WriteXY(13.8, wCont, 'DESCONTO');                          //Não precisa do Desconto e o valor total fica no lugar da impressão do desconto.
    Imp.WriteXY(17, wCont, Bib.NumToTexto(wTotalDescontos, 2, 19)); //Solicitado por Djeison. Junior 09/04/2019
    wCont := wCont + 2;}
    Imp.WriteXY(17, wCont, Bib.NumToTexto(wtotal_produtos-wTotalDescontos, 2, 19));
  end;

end;

procedure TFNotaImpressao.EmitePedido40ColunasTermica;
