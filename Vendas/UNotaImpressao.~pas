        Imp.WriteXY(8.2, wCont, Bib.NumToTexto(QContaReceberVAL_TITULO.Value, 2, 8));
        wCont := wCont + 1;
        QContaReceber.Next;
      end;
    end;
    QContaReceber.Close;
    inc(wCont);
    Imp.WriteXY(16.7, wCont, 'Total......:' + Bib.NumToTexto(wtotal_produtos + wvlr_ipi + wTotalDesconto, 2, 11));
    inc(wCont);
    Imp.WriteXY(16.7, wCont, 'Desconto...:' + Bib.NumToTexto(QNFE_EmiteVal_Desconto.Value, 2, 11));
    inc(wCont);
    Imp.WriteXY(16.7, wCont, 'Acrescimos.:' + Bib.NumToTexto(QNFE_EmiteVal_Despesas.Value, 2, 11));
    inc(wCont);
    Imp.WriteXY(7, wCont, '______________________________________');
    Imp.WriteXY(16.7, wCont, 'Entrada....:' + Bib.NumToTexto(QNFE_EmiteVal_AVista.Value, 2, 11));
    inc(wCont);
    Imp.WriteXY(7, wCont, QNFE_EmiteNOME.Value);
    Imp.WriteXY(16.7, wCont, 'Total Geral:' + Bib.NumTotexto(wtotal_produtos
      + wvlr_ipi
      + QNFe_EmiteVal_FunRural.Value
      - QNFE_EmiteVal_Desconto.Value
      - QNFE_EmiteVal_AVista.Value
      + QNFE_EmiteVal_Despesas.Value, 2, 11));
  End;
End;

function TFNotaImpressao.FechaNFCe: Boolean;
var wCartao, wModalResult: Integer;
  wFinaliza: Boolean;
  wValDesconto, wValDespesas: Double;
  // Para o pix
  vDigCpfCnpj, iItem, wBanco : integer;
  aCpfCnpj, aCodBarra, aProduto, wPadrao: string;
  aValPgtoPix : Double;
label
  lErroQrCode, lDispensaQrCode;
begin
  with DMNotaSaida do
  begin
    if (DMOracle.FastSelect('NUM_CGC_CPF','TB_CADASTRO','COD_CADASTRO = '+
       QNotaSaidaCOD_CADASTRO.Text) = '') and
       not (StrToInt('0' + DMNfe.QNfeEmissaoDESC_RETORNO_PROCESSAMENTO.Value) in SIT_NFE_ACEITO) then
    begin
      if FNFCeParam = nil then
        FNFCeParam := TFNFCeParam.Create(Application);
      QNotaNomeCons.Close;
      QNotaNomeCons.Open;
      QNotaNomeCons.First;
      while not QNotaNomeCons.Eof do
      begin
        FNFCeParam.leCGCCPF.Items.Add(QNotaNomeConsDESC_CGC_CPF.Value);
        QNotaNomeCons.Next;
      end;
      QNotaNome.Close;
      QNotaNome.SetVariable('PK', QNotaSaidaCOD_NOTA_CAB.Value);
      QNotaNome.Open;
      FNFCeParam.leCGCCPF.Text := QNotaNomeDESC_CGC_CPF.Value;
      FNFCeParam.leNome.Text := QNotaNomeNOME.Value;
      FNFCeParam.PGRelatorio.Pages[0].TabVisible := true;
      wModalResult := FNFCeParam.ShowModal;
      if wModalResult = mrOk then
      begin
        if QNotaNome.Eof then
          QNotaNome.Insert
        else
          QNotaNome.Edit;
        QNotaNomeCOD_NOTA_CAB.Value   := QNotaSaidaCOD_NOTA_CAB.Value;
        QNotaNomeNOME.Value           := Trim(FNFCeParam.leNome.Text);
        QNotaNomeDESC_CGC_CPF.Value   := Trim(FNFCeParam.leCGCCPF.Text);
        QNotaNome.Post;
        DMOracle.DBCemapa.Commit;
      end
      else
      begin
        if not QNotaNome.Eof then
        begin
          QNotaNome.Delete;
          DMOracle.DBCemapa.Commit;
        end;
        if wModalResult = mrAbort then
          Abort;
      end;
    end;
    Try
      QSomaPagamentos.Refresh;
      if QSomaItemNota.State = dsInactive then
        DMNotaSaida.QSomaItemNota.Open;
      QSomaItemNota.Refresh;
      Result := RoundTo(QSomaPagamentosVAL_PAGAMENTOS_CONFIRMADOS.Value, -2) =
         RoundTo(QSomaItemNotasval_total_nota.Value, -2);

      if not Result then
      begin
        if FNFCeFechamento = nil then
          FNFCeFechamento := TFNFCeFechamento.Create(Application);
        FNFCeFechamento.edDesconto.Text := QNotaSaidaVAL_DESCONTO.Text;
        FNFCeFechamento.edDespesa.Text := QNotaSaidaVAL_DESPESAS.Text;

        Result := FNFCeFechamento.ShowModal = mrOk;
        if Result then
        begin
          wValDesconto := StrToFloat('0' + bib.LimpaNumero(Trim(FNFCeFechamento.edDesconto.Text),true));
          wValDespesas := StrToFloat('0' + bib.LimpaNumero(Trim(FNFCeFechamento.edDespesa.Text),true));
          if wValDesconto <> QNotaSaidaVAL_DESCONTO.Value then
            DMOracle.ExecutaSql(MontaUpdate('VAL_DESCONTO', StringReplace(FloatToStr(wValDesconto),',','.',[rfReplaceAll]),
                   'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True);
          if wValDespesas <> QNotaSaidaVAL_DESPESAS.Value then
            DMOracle.ExecutaSql(MontaUpdate('VAL_DESPESAS', StringReplace(FloatToStr(wValDespesas),',','.',[rfReplaceAll]),
                   'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True);
          QPagamento.Close;
          QPagamento.SetVariable('COD_NOTA_CAB', QNotaSaidaCOD_NOTA_CAB.Value);
          QPagamento.Open;
          QPagamento.First;
          DMOracle.DBCemapa.StartTransaction; //controle serve para as parcelas do contas a receber e os lançamentos do caixa.
          while not QPagamento.Eof do
          begin
            if  (QPagamentoIND_CONFIRMADO.Value = 'N') then
            begin
              if (QPagamentoDESC_PAGAMENTO.Value = 'Crédito Loja') then
              begin
                QContaReceber.Open;
                if QContaReceber.RecordCount = 0 then
                begin
                  QContaReceber.Close;
                  FNFCeFechamento.LancarParcelas(QPagamentoVAL_VALOR.Value);
                  DMNotaSaida.GeraContaReceber(FNFCeFechamento.pParcelas, FNFCeFechamento.pFinalidade, '',
                        IntToStr(FNFCeFechamento.pDepartamento), IntToStr(FNFCeFechamento.pContaCorrente));
                end
                else
                  QContaReceber.Close;
                if QNotaSaidaIND_CONDICAO_PAGTO.Value <> '2' then
                  DMOracle.ExecutaSql(MontaUpdate('IND_CONDICAO_PAGTO', '2',
                       'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True);
              end;
              if (QPagamentoDESC_PAGAMENTO.Value = 'Dinheiro') then
              begin
                AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,QPagamentoDESC_PAGAMENTO.Value, QNotaSaidaCOD_OPERACAO.AsString,
                  QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                  QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                  StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));
              end;
              if (QPagamentoDESC_PAGAMENTO.Value = 'Cheque') then
              begin
                AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,'CHEQUE', QNotaSaidaCOD_OPERACAO.AsString,
                  QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                  QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                  StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));
              end;
              if (QPagamentoDESC_PAGAMENTO.Value = 'Cartão de Crédito') then
              begin
                AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,'CARTAO CREDITO', QNotaSaidaCOD_OPERACAO.AsString,
                  QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                  QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                  StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));
              end;
              if (QPagamentoDESC_PAGAMENTO.Value = 'Cartão de Débito') then
              begin
                AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,'CARTAO DEBITO', QNotaSaidaCOD_OPERACAO.AsString,
                  QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                  QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                  StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));
              end;
              if (QPagamentoDESC_PAGAMENTO.Value = 'Pagamento Instantâneo (PIX)') then
              begin
                {AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,'PIX', QNotaSaidaCOD_OPERACAO.AsString,
                  QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                  QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                  StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));}
                  //aqui utilizar o pgto PIX
                  QContaPix.Open;
                  if QContaPix.RecordCount > 0 then
                  begin
                    // INICIALIZA O PIX - 13/05/2024
                    // Inicializa a variável que vai controlar o envio e conferência do PIX
                    // PIX QRCODE --> Atribui as configurações padrão salvas no form do módulo bancos
                    cControllerPix.Configuracao
                            .PSP(TTipoBancoPix(QContaPixCOD_PSP_BANCO.Value))
                            .ClientID(QContaPixDESC_CLIENT_ID.Text)
                            .ClientSecret(QContaPixDESC_CLIENT_SECRET.Text)
                            .ConsumerKey(QContaPixDESC_CONSUMER_KEY.Text)
                            .ConsumerSecret(QContaPixDESC_CONSUMER_SECRET.Text)
                            .DevelopApplication(QContaPixDESC_DEVELOPER_APPLICATION_KEY.Text)
                            .AccountID(QContaPixDESC_ACCOUNT_ID.Text)
                            .ChavePrivada(QContaPixDESC_ARQUIVO_CHAVE_PRIVADA.Text)
                            .Certificado(QContaPixDESC_ARQUIVO_CERTIFICADO.Text)
                            .CertificadoRoot(QContaPixDESC_ARQUIVO_ROOT_CERTIFICADO.Text)
                            .SecretKey(QContaPixDESC_SECRET_KEY.Text)
                            .AccessKey(QContaPixDESC_ACCESS_KEY.Text)
                            .CertificadoPFX(QContaPixDESC_ARQUIVO_PFX.Text)
                            .SenhaCertificado(QContaPixDESC_SENHA_PFX.Text)
                            .Token(QContaPixDESC_TOKEN.Text)
                            .TokenSandbox(QContaPixDESC_ACCESS_TOKEN.Text)
                            .MediatorFee(QContaPixDESC_MEDIATOR_FEE.Value)
                            .APIVersion(QContaPixCOD_API_VERSION.Text)
                            .Ambiente(QContaPixIND_AMBIENTE_PSP.Text)
                            .ChavePIX(QContaPixDESC_CHAVE_PIX.Text);

                    // Executa o componente que vai gerar a comunicação com o banco de forma dinâmica
                    // De acorodo com o banco cadastrado, sobe o componente.
                    cpPixCemapa.PSP :=  cControllerPix.Contexto.ExecutarStrategy.PSP;
                    // Define o ambiente com base na informação trazida do cadastro pix
                    cpPixCemapa.Ambiente := TACBrPixCDAmbiente(StrToInt(cControllerPix.Configuracao.Ambiente));
                    cpPixCemapa.TimeOut := 3600;
                    cpPixCemapa.ArqLOG := './defaultFailPix.log';
                    cpPixCemapa.NivelLog := 4;
                    // Constantes da classe Cemapa.Conversoes.API
                    cpPixCemapa.Recebedor.Nome := QNFE_EmiteNOME_FILIAL.Text; //SOFTWARE_HOUSE;
                    cpPixCemapa.Recebedor.CEP := QNFE_EmiteCEP_FILIAL.Text; //SOFTWARE_HOUSE_CEP;
                    cpPixCemapa.Recebedor.Cidade := QNFE_EmiteCIDADE_FILIAL.Text; //SOFTWARE_HOUSE_CIDADE;
                    cpPixCemapa.Recebedor.UF := QNFE_EmiteUF_FILIAL.Text; // SOFTWARE_HOUSE_UF;
                  end;
                  //inicio pix
                   if (QContaPixIND_PIX_PADRAO.Text = 'S') and (QNotaSaidaDESC_TXID.Text = '') then
                   begin
                     with cpPixCemapa.PSP.epCob.CobSolicitada do
                     begin
                       chave := cControllerPix.Configuracao.ChavePIX;
                       calendario.expiracao := 3600;

                       devedor.nome := Trim(QNotaNomeNOME.Value);
                       aCpfCnpj := trim(QNotaNomeDESC_CGC_CPF.Value);
                       aCpfCnpj := Bib.LimpaString(Bib.LimpaString(aCpfCnpj, '-'), '.');
                       aCpfCnpj := Bib.LimpaString(aCpfCnpj, '/');

                       vDigCpfCnpj := Length(aCpfCnpj);

                       if (vDigCpfCnpj > 11) then
                         devedor.cnpj := aCpfCnpj
                       else
                         devedor.cpf := aCpfCnpj;
                       QItemNfCons.Close;
                       QItemNfCons.SetVariable('COD_NOTA_CAB', QItemNFCOD_NOTA_CAB.Value);
                       QItemNfCons.Open;
                       QItemNfCons.First;
                       // quando é pra este prestador de serviço de pagamento
                       // precisa mandar os itens da nota
                       if (cpPixCemapa.PSP is TACBrPSPShipay) then
                       begin

                         with infoAdicionais.New do
                         begin
                           nome := 'order_ref';
                           valor := FormatDateTime('yymmddhhnnss', Now);
                         end;

                         for iItem := 0 to QItemNfCons.RecordCount -1 do
                         begin
                           with infoAdicionais.New do
                           begin
                             aCodBarra := DMOracle.BuscaNome('SELECT DESC_CODIGO_BARRA FROM TB_PRODUTO', 'COD_PRODUTO = ' + FloatToStr(QItemNfConsCOD_PRODUTO.Value));
                             nome := 'item_' + IntToStr(iItem + 1);
                             aProduto := DMOracle.BuscaNome('SELECT DESC_PRODUTO FROM TB_PRODUTO', 'COD_PRODUTO = ' + FloatToStr(QItemNfConsCOD_PRODUTO.Value));
                             valor := '{' + '"ean": "' + aCodBarra + '", ' +
                                '"item_title": "' + aProduto + '", ' +
                                '"quantity":'+  QItemNfConsQT_QUANTIDADE.Text  +', ' +
                                '"sku": "' + 'EAN' + '", ' +
                                '"unit_price": ' + StringReplace(QItemNfConsVAL_UNITARIO.Text, '.', '', []) + '}';
                           end; // preenchimento das informações
                           QItemNfCons.Next;
                         end; // for
                         QItemNfCons.Close;
                       end; //  if shipay
                       QSomaItemNota.Close;
                       QSomaItemNota.SetVariable('COD_NOTA_CAB',QNotaSaidaCOD_NOTA_CAB.Value);
                       QSomaItemNota.Open;
                       // busca o valor total da nota, não encontrei em outro lugar
                       //aValPgtoPix := StrToFloat(DMOracle.BuscaNome('SELECT )
                       if QNotaSaidaCOD_SERIE_MODELO.Value = '65' then
                         valor.original := QPagamentoVAL_PAGAMENTO.Value
                       else
                         valor.original := QSomaItemNotaSVAL_TOTAL.Value + QSomaItemNotaSVAL_DESPESAS.Value - QSomaItemNotaSVAL_DESCONTO.Value - QNotaSaidaVal_AVista.Value;

                       LimpaStatusPix(fPixDadosStatus);

                       fPixDadosStatus.Total := valor.original;

                       // Começa a executar a cobrança
                       if cpPixCemapa.PSP.epCob.CriarCobrancaImediata then
                       begin
                        fPixDadosStatus.TxID := cpPixCemapa.PSP.epCob.CobGerada.txId;
                        fPixDadosStatus.QRCode := Trim(cpPixCemapa.PSP.epCob.CobGerada.pixCopiaECola);

                        if (fPixDadosStatus.QRCode = EmptyStr) then
                          fPixDadosStatus.QRCode := cpPixCemapa.GerarQRCodeDinamico(cpPixCemapa.PSP.epCob.CobGerada.location);

                        if FQrCodePix = nil then
                          FQrCodePix := TFQrCodePix.Create(nil);

                        FQrCodePix.recebeDados(cpPixCemapa, fPixDadosStatus);
                       end
                       else
                       begin
                         fPixDadosStatus.EmErro := True;
                           Raise Exception.Create('Erro ao Criar Cobrança Pix: ' + sLineBreak +
                                   FormatarJSON(cpPixCemapa.PSP.epCob.Problema.AsJSON));
                       end;
                       FQrCodePix.ShowModal;
                       if (FQrCodePix.isAbort) then
                         goto lDispensaQrCode;
                       if (FQrCodePix.ModalResult = MRCancel) and not (fPixDadosStatus.EmErro)then
                       begin
                         cpPixCemapa.PSP.epCob.CobRevisada.status := stcREMOVIDA_PELO_USUARIO_RECEBEDOR;
                         if cpPixCemapa.PSP.epCob.RevisarCobrancaImediata(fPixDadosStatus.TxID) then
                         begin
                           cpPixCemapa.PSP.Clear;
                           fPixDadosStatus.EmErro := true;
                           ShowMessage('Operação com o Pix CANCELADA!');
                           goto lErroQrCode;
                         end
                         else if (FQrCodePix.ModalResult = MRCancel) and (fPixDadosStatus.EmErro)then
                         begin
                           ShowMessage('Falha ao CANCELAR a Cobrança!');
                           goto lErroQrCode;
                         end;
                       end
                       else if (fPixDadosStatus.EmErro) then
                       begin
                         ShowMessage('Erro ao realizar a cobrança!');
                         goto lErroQrCode;
                       end;
                     end;
                     //// Aqui daria continidade para pegar os dados do pix e do valor.
                     //// FPixDadosStatus.TxID é onde fica o codigo único do pix
                     //// fPixDadosStatus.QRCode é onde está a url para gerar o qrcode
                     //// fPixDadosStatus.Total é o valor da cobrança
                     //// fPixDadosStatus.EmErro Caso dê erro, vai ser aqui que pega a informaçao
                     //// fPixDadosStatus.QtdConsultas quantidade de consultas tentadas. Vou limitar em 36
                     AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,'PIX', QNotaSaidaCOD_OPERACAO.AsString,
                        QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                        QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                        StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));
                     DMOracle.ExecutaSql('UPDATE TB_NOTA_CAB SET DESC_TXID = ' + QuotedStr(fPixDadosStatus.TxID) + ' WHERE COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text);
                     QContaPix.Close;
                     FQrCodePix := nil;
                    //fim pix
                  end;
                  lDispensaQrCode: //vem pra cá para dispensar QRCODE
                  AtuCaixa(QPagamentoVAL_VALOR.Value - QPagamentoVAL_TROCO.Value,'PIX', QNotaSaidaCOD_OPERACAO.AsString,
                        QNotaSaidaCOD_FILIAL.AsString, QNotaSaidaCOD_DEPARTAMENTO.Text, QNotaSaidaNUM_NOTA.AsString,
                        QNotaSaidaCOD_CADASTRO.AsString, QNotaSaidaCOD_NOTA_CAB.AsString,'',
                        StrToDate(FormatDateTime('DD/MM/YYYY',QNotaSaidaDT_EMISSAO.Value)));
                  if (DMParamSistema.CodEmpresa = 'FERRAGMED') then
                  begin
                    if FInformaBancoPix = nil then
                      FInformaBancoPix := TFInformaBancoPix.create(Application);
                    FInformaBancoPix.ShowModal;
                  end;
              end;
              if QPagamento.State = dsBrowse then
              begin
                QPagamento.Edit;
                QPagamentoIND_CONFIRMADO.Value := 'S';
                QPagamento.Post;
              end
              else
                QPagamentoIND_CONFIRMADO.Value := 'S';
            end;
            QPagamento.Next;
          end;
          QSomaPagamentos.Refresh;
        end;
      end;

      // PARA O ERRO NO PIX OU NO QRCODE
      lErroQrCode:
      if fPixDadosStatus.EmErro then
        Result := false;


      if DMParamSistema.CodEmpresa <> 'ARISTIDES' then
      begin
        if RoundTo(QSomaPagamentosVAL_A_PRAZO.Value,-2) > 0 then
          DMOracle.ExecutaSql(MontaUpdate('IND_CONDICAO_PAGTO', '2',
            'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True)
        else if RoundTo(QSomaPagamentosVAL_AVISTA.Value,-2) > 0 then
          DMOracle.ExecutaSql(MontaUpdate('IND_CONDICAO_PAGTO', '1',
            'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True)
        else if RoundTo(QSomaPagamentosVAL_CARTAO_CREDITO.Value,-2) > 0 then
          DMOracle.ExecutaSql(MontaUpdate('IND_CONDICAO_PAGTO', '4',
            'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True)
        else if RoundTo(QSomaPagamentosVAL_CARTAO_DEBITO.Value,-2) > 0 then
          DMOracle.ExecutaSql(MontaUpdate('IND_CONDICAO_PAGTO', '5',
            'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True)
        else if RoundTo(QSomaPagamentosVAL_PIX.Value,-2) > 0 then
          DMOracle.ExecutaSql(MontaUpdate('IND_CONDICAO_PAGTO', '6',
            'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + QNotaSaidaCOD_NOTA_CAB.Text), True)

      end;
      QSomaPagamentos.Refresh;
      if QSomaPagamentosVAL_TEF_NAO_PROCESSADO.Value > 0.001 then
      begin
        //Guarda no registro o códiogo da filial
        //para o caso de dar erro na impressão do TEF
        Registry := TRegistry.Create;//executa o tregistry
        Registry.RootKey:=HKEY_CURRENT_USER; //abre a chave mestra
        Registry.OpenKey('SOFTWARE\CemapaSistema',true);
        Registry.WriteString('FilialTEF',QNotaSaidaCOD_FILIAL.Text);

        if FTef = nil then
          FTef := TFTef.Create(Application);

        FTEF.Modalidade := 2;
        FTEF.ValorTransacao := QSomaPagamentosVAL_TEF_NAO_PROCESSADO.Value;
        FTEF.NumNota := QNotaSaidaNUM_NOTA.Text;
        FTEF.CodNotaCab := QNotaSaidaCOD_NOTA_CAB.Value;
        FTEF.btIniciaTef.Visible := true;
        if FTEF.Comprovantes = nil then
          FTEF.Comprovantes := TStringList.Create;
        FTEF.lbMensagem.Caption := '';
        FTEF.ValorDinheiro := 0;
        FTEF.ValorDesconto := 0;
        FTEF.IndNFCe := True;

        if Result then
        begin
          with DMTEF do
          begin
            if not QTefCab.Eof then
            begin
              QTefCab.Edit;
              QTefCabIND_STATUS.Value := 'PENDENTE';
              QTefCabDT_EMISSAO.Value := Now;
              QTefCab.Post;
            end;
          end;
        end
        else
        begin
          FTEF.Finaliza(FINALIZA_CANCELANDO);
          MessageDlg('Transação TEF não foi efetuada.', mtError, [mbOK], 0);
        end;
      end;
      DMOracle.DBCemapa.Commit;
    Except
      on e: Exception do
      begin
        MessageDlg('Erro: '  + e.Message,mtError,[mbok],0);
      end;
    end;
  end;
end;

procedure TFNotaImpressao.EmitePedido_Bobina_Termica;
var wCodFinalidade: Integer;
  wQuant, wVlUnitario, wVlDesconto, wTotal: Real;
  wVal: string;
  wDesconto: Real;
  wImpressao, wLinha: String;
begin
  wImpressao := '';
  with DMNotaSaida do
  begin
    if DMParamSistema.CodEmpresa = 'NFCE-DOCES' then
    begin
      wImpressao := wImpressao +  DMParamSistema.QParamSistemaDESC_EMPRESA.Value+chr(13)+chr(10);
      wImpressao := wImpressao +  'CNPJ:'+QNFE_EmiteCGC_FILIAL.Value + ' IE:' +QNFE_EmiteINSCRICAO_FILIAL.Value+chr(13)+chr(10);
      wImpressao := wImpressao +  QNFE_EmiteEND_FILIAL.Value + ' ' +  QNFE_EmiteNUM_ENDERECO_FILIAL.Text + ' ' + QNFE_EmiteBAIRRO_FILIAL.Value +chr(13)+chr(10);
      wImpressao := wImpressao +  QNFE_EmiteCIDADE_FILIAL.Value +'-'+QNFE_EmiteUF_FILIAL.Value +chr(13)+chr(10);
    end
    else
      wImpressao := wImpressao +  QNFE_EmiteNOME_FILIAL.Value+chr(13)+chr(10);
    wImpressao := wImpressao + + Bib.ift(DMParamSistema.CodEmpresa <> 'BAZAR',
      'Telefone: '+QNFE_EmiteTELEFONE_FILIAL.Value + chr(13)+chr(10)+ chr(13)+chr(10), chr(13)+chr(10));

    wImpressao := wImpressao + Bib.ift(DMParamSistema.CodEmpresa <> 'BAZAR', Trim(QNFE_EmiteCOD_CADASTRO.Text) + ' ','') +
      QNFE_EmiteNOME.Value+chr(13)+chr(10);
    if ((trim(QNFE_EmiteNUM_CGC_CPF.Value) <> '') or
       (trim(QNFE_EmiteNUM_INSCRICAO.Value) <> '')) and
       (DMParamSistema.CodEmpresa <> 'OSARE') then
      wImpressao := wImpressao + 'CPF: ' + Trim(QNFE_EmiteNUM_CGC_CPF.Value) +
        Bib.ift(DMParamSistema.CodEmpresa <> 'BAZAR', ' RG: ' + Trim(QNFE_EmiteNUM_INSCRICAO.Value)+chr(13)+chr(10),
          chr(13)+chr(10));



    if (QNFE_EmiteDESC_FANTASIA.Value <> '') and (DMParamSistema.CodEmpresa <> 'OSARE') and
       (DMParamSistema.CodEmpresa <> 'BAZAR') then
       wImpressao := wImpressao +  QNFE_EmiteDESC_FANTASIA.Value+chr(13)+chr(10);
    if (QNFE_EmiteDESC_ENDERECO.Value <> '') then
      wImpressao := wImpressao +  QNFE_EmiteDESC_ENDERECO.Value+chr(13)+chr(10);
    if (QNFE_EmiteDESC_BAIRRO.Value <> '') then
      wImpressao := wImpressao + QNFE_EmiteDESC_BAIRRO.Value+chr(13)+chr(10);
    wImpressao := wImpressao + Bib.ift((DMParamSistema.CodEmpresa = 'OSARE') or (DMParamSistema.CodEmpresa = 'BAZAR'),
      '', QNFE_EmiteDESC_CIDADE.Text + '-' + QNFE_EmiteCOD_ESTADO.Text +
        Bib.ift((QNFE_EmiteDESC_TELEFONE.Value <> '') and (DMParamSistema.CodEmpresa <> 'DINGLIS'),
          ' Fone: ' + QNFE_EmiteDESC_TELEFONE.Text,'')+chr(13)+chr(10));

    //Imprimir Data e Hora.
    wImpressao := wImpressao + 'Emissão: ' + BibVenda.ImprimeDataHora(DMParamSistema.CodEmpresa) +
                 Bib.ift(DMParamSistema.CodEmpresa <> 'BAZAR', 'OP. '+ QNFE_EmiteCOD_OPERACAO.Text + ' - ' +
                  QNFE_EmiteNAT_OPERACAO.Value + chr(13)+chr(10), chr(13)+chr(10));
    if DMParamSistema.CodEmpresa = 'FRIGOPIES' then //Precisa do Num Pedido lado esquerdo. Junior 02/10/2019. Utiliza impressora antiga
      wImpressao := wImpressao + ('PEDIDO NÚM.: ' + QNFE_EmiteNUM_NOTA.Text)+chr(13)+chr(10)
    else if QNFE_EmiteIND_CONDICIONAL.Value = 'S' then
      wImpressao := wImpressao + Bib.FormataTextoEsq('COND. NÚM.: ' + QNFE_EmiteNUM_NOTA.Text, 65)+chr(13)+chr(10)
    else
      wImpressao := wImpressao + Bib.FormataTextoEsq('PEDIDO NÚM.: ' + QNFE_EmiteNUM_NOTA.Text, 65)+chr(13)+chr(10);
//     // ****** Contas a receber ********
    if QNFE_EmiteInd_Condicao_Pagto.Value = '2' then
    begin
      wImpressao := wImpressao +  '________________________________________________'+chr(13)+chr(10);
      wImpressao := wImpressao +  'PRESTAÇÕES A PAGAR'+chr(13)+chr(10);
      wImpressao := wImpressao +  '________________________________________________'+chr(13)+chr(10);

      QContaReceber.Open;
      QContaReceber.First;
      wCodFinalidade := QContaReceberCOD_FINALIDADE.Value; //essa variavel é usada mais abaixo, ao gerar a mensagem de juros
      wImpressao := wImpressao + 'Vencimento      ' + 'Valor'+chr(13)+chr(10);
      while not QContaReceber.Eof do // Faturamento
      begin
        wImpressao := wImpressao + QContaReceberDT_Vencimento.Text + '    ' + Bib.NumToTexto(QContaReceberVal_Titulo.Value, 2, 8)+chr(13)+chr(10);
        QContaReceber.Next;
      end;
      QContaReceber.Close;
    end;
//    // ****** fim Contas a receber ********
//    // **** Itens ****
    wImpressao := wImpressao +  '________________________________________________'+chr(13)+chr(10);
    if (DMParamSistema.CodEmpresa = 'CEREAIS') or (DMParamSistema.CodEmpresa = 'MAVENIDA') then
      wImpressao := wImpressao +  'QTDE  UN  PRODUTO '+chr(13)+chr(10)
    else
      wImpressao := wImpressao +  'QTDE  UN  LOTE  PRODUTO '+chr(13)+chr(10);

    if DMParamSistema.CodEmpresa <> 'BAZAR' then
      wLinha := Bib.FormataTextoEsq('PREÇO UNITÁRIO   VL DESC   PERC   TOTAL',49) +chr(13)+chr(10)
    else
      wLinha := Bib.FormataTextoEsq('PREÇO UNITÁRIO                             TOTAL',65) +chr(13)+chr(10);
    wImpressao := wImpressao + wLinha;
    wImpressao := wImpressao +  '________________________________________________'+chr(13)+chr(10);
    wQuant := 0;
    QNFE_EmiteIt.First;
    wVlDesconto := 0; //calcula o desconto total
    while not QNFE_EmiteIT.Eof do
    begin
      wVlUnitario := QNFE_EmiteItVAL_UNITARIO.Value;
      if (QNFE_EmiteItPERC_DESC.Text <> '') and (QNFE_EmiteItPERC_DESC.Text <> '0') then
        wVlDesconto := wVlDesconto + ((wVlUnitario - QNFE_EmiteITVal_Unitario.Value) * QNFE_EmiteITQt_Quantidade.Value); // para achar o valor que foi dado de desconto
      wQuant := wQuant + QNFE_EmiteITQT_Quantidade.Value;

      if (DMParamSistema.CodEmpresa = 'CEREAIS') then
        wImpressao := wImpressao + Bib.NumToTexto(QNFE_EmiteITQT_Quantidade.Value, 0, 10) +
            '   ' + QNFE_EmiteITDesc_Unidade.Value + '         ' +
              Trim(QNFE_EmiteITCod_Produto.Text) +
              '-' + copy(Trim(QNFE_EmiteITDesc_Produto.Text), 1, 30) +chr(13)+chr(10)
      else if (DMParamSistema.CodEmpresa = 'MAVENIDA') then
        wImpressao := wImpressao + Bib.NumToTexto(QNFE_EmiteITQT_Quantidade.Value, 3, 8) + '  ' +  QNFE_EmiteITDesc_Unidade.Value +
              '  ' + Trim(QNFE_EmiteITCod_Produto.Text) + '-' + copy(Trim(QNFE_EmiteITDesc_Produto.Text), 1, 30) +chr(13)+chr(10)
      else
        wImpressao := wImpressao +  Bib.ift(DMParamSistema.CodEmpresa <> 'BAZAR',
          Bib.NumToTexto(QNFE_EmiteITQT_Quantidade.Value, 2, 10), Bib.NumToTexto(QNFE_EmiteITQT_Quantidade.Value, 0, 10)) +
            '   ' + QNFE_EmiteITDesc_Unidade.Value + '   ' + QNFE_EmiteItCOD_LOTE_TIPO.Text + '  ' +
              Trim(QNFE_EmiteITCod_Produto.Text) +
              '-' + copy(Trim(QNFE_EmiteITDesc_Produto.Text), 1, 30) +chr(13)+chr(10);

      if (DMParamSistema.QParamSistemaCOD_EMPRESA.Text = 'OSARE') or (DMParamSistema.QParamSistemaCOD_EMPRESA.Text = 'PIXIXE') then //Descontar o valor de desconto já no item. Vanessa 13/07/2018
        wLinha :=  Bib.FormataTextoEsq(Bib.NumToTexto(wVlUnitario, 2, 10) +
                   Bib.NumToTexto(QNFE_EmiteItVAL_DESCONTO_TOTAL.Value, 2, 10) +
                   Bib.NumToTexto(Bib.ift(QNFE_EmiteItVAL_DESCONTO_TOTAL.Value > 0,
                   QNFE_EmiteItVAL_DESCONTO_TOTAL.Value * 100/QNFE_EmiteItVAL_TOTAL.Value,0.00), 2, 10)+ '%' +
                   Bib.NumToTexto(((wVlUnitario * QNFE_EmiteITQT_Quantidade.Value) - QNFE_EmiteItVAL_DESCONTO.Value), 2, 10),70)+chr(13)+chr(10)

      else
        wLinha :=  Bib.ift(DMParamSistema.CodEmpresa <> 'BAZAR', Bib.FormataTextoEsq(Bib.NumToTexto(wVlUnitario, 2, 10) +
                   (Bib.NumToTexto(QNFE_EmiteItVAL_DESCONTO_TOTAL.Value, 2, 10) +
                   Bib.NumToTexto(Bib.ift(QNFE_EmiteItVAL_DESCONTO_TOTAL.Value > 0,
                   QNFE_EmiteItVAL_DESCONTO_TOTAL.Value * 100/QNFE_EmiteItVAL_TOTAL.Value,0.00), 2, 10)+ '%')
                   +
                   Bib.NumToTexto((wVlUnitario * QNFE_EmiteITQT_Quantidade.Value), 2, 10),70),
                   Bib.FormataTextoEsq(Bib.NumToTexto(wVlUnitario, 2, 10) +
                   '                                      ' +
                   Bib.NumToTexto((wVlUnitario * QNFE_EmiteITQT_Quantidade.Value), 2, 10),80))+chr(13)+chr(10);

      wImpressao := wImpressao + wLinha;
      QNFE_EmiteIT.Next;
    end;
    if (DMParamSistema.CodEmpresa <> 'BAZAR') then//    if (DMParamSistema.CodEmpresa <> 'OSARE') then //Keli solicitou para aparecer a QTDE de Itens. Junior 20/09/2018
    begin
      wImpressao := wImpressao +  '____________'+chr(13)+chr(10);
      wImpressao := wImpressao +  Bib.NumToTexto(wQuant, 2, 10)+chr(13)+chr(10);
    end;
