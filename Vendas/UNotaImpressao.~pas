        end;
        QNFE_EmiteIT.Next;
        if wContLinha >= 15 then
        begin
          wCont := 42;
          Imp.WriteXY(15.4, wCont, 'CONTINUA');
          wNotaGlobal := 1;
          Imp.SaltaPagina;
          Break;
        end;
      end;
    end;
    // Fim do Controle de Continuação
    if QNFE_EmiteVal_Desconto.Value > 0 then
