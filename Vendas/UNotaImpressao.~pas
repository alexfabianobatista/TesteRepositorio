  Imp.WriteXY(8, wCont, 'Vendedor....: ' + DMNotaSaida.QNFE_EmiteNOME_VENDEDOR.Text);
  wCont := wCont + 1;
  If DMNotaSaida.QNFE_EmiteIND_CONDICAO_PAGTO.Value = '1' Then
     wCondicao := 'A Vista'
  Else
    If DMNotaSaida.QNFE_EmiteIND_CONDICAO_PAGTO.Value = '2' Then
       wCondicao := 'A Prazo'
    Else
      If DMNotaSaida.QNFE_EmiteIND_CONDICAO_PAGTO.Value = '3' Then
         wCondicao := 'Conta Corrente';

  Imp.WriteXY(0, wCont, 'Condicao.....: '+wCondicao);
  Imp.WriteXY(8, wCont, 'Condicao....: '+wCondicao);
  wCont := wCont + 1;
  Imp.WriteXY(0, wCont, 'Vendedor.....: ' + DMNotaSaida.QNFE_EmiteNOME_VENDEDOR.Text);
  Imp.WriteXY(8, wCont, 'Entregue por: ');
  Inc(wCont);
  Imp.WriteXY(0, wCont, '______________________________________________________________________________________________________________________________________');
  wCont := wCont + 1;
  Imp.WriteXY(0, wCont, 'Item         Qtde            Total');
  Imp.WriteXY(8, wCont, 'Item Código  Descrição                   Loc       Qtde    Marca           E1');
  wCont := wCont + 1;
  Imp.WriteXY(0, wCont, '______________________________________________________________________________________________________________________________________');

  DMNotaSaida.QNFE_EmiteIt.First;
  wNumItem := 0;
  wtotal_produtos := 0;
  while not DMNotaSaida.QNFE_EmiteIT.Eof do
  begin
    inc(wNumItem);
    Inc(wCont);
    Imp.WriteXY(0, wCont, DMNotaSaida.QNFE_EmiteITCod_Produto.Text);
    Imp.WriteXY(1.8, wCont, Bib.NumToTexto(DMNotaSaida.QNFE_EmiteITQT_Quantidade.Value,0, 5));
    Imp.WriteXY(3.5, wCont, Bib.NumToTexto(DMNotaSaida.QNFE_EmiteITVal_Total.Value, 2, 10));
    Imp.WriteXY(8, wCont, IntToStr(wNumItem));
    Imp.WriteXY(9, wCont, DMNotaSaida.QNFE_EmiteITCod_Produto.Text);
    Imp.WriteXY(10, wCont, (Copy(DMNotaSaida.QNFE_EmiteITDesc_Produto.Text, 1, 25)));
    Imp.WriteXY(14, wCont, (Copy(DMNotaSaida.QNFE_EmiteITDesc_Localizacao.Text, 1, 10)));
    Imp.WriteXY(15.3, wCont, Bib.NumToTexto(DMNotaSaida.QNFE_EmiteITQT_Quantidade.Value,0, 5));
    Imp.WriteXY(16.7, wCont, (Copy(DMNotaSaida.QNFE_EmiteITDesc_Marca.Text, 1, 7)));
    wEstoque := StrToFloat('0'+DMOracle.BuscaNome('SELECT QT_QUANTIDADE FROM TB_ESTOQUE',
    'COD_PRODUTO = ' + DMNotaSaida.QNFE_EmiteITCod_Produto.Text
    + ' AND COD_FILIAL = ' + DMNotaSaida.QNFE_EmiteCod_Filial.Text));
    Imp.WriteXY(18.5, wCont, Bib.NumToTexto(wEstoque,0, 5));
    wTotal_Produtos := wTotal_Produtos + DMNotaSaida.QNFE_EmiteITQT_Quantidade.Value;
    DMNotaSaida.QNFE_EmiteIt.Next;
  end;
  Inc(wCont);
  Imp.WriteXY(0, wCont, '______________________________________________________________________________________________________________________________________');
  Inc(wCont);
  Imp.WriteXY(0, wCont, 'Total Itens:'+Bib.NumToTexto(wtotal_produtos,0, 5));
  Imp.WriteXY(13, wCont, 'Total Itens:'+Bib.NumToTexto(wtotal_produtos,0, 5));
  Inc(wCont);
  Imp.WriteXY(13, wCont, 'Revisado por:___________________________');
  Inc(wCont, 2);
  Imp.WriteXY(0, wCont, '________________________________________');
  Inc(wCont, 1);
  Imp.WriteXY(0, wCont, 'Assine para confirmar pedido');
End;


