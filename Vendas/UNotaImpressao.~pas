        if (QNFE_EmiteIND_CONDICAO_PAGTO.Value = '2') then
        begin
          QRLPagar.Enabled := True;
          QRBand1.Height  := 222;
          QRM1.Lines.Append('Parcelas');
          QRM2.Lines.Append('Vencimento');
          QRM3.Lines.Append('Valor');

          QContaReceber.Open;
          QContaReceber.First;
          while not QContaReceber.Eof do
