      Inc(wCont);
      Imp.WriteXY(0.5, wCont, 'DESCONTO: ' + Bib.NumToTexto(QNFE_EmiteVal_Desconto.Value, 2, 13));
    end;
    // Fim dos Item de Produto
    IMP_OBS_CORPO_NOTA(1, wCont);
