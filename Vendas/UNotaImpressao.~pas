function TFNotaImpressao.EmiteNF(wCodNF: Integer; wTipo: string = ''
  ; IdLote: Int64 = 0
  ; EnviarNFe: Boolean = False): boolean; //wTipo serve para nao exibir tela FTipoNota
var wTipoDocumento, wLpt_Pedido, wComando, wChaveAcesso, wTipoNota: string;
  RDPrint: TRDprint;
begin
  // *** Emissão de Nota Fiscal *** \\

  wEmpresa := DMParamSistema.QParamSistemaCOD_EMPRESA.Value;
  wTipoDocumento := DMOracle.BuscaNome('SELECT IND_EMITE FROM TB_OPERACAO, TB_NOTA_CAB',
    'TB_NOTA_CAB.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
    + ' AND TB_NOTA_CAB.COD_NOTA_CAB = ' + FloatToStr(wCodNF));
  if wTipoDocumento = 'N' then //Se operacao nao emite nada, sai da procedure. Diego A. S.
    Exit;
  DMNotaSaida.SetaEmissao(wCodNF);
  wLpt_Nota := DMOracle.BuscaNome('SELECT DESC_LPT_NOTA FROM TB_FILIAL', 'COD_FILIAL = ' + FloatToStr(DMNotaSaida.QNFE_EmiteCod_Filial.Value));
  wLpt_Pedido := DMOracle.BuscaNome('SELECT DESC_LPT_PEDIDO FROM TB_FILIAL', 'COD_FILIAL = ' + FloatToStr(DMNotaSaida.QNFE_EmiteCod_Filial.Value));
  if DMNotaSaida.QNFE_EmiteIND_SITUACAO.Value <> '2' then
    raise Exception.Create('Esta Nota não foi confirmada!');
  wMensCorpoNota := 'N';
  wPeso := 0; // inicializa variavel utilizado na procedure calc_Peso_nota
  wPesoBruto := 0;
  wDesc_Transgenicos := 0;
  if DMNotaSaida.QNFE_EmiteInd_Entrada_Saida.Value = 'E' then
  begin
    wbase_icm_tributada := DMNotaEntrada.QSomaItemNotaSVal_ICM_Base.Value;
    wvlr_icm := DMNotaEntrada.QSomaItemNotaSVal_ICM.Value;
    wtotal_produtos := DMNotaEntrada.QSomaItemNotaSVal_Total.Value;
    wvlr_ipi := DMNotaEntrada.QSomaItemNotaSVal_Ipi.Value;
    wDesc_Transgenicos := DMNotaEntrada.QSomaItemNotasVal_Dpi_Transgenicos.Value;
    wBase_Subst := 0;
    wIcms_Subst := 0;
    wTotalDescontos := DMNotaSaida.QNFE_EmiteVAL_DESCONTO.Value;
  end
  else
  begin
//    DMNotaSaida.QNotaSaida.Close;
    DMNotaSaida.QSomaItemNota.Close;
    DMNotaSaida.QSomaItemNota.Master := nil; // FEITO PELO CESAR PARA NAO ACESSAR O QNOTASAIDA (ESTAVA DANDO OPEN)
    DMNotaSaida.QSomaItemNota.MasterFields := '';
    DMNotaSaida.QSomaItemNota.DetailFields := '';
    DMNotaSaida.QSomaItemNota.SetVariable('COD_NOTA_CAB', DMNotaSaida.QNFE_EmiteCOD_NOTA_CAB.Value);
//    DMNotaSaida.QNotaSaida.Open;
    DMNotaSaida.QSomaItemNota.Open;
    wbase_icm_tributada := DMNotaSaida.QSomaItemNotaSVal_ICM_Base.Value;
    wvlr_icm := DMNotaSaida.QSomaItemNotaSVal_ICM.Value;
    wtotal_produtos := DMNotaSaida.QSomaItemNotaSVal_Total.Value;
    wDescontoItens := DMNotaSaida.QSomaItemNotaSVAL_DESCONTO_ITEM.Value;
    wTotalDescontos := DMNotaSaida.QSomaItemNotaSVAL_DESCONTO.Value;
    wvlr_ipi := DMNotaSaida.QSomaItemNotaSVal_Ipi.Value;
    wBase_Subst := DMNotaSaida.QSomaItemNotaSVal_Base_Subst.Value;
    wIcms_Subst := DMNotaSaida.QSomaItemNotaSVal_Icms_Subst.Value;
    wTotalDespesas := DMNotaSaida.QSomaItemNotaSVal_Despesas.Value;
    DMNotaSaida.QSomaItemNota.Close;
    DMNotaSaida.QSomaItemNota.Master := DMNotaSaida.QNotaSaida;
    DMNotaSaida.QSomaItemNota.MasterFields := 'COD_NOTA_CAB';
    DMNotaSaida.QSomaItemNota.DetailFields := 'COD_NOTA_CAB';
  end;
  wCod_Mens := '';
  if Imp = nil then
    Imp := TImp.Create;
  if wTipoDocumento = 'F' then // Nota Fiscal
  begin
    wTipoNota := DMNotaSaida.QNFE_EmiteCOD_SERIE_MODELO.Value;

    if (wTipoNota = '55') or (wTipoNota = '65') or (wTipoNota = '98') then
    begin
      with DMNotaSaida do
      begin
        if QNotaSaidaCOD_SERIE_MODELO.Value = '65' then
        begin
          QNotaSaida.RefreshRecord;
          if FechaNFCe then
            result := DMNfe.EmissaoNfe(QNFE_EmiteCOD_NOTA_CAB.Value, IdLote, EnviarNFe);
          QNotaSaida.RefreshRecord;
        end
        else
          result := DMNfe.EmissaoNfe(QNFE_EmiteCOD_NOTA_CAB.Value, IdLote, EnviarNFe);
        QNFE_Emite.Close;
        QNFE_Emite.Open;
        DMNfe.SetaNfe(QNFE_EmiteDESC_CHAVE_ACESSO.Value,True);
        if StrToInt('0' + DMNfe.QNfeSIT_NFE.Value) in [100, 149] then
        begin
          if (RoundTo(QSomaPagamentosVAL_TEF.Value,-2) > 0) then
            ImprimeComprovantesTEF;
          if RoundTo(pValorNovoValeCompras + pValorNovoValePresente,-2) > 0 then
            EmiteNovoValeProduto;
        end;
        Exit;
      end;
    end
    else
    begin
      if Trim(wLpt_Nota) = 'LPT1' then
        Imp.AbreImpressora
      else
        if Trim(wLpt_Nota) = 'LPT2' then
          Imp.AbreImpressora_Lpt2
        else
          Imp.AbreImpressora_Com2;
      //Imp.ConfiguraImpressora('CONDENSADO_ON','SEXTOS',66);
      if wEmpresa = 'NIR' then
      begin
        Imp.ConfiguraImpressora('CONDENSADO_ON', 'OITAVOS', 66);
        FNotaImpressao.NF_NIR;
      end;
      if wEmpresa = 'FAZENDA1' then
      begin
        if FNotaRDPrint = nil then
          FNotaRDPrint := TFNotaRDPrint.Create(Application);
        RDPrint := TRDPrint.Create(FNotaRDPrint);
        EmiteNFRDPrint(wCodNF, RDPrint);
      end;
      if ((wEmpresa = 'LACTOMIL') and (DMNotaSaida.QNotaSaidaCOD_OPERACAO.Value = 27)) then
      begin
        Imp.ConfiguraImpressora('CONDENSADO_ON', 'OITAVOS', 68);
        FNotaImpressao.NF_LACTOMIL;
      end;
    end;
    try
      with DMOracle do
      begin
        QExecSQL.Close;
        QExecSQL.SQL.Clear;
        wComando := 'UPDATE TB_NOTA_CAB SET IND_TIPO_NOTA = ' + QuotedStr(wTipoNota) + ', ';
        wComando := wComando + ' DESC_CHAVE_ACESSO = ' + QuotedStr(wChaveAcesso) + ' WHERE ' +
          'COD_NOTA_CAB = ' + IntToStr(wCodNF);
        QExecSQL.SQL.Add(wComando);
        QExecSQL.ExecSQL;
        if (DMOracle.DBCemapa.InTransaction)  then
          DMOracle.DBCemapa.Commit;
      end;
    except
      DMOracle.DBCemapa.Rollback;
      MessageDlg('Atenção!' + #13 + #10 + 'Não foi possível gerar a chave de acesso da nota número ' + IntToStr(wCodNF) + '.' +
        #13 + #10 + 'Por favor, faça a reemissão desta nota.' +
        #13 + #10 + 'Se o problema persistir, entre em contato com a Cemapa: (45) 3264-3773.' +
        #13 + #10 + '' + #13 + #10 + 'Nos desculpamos por quaisquer transtornos.' +
        #13 + #10 + 'Obrigado.', mtError, [mbOK], 0);
    end;
  end // Nota Fiscal
  else
  begin

    if ((DMNotaSaida.QNFE_EmiteIND_IMPRIME_PEDIDO.Value <> 'DESKJET') and (DMNotaSaida.QNFE_EmiteIND_IMPRIME_PEDIDO.Value <> 'EXCEL') and
       (wTipoDocumento <> 'R')) then
    begin
      if (Trim(wLpt_Pedido) = 'LPT1') Or
         (wTipo = 'ESTOQUE')         then
        Imp.AbreImpressora
      else if (Trim(wLpt_Pedido) = 'LPT2') And
              (wTipo <> 'ESTOQUE')         then
        Imp.AbreImpressora_Lpt2
      else
        Imp.AbreImpressora_Com2;
      Imp.ConfiguraImpressora('CONDENSADO_ON', 'SEXTOS', 33);
    end;
    if (wTipoDocumento = 'P') then // Pedido
      If wTipo <> 'ESTOQUE' Then
      begin
        if (DMParamSistema.CodEmpresa = 'FURGOESMED') then
        begin //Confirmação para imprimir. Solicitado por Fábio (Furgoes Medianeira)
              //Alteram muitas O.S após fechada fazendo imprimir muitos formulários sem serventia. Junior 17/08/2017
          if (MessageDlg('Deseja imprimir?', mtConfirmation, [mbYes, mbNo], 0) = mrYes) then
          begin
            Imp.ConfiguraImpressora('CONDENSADO_ON', 'OITAVOS', 68);
            FNotaImpressao.NF_FURGOES;
          end
          else
            Exit;
        end
        else
          EmitePedido('Pedido:');
      end
      Else
        Emite_Pedido_Inside;
    if (wTipoDocumento = 'O') then // Orçamento
      EmitePedido('Orçamento:');
    if (wTipoDocumento = 'R') then // Pedido 40 colunas //Imprimir por Tipo Doc. da Operação para Pixixe Fabrica - Junior 07/02/2018
      if (DMNotaSaida.QNFE_EmiteIND_IMPRIME_PEDIDO.Value = 'DESKJET') or (DMParamSistema.CodEmpresa = 'PIXIXE_FAB') then
      begin
        with DMNotaSaida do
        begin
          QSomaPagamentos.Close;
          QSomaPagamentos.Open;
          Result := QSomaPagamentosVAL_TEF_NAO_PROCESSADO.Value <= 0.001;
          if QSomaPagamentosVAL_TEF_NAO_PROCESSADO.Value > 0.001 then
          begin
            //Guarda no registro o códiogo da filial
            //para o caso de dar erro na impressão do TEF
            Registry := TRegistry.Create;//executa o tregistry
            Registry.RootKey:=HKEY_CURRENT_USER; //abre a chave mestra
            Registry.OpenKey('SOFTWARE\CemapaSistema',true);
            Registry.WriteString('FilialTEF',QNotaSaidaCOD_FILIAL.Text);

            if FTef = nil then
              FTef := TFTef.Create(Application);

            FTEF.Modalidade := 2;
            FTEF.ValorTransacao := DMNotaSaida.QSomaPagamentosVAL_TEF_NAO_PROCESSADO.Value;
            FTEF.NumNota := QNotaSaidaNUM_NOTA.Text;
            FTEF.CodNotaCab := QNotaSaidaCOD_NOTA_CAB.Value;
            FTEF.btIniciaTef.Visible := true;
            if FTEF.Comprovantes = nil then
              FTEF.Comprovantes := TStringList.Create;
            FTEF.lbMensagem.Caption := '';
            FTEF.ValorDinheiro := 0;
            FTEF.ValorDesconto := 0;
            FTEF.IndNFCe := True;

            Result := FTEF.ShowModal = mrOk;
            if Result then
            begin
              with DMTEF do
              begin
                if not QTefCab.Eof then
                begin
                  QTefCab.Edit;
                  QTefCabIND_STATUS.Value := 'PENDENTE';
                  QTefCabDT_EMISSAO.Value := Now;
                  QTefCab.Post;
                end;
              end;
            end
            else
            begin
              FTEF.Finaliza(FINALIZA_CANCELANDO);
              MessageDlg('Transação TEF não foi efetuada.', mtError, [mbOK], 0);
            end;
          end;

          if result then
          begin
            if (DMParamSistema.CodEmpresa = 'MAVENIDA')  or (DMParamSistema.CodEmpresa = 'NFCE-PALAD') or (DMParamSistema.CodEmpresa = 'NFCE-DOCES') or
               (DMParamSistema.CodEmpresa = 'MODASUL')   or (DMParamSistema.CodEmpresa = 'INSIDE')     or (DMParamSistema.CodEmpresa = 'JASOL')      or
               (DMParamSistema.CodEmpresa = 'DONABENTA') or (DMParamSistema.CodEmpresa = 'NFCE-ITALI') or (DMParamSistema.CodEmpresa = 'LACARNES')   or
               (DMParamSistema.CodEmpresa = 'DONNA')     or (DMParamSistema.CodEmpresa = 'NFCE-DOGAO') or (DMParamSistema.CodEmpresa = 'PRAIASMI')   or
               (DMParamSistema.CodEmpresa = 'BRASIL')    or (DMParamSistema.CodEmpresa = 'NFCE-ANJO')  or (DMParamSistema.CodEmpresa = 'FINESTRA')   or
               (DMParamSistema.CodEmpresa = 'BEBIDAS') then
              EmitePedido40ColunasTermica
            else if (DMParamSistema.CodEmpresa = 'BORRIFAR') then
              EmitePedido30Colunas
            else
              EmitePedido_Bobina_Termica;
            QSomaPagamentos.Refresh;
            if (RoundTo(QSomaPagamentosVAL_TEF.Value,-2) > 0) then
              ImprimeComprovantesTEF;
          end;
        end;
      end
      else
      begin
        if (Trim(wLpt_Pedido) = 'LPT1') then
          Imp.AbreImpressora
        else if (Trim(wLpt_Pedido) = 'LPT2') then
          Imp.AbreImpressora_Lpt2
        else if (Trim(wLpt_Pedido) = 'LPT3') then
          Imp.AbreImpressora_Lpt3;
        EmitePedido_Bobina;
      end;
    if (wTipoDocumento = 'Z') then // Pedido novo
      EmitePedido_Novo;
  end;
  if (wTipoDocumento[1] in ['P', 'O', 'F', 'R', 'Z']) and not ((wTipoDocumento = 'F') and
    ((wTipoNota = 'ELETRONICA') or (wTipoNota = '55'))) then
    if (wTipoDocumento[1] <> 'P') or (DMNotaSaida.QNFE_EmiteIND_IMPRIME_PEDIDO.Value <> 'DESKJET') and (DMNotaSaida.QNFE_EmiteIND_IMPRIME_PEDIDO.Value <> 'EXCEL') then
      if wEmpresa <> 'FAZENDA1' then
      begin //adicionado o if para imprimir PEDIDOS na impressora termica. - Junior - 29/07/2015 -
        if (wTipoDocumento[1] = 'R') and ((DMNotaSaida.QNFE_EmiteIND_IMPRIME_PEDIDO.Value = 'DESKJET') or (DMParamSistema.CodEmpresa = 'PIXIXE_FAB') ) then
          Application.ProcessMessages //Imprimir por Tipo Doc. da Operação para Pixixe Fabrica - Junior 07/02/2018
        else
        begin
          Imp.SaltaPagina;
          Imp.ConfiguraImpressora('CONDENSADO_OFF', 'SEXTOS', 66);
          Imp.FechaImpressora; // Finaliza os serviços de Impressao
        end;
      end;
  
  if DMNotaSaida.QNFE_EmiteIND_SITUACAO.Value = '2' then
    if RoundTo(DMNotaSaida.QSomaValessval_novo_vale_compras.Value + DMNotaSaida.QSomaValessval_novo_vale_presente.Value,-2) > 0 then
      EmiteNovoValeProduto;
  with DMNotaSaida do
  begin
    QNFE_Emite.Close;
    QNFE_EmiteIT.Close;
  end;
  result := true;
end;

procedure TFNotaImpressao.EmiteCabecalho(wCodNota : Integer);
Begin
  if Imp = nil then
    Imp := TImp.Create;
  DMNotaSaida.SetaEmissao(wCodNota);

  wLpt_Nota := DMOracle.BuscaNome('SELECT DESC_LPT_NOTA FROM TB_FILIAL', 'COD_FILIAL = ' + FloatToStr(DMNotaSaida.QNFE_EmiteCod_Filial.Value));

  if Trim(wLpt_Nota) = 'LPT1'  then
    Imp.AbreImpressora
  else
    if Trim(wLpt_Nota) = 'LPT2' then
      Imp.AbreImpressora_Lpt2
    else
      Imp.AbreImpressora_Com2;

  Imp.ConfiguraImpressora('CONDENSADO_OFF', 'SEXTOS', 66);

  FNotaImpressao.NF_CABECALHO;

  Imp.SaltaPagina;
  Imp.ConfiguraImpressora('CONDENSADO_OFF', 'SEXTOS', 66);
  Imp.FechaImpressora; // Finaliza os serviços de Impressao

  with DMNotaSaida do
  begin
    QNFE_Emite.Close;
    QNFE_EmiteIT.Close;
  end;

End;

procedure TFNotaImpressao.EmiteComprovanteEntrega(pPagto, pProximo: string);
begin
  if Imp = nil then
    Imp := TImp.Create;
  Imp.AbreImpressora;
  with DMNotaSaida do
  begin
    QNFE_Emite.Close;
    QNFE_Emite.SetVariable('Cod_Nota_Cab', QNFE_EmiteCod_Nota_Cab.Value);
    QNFE_Emite.Open;
    wCont := 0;
    Imp.WriteXY(0, wCont, QNFE_EmiteNOME_FILIAL.Value);
    Inc(wCont);
    Imp.WriteXY(0, wCont, Trim(QNFE_EmiteCOD_CADASTRO.Text) + ' ' + QNFE_EmiteNOME.Value);
    Inc(wCont);
    if DMNotaSaida.QNFE_EmiteDESC_FANTASIA.Value <> '' then
    begin
      Imp.WriteXY(0, wCont, QNFE_EmiteDESC_FANTASIA.Value);
      Inc(wCont);
    end;
    Imp.WriteXY(0, wCont, QNFE_EmiteDESC_ENDERECO.Value);
    Inc(wCont);
    Imp.WriteXY(0, wCont, QNFE_EmiteDESC_BAIRRO.Value);
    Inc(wCont);
    Imp.WriteXY(0, wCont, QNFE_EmiteDESC_CIDADE.Text + ' ' + QNFE_EmiteCOD_ESTADO.Text + ' ' + QNFE_EmiteDESC_TELEFONE.Text);
    Inc(wCont);
    Imp.WriteXY(0, wCont, 'Emissao:');
    Imp.WriteXY(1.5, wCont, QNFE_EmiteDT_EMISSAO.Text);
    Imp.WriteXY(3, wCont, 'PEDIDO NUM.:');
    Imp.WriteXY(5, wCont, QNFE_EmiteNUM_NOTA.Text);
    Inc(wCont);
    Imp.WriteXY(0, wCont, '________________________________________');
    Inc(wCont);
    Imp.WriteXY(0, wCont, 'Proximo a:' + pProximo);
    Inc(wCont);
    Imp.WriteXY(0, wCont, 'Observacao:' + pPagto);
    wCont := wCont + 6;
    Imp.WriteXY(0, wCont, '');
  end;
  Imp.FechaImpressora; // Finaliza os serviços de Impressao
end;

procedure TFNotaImpressao.NF_NIR;
var wContServico: Byte;
  wTotalISS, wTotalServico: Real;
begin
  // *** Emissão de Nota Fiscal para a NIR Informatica
  // *** OBS - Colocar Posicao X em Centimetros
  // *** wNotaGlobal Controla a quebra de continuação
  wTotalISS := 0;
  wTotalServico := 0;
  with DMNotaSaida do
  begin
    wNotaGlobal := 0;
    wCont := 0; // INICIALIZA VALOR DA VARIAVEL - Robson 26/06/2000
    while wNotaGlobal < 2 do
    begin
      wCont := 0;
      if wNotaGlobal = 1 then
        Imp.WriteXY(9.5, wCont, 'CONTINUACAO');
      WnotaGlobal := 2;
      if QNFE_EmiteInd_Entrada_Saida.Value = 'S' then
        Imp.WriteXY(11.5, wCont, 'X')
      else
        Imp.WriteXY(14.0, wCont, 'X');
      Imp.WriteXY(16.2, wCont, Bib.NumToTexto(QNFE_EmiteNUM_NOTA.Value, 0, 8));
      wCont := wCont + 5;
      Imp.WriteXY(0.2, wCont, QNFE_EmiteNAT_OPERACAO.Value);
