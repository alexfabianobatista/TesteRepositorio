  object QCupomFiscalCab: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  ROWID,'
      #9'COD_NOTA_CAB,'
      #9'COD_USUARIO,'
      #9'COD_FILIAL,'
      #9'COD_OPERACAO,'
      #9'COD_ESTADO,'
      #9'COD_VENDEDOR,'
      #9'COD_CADASTRO,'
      #9'TRUNC(NUM_NOTA) AS NUM_NOTA,'
      #9'COD_SERIE,'
      #9'IND_SITUACAO,'
      #9'IND_CONDICAO_PAGTO,'
      #9'DT_EMISSAO,'
      #9'DT_MOVIMENTO,'
      '  '#9'DT_RECEBIMENTO,'
      #9'VAL_DESPESAS,'
      #9'IND_ENTRADA_SAIDA,'
      #9'VAL_FRETE,'
      #9'VAL_DESCONTO,'
      #9'OBS_COMPLEMENTO,'
      #9'DT_USUARIO,'
      #9'VAL_ICM_FRETE,'
      #9'VAL_ICM_BASE_FRETE,'
      #9'VAL_FUNRURAL,'
      #9'DESC_PLACA,        '
      #9'NUM_KM,'
      #9'COD_SERIE_MODELO,'
      '  '#9'IND_CUPOM_TOTALIZADO,'
