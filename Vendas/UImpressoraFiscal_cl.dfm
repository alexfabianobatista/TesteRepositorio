  object QRIdentificEmpresa: TOracleDataSet1
    SQL.Strings = (
      'SELECT '
      '  REGEXP_REPLACE(F.NUM_CGC, '#39'[^0-9]'#39', '#39#39') as NUM_CGC,'
      '  F.DESC_INSCRICAO as DESC_INSCRICAO,'
      
