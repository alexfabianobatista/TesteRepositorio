  object QR01: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  ECF.DESC_MARCA,'
      '  ECF.DESC_MODELO,'
      '  ECF.DESC_TIPO,'
      
        '  TO_CHAR(ECF.DT_HORA_INSTALACAO_SB, '#39'YYYYMMDD'#39') AS DT_INSTALACA' +
        'O_SB,'
      
        '  TO_CHAR(ECF.DT_HORA_INSTALACAO_SB, '#39'HH24MISS'#39') AS HORA_INSTALA' +
        'CAO_SB,'
      '  ECF.IND_MF_ADICIONAL,'
      '  ECF.NUM_SEQ_ECF,'
      '  ECF.NUM_SERIE,'
      '  ECF.NUM_VERSAO_SB,'
