      '  F.DESC_INSCRICAO,'
      '  F.DESC_HASH_MD5 AS DESC_HASH_MD5_FILIAL'
      'FROM'
      '  TB_ECF ECF'
      'INNER JOIN TB_FILIAL F ON'
      '  F.COD_FILIAL = :FILIAL'
      'WHERE'
      '  (:NUM_SERIE IS NULL OR'
      '  ECF.NUM_SERIE = :NUM_SERIE)'
