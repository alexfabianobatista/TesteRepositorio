procedure TBibVenda.PersonalizaPagamento(var wRadioGroup: TDBRadioGroup);
begin
  if DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'SONOBOM' then
    wRadioGroup.Items.Delete(
      wRadioGroup.Items.IndexOf('OUTROS')
    );
end;

function TBibVenda.ImportaPedidoExcelRetifoz(wQPedido,  wQPedItem: TOracleDataSet1; ArquivoXLS: string): Boolean;
const
   xlCellTypeLastCell = $0000000B;
var
   XLSAplicacao, AbaXLS: OLEVariant;
   wCodProd, maxLinha, maxColuna, i, wCodigo, wCodTributacao,
   wCodTribProduto, wCodTribEstado : Integer;
   wCnpj, wCodCadastro, wCodEstado, wCodEstadoCad, wCodEstadoFilial , wObs: string;
begin
   Result := False;
   // Cria Excel- OLE Object
   XLSAplicacao := CreateOleObject('Excel.Application');
   with DMOracle do
   begin
    try
      // Esconde Excel
        XLSAplicacao.Visible := False;
        // Abre o Workbook
        XLSAplicacao.Workbooks.Open(ArquivoXLS);

        {Selecione aqui a aba que você deseja abrir primeiro - 1,2,3,4....}
        XLSAplicacao.WorkSheets[1].Activate;
        {Selecione aqui a aba que você deseja ativar - começando sempre no 1 (1,2,3,4) }
        AbaXLS := XLSAplicacao.Workbooks[ExtractFileName(ArquivoXLS)].WorkSheets[1];

        AbaXLS.Cells.SpecialCells(xlCellTypeLastCell, EmptyParam).Activate;
        // Pegar o número da última linha
        maxLinha := XLSAplicacao.ActiveCell.Row - 1;
        // Pegar o número da última coluna
        maxColuna := XLSAplicacao.ActiveCell.Column;

        // Associaca a variant WorkSheet com a variant do Delphi
        //RangeMatrix := XLSAplicacao.Range['A1', XLSAplicacao.Cells.Item[x, y]].Value;




        wCnpj := Bib.LimpaString(Bib.LimpaString(Bib.LimpaString(XLSAplicacao.Cells.Item[3, 2].Value, '.'), '/'), '-'); //CNPJ EM B3 [LINHA 3 , COLUNA B]
        wCodCadastro := DmOracle.FastSelect('COD_CADASTRO', 'TB_CADASTRO','LIMPA_CNPJ(NUM_CGC_CPF) = '+ QuotedStr(wCnpj));

        if (wCodCadastro = '' ) or (wCodCadastro = null) then
        begin
          result := false;
          Raise Exception.Create('Cliente não encontrado, por favor, cadastrar o cliente antes de importar');
        end;

        wObs :=  Concat(XLSAplicacao.Cells.Item[4, 1].Value, ' ', XLSAplicacao.Cells.Item[4, 2].Value);

        wQPedido.Close;
        wQPedido.Open;
        wQPedido.Append;

        wCodigo := wQPedido.FieldByName('COD_PEDIDO_CAB').Value;

        wCodEstadoFilial := FastSelect('COD_ESTADO', 'TB_FILIAL', 'COD_FILIAL = ' + IntToStr(DMUsuario.CodFilialUsuario));
        wCodEstadoCad :=  FastSelect('COD_ESTADO', 'TB_CADASTRO', 'COD_CADASTRO = ' + wCodCadastro);
        if  wCodEstadoFilial <>  wCodEstadoCad then
          wCodTribEstado :=  StrToInt(FastSelect('PERC_TRIBUTACAO', 'TB_ESTADO', 'COD_ESTADO = ' + QuotedStr(wCodEstadoCad)));

        wQPedido.FieldByName('COD_CADASTRO').Text := wCodCadastro;
        wQPedido.FieldByName('COD_OPERACAO').Value := DMUsuario.CodOperacaoPadrao;
        wQPedido.FieldByName('COD_FILIAL').Value := DMUsuario.CodFilialUsuario;
        wQPedido.FieldByName('NUM_PEDIDO').Value := DMSequencia.Sequencia(DMUsuario.CodFilialUsuario, 'PEDIDO');
        wQPedido.FieldByName('IND_TIPO_PAGAMENTO').Value := 'A PRAZO';
        wQPedido.FieldByName('DT_EMISSAO').Value := Now;
        wQPedido.FieldByName('DESC_OBSERVACAO').Value := wObs;
        wQPedido.Post;
        wQPedido.Edit;

        wQPedItem.Close;
        wQPedItem.ClearVariables;
        wQPedItem.SetVariable('COD_PEDIDO_CAB', wCodigo);
        wQPedItem.Open;

         for i:= 11 to maxLinha do
        begin
          if Trim(XLSAplicacao.Cells.Item[I, 3].Value) <> 'TOTAL R$' then
          begin
            wQPedItem.Append;



            wQPedItem.FieldByName('COD_PEDIDO_CAB').Value := wCodigo;
            //PARA TESTES
            {wCodProd := StrToInt(DmOracle.FastSelect('COALESCE((SELECT COD_PRODUTO FROM TB_PRODUTO WHERE NUM_FABRICANTE = '
                                                              + QuotedStr(XLSAplicacao.Cells.Item[I, 2].Value)
                                                              + '), 1)', 'DUAL','')); }
            wCodProd := StrToInt(FastSelect('COALESCE((SELECT COD_PRODUTO FROM TB_PRODUTO WHERE NUM_FABRICANTE = '
                                                              + QuotedStr(XLSAplicacao.Cells.Item[I, 2].Value)
                                                              + '), 1)', 'DUAL',''));

            wCodTribProduto := StrToInt(FastSelect('COD_TRIBUTACAO', 'TB_PRODUTO', 'COD_PRODUTO = ' + IntToStr(wCodProd)));


            wQPedItem.FieldByName('COD_PRODUTO').Value := wCodProd;
            wQPedItem.FieldByName('COD_TRIBUTACAO').Value  := IfThen(wCodEstadoCad <> wCodEstadoFilial, wCodTribEstado, wCodTribProduto);
            DmOracle.FastSelect('COD_TRIBUTACAO', 'TB_PRODUTO','COD_PRODUTO = '+ IntToStr(wCodProd));
            wQPedItem.FieldByName('QT_PEDIDO').Text :=  XLSAplicacao.Cells.Item[I, 1].Value;
            wQPedItem.FieldByName('VAL_UNITARIO').Text :=  XLSAplicacao.Cells.Item[I, 3].Value;
            wQPedItem.Post;
          end
          else
          begin
            wQPedItem.Refresh;
            wQPedido.Refresh;

            // Fecha o Microsoft Excel
            if not VarIsEmpty(XLSAplicacao) then
            begin
              XLSAplicacao.Workbooks.Close;
              XLSAplicacao.Quit;
              AbaXLS := Unassigned;
              XLSAplicacao := Unassigned;

              Result := True;
            end;

            exit;

          end
        end;

        wQPedItem.Refresh;
        wQPedido.Refresh;      
      finally
          // Fecha o Microsoft Excel
          if not VarIsEmpty(XLSAplicacao) then
          begin
                XLSAplicacao.Workbooks.Close;
                XLSAplicacao.Quit;
                AbaXLS := Unassigned;
                XLSAplicacao := Unassigned;
                Result := True;
          end;
      end;
    end;
end;
end.


