procedure TFNotaConsum_Confirma.Finaliza;
var wTotal_Desconto, wEntrada: Real;
  wAVista, wLibera_Bloqueto, wPrazo, wResult, wNome_Recibo: string;
  x, y: array of string;
  wLote, i: Integer;
  wDescontoAcrescimo, wTotal: Double;
  // Para o pix
  vDigCpfCnpj, iItem, wBanco : integer;
  aCpfCnpj, aCodBarra, aProduto, wPadrao, wComando: string;
label
  lDispensaQrCode;
begin
  FNotaImpressao := TFNotaImpressao.Create;
  if StrToFloat(MEValorDesconto.Text) > DMNotaSaida.QSomaItemNotaSVal_Total_Nota.Value then
    raise Exception.Create('Valor de Desconto maior que o valor da nota!');

  wTotal_Desconto := 0; // INICIALIZA VALOR DA VARIAVEL - Robson 26/06/2000
  wTotal := StrToFloat(Trim(Bib.LimpaString(EdVenda.Text, '.')));
  wDescontoAcrescimo := RoundTo(DMNotaSaida.QSomaItemNotaSVal_Total_Nota.Value, -2) - RoundTo(wTotal, -2)
    - DMNotaSaida.QSomaValessval_vale_compras_menos_novo.Value - DMNotaSaida.QSomaValessval_vale_presente_menos_novo.Value;
  wEntrada := StrToFloat(Bib.LimpaString(MeEntrada.Text, '.'));
  try
    with DMNotaSaida do
    begin
      QItemNF.AutoCalcFields := False;
      QSomaItemNota.AutoCalcFields := False;
      QNotaSaida.AutoCalcFields := False;

      QItemNF.DisableControls;
      try
        QNotaSaida.Edit;
        if QNotaSaidaNum_Nota.Value = 0 then
            QNotaSaidaNum_Nota.Value := DMSerie.NumeroSerie(QNotaSaidaCod_Filial.Value, QNotaSaidaCod_Serie.Value,
              QNotaSaidaCOD_SERIE_MODELO.Value);

        if wDescontoAcrescimo > 0 then
        begin
          if (wDescontoAcrescimo <= QNotaSaidaVal_Despesas.Value) then
            QNotaSaidaVal_Despesas.Value := QNotaSaidaVal_Despesas.Value - wDescontoAcrescimo
          else
          begin
            wDescontoAcrescimo := wDescontoAcrescimo - QNotaSaidaVAL_DESPESAS.Value;
            QNotaSaidaVAL_DESPESAS.Value := 0;
            QNotaSaidaVAL_DESCONTO.Value := QNotaSaidaVAL_DESCONTO.Value + wDescontoAcrescimo;
          end
        end
        else
          if wDescontoAcrescimo < -0.01 then
          begin
            if (Abs(wDescontoAcrescimo) <= QNotaSaidaVAL_DESCONTO.Value) then
            begin
              QNotaSaidaVal_Desconto.Value := QNotaSaidaVal_Desconto.Value + wDescontoAcrescimo
            end
            else
            begin
              wDescontoAcrescimo := wDescontoAcrescimo + QNotaSaidaVAL_DESCONTO.Value;
              QNotaSaidaVAL_DESCONTO.Value := 0;
              QNotaSaidaVal_Despesas.Value := QNotaSaidaVal_Despesas.Value + Abs(wDescontoAcrescimo);
            end;
          end;
        DMNfe.QNfeEmissao.Close;
        DMNfe.QNfeEmissao.SetVariable('NOTA_CAB', QNotaSaidaCOD_NOTA_CAB.Value);
