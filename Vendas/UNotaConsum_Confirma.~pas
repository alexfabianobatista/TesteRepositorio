                end;
              end;
            end
            else
          begin
            with DMContasReceber do
            begin
              QRBloqueto.Close;
              QRBloqueto.SetVariable('COD_NOTA_CAB_INICIAL', DMNotaSaida.QNotaSaidaCod_Nota_Cab.Text);
