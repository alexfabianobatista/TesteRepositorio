procedure TFNotaConsum_Confirma.ValidaDesconto(Sender: TObject);
var
  wTotalVenda: Real;
  wDescontoPermitido, wDescTipoFuncionario, wsenhaCrypt : String;
  wPrecoMinimo : Real;
  wTotalPermitido: Real;
begin
 // ---- ALTERAÇÃO PARA PEDIR SENHA NO DESCONTOS PARA USUARIOS NÃO PRIVILEGIADOS - JUNIOR 02/09/2013
  if (DMParamSistema.QParamSistemaIND_DESCONTO_MAXIMO.Value = 'U') and
     (DMParamSistema.QParamSistemaCOD_EMPRESA.Value <> 'FERRAGMED') and
     (DMParamSistema.QParamSistemaCOD_EMPRESA.Value <> 'DONABENTA') then
  begin
    wTotalPermitido := DMNotaSaida.QSomaItemNotaSVAL_TOTAL.Value;
    if (Trim(MEValorDesconto.Text) <> '') then
    begin
      with DMNotaSaida do
      begin
        wTotalVenda := QSomaItemNotaSVal_Total_Nota.Value + QNotaSaidaVAL_DESCONTO.Value - StrToFloat(MEValorDesconto.Text)
                        - DMNotaSaida.QSomaValessval_vale_compras_menos_novo.Value -
                          DMNotaSaida.QSomaValessval_vale_presente_menos_novo.Value;
        wDescontoPermitido := DMOracle.BuscaNome('SELECT PERC_DESCONTO_MAXIMO FROM TB_USUARIO',
                                        'COD_USUARIO = ' + IntToStr(DmUsuario.CodUsuarioCorrente));
        if Trim(MEValorDesconto.Text) <> '0' then
          wTotalPermitido := wTotalPermitido * (1 - StrToFloat(wDescontoPermitido) / 100);
        if (not DmUsuario.Privilegiado) then
          if wTotalVenda < wTotalPermitido then
          begin
            if Fsenha = nil then
              FSenha := TFSenha.Create(Application);
            if (FSenha.ShowModal = MrOK) and
               (not FSenha.MeUsuario.Visible or (trim(FSenha.MeUsuario.Text) <> '')) then
            begin
              if not FSenha.MeUsuario.Visible then
              begin
                if UpperCase(Trim(FSenha.EdSenha.Text)) <> UpperCase(DmParamSistema.QParamSistemaDesc_Senha_Oficina.Value) then
                begin
                  if TForm(Sender).Name = 'FNotaConsum_Confirma' then
                  begin
                    MEValorDesconto.Text := '0,00';
                    MEValorDesconto.SetFocus;
                  end;
                  if TForm(Sender).Name = 'FNotaFrenteCaixaConfirma' then
                  begin
                      FNotaFrenteCaixaConfirma.MEValorDesconto.Text := '0,00';
                      FNotaFrenteCaixaConfirma.MEValorDesconto.SetFocus;
                  end;
                  raise Exception.Create('Senha Incorreta.');
                end;
              end
              else
              begin
                DMUsuario.QUsuario.Close;
                DMUsuario.QUsuario.SetVariable('PK',StrToInt(Trim(FSenha.MeUsuario.Text)));
                DMUsuario.QUsuario.Open;
                wDescTipoFuncionario := DMUsuario.QUsuarioDESC_TIPO_FUNCIONARIO.Text;
                if (wDescTipoFuncionario = 'DIRETOR') or (wDescTipoFuncionario = 'GERENTE') or
                   (wDescTipoFuncionario = 'SUPERVISOR') then
                begin
                  wsenhaCrypt := bib.Decode(DMUsuario.QUsuarioDesc_Senha.Value);
                  If (UpperCase(Trim(FSenha.EdSenha.Text)) <> Trim(wsenhaCrypt))then
                  begin
                    MEValorDesconto.Text := '0,00';
                    MEValorDesconto.SetFocus;
                    raise Exception.Create('Informe a senha de liberação correta.');
                  end;
                end
                else
                begin
                  MEValorDesconto.Text := '0,00';
                  MEValorDesconto.SetFocus;
                  raise Exception.Create('Usuário sem permissão para desconto.');
                end;
              end;
            end
            else
            begin

                if TForm(Sender).Name = 'FNotaConsum_Confirma' then
                begin
                  MEValorDesconto.Text := '0,00';
                  MEValorDesconto.SetFocus;
                end;
                if TForm(Sender).Name = 'FNotaFrenteCaixaConfirma' then
                begin
                    FNotaFrenteCaixaConfirma.MEValorDesconto.Text := '0,00';
                    FNotaFrenteCaixaConfirma.MEValorDesconto.SetFocus;
                end;
                Abort;
            end;
        end;// Privilegiado
      end;
    end;  // Valor Desconto <> ''
  end;  // Desconto por usuario
end;

procedure TFNotaConsum_Confirma.EdRecebidoExit(Sender: TObject);
var Perc_aplicar, wTotalVenda: Real;
  wVlMoeda: string;
  wDescontoPermitido : String;
begin
  Perc_Aplicar := 1;
  case RGTipoPgto.ItemIndex of
    0: Perc_Aplicar := 1 - DMParamSistema.QParamSistemaPerc_Desconto_Vista.Value / 100;
    1: Perc_Aplicar := 1;
    2: Perc_Aplicar := 1 + DMParamSistema.QParamSistemaPerc_Acrescimo_Mes.Value / 100;
  end;
  wTotalVenda := DMNotaSaida.QSomaItemNotaSVal_Total_Nota.Value * Perc_Aplicar
                 - DMNotaSaida.pValorValeCompras - DMNotaSaida.pValorValePresente;
  if (Trim(MEValorDesconto.Text) <> '') then
  begin
    with DMNotaSaida do
    begin
      //wTotalVenda := wTotalVenda - StrToFloat(MEValorDesconto.Text);
      wTotalVenda := QSomaItemNotaSVal_Total_Nota.Value + QNotaSaidaVAL_DESCONTO.Value - StrToFloat(MEValorDesconto.Text)
                     - DMNotaSaida.QSomaValessval_vale_compras_menos_novo.Value -
                       DMNotaSaida.QSomaValessval_vale_presente_menos_novo.Value;
    end;
  end;

   wVlMoeda := DMOracle.BuscaNome('SELECT VLR_COTACAO FROM TB_COTACAO', 'COD_MOEDA = 2  AND  DT_COTACAO= TO_DATE('+ CHR(39) + DMNotaSaida.QNotaSaidaDt_Emissao.Text + CHR(39) + ',' + CHR(39)+'dd/mm/yyyy hh24:mi:ss'+CHR(39)+')');
  EdDolar.Text := '';
  if (Trim(wVlMoeda) <> '') and (Trim(wVlMoeda) <> '0') then // Dólar
    EdDolar.Text := FormatFloat('###,###,##0.00', wTotalVenda / StrToFloat(wVlMoeda));
  wVlMoeda := DMOracle.BuscaNome('SELECT VLR_COTACAO FROM TB_COTACAO', 'COD_MOEDA = 3  AND  DT_COTACAO= TO_DATE('+ CHR(39) + DMNotaSaida.QNotaSaidaDt_Emissao.Text + CHR(39) + ',' + CHR(39)+'dd/mm/yyyy hh24:mi:ss'+CHR(39)+')');
  EdPesos.Text := '';
  if (Trim(wVlMoeda) <> '') and (Trim(wVlMoeda) <> '0') then // Pesos
    EdPesos.Text := FormatFloat('###,###,##0.00', wTotalVenda / StrToFloat(wVlMoeda));
  wVlMoeda := DMOracle.BuscaNome('SELECT VLR_COTACAO FROM TB_COTACAO', 'COD_MOEDA = 4  AND  DT_COTACAO= TO_DATE('+ CHR(39) + DMNotaSaida.QNotaSaidaDt_Emissao.Text + CHR(39) + ',' + CHR(39)+'dd/mm/yyyy hh24:mi:ss'+CHR(39)+')');
  EdGuarani.Text := '';
  if (Trim(wVlMoeda) <> '') and (Trim(wVlMoeda) <> '0') then // Guarani
    EdGuarani.Text := FormatFloat('###,###,##0.00', wTotalVenda * StrToFloat(wVlMoeda));

  EdVenda.Text := FormatFloat('###,###,##0.00', wTotalVenda);
  EdTroco.Text := FormatFloat('###,###,##0.00', StrToFloat(Bib.LimpaString(EdRecebido.Text, '.')) - wTotalVenda);
  if (DMParamSistema.CodEmpresa = 'NFCE-DOCES') or (DMParamSistema.CodEmpresa = 'NFCE-DOGAO') then
    if (BtAvancar.Showing) then
      BtAvancar.SetFocus;
end;

procedure TFNotaConsum_Confirma.MEPercDescontoExit(Sender: TObject);
begin
  if Trim(MEPercDesconto.Text) <> '' then
  begin
    MEValorDesconto.Text := FormatFloat('#,##0.00',(DMNotaSaida.QSomaItemNotaSVal_Total_Nota.Value
      * StrToFloat(MEPercDesconto.Text) / 100));
    MEPercDesconto.Text := '';
    ValidaDesconto(Self);
  end;
  EdRecebidoExit(Self);
end;

