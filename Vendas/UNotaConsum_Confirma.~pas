                DMOracle.DBCemapa.Commit;
                if DMOracle.DBCemapa.InTransaction then
                  DMOracle.DBCemapa.Commit;
              end;
            end;
          end;
        end;
      end;
      except
        if QNotaSaida.State in [dsEdit, dsInsert] then
          QNotaSaida.Cancel; // RollBack
        raise;
      end;
    end;
  except
    DmNotaSaida.QItemNF.AutoCalcFields := True;
