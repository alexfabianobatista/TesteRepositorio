         ('values(SQCONTA_PAGAR_MOV.NextVal,' + IntToStr(wCodContaPagar) + ',' + chr(39) + DateToStr(DATE) + chr(39) + ',' + StringReplace(FloatToStr(wValMovimento), ',', '.', [rfReplaceAll]) + ',' );
        DMOracle.QExecSQL.SQL.Add
         ('''PRINCIPAL'' ,' + chr(39) + DateToStr(DATE) + chr(39) + ',' + QNotaEntradaCOD_USUARIO.Text + ')' );
        DMOracle.QExecSQL.ExecSQL;
        DMOracle.DBCemapa.Commit;
      end;
    end;
  end;
end;

procedure TFDevolucaoTroca.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  if DMNotaEntrada.QNotaEntrada.Active then
    excluirNFDevolucaoPendente;
  DMDevolucaoTroca.QValeProduto.Close;
  DMDevolucaoTroca.QValeProdutoItem.Close;
end;

procedure TFDevolucaoTroca.excluirNFDevolucaoPendente;
begin
  with DMNotaEntrada do
    if  QNotaEntrada.Active and (QNotaEntrada.RecordCount = 0) and (not StrToInt('0' + DMNfe.QNfeSIT_NFE.Value) in SIT_NFE_ACEITO) then
    begin
      if QNotaEntradaIND_SITUACAO.Value = 'S' then
        VoltaConfirmacao(QNotaEntradaCOD_NOTA_CAB.Value,'S','2');
      ExcluiNota;
      if (QNotaEntradaCOD_SERIE_MODELO.Value = '55') or
         (QNotaEntradaCOD_SERIE_MODELO.Value = '65') then
        begin
          ShowMessage('A nota nº '+QNotaEntradaNUM_NOTA.Text+' não foi autorizada e será excluída. '+
            'O sistema tentará inutilizar o nº ' + QNotaEntradaNUM_NOTA.Text + ', caso não seja possível, '+
            'tente inutilizá-lo mais tarde.');
          DMNfe.InutilizaNumeracaoNfe(QNotaEntradaCOD_FILIAL.Value, QNotaEntradaCOD_SERIE.Value,
            QNotaEntradaNUM_NOTA.Value, QNotaEntradaNUM_NOTA.Value,QNotaEntradaCOD_ESTADO.Value,
            'NUMERACAO DESCARTADA',DMNfe.QNfeIND_AMBIENTE_NFE.Value,
            StrToInt(QNotaEntradaCOD_SERIE_MODELO.Value));
        end;
    end;
end;

