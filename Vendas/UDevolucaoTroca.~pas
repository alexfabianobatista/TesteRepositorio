          QItemNFVAL_ICM.Value := (CDSItensDevolucaoVAL_ICM.Value /
                                   CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                   CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_CUSTO.Value := (CDSItensDevolucaoVAL_CUSTO.Value /
                                   CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                   CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_BASE_SUBST.Value := (CDSItensDevolucaoVAL_BASE_SUBST.Value /
                                         CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                         CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_ICMS_SUBST.Value := (CDSItensDevolucaoVAL_ICMS_SUBST.Value /
                                         CDSItensDevolucaoQT_QUANTIDADE.Value) *
