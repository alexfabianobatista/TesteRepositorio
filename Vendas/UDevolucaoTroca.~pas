              QItemNFVAL_ICM_BASE.Clear;
              QItemNFVAL_ICM.Clear;
            end;


          end;

          QItemNFVAL_PIS.Value := (CDSItensDevolucaoVAL_PIS.Value /
                                   CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                   CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_CONFINS.Value := (CDSItensDevolucaoVAL_CONFINS.Value /
                                       CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                       CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFCOD_NOTA_ITEM_ORIGEM.Value := CDSItensDevolucaoCOD_NOTA_ITEM.Value;



          QItemNF.Post;
        end;
        CDSItensDevolucao.Next;
      end;

      PagamentosNFe4.GeraPagamentos('E');
{Cria movimento na tabela conta_pagar_cab. Alex 08/04/2026  }
      if (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'S') then
      begin
        wValMovimento:= 0;
        wDesconto:= 0;
        cbResumoDevComprovante.Enabled := False;
        cbResumoDevComprovante.Checked := False;
        wDataVencimento := QNotaEntradaDT_EMISSAO.Value + 30;
        wDesconto := (DMDevolucaoTroca.pValorTotalDevolucao) * (DMCadastro.QCadastroPERC_DESCONTO.Value/100);
        wValMovimento := DMDevolucaoTroca.pValorTotalDevolucao - wDesconto;
        wNota := QNotaEntradaCOD_NOTA_CAB.Text;
        with DMOracle, DMUsuario do
        begin
          DMOracle.QExecSQL.close;
          DMOracle.QExecSQL.SQL;
          DMOracle.QExecSQL.SQL.Clear;
          DMOracle.QExecSQL.SQL.Add('insert into tb_conta_pagar_cab (cod_conta_pagar_cab,cod_cadastro,num_titulo,');
          DMOracle.QExecSQL.SQL.Add('num_parcela,dt_emissao,dt_vencimento,val_titulo,cod_usuario,cod_finalidade,');
          DMOracle.QExecSQL.SQL.Add('cod_filial,cod_departamento,desc_tipo_documento,ind_situacao,cod_nota_cab,desc_observacao,ind_devolucao)');
          DMOracle.QExecSQL.SQL.Add
           ('Values(SQCONTA_PAGAR.NextVal,' + QNotaEntradaCOD_CADASTRO.Text + ',' + QNotaEntradaNUM_NOTA.Text + ',1,' + chr(39) + DateToStr(DATE) + chr(39) + ',');
          DMOracle.QExecSQL.SQL.Add
           (chr(39) + DateToStr(wDataVencimento) + chr(39) + ',' + StringReplace(FloatToStr(wValMovimento), ',', '.', [rfReplaceAll]) + ',' + QNotaEntradaCOD_USUARIO.Text + ',' );
          DMOracle.QExecSQL.SQL.Add
           (QUsuarioCOD_FINALIDADE_PAGAR.text + ',' + QNotaEntradaCOD_FILIAL.Text + ',' + QUsuarioCOD_DEPARTAMENTO.text + ', ''DEV'', ''ABERTO'' ,' + QNotaEntradaCOD_NOTA_CAB.Text);
          DMOracle.QExecSQL.SQL.Add
           (',' + chr(39) + 'REF. A NFe DE DEVOLUCAO: ' + QNotaEntradaNUM_NOTA.Text + chr(39) + ', ''S''' + ')');
          DMOracle.QExecSQL.ExecSQL;
        end;
      end;

      wExec := TExecutador.Create;
      wExec.Adiciona('UPDATE TB_NOTA_CAB SET VAL_DESCONTO = ' + bib.TrocaVirgulaPorPonto(floatToStr(wValDescontoTotal)) + ' WHERE COD_NOTA_CAB = ' +
                      QNotaEntradaCOD_NOTA_CAB.Text);
      wExec.Executar(true, false);

      wTipoDocumento := DMOracle.BuscaNome('SELECT IND_EMITE FROM TB_OPERACAO ','COD_OPERACAO='+FloatToStr(QNotaEntradaCod_Operacao.Value));

      wLoteNFe := StrToInt('0'+ DMOracle.BuscaNome('SELECT ID_LOTE FROM TB_NF_ELETRONICA','COD_NOTA_CAB = '+QNotaEntradaCOD_NOTA_CAB.Text));

      wResult := True;
      If (wTipoDocumento = 'F') Then
        wResult := FNotaImpressao.EmiteNF(QNotaEntradaCod_Nota_Cab.Value,'',wLoteNFe,true);
      If (wTipoDocumento = 'P') and (DMParamSistema.CodEmpresa = 'PAULINHO') then
        FNotaImpressao.EmiteNF(QNotaEntradaCod_Nota_Cab.Value);

      if wResult then
      begin
        wMovimentaEstoque := DMOracle.FastSelect('IND_ESTOQUE', 'TB_OPERACAO', 'COD_OPERACAO = ' + QNotaEntradaCOD_OPERACAO.Text);
        if wMovimentaEstoque = 'S' then
          wMovimentaEstoque := DMOracle.FastSelect('IND_ESTOQUE', 'TB_FILIAL', 'COD_FILIAL = ' + QNotaEntradaCOD_FILIAL.Text);
        if wMovimentaEstoque = 'S' then
        begin
          QItemNF.First;
          while not QItemNF.Eof do
          begin
            DMEstoque.Atualiza_Estoque(
              QNotaEntradaCOD_OPERACAO.Value
              , QNotaEntradaCOD_FILIAL.Value
              , QItemNFCOD_PRODUTO.Value
              , QItemNFCOD_LOTE_TIPO.Value
              , QItemNFQT_QUANTIDADE.Value
              , QItemNFVAL_UNITARIO.Value
              , QNotaEntradaDT_EMISSAO.Value
              , QNotaEntradaDT_EMISSAO.Value
              , QNotaEntradaCOD_CADASTRO.Text
            );
            QItemNF.Next;
          end;
        end;
      end;
    end;
{Cria movimento na tabela conta_pagar_mov. Alex 08/04/2026}
    if (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'S') then
    begin
      with DMOracle,DMNotaEntrada do
      begin
        wCodContaPagar := StrToInt(fastselect('COD_CONTA_PAGAR_CAB','TB_CONTA_PAGAR_CAB','COD_NOTA_CAB = '+ wNota));
        DMOracle.QExecSQL.close;
