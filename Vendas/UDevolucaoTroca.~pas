          with DMCadastro do  //para limpar dados de icms nos casos de PF e não contribuinte. - Marlon/Cleber 02-01-2020
          begin
            QCadastro.Close;
            QCadastro.SetVariable('PK', QNotaEntradaCOD_CADASTRO.Value);
            QCadastro.Open;

            If (QCadastroIND_FISICA_JURIDICA.Value = 'F') or
               ((QCadastroIND_FISICA_JURIDICA.Value = 'J') and
                ((QCadastroNUM_INSCRICAO.Value = '') or
                (QCadastroNUM_INSCRICAO.Value = 'ISENTO')) and
                (QCadastroIND_CONTRIBUINTE.Value = 'NAO'))   then
