  begin
    cbResumoDevComprovante.Enabled := False;
    cbResumoDevComprovante.Checked := False;
  end;
end;

procedure TFDevolucaoTroca.configuraSequenciaAbas;
begin
  wSequenciaAbas.Clear;

  // Adicionar as abas na sequencia correta
  if wTipoDevolucao = 'DEVOLUCAO' then
  begin
    wSequenciaAbas.addValue(0, 'TSPrincipal');
    wSequenciaAbas.addValue(1, 'TSItensDevolver');
    wSequenciaAbas.addValue(2, 'TSResumoDevolucao')
  end
  else if wTipoDevolucao = 'TROCA' then // Troca
  begin
    wSequenciaAbas.addValue(0, 'TSPrincipal');
    //wSequenciaAbas.addValue(1, 'TSItensDevolver');
    //wSequenciaAbas.addValue(2, 'TSItensTroca');
  end
  else
  begin
    wSequenciaAbas.addValue(0, 'TSPrincipal');
    wSequenciaAbas.addValue(1,'TSCopiaValeProduto');
  end;
end;

procedure TFDevolucaoTroca.FormActivate(Sender: TObject);
var i: integer;
begin
  PageControl1.Pages[0].TabVisible := true;
  for i := 1 to PageControl1.PageCount - 1 do
  begin
    PageControl1.Pages[i].TabVisible := false;
  end;
  rgTipoClick(Self);
  DMDevolucaoTroca.limpaInstrucoes;
  BtVoltar.Visible := True;
  BtAvancar.Visible := True;
  BtAvancar.SetFocus;
  DMDevolucaoTroca.QValeProduto.Open;
  DMDevolucaoTroca.QValeProdutoItem.Open;

  if (DMParamSistema.CodEmpresa = 'OSARE') or (DMParamSistema.CodEmpresa = 'PIXIXE') then
  begin
    MeSerie.Text := DMUsuario.CodSeriePadrao;
    MeModelo.Text := DMUsuario.CodSerieModeloPadrao;
  end;
  if (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'S') then
  begin
    cbResumoDevComprovante.Enabled := False;
    cbResumoDevComprovante.Checked := False;
  end;
end;

procedure TFDevolucaoTroca.rgTipoClick(Sender: TObject);
begin
  if rgTipo.ItemIndex = 0 then
    wTipoDevolucao := 'DEVOLUCAO'
  else if rgTipo.ItemIndex = 1 then
    wTipoDevolucao := 'TROCA'
  else
    wTipoDevolucao := 'VALEPRODUTO';

  configuraSequenciaAbas;
  
  DMDevolucaoTroca.limpaInstrucoes;
end;

procedure TFDevolucaoTroca.gerenciaAbas(pDirecao: string = '+');
var wAbaAtual: string;
  i, j, k: integer;
begin
  executaAcaoAba(pDirecao);

  k := 0;
  while k < wSequenciaAbas.count do
  begin
    if wSequenciaAbas.getValue(k)
      = PageControl1.Pages[PageControl1.ActivePageIndex].Name then
    begin
      i := k;
      break;
    end;
    inc(k);
  end;

  i :=  strToInt(ifthen(pDirecao = '+', intToStr(i + 1), intToStr(i - 1)));   

  for j := 0 to PageControl1.PageCount - 1 do
  begin
    wAbaAtual := PageControl1.Pages[j].Name;
    if wAbaAtual = wSequenciaAbas.getValue(i) then
    begin
      PageControl1.Pages[j].TabVisible := true;
      PageControl1.ActivePageIndex := j;

      // Aqui são colocadas ações que deverão ser executadas ao entrar
      // em cada aba do PageControl
      case (PageControl1.ActivePageIndex) of
        0:
        begin
          lbFuncao.Caption := 'Escolha o tipo de devolução.';
          BtAvancar.SetFocus;
        end;
        1:
        begin
          lbFuncao.Caption := 'Informe a nota e a quantidade de itens que serão devolvidos.';
          MEItensDataIni.Text := DateToStr(IncDay(DMOracle.DataServ, -14));
          MEItensDataFin.Text := DateToStr(DMOracle.DataServ);
          if Trim(FmCadastro1.MeCadastro.Text) = '' then 
            FmCadastro1.MeCadastro.SetFocus
          else
            BtAvancar.SetFocus;
        end;
        2: lbFuncao.Caption := 'Informe os itens que serão trocados pelos itens devolvidos.';
        3:
        begin
          lbFuncao.Caption := 'Resumo da devolução.';
          PResumoDevCRIndicador.Color := clGray;
          PResumoDevNFIndicador.Color := clGray;
          PResumoDevVPIndicador.Color := clGray;
          BtAvancar.SetFocus;
        end;
        4:
        begin
          lbFuncao.Caption := 'Informe o cliente e depois selecione qual vale deseja emitir.';
          MEDataEmissaoValeInicial.Text := DateToStr(IncDay(DMOracle.DataServ, -30));
          MEDataEmissaoValeFinal.Text := DateToStr(DMOracle.DataServ);
          if Trim(FmCadastro2.MeCadastro.Text) = '' then
            FmCadastro2.MeCadastro.SetFocus
          else
            BtAvancar.SetFocus;
        end;
      end;
      break;
    end;
  end; 
  for j := 0 to PageControl1.PageCount - 1 do
  begin
    if PageControl1.Pages[j].imageindex <> pagecontrol1.activepageindex then
      PageControl1.Pages[j].TabVisible := false;
  end;
end;

procedure TFDevolucaoTroca.BtAvancarClick(Sender: TObject);
begin
  gerenciaAbas('+');
end;

procedure TFDevolucaoTroca.executaAcaoAba(pDirecao: string);
begin
  case(PageControl1.ActivePageIndex) of
    1: if pDirecao = '+' then
        begin
          if rgTipo.ItemIndex < 2 then itensDevolver;
        end
        else excluirNFDevolucaoPendente;
    3: if pDirecao = '+' then acoesDevolucao;
    4: if pDirecao = '+' then acoesCopiaValeProduto;
  end
end;

procedure TFDevolucaoTroca.itensDevolver;
var wQtDev: double;
begin
  wQtDev := 0;
  if DMDevolucaoTroca.CDSItensDevolucao.RecordCount = 0 then
  begin
    MessageDlg('Antes de avançar, selecione o Cliente, a Nota Fiscal de venda e os Itens a devolver.',
    mtInformation, [mbOk], 0);
    abort;
  end;
  atualizaValorTotalDevolucao;
  with DMDevolucaoTroca do
  begin
    // checa se foi informado quantidade para devolução
    CDSItensDevolucao.First;
    while not CDSItensDevolucao.Eof do
    begin
      if CDSItensDevolucaoQT_DEVOLUCAO.Value > CDSItensDevolucaoQT_QUANTIDADE.Value then
      begin
        MessageDlg('Informe uma quantidade a ser devolvida que seja menor ou igual à quantidade vendida.'
          ,mtInformation, [mbOk], 0);
        abort;
      end;
      wQtDev := wQtDev + CDSItensDevolucaoQT_DEVOLUCAO.Value;
      CDSItensDevolucao.Next;
    end;
    CDSItensDevolucao.First;
    if wQtDev = 0 then
    begin
      MessageDlg('Informe a quantidade a ser devolvida.'
        ,mtInformation, [mbOk], 0);
      abort;
    end;  

    // checa se operação de saída possui uma operação de entrada vinculada
    if DMOracle.FastSelect('NVL(COD_OPERACAO_ENTRADA, 0)', 'TB_OPERACAO'
      , 'COD_OPERACAO = ' + QNotaSaidaConsCOD_OPERACAO.Text) = '0' then
    begin
      MessageDlg('Operação: '
        + DMOracle.FastSelect('COD_OPERACAO ||' + quotedStr(' - ')
        +'|| DESC_OPERACAO'
        , 'TB_OPERACAO', 'COD_OPERACAO = '
        + QNotaSaidaConsCOD_OPERACAO.Text)
        + #13#10 + 'Não possui operação de entrada referenciada.'
        + #13#10 + 'Por favor informe a operação de entrada na aba Venda '
        + 'do cadastro de operações.', mtError, [mbOk], 0);
      MessageDlg('Após configurar a operação clique em Avançar para prosseguir.'
        , mtInformation, [mbOk], 0);
        abort;
    end;

    resumoDevolucao;
  end;
end;

