procedure TFDevolucaoTroca.baixaCP(pValorBaixa: double; wCodNota, wCodCadastro: integer);
var wValBaixado, wPercentualBaixa, wValor: double;
begin
  if FContaPagarBaixa = Nil then
    FContaPagarBaixa := TFContaPagarBaixa.Create(Application);
  with DMDevolucaoTroca, DMContasPagar do
  begin
    wValBaixado := 0;
    wValor := pValorBaixa;

    FContaPagarBaixa.pCodNotaCab:= wCodNota;
    FContaPagarBaixa.pCodCadastro:= wCodCadastro;
    FContaPagarBaixa.Tag := 1;
    FContaPagarBaixa.MEDataBaixa.Text:= DateToStr(DMOracle.DataServ);
    FContaPagarBaixa.SBProcuraClick(self);

    while not QContasPagarBaixa.Eof do
    begin
      // Inicializa as variáveis de controle
      FContaPagarBaixa.PCBaixa.ActivePageIndex := 1;
      FContaPagarBaixa.Refresh;
      Application.ProcessMessages;
      FContaPagarBaixa.RGFormaPagto.ItemIndex := 2; //baixa contábil
      QContasPagar_Mov.Close;
      QContasPagar_Mov.Open;
      QContasPagarBaixaMov.Close;
      QContasPagarBaixaMov.Open;

      FContaPagarBaixa.PCBaixaChange(self);

      wPercentualBaixa := StrToFloat(Trim(FContaPagarBaixa.MEValorBaixa.Text)) * 100 /pValorBaixa;
      wValBaixado:= StrToFloat(Trim(FContaPagarBaixa.MEValorBaixa.Text));


//      wPercentualBaixa := pValorBaixa * 100 /wValorFaltaReceber;
//      FContaPagarBaixa.MEValorBaixa.Text:= floatToStr(RoundTo( wValorBaixa * wPercentualBaixa / 100,-2));
      FContaPagarBaixa.MEValorBaixa.Text:=  FloatToStr(RoundTo(wValor - wValBaixado, -2));


//      wValBaixado := wValBaixado +  StrToFloat(Trim(FContaPagarBaixa.MEValorBaixa.Text));
      try
        FContaPagarBaixa.SBBaixaClick(self);
      except
      end;
      FContaPagarBaixa.PCBaixa.ActivePageIndex := 0;
      QContasPagarBaixa.Next;
    end;
  end;
  // Fez alguma baixa
  if RoundTo(wValorBaixa, -2) = RoundTo(wValBaixado, -2) then
    ShowMessage('Baixado o(s) título(s) do Contas a Pagar!');
end;

