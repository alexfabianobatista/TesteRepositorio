procedure TFDevolucaoTroca.btNotasListarClick(Sender: TObject);
begin
  if (Trim(FmCadastro1.MeCadastro.Text) = '') and (Trim(MENumNota.Text) = '') and ((Trim(MEItensDataIni.Text) = '')
    or (Trim(MEItensDataFin.Text) = '')) then
  begin
    MessageDlg('Informe pelo menos um dos parâmetros antes de buscar, Cliente, Número da Nota ou período.', mtError,
      [mbOk], 0);
    Abort;
  end;
  with DMDevolucaoTroca do
  begin
    QNotaSaidaCons.Close;
    QNotaSaidaCons.ClearVariables;
    if (Trim(MEItensDataIni.Text) <> '') and
       (Trim(MEItensDataFin.Text) <> '') then
    begin
      QNotaSaidaCons.SetVariable('DT_INICIAL', MEItensDataIni.Text);
      QNotaSaidaCons.SetVariable('DT_FINAL', MEItensDataFin.Text);
    end;
    if trim(MeSerie.Text) <> '' then
      QNotaSaidaCons.SetVariable('COD_SERIE', trim(MeSerie.Text))
    else
      QNotaSaidaCons.SetVariable('COD_SERIE', NULL);

    if trim(MeModelo.Text) <> '' then
      QNotaSaidaCons.SetVariable('COD_SERIE_MODELO', trim(MeModelo.Text))
    else
      QNotaSaidaCons.SetVariable('COD_SERIE_MODELO', NULL);

    if Trim(FmCadastro1.MeCadastro.Text) <> '' then
      QNotaSaidaCons.SetVariable('CADASTRO', trim(FmCadastro1.MeCadastro.Text))
    else
      QNotaSaidaCons.SetVariable('CADASTRO', NULL);

    if Trim(MENumNota.Text) <> '' then
      QNotaSaidaCons.SetVariable('NUM_NOTA', Trim(MENumNota.Text))
    else
      QNotaSaidaCons.SetVariable('NUM_NOTA', NULL);

    if Trim(FmProduto2.MeProduto.Text) <> '' then
      QNotaSaidaCons.SetVariable('PRODUTO', trim(FmProduto2.MeProduto.Text))
    else
      QNotaSaidaCons.SetVariable('PRODUTO', NULL);
      
    QNotaSaidaCons.SetVariable('SITUACAO', 2); // confirmada
    QNotaSaidaCons.Open;
  end;
end;

