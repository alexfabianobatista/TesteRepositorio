procedure TFDevolucaoTroca.resumoDevolucao;
begin
  wValorJaRecebido := 0; // Armazena valor que já foi pago no contas a receber
  wValorFaltaReceber := 0; // Armazena valor que falta receber no contas a receber
  wValorTotalReceber := 0;// Armazena o valor total de todas as parcelas a receber
  wValorValeProduto := 0; // Armazena o valor do Vale Compras se existir
  wValorBaixa := 0; // Armazena o valor a baixar
  cbResumoDevCR.Checked := true;
  cbResumoDevCR.Enabled := true;
  if (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'N') then
  begin
    cbResumoDevComprovante.Checked := true;
    cbResumoDevComprovante.Enabled := true;
  end
  else
  begin
    cbResumoDevComprovante.Checked := false;
    cbResumoDevComprovante.Enabled := false;
  end;


  with DMDevolucaoTroca do
  begin
    QContasReceberCons.Close;
    QContasReceberCons.SetVariable('COD_NOTA_CAB',QNotaSaidaConsCOD_NOTA_CAB.Value);
    QContasReceberCons.Open;

    if (DMParamSistema.CodEmpresa = 'QUERENCIA') or (DMParamSistema.CodEmpresa = 'AGROCAMPO') then
    begin
      // Busca os valores já recebidos, falta receber e total a receber
      while not QContasReceberCons.Eof do
      begin
        wValorTotalReceber:= wValorTotalReceber + QContasReceberConsVAL_ORIGINAL.Value;
        QContasReceberMovCons.Close;
        QContasReceberMovCons.SetVariable('COD_CONTA_RECEBER_CAB',QContasReceberConsCOD_CONTA_RECEBER_CAB.Value);
        QContasReceberMovCons.Open;

        while not QContasReceberMovCons.Eof do
        begin
          wValorJaRecebido := wValorJaRecebido
            + QContasReceberMovConsVAL_MOVIMENTO.Value;
          QContasReceberMovCons.Next;
        end;
        QContasReceberCons.Next;
      end;

      wValorFaltaReceber := wValorTotalReceber - wValorJaRecebido;
    end;

    if pValorTotalDevolucao > wValorFaltaReceber then  // Emitir cortesia pois o título a receber já foi recebido
      wValorValeProduto := pValorTotalDevolucao - wValorFaltaReceber;


    if wValorFaltaReceber > 0  then // Fazer baixa do valor total da devolução
      wValorBaixa := pValorTotalDevolucao - wValorValeProduto;

    wValorJaRecebido := wValorJaRecebido - pValorTotalDevolucao;
    cbResumoDevComprovante.Caption := 'Emitir Vale-compras no valor de R$ ' + formatFloat('#0.00', wValorValeProduto) + '.';
    cbResumoDevCR.Caption:= 'Baixar títulos do contas a receber no valor de R$ ' + formatfloat('#0.00', wValorBaixa) + '.';

    cbResumoDevComprovante.Checked := (wValorValeProduto > 0);
    Application.ProcessMessages;
    cbResumoDevComprovante.Enabled := (wValorValeProduto > 0);

    cbResumoDevCR.Checked := (wValorBaixa > 0);
    Application.ProcessMessages;
    cbResumoDevCR.Enabled := (wValorBaixa > 0);

    cbResumoDevNF.Caption := 'Emitir nota fiscal de devolução de venda.';
  end;
end;

procedure TFDevolucaoTroca.acoesDevolucao;
begin
  emitirNFDevolucao;
  if (StrToInt('0' + DMNfe.QNfeSIT_NFE.Value) in SIT_NFE_ACEITO) or
     ((DMNotaEntrada.QNotaEntradaIND_SITUACAO.Value = '2') and
      (DMNotaEntrada.QNotaEntradaCOD_SERIE_MODELO.Value <> '55')) then
  begin
    PResumoDevNFIndicador.Color := clGreen;
    if (DMParamSistema.CodEmpresa = 'QUERENCIA') or (DMParamSistema.CodEmpresa = 'AGROCAMPO') then
      baixaCR;
    BtVoltar.Visible := false;
    BtAvancar.Visible := false;
    if (((cbResumoDevComprovante.Enabled) and (cbResumoDevComprovante.Checked)) or ((wValorBaixa > 0) and (wValorValeProduto = 0))) and
       (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'N') then
    begin
      if cadastraValeProduto then
      begin
        PResumoDevVPIndicador.Color := clGreen;
        if MessageDlg('Deseja imprimir o Vale Compras nº ' +
            DMDevolucaoTroca.QValeProdutoCOD_VALE_PRODUTO.Text + '?',mtConfirmation,[mbYes,mbNo],0) = mrYes then
          FNotaImpressao.emitirValeProduto(DMDevolucaoTroca.QValeProdutoCOD_VALE_PRODUTO.Value);
      end
      else
        PResumoDevVPIndicador.Color := clRed;
    end
    else
      PResumoDevVPIndicador.Color := clGreen;
  end
  else
    PResumoDevNFIndicador.Color := clRed;
end;

procedure TFDevolucaoTroca.baixaCR;
var wValBaixado, wPercentualBaixa: double;
begin
  if (cbResumoDevCR.Enabled) and (cbResumoDevCR.Checked) then
  begin
    if FContasReceberBaixa = Nil then
      FContasReceberBaixa := TFContasReceberBaixa.Create(Application);
    with DMDevolucaoTroca do
    begin
      wValBaixado := 0;
      FContasReceberBaixa.pCodNotaCab
        := DMDevolucaoTroca.QNotaSaidaConsCOD_NOTA_CAB.Value;
      FContasReceberBaixa.Tag := 1;
      FContasReceberBaixa.MEDtBaixa.Text
        := DateToStr(DMOracle.DataServ);
      FContasReceberBaixa.CbCalculoJuros.Checked := false;
      FContasReceberBaixa.SBProcuraClick(self);

      while not DMContasReceber.QContasReceberBaixa.Eof do
      begin
        // Inicializa as variáveis de controle
        FContasReceberBaixa.PCBaixa.ActivePageIndex := 1;
        FContasReceberBaixa.Refresh;
        Application.ProcessMessages;
        //FContasReceberBaixa.RGFormaPagto.ItemIndex := 3; //Cartão de Crédito Alterado para Baixa Contábil para não aparecer no caixa
        FContasReceberBaixa.RGFormaPagto.ItemIndex := 2;//Junior 05/07/2021. AGROCAMPO 
        DMContasReceber.QContasReceberBaixaMov.Close;
        DMContasReceber.QContasReceberBaixaMov.Open;
        DMContasReceber.QContasReceber_Mov.Close;
        DMContasReceber.QContasReceber_Mov.Open;

        FContasReceberBaixa.PCBaixaChange(self);

        wPercentualBaixa := StrToFloat(Trim(FContasReceberBaixa.MEValorBaixa.Text)) * 100 /wValorFaltaReceber;
        FContasReceberBaixa.MEValorBaixa.Text
            := floatToStr(RoundTo( wValorBaixa * wPercentualBaixa / 100,-2));

        wValBaixado := wValBaixado +
          + StrToFloat(Trim(FContasReceberBaixa.MEValorBaixa.Text));
        try
          FContasReceberBaixa.SBBaixaClick(self);
        except
        end;
        FContasReceberBaixa.PCBaixa.ActivePageIndex := 0;
        DMContasReceber.QContasReceberBaixa.Next;
      end;

      // Fez alguma baixa
      if RoundTo(wValorBaixa, -2) = RoundTo(wValBaixado, -2) then
        PResumoDevCRIndicador.Color := clGreen
      else
        PResumoDevCRIndicador.Color := clRed;
    end;
  end;
end;

