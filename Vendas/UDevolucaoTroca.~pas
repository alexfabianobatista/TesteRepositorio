procedure TFDevolucaoTroca.DBGrid1KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (KEY in [VK_DOWN, VK_TAB])
    and ( DBGrid1.DataSource.DataSet.RecNo
      = DBGrid1.DataSource.DataSet.RecordCount )  then
  begin
    BtAvancar.SetFocus;
    atualizaValorTotalDevolucao;
    abort;
  end;

  if (Key in [13, 37, 38, 39, 40, VK_TAB])then
  begin
    atualizaValorTotalDevolucao;
  end;
  if (Key in [13, VK_TAB])then
  begin
    atualizaValorTotalDevolucao;
  end;
end;

