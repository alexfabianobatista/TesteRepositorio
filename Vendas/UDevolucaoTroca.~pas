procedure TFDevolucaoTroca.FmProduto1MeProdutoExit(Sender: TObject);
begin
  FmProduto1.MeProdutoExit(Sender);
  with DMProduto, DMEstoque do
  begin

    if trim(FmProduto1.MeProduto.Text) = '' then abort;

    QProduto.Close;
    QProduto.SetVariable('PK', FmProduto1.MeProduto.Text);
    QProduto.Open;

    if QProduto.IsEmpty then abort;

    if QEstoqueCons.RecordCount = 0 then
    begin
      QEstoqueCons.Close;
      QEstoqueCons.SetVariable('COD_PRODUTO', QProdutoCOD_PRODUTO.Value);
      QEstoqueCons.SetVariable('FILIAL'
        ,DMDevolucaoTroca.QNotaSaidaConsCOD_FILIAL.Value);
      QEstoqueCons.Open;
    end;

    meQuantidade.Text := '1';
    meUnitario.Text := FormatFloat('#,###0.000',QProdutoVAL_VAREJO.Value);
    fmTributacao1.meTributacao.Text := QProdutoCOD_TRIBUTACAO.Text;
    fmLote1.meLote.Text := IfThen(
      (QEstoqueCons.RecordCount > 0)
      ,QEstoqueConsCOD_LOTE_TIPO.Text
      ,'1'
      );
    meDesconto.Text := '0,000';
  end;
end;

procedure TFDevolucaoTroca.btAdicionaItemClick(Sender: TObject);
var wPercIPI: real;
begin

  // Validações

  if (trim(FmProduto1.MeProduto.Text) = '')
    or (strToFloat((trim(FmProduto1.MeProduto.Text))) = 0) then
  begin
    MessageDlg('Produto não informado.', mtError, [mbOk], 0);
