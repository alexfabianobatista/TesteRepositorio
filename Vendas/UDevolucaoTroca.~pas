function TFDevolucaoTroca.cadastraValeProduto: Boolean;
begin
  if (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'N') then
  begin
    result := false;
    try
      DMOracle.DBCemapa.StartTransaction;
      with DMDevolucaoTroca, DMNotaEntrada do
      begin
        QValeProdutoValida.Close;
        QValeProdutoValida.ClearVariables;
        QValeProdutoValida.SetVariable('COD_NOTA_CAB', QNotaSaidaConsCOD_NOTA_CAB.Value);
        QValeProdutoValida.Open;

        if (QValeProdutoValida.RecordCount = 0) or
           (QValeProdutoValidaIND_VALIDO.Value = 'S') then
        begin
          QValeProduto.Insert;
          QValeProdutoCOD_NOTA_CAB.Value := QNotaSaidaConsCOD_NOTA_CAB.Value;
          QValeProdutoCOD_FILIAL.Value := QNotaSaidaConsCOD_FILIAL.Value;
          QValeProdutoCOD_NOTA_CAB_DEV.Value := QNotaEntradaCOD_NOTA_CAB.Value;
          QValeProdutoCOD_CADASTRO.Value := QNotaEntradaCOD_CADASTRO.Value;
          QValeProdutoDT_EMISSAO.Value := DMOracle.DataServ;
          QValeProdutoVAL_VALOR_BAIXADO.Value := wValorBaixa;
          QValeProdutoVAL_VALE_PRODUTO.Value := wValorValeProduto;
          QValeProdutoIND_SITUACAO_VALE_PRESENTE.Value := 2; //emitido
          If ( ((DMParamSistema.CodEmpresa = 'QUERENCIA') or (DMParamSistema.codEmpresa = 'AGROCAMPO') or (DMParamSistema.CodEmpresa = 'SCALA') )  and
             (QValeProdutoVAL_VALE_PRODUTO.Value = 0)) then
          Begin
            QValeProdutoCOD_NOTA_CAB_TROCA.Value := QNotaEntradaCOD_NOTA_CAB.Value;

          end;
          QValeProduto.Post;
          CDSItensDevolucao.First;
          while not CDSItensDevolucao.Eof do
          begin
            if CDSItensDevolucaoQT_DEVOLUCAO.Value > 0 then                   
            begin
              QValeProdutoItem.Insert;
              QValeProdutoItemCOD_VALE_PRODUTO.Value := QValeProdutoCOD_VALE_PRODUTO.Value;
              QValeProdutoItemCOD_NOTA_ITEM.Value := CDSItensDevolucaoCOD_NOTA_ITEM.Value;
              QValeProdutoItemQT_QUANTIDADE_DEVOLVIDA.Value := CDSItensDevolucaoQT_DEVOLUCAO.Value;
              QValeProdutoItem.Post;
            end;
            CDSItensDevolucao.Next
          end;
        end;
      end;
      DMOracle.DBCemapa.Commit;
      result := true;
    except
      on E : Exception Do
        MessageDlg(E.ClassName + '. erro ao cadastrar o Vale Compras. ' + E.Message,
        mtError, [mbOK],0);
    end;
  end;
end;
