  end;

  if (trim(FmTributacao1.MeTributacao.Text) = '')
    or (strToFloat((trim(FmTributacao1.MeTributacao.Text))) = 0) then
  begin
    MessageDlg('Tributação não informada.', mtError, [mbOk], 0);
    Abort;
  end;

  if (trim(FmLote1.meLote.Text) = '')
    or (strToFloat((trim(FmLote1.meLote.Text))) = 0) then
  begin
    MessageDlg('Lote não informado.', mtError, [mbOk], 0);
    Abort;
  end;

  if (trim(meQuantidade.Text) = '')
    or (strToFloat((trim(meQuantidade.Text))) = 0) then
  begin
    MessageDlg('Quantidade não informada.', mtError, [mbOk], 0);
    Abort;
  end;

  if (trim(meUnitario.Text) = '')
    or (strToFloat((trim(meUnitario.Text))) = 0) then
  begin
    MessageDlg('Valor unitário não informado.', mtError, [mbOk], 0);
    Abort;
  end;

  // Adiciona itens

  with DMDevolucaoTroca do
  begin
    CDSItensTroca.Append;
    CDSItensTrocaCOD_PRODUTO.Text :=  trim(FmProduto1.MeProduto.Text);
    CDSItensTrocaDESC_PRODUTO.Text := trim(FmProduto1.EdProduto.Text);
    CDSItensTrocaCOD_LOTE_TIPO.Text := trim(FmLote1.meLote.Text);
    CDSItensTrocaQT_QUANTIDADE.Text := trim(meQuantidade.Text);
    CDSItensTrocaVAL_UNITARIO.Text := trim(meUnitario.Text);
    CDSItensTrocaCOD_TRIBUTACAO.Text := trim(FmTributacao1.meTributacao.Text);
    calculaICM;
    CDSItensTrocaVAL_DESCONTO.Text := '0,00';
    if trim(meDesconto.Text) <> '' then
      CDSItensTrocaVAL_DESCONTO.Text := trim(meDesconto.Text);

    // Ipi
    wPercIPI
      := strToFloat(
        DMOracle.FastSelect('NVL(PERC_IPI, 0)', 'TB_PRODUTO', 'COD_PRODUTO = '
          + CDSItensTrocaCOD_PRODUTO.Text)
        );
