procedure TFDevolucaoTroca.emitirNFDevolucao;
var wTipoDocumento, wCpfCnpjCadastro, wCodNotaCab, wTituloCadastroCons, wNota: String;
    wLoteNFe, wCodCadastro, wCodContaPagar: Integer;
    wValDescontoTotal,wValMovimento, wDesconto: Real;
    wExec: TExecutador;
    wMovimentaEstoque: string;
    wResult: Boolean;
    wDataVencimento: TDateTime;
begin
  wValDescontoTotal := 0;
  if (cbResumoDevNF.Enabled) and (cbResumoDevNF.Checked) then
  begin
    // Criação da Nota na NotaCab
    with DMNotaEntrada, DMDevolucaoTroca, DMCadastro do
    begin
      wCodCadastro := QNotaSaidaConsCOD_CADASTRO.Value;
      if (QNotaSaidaConsCOD_SERIE_MODELO.Value = '55') or
         (QNotaSaidaConsCOD_SERIE_MODELO.Value = '65') then
      begin
        wCpfCnpjCadastro := DMOracle.BuscaNome('SELECT NUM_CGC_CPF FROM TB_CADASTRO','COD_CADASTRO = ' + IntToStr(wCodCadastro));
        while wCpfCnpjCadastro = '' do
        begin
          if FCadastroCons = nil then
            FCadastroCons := TFCadastroCons.Create(Application);
          wTituloCadastroCons := FCadastroCons.Caption;
          FCadastroCons.Caption := 'Informe o cadastro completo do cliente para a devolução.';
          if FCadastroCons.ShowModal <> mrOk then
          begin
            FCadastroCons.Caption := wTituloCadastroCons;
            Abort;
          end;
          FCadastroCons.Caption := wTituloCadastroCons;
          wCpfCnpjCadastro := QCadastroConsNUM_CGC_CPF.Value;
          wCodCadastro := QCadastroConsCOD_CADASTRO.Value;
        end;
      end;

      wCodNotaCab := DMOracle.BuscaNome('SELECT COD_NOTA_CAB FROM TB_NOTA_REFERENCIADA','COD_NOTA_CAB_REF = '+QNotaSaidaConsCOD_NOTA_CAB.Text);

      QNotaEntrada.Close;
      QNotaEntrada.SetVariable('PK', StrToInt('0'+wCodNotaCab));
      QNotaEntrada.Open;

      QItemNF.Close;
      QItemNF.Open;

      DMNfe.SetaNfe(QNotaEntradaDESC_CHAVE_ACESSO.Value,True);

      DMOperacao.QOperacao.Close;
      DMOperacao.QOperacao.SetVariable('PK', DMOracle.BuscaNome('SELECT COD_OPERACAO_ENTRADA FROM TB_OPERACAO','COD_OPERACAO = '+ QNotaSaidaConsCOD_OPERACAO.Text));
      DMOperacao.QOperacao.Open;

      if DMOperacao.QOperacaoCOD_SERIE.IsNull then
        Raise Exception.Create('A série para nota fiscal não foi cadastrada');
      if DMOperacao.QOperacaoCOD_SERIE_MODELO.IsNull then
        Raise Exception.Create('O modelo da série para nota fiscal não foi cadastrado');

      if (QNotaEntrada.RecordCount = 0) or (StrToInt('0' + DMNfe.QNfeSIT_NFE.Value) in SIT_NFE_ACEITO) or
         ((QNotaEntradaCOD_SERIE_MODELO.Value <> '65') and (QNotaEntradaCOD_SERIE_MODELO.Value <> '55') and
          (QNotaEntradaIND_SITUACAO.Value = '2')) then
      begin
        QNotaEntrada.Insert;
        QNotaEntradaCOD_NOTA_CAB.Value := DMOracle.Sequencia('NOTA');
        QNotaEntradaNUM_NOTA.Value := DMSerie.NumeroSerie(QNotaSaidaConsCOD_FILIAL.Value,DMOperacao.QOperacaoCOD_SERIE.Value,
        DMOperacao.QOperacaoCOD_SERIE_MODELO.Value);
      end
      else
      begin
        QNotaEntrada.Edit;
        QValeProduto.Close;
        QValeProduto.ClearVariables;
        QValeProduto.SetVariable('COD_NOTA_CAB_DEV', QNotaEntradaCOD_NOTA_CAB.Value);
        QValeProduto.Open;

        if QValeProduto.RecordCount > 0 then
        begin
          DMOracle.QExecSQL.close;
          DMOracle.QExecSQL.SQL;
          DMOracle.QExecSQL.SQL.Clear;
          DMOracle.QExecSQL.SQL.Add('DELETE FROM TB_VALE_PRODUTO_ITEM WHERE COD_VALE_PRODUTO = ' + QValeProdutoCOD_VALE_PRODUTO.Text);
          DMOracle.QExecSQL.ExecSQL;
          QValeProduto.Delete;
        end;
        with DMOracle do
        begin
          QExecSQL.Close;
          QExecSQL.SQL.Clear;
          QExecSQL.SQL.Add('DELETE FROM TB_PAGAMENTO WHERE COD_NOTA_CAB = ' + QNotaEntradaCOD_NOTA_CAB.Text);
          QExecSQL.ExecSQL;
        end;
        QItemNF.First;
        while not QItemNF.Eof do
          QItemNF.Delete;
      end;

      QNotaEntradaCOD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
      QNotaEntradaCOD_FILIAL.Value := QNotaSaidaConsCOD_FILIAL.Value;

      QNotaEntradaCOD_VENDEDOR.Value := QNotaSaidaConsCOD_VENDEDOR.Value;

      QNotaEntradaCOD_OPERACAO.Value := DMOperacao.QOperacaoCOD_OPERACAO.Value;
      QNotaEntradaCOD_ESTADO.Value := QNotaSaidaConsCOD_ESTADO.Value;

      QNotaEntradaCOD_CADASTRO.Value := wCodCadastro;

      If (QNotaSaidaConsCOD_CADASTRO_PARCEIRO.Value <> 0) And (QNotaSaidaConsCOD_CADASTRO_PARCEIRO.Text <> '') Then
         QNotaEntradaCOD_CADASTRO_Parceiro.Value := QNotaSaidaConsCOD_CADASTRO_PARCEIRO.Value;

      QNotaEntradaCOD_SERIE.Value := DMOperacao.QOperacaoCOD_SERIE.Value;
      QNotaEntradaCOD_SERIE_MODELO.Value := DMOperacao.QOperacaoCOD_SERIE_MODELO.Value;

      QNotaEntradaCOD_MENSAGEM.Text := DMOperacao.QOperacaoCod_Mensagem.Text;

      QNotaEntradaIND_SITUACAO.Value :='2';
      if (DMParamSistema.QParamSistemaIND_GERA_PARCELA_DEVOL.Value = 'S') then
        QNotaEntradaIND_CONDICAO_PAGTO.Value :='2'
      else
        QNotaEntradaIND_CONDICAO_PAGTO.Value := '3';
      QNotaEntradaDT_EMISSAO.Value :=DMOracle.Dataserv;
      QNotaEntradaDT_MOVIMENTO.Value :=DMOracle.DataHoraserv;
      QNotaEntradaDT_RECEBIMENTO.Value :=DMOracle.Dataserv;
      QNotaEntradaIND_ENTRADA_SAIDA.Value :='E';
      QNotaEntradaIND_TIPO_FRETE.Value :='SEM';
      QNotaEntradaCOD_DEPARTAMENTO.Value := DMUsuario.CodDepartamentoUsuario;

      QNotaEntradaOBS.Value := 'DEV. REF. NF. NR. ' + FloatToStr(QNotaSaidaConsNUM_NOTA.Value);
      QNotaEntradaIND_FINALIDADE_NFE.Value := 4;  //Finalidade de devolução

      QNotaEntradaDT_USUARIO.Value :=DMOracle.DataHoraserv;
      QNotaEntrada.Post;
      QNotaEntrada.Edit;

      QNotaReferenciada.Close;
      QNotaReferenciada.Open;

      if QNotaReferenciada.RecordCount = 0 then
      begin
        if (QNotaSaidaConsDESC_CHAVE_ACESSO.Value = '') and
           ((QNotaSaidaConsCOD_SERIE_MODELO.Value = '55') or
            (QNotaSaidaConsCOD_SERIE_MODELO.Value = '65')) then
        begin
          MessageDlg('A nota nº ' + QNotaSaidaConsNUM_NOTA.Text + ' não será referenciada pois não possui chave de acesso.', mtError, [mbOK],0);
          Abort;
        end;
        if not((QNotaEntradaCOD_SERIE_MODELO.Value = '55') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '65') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '01') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '02') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '04') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '2B') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '2C') or
           (QNotaEntradaCOD_SERIE_MODELO.Value = '2D') or
           ((QNotaEntradaCOD_SERIE_MODELO.Value <> '55') and
            (QNotaSaidaConsCOD_SERIE_MODELO.Value <> '55') and
            (QNotaSaidaConsCOD_SERIE_MODELO.Value <> '65') and
            (QNotaSaidaConsIND_SITUACAO.Value = '2'))) then
        begin
          MessageDlg('A nota nº ' + QNotaEntradaConsNUM_NOTA.Text + ' não será referenciada pois seu modelo diverge dos modelos aceitos: 55, 65, 01, 04, 2B, 2C e 2D.', mtError, [mbOK],0);
          Abort;
        end;
      end
      else
      begin
        QNotaReferenciada.First;
        while not QNotaReferenciada.Eof do
          QNotaReferenciada.Delete;
      end;
      try
        QNotaReferenciada.Insert;
        QNotaReferenciadaCOD_NOTA_CAB.Value := QNotaEntradaCOD_NOTA_CAB.Value;
        QNotaReferenciadaCOD_NOTA_CAB_REF.Value := QNotaSaidaConsCOD_NOTA_CAB.Value;
        QNotaReferenciadaDESC_CHAVE_ACESSO.Value := Bib.LimpaNumero(QNotaSaidaConsDESC_CHAVE_ACESSO.Value);
        QNotaReferenciadaNUM_NOTA.Value := QNotaSaidaConsNUM_NOTA.AsInteger;
        QNotaReferenciadaCOD_SERIE.Value := QNotaSaidaConsCOD_SERIE.Value;
        QNotaReferenciadaCOD_SERIE_MODELO.Value := QNotaSaidaConsCOD_SERIE_MODELO.Value;
        QNotaReferenciadaDT_EMISSAO.Value := QNotaSaidaConsDT_EMISSAO.Value;
        QNotaReferenciada.Post;
      except
        QNotaReferenciada.Cancel;
        raise Exception.Create('Erro ao gravar nota referenciada.');
      end;

      // Criação dos itens da nota
      CDSItensDevolucao.First;
      while not CDSItensDevolucao.Eof do
      begin
        if CDSItensDevolucaoQT_DEVOLUCAO.Value > 0 then
        begin
          QItemNF.Insert;
          QItemNFCOD_NOTA_ITEM.Value := DMOracle.Sequencia('NOTA_ITEM');
          QItemNFCOD_NOTA_CAB.Value := QNotaEntradaCOD_NOTA_CAB.Value;
          QItemNFCOD_TRIBUTACAO.Value := CDSItensDevolucaoCOD_TRIBUTACAO.Value;
          QItemNFQT_QUANTIDADE.Value := CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_TOTAL.Value := CDSItensDevolucaoQT_DEVOLUCAO.Value *
                                    CDSItensDevolucaoVAL_UNITARIO.Value;
          QItemNFVAL_IPI.Value := (CDSItensDevolucaoVAL_IPI.Value /
                                   CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                   CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFPERC_COMISSAO.Value := CDSItensDevolucaoPERC_COMISSAO.Value;
          QItemNFCOD_PRODUTO.Value := CDSItensDevolucaoCOD_PRODUTO.Value;
          QItemNFCOD_LOTE_TIPO.Value := CDSItensDevolucaoCOD_LOTE_TIPO.Value;
          QItemNFDESC_INF_ADICIONAL.Value := CDSItensDevolucaoDESC_INF_ADICIONAL.Value;
          wValDescontoTotal := wValDescontoTotal + (CDSItensDevolucaoVAL_DESCONTO.Value /
                                        CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                        CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_DESPESAS.Value := (CDSItensDevolucaoVAL_DESPESAS.Value /
                                        CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                        CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_FRETE.Value := (CDSItensDevolucaoVAL_FRETE.Value /
                                     CDSItensDevolucaoQT_QUANTIDADE.Value) *
                                     CDSItensDevolucaoQT_DEVOLUCAO.Value;
          QItemNFVAL_UNITARIO.Value := CDSItensDevolucaoVAL_UNITARIO.Value;
          QItemNFVAL_ICM_BASE.Value := (CDSItensDevolucaoVAL_ICM_BASE.Value /
                                        CDSItensDevolucaoQT_QUANTIDADE.Value) *
