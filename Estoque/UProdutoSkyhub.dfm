          Lines.Strings = (
            
              'Especifica'#231#245'es ajudam a prover informa'#231#245'es ao comprador. Caso se' +
              'u produto n'#227'o possua tal informa'#231#227'o ent'#227'o  deixe o '
            
              'campo em branco. Quanto mais informa'#231#245'es voc'#234' preencher, mais fi' +
              'el ser'#225' o seu an'#250'ncio. Campos como Cor e Garantia s'#227'o '
            'muito bem vistos  e incentivam a compra do produto.')
