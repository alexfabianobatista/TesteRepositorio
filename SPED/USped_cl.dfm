  object QBuscaTodos: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  DESC_CONTEUDO,'
      '  DESC_CONTEUDO_LONGO'
      'FROM'
      '('
      '  SELECT'
      '    S.DESC_CONTEUDO,'
      '    S.DESC_CONTEUDO_LONGO,'
      '    ROWNUM AS LINHA'
      '  FROM'
      '    TB_SPED S'
      '  INNER JOIN TB_SPED_BLOCO B ON'
      '    B.DESC_BLOCO = S.DESC_BLOCO'
      '  ORDER BY'
      '    B.NUM_ORDEM,'
      '    S.COD_REGISTRO'
      ')'
      'WHERE'
      '  LINHA BETWEEN :LINHA_INI AND :LINHA_FIN')
