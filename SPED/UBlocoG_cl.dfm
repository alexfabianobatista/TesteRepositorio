  object QReg125: TOracleDataSet1
    SQL.Strings = (
      'SELECT item.cod_patrimonio_item, '
      '        cont.val_credito, '
      '        cont.cod_controle_credito_icms, '
      '        item.val_icms, '
      '        item.dt_aquisicao,'
      '        item.cod_nota_cab_entrada'
      'FROM tb_controle_credito_icms cont, tb_patrimonio_item item'
