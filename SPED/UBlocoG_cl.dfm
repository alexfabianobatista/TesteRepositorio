  object QReg140: TOracleDataSet1
    SQL.Strings = (
      'SELECT TB_PRODUTO.COD_PRODUTO,'
      '       TB_PRODUTO.DESC_PRODUTO,'
      '       TB_NOTA_ITEM.QT_QUANTIDADE,'
      '       TB_PRODUTO.DESC_UNIDADE,'
