  object QReg130: TOracleDataSet1
    SQL.Strings = (
      
        'SELECT DECODE(tb_nota_cab.ind_entrada_saida,'#39'E'#39', 1,'#39'S'#39', 2) emite' +
        'nte, '
      '        tb_nota_cab.cod_cadastro, '
