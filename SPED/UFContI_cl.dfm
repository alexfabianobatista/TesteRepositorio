  object QReg075: TOracleDataSet1
    SQL.Strings = (
      'SELECT DISTINCT'
      '  H.COD_HISTORICO_CONTABIL,'
      '  H.DESC_HISTORICO_CONTABIL'
      'FROM'
      '  TB_HISTORICO_CONTABIL H'
      '  INNER JOIN TB_LANCTO_CONTABIL L ON'
      '  H.COD_HISTORICO_CONTABIL = L.COD_HISTORICO_CONTABIL'
      'WHERE'
      '  L.COD_FILIAL IN :FILIAIS'
      '  AND'
      '  L.DT_LANCAMENTO BETWEEN :DT_INI AND :DT_FIN'
      ''
      'UNION'
      ''
      'SELECT DISTINCT'
      '  H.COD_HISTORICO_CONTABIL,'
      '  H.DESC_HISTORICO_CONTABIL'
      'FROM'
      '  TB_FCONT_LANC_EXTEMPORANEO E'
      '    INNER JOIN TB_HISTORICO_CONTABIL H'
      '    ON E.COD_HISTORICO_CONTABIL = H.COD_HISTORICO_CONTABIL')
