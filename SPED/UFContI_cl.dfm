  object QReg050: TOracleDataSet1
    SQL.Strings = (
      'SELECT '
      'COD_PLANO_CONTA,'
      'COD_REDUZIDO,'
      'DESC_PLANO_CONTA,'
      'NUM_GRAU,'
      'NUM_PLANO_CONTA,'
      'DESC_NATUREZA_CONTA,'
      'NUM_GRAUS_CONTABIL,'
      'COD_PLANO_CONTA_REFERENCIAL'
      'FROM('
      '--SALDO CONTABIL'
      'SELECT DISTINCT'
      '  P.COD_PLANO_CONTA COD_PLANO_CONTA,'
      '  P.COD_REDUZIDO COD_REDUZIDO,'
      '  P.DESC_PLANO_CONTA DESC_PLANO_CONTA,'
      '  P.NUM_GRAU NUM_GRAU,'
      '  P.NUM_PLANO_CONTA NUM_PLANO_CONTA,'
      '  P.DESC_NATUREZA_CONTA DESC_NATUREZA_CONTA,'
      '  S.NUM_GRAUS_CONTABIL NUM_GRAUS_CONTABIL,'
      '  R.NUM_PLANO_CONTA_REFERENCIAL COD_PLANO_CONTA_REFERENCIAL'
      'FROM'
      '  TB_PLANO_CONTA P,'
      '  TB_PLANO_CONTA_REFERENCIAL R,'
      '  TB_PARAM_SISTEMA S,'
      '  --TB_LANCTO_CONTABIL L'
      '  TB_SALDO_CONTABIL L'
      'WHERE'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      '  AND'
      
        '  P.COD_PLANO_CONTA_REFERENCIAL = R.COD_PLANO_CONTA_REFERENCIAL(' +
        '+)'
      '  AND'
      '  P.COD_PLANO_CONTA = L.COD_PLANO_CONTA'
      '  AND'
      
        '  --EXTRACT(YEAR FROM L.DT_LANCAMENTO) = EXTRACT(YEAR FROM TO_DA' +
        'TE(:DT_INI, '#39'dd/MM/yyyy'#39'))'
      
        '  SUBSTR(L.DT_ANO_MES,1,4) = EXTRACT(YEAR FROM TO_DATE(:DT_INI, ' +
        #39'dd/MM/yyyy'#39'))'
      '  AND'
      '  P.DESC_NATUREZA_CONTA IN ('#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39')'
      '  AND'
      '  L.COD_FILIAL IN :FILIAIS'
      ''
      'UNION'
      ''
      '--LAN'#199'AMENTOS CONTABEIS'
      'SELECT DISTINCT'
      '  P.COD_PLANO_CONTA COD_PLANO_CONTA,'
      '  P.COD_REDUZIDO COD_REDUZIDO,'
      '  P.DESC_PLANO_CONTA DESC_PLANO_CONTA,'
      '  P.NUM_GRAU NUM_GRAU,'
      '  P.NUM_PLANO_CONTA NUM_PLANO_CONTA,'
      '  P.DESC_NATUREZA_CONTA DESC_NATUREZA_CONTA,'
      '  S.NUM_GRAUS_CONTABIL NUM_GRAUS_CONTABIL,'
      '  R.NUM_PLANO_CONTA_REFERENCIAL COD_PLANO_CONTA_REFERENCIAL'
      'FROM'
      '  TB_PLANO_CONTA P,'
      '  TB_PLANO_CONTA_REFERENCIAL R,'
      '  TB_PARAM_SISTEMA S,'
      '  --TB_LANCTO_CONTABIL L'
      '  TB_LANCTO_CONTABIL L'
      'WHERE'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      '  AND'
      
        '  P.COD_PLANO_CONTA_REFERENCIAL = R.COD_PLANO_CONTA_REFERENCIAL(' +
        '+)'
      '  AND'
      '  P.COD_PLANO_CONTA = L.COD_PLANO_CONTA'
      '  AND'
      
        '  EXTRACT(YEAR FROM L.DT_LANCAMENTO) = EXTRACT(YEAR FROM TO_DATE' +
        '(:DT_INI, '#39'dd/MM/yyyy'#39'))'
      
        '  --SUBSTR(L.DT_ANO_MES,1,4) = EXTRACT(YEAR FROM TO_DATE(:DT_INI' +
        ', '#39'dd/MM/yyyy'#39'))'
      '  AND'
      
        '  P.COD_PLANO_CONTA NOT IN (SELECT COD_PLANO_CONTA FROM TB_SALDO' +
        '_CONTABIL WHERE SUBSTR(DT_ANO_MES,1,4) = EXTRACT(YEAR FROM TO_DA' +
        'TE(:DT_INI, '#39'dd/MM/yyyy'#39')))'
      '  AND'
      '  P.DESC_NATUREZA_CONTA IN ('#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39')'
      '  AND'
      '  L.COD_FILIAL IN :FILIAIS'
      '  '
      'UNION'
      ''
      '--CONTAS SUPERIORES'
      'SELECT DISTINCT'
      '  P.COD_PLANO_CONTA COD_PLANO_CONTA,'
      '  P.COD_REDUZIDO COD_REDUZIDO,'
      '  P.DESC_PLANO_CONTA DESC_PLANO_CONTA,'
      '  P.NUM_GRAU NUM_GRAU,'
      '  P.NUM_PLANO_CONTA NUM_PLANO_CONTA,'
      '  P.DESC_NATUREZA_CONTA DESC_NATUREZA_CONTA,'
      '  S.NUM_GRAUS_CONTABIL NUM_GRAUS_CONTABIL,'
      '  R.NUM_PLANO_CONTA_REFERENCIAL COD_PLANO_CONTA_REFERENCIAL'
      'FROM'
      '  TB_PLANO_CONTA P,'
      '  TB_PLANO_CONTA_REFERENCIAL R,'
      '  TB_PARAM_SISTEMA S  '
      'WHERE'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      '  AND'
      
        '  P.COD_PLANO_CONTA_REFERENCIAL = R.COD_PLANO_CONTA_REFERENCIAL(' +
        '+)'
      '  AND'
      '  P.NUM_GRAU < S.NUM_GRAUS_CONTABIL'
      '  AND '
      '  P.DESC_NATUREZA_CONTA IN ('#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39'))'
      'ORDER BY'
      '  NUM_PLANO_CONTA')
    Variables.Data = {
      0300000002000000080000003A46494C49414953010000002100000053454C45
      435420434F445F46494C49414C2046524F4D2054425F46494C49414C00000000
