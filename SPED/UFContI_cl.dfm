  object QReg051: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  R.NUM_PLANO_CONTA_REFERENCIAL,'
      '  P.NUM_GRAU'
      'FROM'
      '  TB_PLANO_CONTA P'
      
        'LEFT JOIN TB_PLANO_CONTA_REFERENCIAL R ON P.COD_PLANO_CONTA_REFE' +
        'RENCIAL = R.COD_PLANO_CONTA_REFERENCIAL'
      'WHERE'
      '  P.COD_PLANO_CONTA = :COD_PLANO_CONTA'
      ''
      '--Apenas para teste'
      ''
      '/*SELECT'
      '  '#39'30103'#39' NUM_PLANO_CONTA_REFERENCIAL,'
      '  '#39'3'#39' NUM_GRAU'
      'FROM'
      '  TB_PLANO_CONTA P'
      
        'LEFT JOIN TB_PLANO_CONTA_REFERENCIAL R ON P.COD_PLANO_CONTA_REFE' +
        'RENCIAL = R.COD_PLANO_CONTA_REFERENCIAL'
      'WHERE'
      '  P.COD_PLANO_CONTA = :COD_PLANO_CONTA*/')
