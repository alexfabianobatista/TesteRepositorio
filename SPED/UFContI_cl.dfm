  object QReg250: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  P.NUM_PLANO_CONTA AS COD_CTA,'
      
        '  (case when (L.VAL_LANCAMENTO < 0) then L.VAL_LANCAMENTO * (-1)' +
        ' else L.VAL_LANCAMENTO end) as VL_DC,'
      '  L.IND_OPERACAO AS IND_DC  '
      'FROM'
      '  TB_LANCTO_CONTABIL L'
      '  INNER JOIN TB_PLANO_CONTA P'
      '    ON L.COD_PLANO_CONTA = P.COD_PLANO_CONTA'
      'WHERE'
      '  L.DT_LANCAMENTO BETWEEN :DATA_INI AND :DATA_FIN'
      'AND'
      '  L.COD_FILIAL IN :FILIAIS'
      'ORDER BY'
      '  P.NUM_PLANO_CONTA'
      '  ')
    Variables.Data = {
      0300000003000000090000003A444154415F494E490C00000000000000000000
      00090000003A444154415F46494E0C0000000000000000000000080000003A46
      494C4941495301000000040000002831290000000000}
