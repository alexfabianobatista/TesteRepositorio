  object QReg155: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA,'
      
        '  ABS(SUM(DECODE(S.DT_ANO_MES,:DT_ANO_MES_INI,S.VAL_ANTERIOR,0))' +
        ') VL_SLD_INI,'
      
        '  CASE WHEN SUM(DECODE(S.DT_ANO_MES,:DT_ANO_MES_INI,S.VAL_ANTERI' +
        'OR,0)) < 0 THEN '#39'C'#39' ELSE '#39'D'#39' END IND_DC_INI,'
      '  SUM(VAL_DEBITO) AS VAL_DEBITO,'
      '  SUM(ABS(VAL_CREDITO)) AS VAL_CREDITO,'
      
        '  ABS(SUM(DECODE(S.DT_ANO_MES,:DT_ANO_MES_FIN,S.VAL_ATUAL,0))) V' +
        'L_SLD_FIN,'
      
        '  CASE WHEN SUM(DECODE(S.DT_ANO_MES,:DT_ANO_MES_FIN,S.VAL_ATUAL,' +
        '0)) < 0 THEN '#39'C'#39' ELSE '#39'D'#39' END IND_DC_FIN'
      'FROM'
      '  TB_SALDO_CONTABIL S'
      'INNER JOIN TB_PLANO_CONTA P'
      '  ON S.COD_PLANO_CONTA = P.COD_PLANO_CONTA'
      '  AND P.DESC_NATUREZA_CONTA IN ('#39'01'#39','#39'02'#39','#39'03'#39')'
      'WHERE'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      'AND'
      '  P.COD_REDUZIDO IS NOT NULL'
      'AND'
      '  S.DT_ANO_MES BETWEEN :DT_ANO_MES_INI AND :DT_ANO_MES_FIN'
      'AND'
      '  S.COD_FILIAL IN :FILIAIS'
      'GROUP BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      'ORDER BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      ''
      '/*'
      'SELECT'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA,'
      '  SUM(VAL_ANTERIOR) AS VAL_ANTERIOR,'
      '  SUM(VAL_DEBITO) AS VAL_DEBITO,'
      '  SUM(VAL_CREDITO) * -1 AS VAL_CREDITO,'
      '  SUM(VAL_ATUAL) AS VAL_ATUAL'
      'FROM'
      '  TB_SALDO_CONTABIL S'
      'INNER JOIN TB_PLANO_CONTA P'
      '  ON S.COD_PLANO_CONTA = P.COD_PLANO_CONTA'
      '  AND P.DESC_NATUREZA_CONTA IN ('#39'01'#39','#39'02'#39','#39'03'#39')'
      
        '--INNER JOIN TB_LANCTO_CONTABIL L --Para pegar somente contas qu' +
        'e tiveram movimenta'#231#245'es no per'#237'odo'
      '  --ON S.COD_PLANO_CONTA = L.COD_PLANO_CONTA'
      '  --AND L.COD_FILIAL IN (1, 2)'
      
        '--  AND L.DT_LANCAMENTO BETWEEN TO_DATE('#39'01/'#39'||SUBSTR(DT_ANO_MES' +
        ',5,2)||'#39'/'#39'||SUBSTR(DT_ANO_MES,1,4),'#39'DD/MM/YYYY'#39') AND'
      
        '--  LAST_DAY(TO_DATE('#39'01/'#39'||SUBSTR(DT_ANO_MES,5,2)||'#39'/'#39'||SUBSTR(' +
        'DT_ANO_MES,1,4),'#39'DD/MM/YYYY'#39'))  '
      'WHERE'
      '  P.COD_REDUZIDO IS NOT NULL'
      'AND'
      '  S.DT_ANO_MES BETWEEN :DT_ANO_MES_INI AND :DT_ANO_MES_FIN'
      'AND'
      '  S.COD_FILIAL IN :FILIAIS'
      'GROUP BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      'ORDER BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      '*/')
    Variables.Data = {
      0300000003000000080000003A46494C49414953010000000400000028312900
      000000000F0000003A44545F414E4F5F4D45535F494E49050000000000000000
      0000000F0000003A44545F414E4F5F4D45535F46494E05000000000000000000
      0000}
