end;

procedure TFReinfR1000.SBConfirmarClick(Sender: TObject);
begin
  with DMReinf, DMUsuario do
  begin
    QReinfR1000COD_USUARIO.Value := QUsuarioCOD_USUARIO.Value;
    //criado para preencher os campos dos dados que são iguais em todos os datasets.
    //usar para todos os registros do REINF.
    //passando após o dataset os booleans sobre o ambiente de envio e tipo de aplicativo.
    //a chamada padrão tem esses parametros como false para facilitar os testes.
    //chamado   ReinfParametrosXMLHomologacaoAplicativo(dataset, ambiente, tipoaplicativo)
    //para ambiente de produção passar true, para aplicativo do governo passar true
    if DMFilial.QFilialIND_AMBIENTE_REINF.Value = 1 then
      BibDB.ReinfParametrosXMLHomologacaoAplicativo(TDataSet(QReinfR1000), true, false)
    else
      BibDB.ReinfParametrosXMLHomologacaoAplicativo(TDataSet(QReinfR1000), false, false);
    QReinfR1000DT_INI_VALIDADE.Value := dtpkDataInicio.Date;
    if cbFimValidade.Checked then
      QReinfR1000DT_FIM_VALIDADE.Value := dtpkDataFim.Date
    else
      QReinfR1000DT_FIM_VALIDADE.Clear;

    QReinfR1000IND_INC_ALT_EXC.Value := cbTipoR1000.ItemIndex; //0 - inclusao; 1 alteracao; 2 - exclusao
    QReinfR1000COD_USUARIO.Value := QUsuarioConsCOD_USUARIO.Value;

  end;
  inherited;

  LimparCampos;
  AtivarDesativarCampos(TButton(Sender));
  dbgReinfR1000.DataSource.DataSet.Refresh;

end;


procedure TFReinfR1000.SBAlterarClick(Sender: TObject);
begin

  with DMReinf do
  begin
    QReinfR1000.Close;
    QReinfR1000.SetVariable('PK', dbgReinfR1000.DataSource.DataSet.FieldByName('COD_REINF_R1000').Value);
    QReinfR1000.Open;

    FmFilialR1000.MeFilial.Text := QReinfR1000COD_FILIAL.Text;
    FmFilialR1000.MeFilialExit(Self);
    FmCadastroR1000.MeCadastro.Text := QReinfR1000COD_CADASTRO.Text;
    FmCadastroR1000.MeCadastroExit(Self);
  end;
  inherited;
  AtivarDesativarCampos(TButton(Sender));

end;


procedure TFReinfR1000.SBIncluirClick(Sender: TObject);
begin
  inherited;
  LimparCampos;
  AtivarDesativarCampos(TButton(Sender));
  DMReinf.QReinfR1000COD_USUARIO.Value := DMUsuario.CodUsuarioCorrente;
end;

procedure TFReinfR1000.SBExcluirClick(Sender: TObject);
begin

  with DMOracle, DMReinf do
  begin

    if (BuscaNome('SELECT COUNT(COD_REINF_PERIODO) FROM TB_REINF_PERIODO', 'DESC_EVENTO_REINF = ' +
                  QuotedStr('R-1000') +  ' AND COD_EVENTO_REINF = ' + QReinfR1000COD_REINF_R1000.Text) = '0') then
    begin
      if Dialogs.MessageDlg('Isso excluirá todas as informações. Deseja continuar?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
      begin
        inherited;
        dbgReinfR1000.DataSource.DataSet.Refresh;
        AtivarDesativarCampos(TButton(Sender));
      end
      else
        ShowMessage('Cancelado pelo usuário');
    end
    else
      Raise Exception.Create('Já existe evento gerado para envio. Exclua os eventos não enviados para poder alterá-los.');

  end;
  
end;

procedure TFReinfR1000.SBCancelarClick(Sender: TObject);
begin
  inherited;

  AtivarDesativarCampos(TButton(Sender));

end;

procedure TFReinfR1000.dbgReinfR1000CellClick(Column: TColumn);
begin
  with DMReinf do
  begin
    if (QReinfR1000.State in [dsBrowse]) then
    begin
      QReinfR1000.Close;
      QReinfR1000.SetVariable('PK', dbgReinfR1000.DataSource.DataSet.FieldByName('COD_REINF_R1000').Value);
      QReinfR1000.Open;

      FmFilialR1000.MeFilial.Text := QReinfR1000COD_FILIAL.Text;
      FmFilialR1000.MeFilialExit(Self);
      FmCadastroR1000.MeCadastro.Text := QReinfR1000COD_CADASTRO.Text;
      FmCadastroR1000.MeCadastroExit(Self);
      dtpkDataInicio.Date := QReinfR1000DT_INI_VALIDADE.AsDateTime;
      if QReinfR1000DT_FIM_VALIDADE.Text <> '' then
        dtpkDataFim.Date := QReinfR1000DT_FIM_VALIDADE.AsDateTime;

      cbTipoR1000.ItemIndex := QReinfR1000IND_INC_ALT_EXC.Value;//0 - inclusao; 1 alteracao; 2 - exclusao
      cbSituacaoEmpresa.ItemIndex := QReinfR1000IND_SIT_PESSOA_JURIDICA.Value;
    end
    else
      Raise Exception.Create('Os dados não puderam ser abertos! Cancele a operação anterior.');
  end;
  AtivarDesativarCampos(TButton(SBConfirmar));
  inherited;

end;

procedure TFReinfR1000.cbFimValidadeClick(Sender: TObject);
begin
  inherited;
  dtpkDataFim.Enabled := (cbFimValidade.Checked) and (DSPrimario.State in [dsEdit, dsInsert]);
end;

procedure TFReinfR1000.btnGerarEventoClick(Sender: TObject);
var
  GeraXML: TGeraXMLReinf;
begin
  inherited;
  if GeraXML = nil then
    GeraXML := TGeraXMLReinf.Create;

  with DMReinf, DMOracle do
  begin

    // verifica se a query do evento está aberta
    if not (QReinfR1000.State in [dsBrowse]) then
      raise Exception.Create('Não foi possível realizar a geração. O registro deve estar salvo!')
    else
    begin
      if (BuscaNome('SELECT COUNT(COD_REINF_PERIODO) FROM TB_REINF_PERIODO', 'DESC_EVENTO_REINF = ' +
                  QuotedStr('R-1000') +  ' AND COD_EVENTO_REINF = ' + QReinfR1000COD_REINF_R1000.Text) = '0') then
      begin
        // verifica se o evento está selecionado
        if Trim(QReinfR1000COD_REINF_R1000.Text) = '' then
          raise Exception.Create('Deve haver um registro selecionado para geração.')
        else
          GeraXML.GerarR1000(QReinfR1000COD_REINF_R1000.Value, 'R-1000', '1.05.01');
      end
      else
        raise Exception.Create('Este evento já foi gerado!');
    end;
    QReinfPeriodo.Refresh;
  end;

end;

procedure TFReinfR1000.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  inherited;
  Action := caFree;
end;

procedure TFReinfR1000.FormActivate(Sender: TObject);
begin
  inherited;
  if not dbgReinfR1000.DataSource.DataSet.IsEmpty then
    dbgReinfR1000CellClick(dbgReinfR1000.Columns.Items[1]);
end;

end.
