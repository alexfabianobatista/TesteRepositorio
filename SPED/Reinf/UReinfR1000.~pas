procedure TFreinfR1000.AtivarDesativarCampos(Botao: TButton);
var
  isAtivo: boolean;
begin
  isAtivo := (DSPrimario.State in [dsEdit, dsInsert]);
  //desativa a edição dos campos do formulário caso este não esteja em edição ou inserção
  FmFilialR1000.Enabled := isAtivo;
  FmCadastroR1000.Enabled := isAtivo;
  cbSituacaoEmpresa.Enabled := isAtivo;
  dtpkDataInicio.Enabled := isAtivo;
  cbTipoR1000.Enabled := isAtivo;
  dblcbsituacaoTributaria.Enabled := isAtivo;
  cbFimValidade.Enabled := isAtivo;
  dbcbDesoneraFolhaCPRB.Enabled := isAtivo;
  dbcbObrigaEcd.Enabled := isAtivo;
  if DSPrimario.State = dsInsert then
    dbcbObrigaEcd.Checked := false;
  dbcbAcordoMulta.Enabled := isAtivo;

  dbgReinfR1000.Enabled := (DSPrimario.DataSet.RecordCount > 0);

  if Botao.Name = 'SBConfirmar' then
     cbFimValidade.Enabled := false
  else if (DSPrimario.State in [dsEdit]) then
    cbFimValidade.Checked := DMReinf.QReinfR1000DT_FIM_VALIDADE.Text <> '';

  cbFimValidadeClick(Self);
end;

procedure TFReinfR1000.LimparCampos;
begin

  FmFilialR1000.MeFilial.Clear;
  FmFilialR1000.EdFilial.Clear;
  FmCadastroR1000.MeCadastro.Clear;
  FmCadastroR1000.EdCadastro.Clear;
  cbTipoR1000.ItemIndex := -1;
  cbSituacaoEmpresa.ItemIndex := -1;
  dbcbDesoneraFolhaCPRB.Checked := false;
  dbcbObrigaEcd.Checked := false;

end;

procedure TFReinfR1000.FmFilial1BtFilialClick(Sender: TObject);
begin
  inherited;
  if FFilialCons = nil then
    FFilialCons := TFFilialCons.Create(Application);

  if FFilialCons.ShowModal = mrOk then
  begin
    with DMFilial, DMReinf do
    begin
      QFilial.Close;
      QFilial.SetVariable('PK', QFilialConsCod_Filial.Value);
      QFilial.Open;
      QReinfR1000COD_FILIAL.Value := QFilialCOD_FILIAL.Value;
      FmFilialR1000.MeFilial.Text := QFilialCOD_FILIAL.Text;
      FmFilialR1000.EdFilial.Text := QFilialDESC_FILIAL.Text;

      if QFilialCOD_CADASTRO_REINF.Text <> '' then
        FmCadastroR1000.MeCadastro.Text := QFilialCOD_CADASTRO_REINF.Text;

      QReinfR1000COD_CLASSIFICACAO_TRIBUTARIA.Value := QFilialCOD_CLASSIFICACAO_TRIBUTARIA.Value;
      if not (QFilialCOD_CLASSIFICACAO_TRIBUTARIA.Value in [2,3,99]) then
        QReinfR1000IND_DESONERACAO_FOLHA.Value := 0; //na tabela da filial é NAO - VALUEUNCHECKED        

      if (QFilialIND_DESONERACAO_CPRB.Text <> '') and (QFilialIND_DESONERACAO_CPRB.Text <> 'NAO') then
        QReinfR1000IND_DESONERACAO_FOLHA.Value := 1
      else
        QReinfR1000IND_DESONERACAO_FOLHA.Value := 2;

      cbSituacaoEmpresa.ItemIndex := QFilialIND_SITUACAO_REINF.Value;
      QReinfR1000IND_SIT_PESSOA_JURIDICA.Value := QFilialIND_SITUACAO_REINF.Value;
      QReinfR1000IND_PRODUCAO_HOMOLOGACAO.Value := QFilialIND_AMBIENTE_REINF.Value;

      if (QFilialCOD_CADASTRO_REINF.Text <> '') and (QFilialCOD_CADASTRO_REINF.Value > 0) then
      begin
        with DMCadastro do
        begin
          QCadastro.Close;
          QCadastro.SetVariable('PK', QFilialCOD_CADASTRO_REINF.Value);
          QCadastro.Open;

          QReinfR1000COD_CADASTRO.Value := QFilialCOD_CADASTRO_REINF.Value;
          FmCadastroR1000.MeCadastro.Text := QFilialCOD_CADASTRO_REINF.Text;
          FMCadastroR1000.EdCadastro.Text := QCadastroNOME.Text;
        end;
      end;
    end;
  end;

end;

procedure TFReinfR1000.FormCreate(Sender: TObject);
begin
  inherited;
  with DMReinf do
  begin
    QReinfR1000.Open;
    QClassificacaoTributaria.Open;
    QReinfR1000Cons.Open;
  end;
  dtpkDataInicio.DateTime := Today;
  dtpkDataFim.DateTime := Today;
  dtpkDataFim.Enabled := cbFimValidade.Checked;
  AtivarDesativarCampos(TButton(SBConfirmar));
end;

