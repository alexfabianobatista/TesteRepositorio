procedure TFReinfR1000.FmFilialR1000MeFilialExit(Sender: TObject);
begin
  inherited;
  if Trim(FmFilialR1000.MeFilial.Text) <> '' then
  begin
    with DMFilial, DMReinf do
    begin
      QFilial.Close;
      QFilial.SetVariable('PK', StrToInt(Trim(FmFilialR1000.MeFilial.Text)));
      QFilial.Open;
      QReinfR1000COD_FILIAL.Value := QFilialCOD_FILIAL.Value;
      FmFilialR1000.MeFilial.Text := QFilialCOD_FILIAL.Text;
      FmFilialR1000.EdFilial.Text := QFilialDESC_FILIAL.Text;

      if QFilialCOD_CADASTRO_REINF.Text <> '' then
        FmCadastroR1000.MeCadastro.Text := QFilialCOD_CADASTRO_REINF.Text;

      QReinfR1000COD_CLASSIFICACAO_TRIBUTARIA.Value := QFilialCOD_CLASSIFICACAO_TRIBUTARIA.Value;
      if not (QFilialCOD_CLASSIFICACAO_TRIBUTARIA.Value in [2,3,99]) then
        QReinfR1000IND_DESONERACAO_FOLHA.Value := 0; //na tabela da filial é NAO - VALUEUNCHECKED        

      if (QFilialIND_DESONERACAO_CPRB.Text <> '') and (QFilialIND_DESONERACAO_CPRB.Text <> 'NAO') then
        QReinfR1000IND_DESONERACAO_FOLHA.Value := 1
      else
        QReinfR1000IND_DESONERACAO_FOLHA.Value := 2;

      cbSituacaoEmpresa.ItemIndex := QFilialIND_SITUACAO_REINF.Value;
      QReinfR1000IND_SIT_PESSOA_JURIDICA.Value := QFilialIND_SITUACAO_REINF.Value;
      QReinfR1000IND_PRODUCAO_HOMOLOGACAO.Value := QFilialIND_AMBIENTE_REINF.Value;
      QReinfR1000IND_ACORDO_MULTA.Value := 0; // 0 - sem acordo | 1 - com acordo : apenas para orgãos internacionais

      if (QFilialCOD_CADASTRO_REINF.Text <> '') and (QFilialCOD_CADASTRO_REINF.Value > 0) then
      begin
        FmCadastroR1000MeCadastroExit(Self);
      end;
    end;
  end;

end;

procedure TFReinfR1000.FmCadastroR1000MeCadastroExit(Sender: TObject);
begin
  inherited;
  if Trim(FmCadastroR1000.MeCadastro.Text) <> '' then
  begin
    with DMCadastro, DMReinf do
    begin
      QCadastro.Close;
