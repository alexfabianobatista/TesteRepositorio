  object QReg300: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  DT_LANCAMENTO'
      'FROM'
      '  TB_PARAM_SISTEMA S,'
      '  TB_LANCTO_CONTABIL'
      'WHERE'
      
        '  DT_LANCAMENTO BETWEEN :DT_LANCAMENTO_INI AND :DT_LANCAMENTO_FI' +
        'N'
      'AND'
      
        '  TB_LANCTO_CONTABIL.COD_HISTORICO_CONTABIL <> S.COD_HISTORICO_C' +
        'ONTABIL_ZERA_EX'
      'AND'
      '  TB_LANCTO_CONTABIL.COD_FILIAL IN :FILIAIS'
      'GROUP BY'
      '  DT_LANCAMENTO'
      'ORDER BY'
      '  DT_LANCAMENTO')
