  object QReg051: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  CASE'
      '    WHEN (NVL(F.COD_INC_TRIB,-1) < 0)'
      '      OR (F.COD_INC_TRIB = 1) THEN'
      '      1'
      '    WHEN F.COD_INC_TRIB = 2 THEN'
      '      2'
      '  END AS COD_PLAN_REF,'
      '  R.NUM_PLANO_CONTA_REFERENCIAL,'
      '  P.NUM_GRAU'
      'FROM'
      '  TB_PLANO_CONTA P'
      
        '    LEFT JOIN TB_PLANO_CONTA_REFERENCIAL R ON P.COD_PLANO_CONTA_' +
        'REFERENCIAL = R.COD_PLANO_CONTA_REFERENCIAL'
      '    INNER JOIN TB_FILIAL F ON P.COD_FILIAL = F.COD_FILIAL'
      'WHERE'
      '  P.COD_PLANO_CONTA = :COD_PLANO_CONTA')
    Variables.Data = {
      0300000001000000100000003A434F445F504C414E4F5F434F4E544103000000
      0000000000000000}
