  object QReg250: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  L.COD_LANCTO_CONTABIL,'
      '  P.NUM_PLANO_CONTA COD_CTA,'
      '  ABS(L.VAL_LANCAMENTO) VL_DC,'
      '  L.COD_HISTORICO_CONTABIL COD_HIST_PAD,'
      '  '#39'D'#39' AS IND_DC'
      'FROM'
      '  TB_LANCTO_CONTABIL L'
      
        '    INNER JOIN TB_PLANO_CONTA P ON L.COD_PLANO_CONTA = P.COD_PLA' +
        'NO_CONTA'
      '  WHERE'
      '    L.IND_OPERACAO = '#39'D'#39
      '    AND'
      '    (:LIMITE = 0 OR'
      '      L.DT_LANCAMENTO = :DT_LANCAMENTO)'
      '    AND'
      '    (:LIMITE = 0 OR'
      '      L.COD_HISTORICO_CONTABIL = :COD_HISTORICO_CONTABIL)'
      '    AND'
      '    (:LIMITE = 0 OR'
      '      L.COD_FILIAL = :COD_FILIAL)'
      '    AND'
      '    ((:LIMITE > 0 AND'
      '      ABS(L.VAL_LANCAMENTO) = ABS(:VAL_LANCAMENTO)) OR'
      '      :LIMITE = 0)'
      '    AND'
      '    (((:LIMITE > 0) AND '
      '      (:COMPLEMENTO IS NOT NULL) AND'
      
        '      (REGEXP_REPLACE(L.DESC_COMPLEMENTO,'#39'[^A-Za-z0-9]'#39', '#39#39') = :' +
        'COMPLEMENTO)) OR'
      '      (:LIMITE = 0))'
      '    AND'
      '    (:LIMITE = 0 OR'
      
        '      (L.COD_LANCTO_CONTABIL BETWEEN (:COD_LANCTO_CONTABIL-:LIMI' +
        'TE) AND (:COD_LANCTO_CONTABIL+:LIMITE)))'
      '    AND'
      '    (:COD_NOTA_CAB IS NULL OR'
      '      L.COD_NOTA_CAB = :COD_NOTA_CAB)'
      '    AND'
      '    (:COD_CONTA_RECEBER_CAB IS NULL OR'
      '      L.COD_CONTAS_RECEBER_CAB = :COD_CONTA_RECEBER_CAB)'
      '    AND'
      '    (:COD_CONTA_PAGAR_CAB IS NULL OR'
      '      L.COD_CONTA_PAGAR_CAB = :COD_CONTA_PAGAR_CAB)'
      '    AND'
      '    (:COD_BCO_MOVIMENTO IS NULL OR'
      '      L.COD_BCO_MOVIMENTO = :COD_BCO_MOVIMENTO)'
      '    AND'
      '    (:COD_CAIXA_MOV IS NULL OR'
      '      L.COD_CAIXA_MOV = :COD_CAIXA_MOV)'
      '    AND'
      '    (:COD_PLANILHA IS NULL OR'
      '      L.COD_PLANILHA = :COD_PLANILHA)'
      '    AND'
      '    P.IND_LIBERADO_USO = '#39'SIM'#39
      '--    AND'
      '--    ROWNUM = 1'
      'UNION ALL'
      'SELECT'
      '  L.COD_LANCTO_CONTABIL,'
      '  P.NUM_PLANO_CONTA COD_CTA,'
      '  ABS(L.VAL_LANCAMENTO) VL_DC,'
      '  L.COD_HISTORICO_CONTABIL COD_HIST_PAD,'
      '  '#39'C'#39' AS IND_DC'
      'FROM'
      '  TB_LANCTO_CONTABIL L'
      
        '    INNER JOIN TB_PLANO_CONTA P ON L.COD_PLANO_CONTA = P.COD_PLA' +
        'NO_CONTA'
      '  WHERE'
      '    L.IND_OPERACAO = '#39'C'#39
      '    AND'
      '    (:LIMITE = 0 OR'
      '      L.DT_LANCAMENTO = :DT_LANCAMENTO)'
      '    AND'
      '    (:LIMITE = 0 OR'
      '      L.COD_HISTORICO_CONTABIL = :COD_HISTORICO_CONTABIL)'
      '    AND'
      '    (:LIMITE = 0 OR'
      '      L.COD_FILIAL = :COD_FILIAL)'
      '    AND'
      '    ((:LIMITE > 0 AND'
      '      ABS(L.VAL_LANCAMENTO) = ABS(:VAL_LANCAMENTO)) OR'
      '      :LIMITE = 0)'
      '    AND'
      '    (((:LIMITE > 0) AND '
      '      (:COMPLEMENTO IS NOT NULL) AND'
      
        '      (REGEXP_REPLACE(L.DESC_COMPLEMENTO,'#39'[^A-Za-z0-9]'#39', '#39#39') = :' +
        'COMPLEMENTO)) OR'
      '      (:LIMITE = 0))'
      '    AND'
      '    (:LIMITE = 0 OR'
      
        '      (L.COD_LANCTO_CONTABIL BETWEEN (:COD_LANCTO_CONTABIL-:LIMI' +
        'TE) AND (:COD_LANCTO_CONTABIL+:LIMITE)))'
      '    AND'
      '    (:COD_NOTA_CAB IS NULL OR'
      '      L.COD_NOTA_CAB = :COD_NOTA_CAB)'
      '    AND'
      '    (:COD_CONTA_RECEBER_CAB IS NULL OR'
      '      L.COD_CONTAS_RECEBER_CAB = :COD_CONTA_RECEBER_CAB)'
      '    AND'
      '    (:COD_CONTA_PAGAR_CAB IS NULL OR'
      '      L.COD_CONTA_PAGAR_CAB = :COD_CONTA_PAGAR_CAB)'
      '    AND'
      '    (:COD_BCO_MOVIMENTO IS NULL OR'
      '      L.COD_BCO_MOVIMENTO = :COD_BCO_MOVIMENTO)'
      '    AND'
      '    (:COD_CAIXA_MOV IS NULL OR'
      '      L.COD_CAIXA_MOV = :COD_CAIXA_MOV)'
      '    AND'
      '    (:COD_PLANILHA IS NULL OR'
      '      L.COD_PLANILHA = :COD_PLANILHA)'
      '    AND'
      '    P.IND_LIBERADO_USO = '#39'SIM'#39
      '--    AND'
      '--    ROWNUM = 1')
    Variables.Data = {
