  object QReg030: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.DESC_FILIAL,'
      '  F.NUM_CGC,'
      '  F.NUM_NIRE,'
      '  F.DT_NIRE,'
      '  C.DESC_CIDADE,'
      '  T.*,'
      '  NULL AS DT_EX_SOCIAL'
      'FROM'
      '  TB_TERMO_ABERTURA T'
      'INNER JOIN TB_FILIAL F ON T.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN TB_CIDADE C ON F.COD_CIDADE = C.COD_CIDADE'
      'WHERE'
      '  T.COD_FILIAL IN :FILIAIS'
