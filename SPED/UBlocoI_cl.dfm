  object QReg200: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  L.COD_FILIAL,'
      '  DT_LANCAMENTO,'
      
        '  (case when (L.VAL_LANCAMENTO < 0) then L.VAL_LANCAMENTO * (-1)' +
        ' else L.VAL_LANCAMENTO end) as VAL_LANCAMENTO,'
      '  NVL(DESC_COMPLEMENTO,'#39#39') DESC_COMPLEMENTO,'
      
        '  REGEXP_REPLACE(DESC_COMPLEMENTO,'#39'[^A-Za-z0-9]'#39', '#39#39') AS DESC_CO' +
        'MPLEMENTO_PARAM,'
      
        '  decode(L.COD_HISTORICO_CONTABIL, S.COD_HISTORICO_CONTABIL_ZERA' +
        '_EX, '#39'E'#39', '#39'N'#39') AS IND_LANCAMENTO,'
      '  COD_LANCTO_CONTABIL,'
      '  L.IND_OPERACAO,'
      '  P.NUM_PLANO_CONTA,'
      '  P.DESC_NATUREZA_CONTA,'
      '  NVL(COD_HISTORICO_CONTABIL,0) COD_HISTORICO_CONTABIL,'
      '  NVL(COD_NOTA_CAB,0) COD_NOTA_CAB,'
      '  NVL(COD_CONTAS_RECEBER_CAB,0) COD_CONTA_RECEBER_CAB,'
      '  NVL(COD_CONTA_PAGAR_CAB,0) COD_CONTA_PAGAR_CAB,'
      '  NVL(COD_BCO_MOVIMENTO,0) COD_BCO_MOVIMENTO,'
      '  NVL(COD_CAIXA_MOV,0) COD_CAIXA_MOV,'
      '  NVL(COD_PLANILHA,0) COD_PLANILHA,'
      '  L.IND_TIPO_LANCAMENTO_SPED'
      'FROM'
      '  TB_PARAM_SISTEMA S,'
      '  TB_LANCTO_CONTABIL L'
      
        'INNER JOIN TB_PLANO_CONTA P ON L.COD_PLANO_CONTA = P.COD_PLANO_C' +
        'ONTA'
      'WHERE'
      '  L.DT_LANCAMENTO BETWEEN :DATA_INI AND :DATA_FIN'
      'AND'
      '  L.COD_FILIAL IN :FILIAIS'
      'AND'
      '/*  ('
      
        '    ((decode(L.COD_HISTORICO_CONTABIL, S.COD_HISTORICO_CONTABIL_' +
        'ZERA_EX, '#39'E'#39', '#39'N'#39') <> '#39'E'#39') AND S.COD_EMPRESA = '#39'GRASEL'#39')'
      '      OR S.COD_EMPRESA <> '#39'GRASEL'#39
      '  ) '
      'AND*/'
      '  CAST(NVL(P.DESC_NATUREZA_CONTA,0) AS INTEGER) <= 4 '
      'AND'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      'ORDER BY'
      '  DT_LANCAMENTO,'
      '  COD_NOTA_CAB,'
      '  COD_CONTA_RECEBER_CAB,'
      '  COD_CONTA_PAGAR_CAB,'
      '  COD_BCO_MOVIMENTO,'
      '  COD_CAIXA_MOV,  '
      '  COD_PLANILHA,  '
      
        '  (case when (L.VAL_LANCAMENTO < 0) then L.VAL_LANCAMENTO * (-1)' +
        ' else L.VAL_LANCAMENTO end),'
      '  DESC_COMPLEMENTO_PARAM,'
      '  L.COD_LANCTO_CONTABIL')
    Variables.Data = {
      0300000003000000090000003A444154415F494E490C00000000000000000000
      00090000003A444154415F46494E0C0000000000000000000000080000003A46
