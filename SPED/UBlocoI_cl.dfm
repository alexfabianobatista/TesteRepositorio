  object QReg155Trim: TOracleDataSet1
    SQL.Strings = (
      'SELECT '
      '  COD_PLANO_CONTA,'
      '  NUM_PLANO_CONTA,'
      '  SUM(VAL_ANTERIOR) AS VAL_ANTERIOR,'
      '  SUM(VAL_DEBITO) AS VAL_DEBITO,'
      '  SUM(VAL_CREDITO) AS VAL_CREDITO,'
      '  SUM(VAL_ATUAL) AS VAL_ATUAL'
      'FROM'
      '('
      'SELECT'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA,'
      '  0 AS VAL_ANTERIOR,'
      '  SUM(VAL_DEBITO) AS VAL_DEBITO,'
      '  SUM(VAL_CREDITO) * -1 AS VAL_CREDITO,'
      '  0 AS VAL_ATUAL'
      'FROM'
      '  TB_PARAM_SISTEMA PS,'
      '  TB_SALDO_CONTABIL S'
      'INNER JOIN TB_PLANO_CONTA P'
      '  ON S.COD_PLANO_CONTA = P.COD_PLANO_CONTA'#9
      'WHERE'
      '  P.COD_REDUZIDO IS NOT NULL'
      'AND'
      '  DT_ANO_MES between :DT_ANO_MES_INI AND :DT_ANO_MES_FIM'
      'AND'
      '  S.COD_FILIAL IN :FILIAIS'
      'AND'
      '  P.NUM_GRAU = PS.NUM_GRAUS_CONTABIL  '
      'AND'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      'AND'
      '  CAST(NVL(P.DESC_NATUREZA_CONTA,0) AS INTEGER) <= 4'
      'HAVING'
      
        '  ((SUM(VAL_ANTERIOR) <> 0) OR (SUM(VAL_DEBITO) <> 0) OR (SUM(VA' +
        'L_CREDITO) <> 0) OR (SUM(VAL_ATUAL) <> 0))'
      'GROUP BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      '  '
      '  '
      'UNION ALL  '
      ''
      'SELECT'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA,'
      '  SUM(VAL_ANTERIOR) AS VAL_ANTERIOR,'
      '  0 AS VAL_DEBITO,'
      '  0 AS VAL_CREDITO,'
      '  0 AS VAL_ATUAL'
      'FROM'
      '  TB_PARAM_SISTEMA PS,'
      '  TB_SALDO_CONTABIL S'
      'INNER JOIN TB_PLANO_CONTA P'
      '  ON S.COD_PLANO_CONTA = P.COD_PLANO_CONTA'#9
      'WHERE'
      '  P.COD_REDUZIDO IS NOT NULL'
      'AND'
      '  DT_ANO_MES = :DT_ANO_MES_INI'
      'AND'
      '  S.COD_FILIAL IN :FILIAIS'
      'AND'
      '  P.NUM_GRAU = PS.NUM_GRAUS_CONTABIL  '
      'AND'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      'AND'
      '  CAST(NVL(P.DESC_NATUREZA_CONTA,0) AS INTEGER) <= 4'
      'HAVING'
      
        '  ((SUM(VAL_ANTERIOR) <> 0) OR (SUM(VAL_DEBITO) <> 0) OR (SUM(VA' +
        'L_CREDITO) <> 0) OR (SUM(VAL_ATUAL) <> 0))'
      'GROUP BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      ''
      'UNION ALL'
      ''
      'SELECT'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA,'
      '  0 AS VAL_ANTERIOR,'
      '  0 AS VAL_DEBITO,'
      '  0 AS VAL_CREDITO,'
      '  SUM(VAL_ATUAL) AS VAL_ATUAL'
      'FROM'
      '  TB_PARAM_SISTEMA PS,'
      '  TB_SALDO_CONTABIL S'
      'INNER JOIN TB_PLANO_CONTA P'
      '  ON S.COD_PLANO_CONTA = P.COD_PLANO_CONTA'#9
      'WHERE'
      '  P.COD_REDUZIDO IS NOT NULL'
      'AND'
      '  DT_ANO_MES = :DT_ANO_MES_FIM'
      'AND'
      '  S.COD_FILIAL IN :FILIAIS'
      'AND'
      '  P.NUM_GRAU = PS.NUM_GRAUS_CONTABIL  '
      'AND'
      '  P.IND_LIBERADO_USO = '#39'SIM'#39
      'AND'
      '  CAST(NVL(P.DESC_NATUREZA_CONTA,0) AS INTEGER) <= 4'
      'HAVING'
      
        '  ((SUM(VAL_ANTERIOR) <> 0) OR (SUM(VAL_DEBITO) <> 0) OR (SUM(VA' +
        'L_CREDITO) <> 0) OR (SUM(VAL_ATUAL) <> 0))'
      'GROUP BY'
      '  P.COD_PLANO_CONTA,'
      '  P.NUM_PLANO_CONTA'
      ' ) '
      'GROUP BY'
      '  COD_PLANO_CONTA,'
      '  NUM_PLANO_CONTA'
      'ORDER BY'
      '  COD_PLANO_CONTA,'
      '  NUM_PLANO_CONTA')
