  object QReg310: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  COD_PLANO_CONTA + 0.00 AS COD_PLANO_CONTA,'
      '  NUM_PLANO_CONTA,'
      '  SUM(VAL_DEBITO) AS VAL_DEBITO,'
      '  SUM(VAL_CREDITO) AS VAL_CREDITO'
      'FROM'
      '('
      '  SELECT'
      '    L.COD_PLANO_CONTA,'
      '    P.NUM_PLANO_CONTA,'
      '    L.VAL_LANCAMENTO AS VAL_DEBITO,'
      '    0 AS VAL_CREDITO'
      '  FROM'
      '    TB_PARAM_SISTEMA S,'
      '    TB_LANCTO_CONTABIL L'
      '  INNER JOIN TB_PLANO_CONTA P ON'
      '    P.COD_PLANO_CONTA = L.COD_PLANO_CONTA'
      '  WHERE'
      '    L.DT_LANCAMENTO = :DT_LANCAMENTO'
      '  AND'
      '    L.COD_FILIAL IN :FILIAIS'
      '  AND'
      '    L.IND_OPERACAO = '#39'D'#39
      '  AND'
      '    L.COD_HISTORICO_CONTABIL <> S.COD_HISTORICO_CONTABIL_ZERA_EX'
      ''
      '  UNION ALL'
      ''
      '  SELECT'
      '    L.COD_PLANO_CONTA,'
      '    P.NUM_PLANO_CONTA,'
      '    0,'
      '    L.VAL_LANCAMENTO'
      '  FROM'
      '    TB_PARAM_SISTEMA S,'
      '    TB_LANCTO_CONTABIL L'
      '  INNER JOIN TB_PLANO_CONTA P ON'
      '    P.COD_PLANO_CONTA = L.COD_PLANO_CONTA'
      '  WHERE'
      '    L.DT_LANCAMENTO = :DT_LANCAMENTO'
      '  AND'
      '    L.COD_FILIAL IN :FILIAIS'
      '  AND'
      '    L.IND_OPERACAO = '#39'C'#39
      '  AND'
      '    L.COD_HISTORICO_CONTABIL <> S.COD_HISTORICO_CONTABIL_ZERA_EX'
      ')'
      'GROUP BY'
      '  COD_PLANO_CONTA,'
      '  NUM_PLANO_CONTA'
      'ORDER BY'
      '  NUM_PLANO_CONTA')
    Variables.Data = {
      03000000020000000E0000003A44545F4C414E43414D454E544F0C0000000000
      000000000000080000003A46494C4941495301000000230000002853454C4543
      5420434F445F46494C49414C2046524F4D2054425F46494C49414C2900000000
      00}
    QBEDefinition.QBEFieldDefs = {
