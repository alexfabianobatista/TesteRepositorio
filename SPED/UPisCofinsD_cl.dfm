object DMPisCofinsD: TDMPisCofinsD
  OldCreateOrder = False
  Left = 558
  Top = 256
  Height = 275
  Width = 398
  object QReg010: TOracleDataSet1
    SQL.Strings = (
      'SELECT DISTINCT CNPJ FROM'
      '('
      'Select'
      '  TB_FILIAL.NUM_CGC CNPJ'
      'FROM'
      '  TB_CONHECIMENTO,  '
      '  TB_OPERACAO,'
      '  TB_FILIAL  '
      'WHERE  '
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL  '
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO <> '#39'1'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO >= :DATA_INI'
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO <= :DATA_FIN'
      ''
      'union all'
      ''
      'Select'
      '  TB_FILIAL.NUM_CGC CNPJ'
      'FROM'
      '  TB_CONHECIMENTO_FRETE'
      
        'INNER JOIN TB_OPERACAO ON TB_CONHECIMENTO_FRETE.COD_OPERACAO = T' +
        'B_OPERACAO.COD_OPERACAO'
      
        'INNER JOIN TB_FILIAL ON TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_FI' +
        'LIAL.COD_FILIAL'
      'WHERE'
      '  TB_CONHECIMENTO_FRETE.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO >= :DATA_INI'
      'AND'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO <= :DATA_FIN'
      ''
      'union all'
      ''
      'SELECT'
      '  TB_FILIAL.NUM_CGC CNPJ'
      'FROM'
      '  TB_NOTA_ITEM I'
      'INNER JOIN TB_NOTA_CAB N ON N.COD_NOTA_CAB = I.COD_NOTA_CAB'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO = O.COD_OPERACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  O.NUM_LIVROS = 10'
      'AND'
      '  N.DT_RECEBIMENTO between :DATA_INI AND :DATA_FIN'
      ''
      'union all'
      ''
      'SELECT'
      '  TB_FILIAL.NUM_CGC CNPJ'
      'FROM'
      '  TB_NOTA_CAB N'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO_CF = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE_CF = TB_SERIE.COD_SERIE AND ' +
        'TB_SERIE.COD_FILIAL = N.COD_FILIAL'
      '  AND TB_SERIE.COD_SERIE_MODELO = N.COD_SERIE_MODELO_CF)'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_OPERACAO O_NOTA ON N.COD_OPERACAO = O_NOTA.COD_OPE' +
        'RACAO'
      
        'INNER JOIN TB_SERIE TB_SERIE_NOTA ON (N.COD_SERIE = TB_SERIE_NOT' +
        'A.COD_SERIE AND TB_SERIE_NOTA.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE_NOTA.COD_SERIE_MODELO)'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O_NOTA.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O_NOTA.NUM_LIVROS <> 10 or O_NOTA.NUM_LIVROS is null)'
      'AND'
      '  N.DT_RECEBIMENTO between :DATA_INI AND :DATA_FIN'
      'AND'
      '  TB_SERIE_NOTA.COD_SERIE_MODELO <> '#39'06'#39
      'AND'
      '  N.NUM_CONHECIMENTO_FRETE IS NOT NULL'
      'AND'
      '  N.IND_ENTRADA_SAIDA = '#39'E'#39
      'AND'
      '  N.IND_TIPO_FRETE = '#39'FOB'#39
      '  '
      'UNION'
      ''
      '--SERVI'#199'O DE TELECOMUNICAC'#213'ES'
      'SELECT'
      '  TB_FILIAL.NUM_CGC CNPJ'
      'FROM'
      '  TB_NOTA_CAB N'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_OPERACAO O_NOTA ON N.COD_OPERACAO = O_NOTA.COD_OPE' +
        'RACAO'
      
        'INNER JOIN TB_SERIE TB_SERIE_NOTA ON (N.COD_SERIE = TB_SERIE_NOT' +
        'A.COD_SERIE AND TB_SERIE_NOTA.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE_NOTA.COD_SERIE_MODELO)'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O_NOTA.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O_NOTA.NUM_LIVROS <> 10 or O_NOTA.NUM_LIVROS is null)'
      'AND'
      '  N.DT_RECEBIMENTO between :DATA_INI AND :DATA_FIN'
      'AND'
      '  TB_SERIE_NOTA.COD_SERIE_MODELO IN ('#39'21'#39','#39'22'#39')'
      'AND'
      '  N.IND_ENTRADA_SAIDA = '#39'E'#39
      ')')
    Variables.Data = {
      0300000002000000090000003A444154415F494E490C00000000000000000000
      00090000003A444154415F46494E0C0000000000000000000000}
    QBEDefinition.QBEFieldDefs = {040000000100000004000000434E504A010000000000}
    Session = DMOracle.DBCemapa
    Left = 32
    Top = 24
    object QReg010CNPJ: TStringField
      FieldName = 'CNPJ'
      Size = 18
    end
  end
  object QReg100: TOracleDataSet1
    SQL.Strings = (
      'SELECT DISTINCT * FROM'
      '(SELECT'
      '  TB_CONHECIMENTO.COD_CONHECIMENTO + 0.00 AS COD_CONHECIMENTO,'
      '  TB_CONHECIMENTO.COD_CADASTRO + 0.00 AS COD_PART,'
      '  TB_SERIE.COD_SERIE_MODELO AS COD_MOD,'
      '  TB_CONHECIMENTO.IND_SITUACAO,'
      '  TB_SERIE.NUM_SERIE_FISCAL AS SER,'
      '  TB_CONHECIMENTO.NUM_CONHECIMENTO + 0.00 AS NUM_DOC,'
      '  TB_CONHECIMENTO.DT_EMISSAO AS DT_DOC,'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO AS DT_A_P,'
      
        '  TB_CONHECIMENTO.VAL_FRETE + TB_CONHECIMENTO.VAL_PEDAGIO + TB_C' +
        'ONHECIMENTO.VAL_SEGURO AS VL_SERV,'
      '  0 AS VL_DESC,'
      '  1 AS IND_FRT, '
      
        '  DECODE(TB_CONHECIMENTO.PERC_DESCONTO_FRETE,0,TB_CONHECIMENTO.V' +
        'AL_FRETE,TB_CONHECIMENTO.VAL_FRETE * TB_CONHECIMENTO.PERC_DESCON' +
        'TO_FRETE / 100) AS VL_DOC,   '
      
        '  DECODE(VAL_ICMS,0,0,TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECI' +
        'MENTO.VAL_SEGURO,0)) AS VL_BC_ICMS,'
      '  TB_CONHECIMENTO.VAL_ICMS AS VL_ICMS,'
      
        '  DECODE(VAL_ICMS,0,TB_CONHECIMENTO.VAL_PEDAGIO + TB_CONHECIMENT' +
        'O.VAL_SEGURO,TB_CONHECIMENTO.VAL_FRETE + TB_CONHECIMENTO.VAL_PED' +
        'AGIO + TB_CONHECIMENTO.VAL_SEGURO) AS VL_NT,'
      '  TB_CONHECIMENTO.VAL_PIS AS VAL_PIS,'
      '  TB_OPERACAO.COD_CST_PIS AS CST_PIS,'
      '  TB_CONHECIMENTO.VAL_COFINS AS VAL_COFINS,'
      '  TB_OPERACAO.COD_CST_COFINS AS CST_COFINS,'
      '  TB_OPERACAO.IND_TIPO_OPERACAO,'
      '  TB_OPERACAO.IND_EMITE,'
      '  TB_TRIBUTACAO.DESC_SITUACAO_TRIB AS CST_ICMS,'
      '  TB_TRIBUTACAO.PERC_ALIQUOTA AS ALIQ_ICMS,'
      
        '  --DECODE(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_FRETE_CRED, TB_OPERACAO.COD_CONTABIL_FRETE_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  TB_CONHECIMENTO.DESC_CHAVE_ACESSO_CTE,'
      '  '#39'C'#39' AS TIPO'
      'FROM'
      '  TB_CONHECIMENTO,'
      '  TB_CADASTRO,'
      '  TB_OPERACAO,'
      '  TB_TRIBUTACAO,'
      '  TB_FILIAL,'
      '  TB_SERIE'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_TRIBUTACAO = TB_TRIBUTACAO.COD_TRIBUTACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      '  TB_CADASTRO.COD_CADASTRO = TB_CONHECIMENTO.COD_CADASTRO'
      '  AND'
      
        '  (NVL(TB_OPERACAO.PERC_BASE_PIS,-1) >= 0 AND NVL(TB_OPERACAO.PE' +
        'RC_BASE_COFINS,-1) >= 0)'
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO <> '#39'1'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'E'#39
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO >= :DATA_INI'
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO <= :DATA_FIN'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = :COD_FILIAL'
      '  AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      ''
      'UNION ALL'
      ''
      'SELECT'
      
        '  TB_CONHECIMENTO_FRETE.COD_CONHECIMENTO_FRETE + 0.00 AS COD_CON' +
        'HECIMENTO,'
      '  TB_CONHECIMENTO_FRETE.COD_CADASTRO + 0.00 AS COD_PART,'
      
        '  DECODE(TB_SERIE.NUM_SERIE_FISCAL, NULL, '#39'08'#39', TB_SERIE.COD_SER' +
        'IE_MODELO) AS COD_MOD,'
      '  TB_CONHECIMENTO_FRETE.IND_SITUACAO,'
      
        '  DECODE(TB_SERIE.NUM_SERIE_FISCAL, NULL, 8, TB_SERIE.NUM_SERIE_' +
        'FISCAL) SER,'
      '  TB_CONHECIMENTO_FRETE.NUM_FRETE + 0.00 AS NUM_DOC,'
      '  TB_CONHECIMENTO_FRETE.DT_EMISSAO_CONHECIMENTO AS DT_DOC,'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO AS DT_A_P,'
      '  TB_CONHECIMENTO_FRETE.VAL_FRETE AS VL_SERV,'
      '  TB_CONHECIMENTO_FRETE.VAL_DESCONTO VL_DESC,'
      '  1 AS IND_FRT,'
      
        '  TB_CONHECIMENTO_FRETE.VAL_FRETE + TB_CONHECIMENTO_FRETE.VAL_PE' +
        'DAGIO AS VL_DOC,'
      
        '  DECODE(TB_CONHECIMENTO_FRETE.VAL_ICMS,0,0,TB_CONHECIMENTO_FRET' +
        'E.VAL_FRETE)  AS VL_BC_ICMS,'
      '  TB_CONHECIMENTO_FRETE.VAL_ICMS,'
      
        '  DECODE(TB_CONHECIMENTO_FRETE.VAL_ICMS,0,TB_CONHECIMENTO_FRETE.' +
        'VAL_FRETE + TB_CONHECIMENTO_FRETE.VAL_PEDAGIO,TB_CONHECIMENTO_FR' +
        'ETE.VAL_PEDAGIO)  AS VL_NT,'
      '  TB_CONHECIMENTO_FRETE.VAL_PIS,'
      '  TB_OPERACAO.COD_CST_PIS AS CST_PIS,'
      '  TB_CONHECIMENTO_FRETE.VAL_COFINS,'
      '  TB_OPERACAO.COD_CST_COFINS AS CST_COFINS,'
      '  TB_OPERACAO.IND_TIPO_OPERACAO,'
      '  TB_OPERACAO.IND_EMITE,'
      '  TB_TRIBUTACAO.DESC_SITUACAO_TRIB AS CST_ICMS,'
      '  TB_TRIBUTACAO.PERC_ALIQUOTA AS ALIQ_ICMS,'
      
        '  --DECODE(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_FRETE_CRED, TB_OPERACAO.COD_CONTABIL_FRETE_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  '#39#39','
      '  '#39'F'#39
      'FROM'
      '  TB_CONHECIMENTO_FRETE'
      
        'INNER JOIN TB_CADASTRO ON TB_CONHECIMENTO_FRETE.COD_CADASTRO = T' +
        'B_CADASTRO.COD_CADASTRO'
      
        'INNER JOIN TB_TRIBUTACAO ON TB_CONHECIMENTO_FRETE.COD_TRIBUTACAO' +
        ' = TB_TRIBUTACAO.COD_TRIBUTACAO'
      
        'INNER JOIN TB_OPERACAO ON TB_CONHECIMENTO_FRETE.COD_OPERACAO = T' +
        'B_OPERACAO.COD_OPERACAO'
      
        'INNER JOIN TB_FILIAL ON TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_FI' +
        'LIAL.COD_FILIAL'
      
        'LEFT JOIN TB_SERIE ON (TB_CONHECIMENTO_FRETE.COD_SERIE = TB_SERI' +
        'E.COD_SERIE AND TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_SERIE.COD_' +
        'FILIAL'
      
        #9'AND TB_CONHECIMENTO_FRETE.COD_SERIE_MODELO = TB_SERIE.COD_SERIE' +
        '_MODELO)'
      'WHERE'
      '  TB_CONHECIMENTO_FRETE.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'E'#39
      'AND'
      
        '  (NVL(TB_OPERACAO.PERC_BASE_PIS,-1) >= 0 AND NVL(TB_OPERACAO.PE' +
        'RC_BASE_COFINS,-1) >= 0)'
      'AND'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO >= :DATA_INI'
      'AND'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO <= :DATA_FIN'
      'AND'
      '  TB_CONHECIMENTO_FRETE.COD_FILIAL = :COD_FILIAL'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      ''
      'UNION ALL'
      ''
      'SELECT'
      '  N.COD_NOTA_CAB + 0.00,'
      '  N.COD_CADASTRO + 0.00 AS COD_PART,'
      '--  '#39'07'#39','
      '  TB_SERIE.COD_SERIE_MODELO AS COD_MOD,'
      '  N.IND_SITUACAO,'
      '  TB_SERIE.NUM_SERIE_FISCAL AS SER,'
      '  N.NUM_NOTA AS NUM_DOC,'
      '  N.DT_EMISSAO AS DT_DOC,'
      '  N.DT_RECEBIMENTO AS DT_A_P,'
      '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO) AS VL_SERV,'
      '  N.VAL_DESCONTO AS VL_DESC,'
      '  CAST(1 AS NUMBER(1)) IND_FRT,'
      '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO) AS VL_DOC,'
      '  SUM(I.VAL_ICM_BASE) AS VL_BC_ICMS,'
      '  SUM(I.VAL_ICM) AS VL_ICMS,'
      
        '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO) - SUM(I.VAL' +
        '_ICM_BASE) AS VL_NT,'
      '  SUM(I.VAL_PIS),'
      '  O.COD_CST_PIS AS CST_PIS,  '
      '  SUM(I.VAL_CONFINS),'
      '  O.COD_CST_COFINS AS CST_COFINS,  '
      '  O.IND_TIPO_OPERACAO,'
      '  O.IND_EMITE,'
      '  TB_TRIBUTACAO.DESC_SITUACAO_TRIB,'
      '  TB_TRIBUTACAO.PERC_ALIQUOTA,'
      
        '  --DECODE(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_FRETE_CRED, ' +
        'O.COD_CONTABIL_FRETE_DEB) COD_CTA,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  N.DESC_CHAVE_ACESSO_CTE,'
      '  '#39'N'#39
      'FROM'
      '  TB_NOTA_ITEM I'
      'INNER JOIN TB_NOTA_CAB N ON N.COD_NOTA_CAB = I.COD_NOTA_CAB'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE = TB_SERIE.COD_SERIE AND TB_' +
        'SERIE.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO)'
      
        'INNER JOIN TB_TRIBUTACAO ON I.COD_TRIBUTACAO = TB_TRIBUTACAO.COD' +
        '_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_CADASTRO = TB_CADASTRO.COD_CADAS' +
        'TRO'
      'INNER JOIN TB_PRODUTO P ON I.COD_PRODUTO = P.COD_PRODUTO'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  O.NUM_LIVROS = 10'
      'AND'
      '  ((N.IND_ENTRADA_SAIDA = '#39'S'#39' AND N.IND_TIPO_FRETE = '#39'CIF'#39')'
      '  OR'
      '  (N.IND_ENTRADA_SAIDA = '#39'E'#39' AND N.IND_TIPO_FRETE = '#39'FOB'#39'))'
      'AND'
      
        '  (NVL(O.PERC_BASE_PIS,-1) >= 0 AND NVL(O.PERC_BASE_COFINS,-1) >' +
        '= 0)'
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  N.DT_RECEBIMENTO BETWEEN :DATA_INI AND :DATA_FIN'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'AND'
      '  (I.COD_CST_PIS IS NOT NULL OR I.COD_CST_COFINS IS NOT NULL)'
      'GROUP BY'
      '  N.COD_NOTA_CAB,'
      '  N.COD_CADASTRO,'
      '  TB_SERIE.COD_SERIE_MODELO,'
      '  N.IND_SITUACAO,'
      '  N.COD_SERIE,'
      '  N.NUM_NOTA,'
      '  N.DT_EMISSAO,'
      '  N.DT_RECEBIMENTO,'
      '  CAST(0 AS NUMBER(1)),'
      '  N.VAL_DESCONTO,'
      '  CAST(1 AS NUMBER(1)),'
      '  O.IND_TIPO_OPERACAO,'
      '  O.IND_EMITE,'
      '  TB_TRIBUTACAO.DESC_SITUACAO_TRIB,'
      '  TB_TRIBUTACAO.PERC_ALIQUOTA,'
      
        '  DECODE(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_FRETE_CRED, O.' +
        'COD_CONTABIL_FRETE_DEB),'
      '  TB_SERIE.NUM_SERIE_FISCAL,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  N.DESC_CHAVE_ACESSO_CTE,'
      '  O.COD_CST_PIS,'
      '  O.COD_CST_COFINS'
      ''
      'UNION ALL'
      ''
      'SELECT'
      '  N.COD_NOTA_CAB + 0.00,'
      '  N.COD_TRANSPORTADOR + 0.00 AS COD_PART,'
      '  S.COD_SERIE_MODELO AS COD_MOD,'
      '  N.IND_SITUACAO,'
      '  S.NUM_SERIE_FISCAL AS SER,'
      '  N.NUM_CONHECIMENTO_FRETE AS NUM_DOC,'
      '  N.DT_EMISSAO AS DT_DOC,'
      '  N.DT_RECEBIMENTO AS DT_A_P,'
      '  N.VAL_FRETE AS VL_SERV,'
      '  N.VAL_DESCONTO AS VL_DESC,'
      '  CAST(1 AS NUMBER(1)) IND_FRT,'
      '  N.VAL_FRETE AS VL_DOC,  '
      '  N.VAL_ICM_BASE_FRETE AS VL_BC_ICMS,'
      '  N.VAL_ICM_FRETE VL_ICMS,'
      '  N.VAL_FRETE - N.VAL_ICM_BASE_FRETE VL_NT,'
      '  NVL(N.VAL_PIS_FRETE,'
      
        '  ((((N.VAL_FRETE * O.PERC_BASE_PIS) / 100) * PS.PERC_PIS) / 100' +
        '))  AS VAL_PIS,'
      '  O.COD_CST_PIS AS CST_PIS,  '
      '  NVL(N.VAL_COFINS_FRETE,'
      
        '  ((((N.VAL_FRETE * O.PERC_BASE_COFINS) / 100) * PS.PERC_COFINS)' +
        ' / 100)) AS VAL_COFINS,'
      '  O.COD_CST_COFINS AS CST_COFINS,  '
      '  O.IND_TIPO_OPERACAO,'
      '  O.IND_EMITE,'
      '  TB_TRIBUTACAO.DESC_SITUACAO_TRIB,'
      '  TB_TRIBUTACAO.PERC_ALIQUOTA,'
      
        '  --DECODE(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_FRETE_CRED, ' +
        'O.COD_CONTABIL_FRETE_DEB) COD_CTA,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  N.DESC_CHAVE_ACESSO_CTE,'
      '  '#39'I'#39' -- Incluso'
      'FROM'
      '  TB_PARAM_SISTEMA PS,'
      '  TB_NOTA_CAB N'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO_CF = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE S ON (N.COD_SERIE_CF = S.COD_SERIE AND S.COD' +
        '_FILIAL = N.COD_FILIAL '
      '  AND N.COD_SERIE_MODELO_CF = S.COD_SERIE_MODELO)'
      
        'INNER JOIN TB_TRIBUTACAO ON N.COD_TRIBUTACAO_FRETE = TB_TRIBUTAC' +
        'AO.COD_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_TRANSPORTADOR = TB_CADASTRO.COD_' +
        'CADASTRO'
      
        'INNER JOIN TB_OPERACAO O_NOTA ON N.COD_OPERACAO = O_NOTA.COD_OPE' +
        'RACAO'
      
        'INNER JOIN TB_SERIE TB_SERIE_NOTA ON (N.COD_SERIE = TB_SERIE_NOT' +
        'A.COD_SERIE AND TB_SERIE_NOTA.COD_FILIAL = N.COD_FILIAL'
      '  AND TB_SERIE_NOTA.COD_SERIE_MODELO = N.COD_SERIE_MODELO)'
      
        'INNER JOIN TB_CADASTRO TB_CADASTRO_NOTA ON N.COD_TRANSPORTADOR =' +
        ' TB_CADASTRO_NOTA.COD_CADASTRO'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O_NOTA.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O_NOTA.NUM_LIVROS <> 10 OR O_NOTA.NUM_LIVROS IS NULL)'
      'AND'
      
        '  (NVL(O.PERC_BASE_PIS,-1) >= 0 AND NVL(O.PERC_BASE_COFINS,-1) >' +
        '= 0)'
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  N.DT_RECEBIMENTO BETWEEN :DATA_INI AND :DATA_FIN'
      'AND'
      
        '  S.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11'#39', '#39'26'#39 +
        ', '#39'27'#39', '#39'57'#39')'
      'AND'
      '  N.NUM_CONHECIMENTO_FRETE IS NOT NULL'
      'AND'
      '  ((N.IND_ENTRADA_SAIDA = '#39'S'#39' AND N.IND_TIPO_FRETE = '#39'CIF'#39')'
      '  OR'
      '  (N.IND_ENTRADA_SAIDA = '#39'E'#39' AND N.IND_TIPO_FRETE = '#39'FOB'#39'))'
      ')')
    Variables.Data = {
