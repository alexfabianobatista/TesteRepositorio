    object QReg101ALIQ_PIS: TFloatField
      FieldName = 'ALIQ_PIS'
    end
    object QReg101VL_PIS: TFloatField
      FieldName = 'VL_PIS'
    end
    object QReg101COD_CTA: TStringField
