  object QReg101: TOracleDataSet1
    SQL.Strings = (
      'SELECT DISTINCT * FROM( '
      'select'
      '  '#39'0'#39' AS IND_NAT_FRT,'
      
        '  NVL(TB_CONHECIMENTO.COD_CST_PIS, TB_PARAM_SISTEMA.COD_CST_PIS_' +
        'FRETE) AS CST_PIS,'
      
        '  DECODE(TB_OPERACAO.COD_BC_CREDITO_PISCOFINS, NULL, 14, TB_OPER' +
        'ACAO.COD_BC_CREDITO_PISCOFINS) AS NAT_BC_CRED,  '
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,'
      '  TB_CONHECIMENTO.VAL_PIS AS VL_PIS,'
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  TB_OPERACAO.COD_BC_CREDITO_PISCOFINS,'
      
        '  SUM(DECODE(TB_CONHECIMENTO.PERC_DESCONTO_FRETE,0,0,TB_CONHECIM' +
        'ENTO.VAL_FRETE * TB_CONHECIMENTO.PERC_DESCONTO_FRETE / 100)) VL_' +
        'BC_PIS,'
      
        '  SUM(DECODE(TB_CONHECIMENTO.PERC_DESCONTO_FRETE,0,0,TB_CONHECIM' +
        'ENTO.VAL_FRETE * TB_CONHECIMENTO.PERC_DESCONTO_FRETE / 100)) VL_' +
        'ITEM, '
      '  '#39'C'#39' as TIPO'
      'FROM'
      '  TB_CONHECIMENTO,  '
      '  TB_OPERACAO,  '
      '  TB_FILIAL,'
      '  TB_SERIE,'
      '  TB_PARAM_SISTEMA'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
      '  AND  '
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL  '
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO <> '#39'1'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.COD_CONHECIMENTO = :COD_CONHECIMENTO'
      '  AND'
      
        '  TB_SERIE.COD_SERIE_MODELO in ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY '
      '    '#39'0'#39', '
      
        '    NVL(TB_CONHECIMENTO.COD_CST_PIS, TB_PARAM_SISTEMA.COD_CST_PI' +
        'S_FRETE), '
      
        '    DECODE(TB_OPERACAO.COD_BC_CREDITO_PISCOFINS, NULL, 14, TB_OP' +
        'ERACAO.COD_BC_CREDITO_PISCOFINS),  '
      '    TB_PARAM_SISTEMA.PERC_PIS, '
      '    TB_CONHECIMENTO.VAL_PIS, '
      
        '    Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB), '
      '    TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '    TB_OPERACAO.COD_BC_CREDITO_PISCOFINS,'
      '    '#39'C'#39
      ''
      'union all'
      ''
      'select'
      '  '#39'0'#39' AS IND_NAT_FRT,  '
      '  '#39'00'#39' AS CST_PIS,'
      
        '  DECODE(TB_OPERACAO.COD_BC_CREDITO_PISCOFINS, NULL, 14, TB_OPER' +
        'ACAO.COD_BC_CREDITO_PISCOFINS) AS NAT_BC_CRED,  '
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,'
      '  0 AS VL_PIS,'
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  TB_OPERACAO.COD_BC_CREDITO_PISCOFINS,'
      '  SUM(TB_CONHECIMENTO_FRETE.VAL_FRETE) VL_BC_PIS,'
      '  SUM(TB_CONHECIMENTO_FRETE.VAL_FRETE) VL_ITEM,   '
      '  '#39'F'#39' AS TIPO'
      'FROM'
      '  TB_CONHECIMENTO_FRETE'
      
        'INNER JOIN TB_OPERACAO ON TB_CONHECIMENTO_FRETE.COD_OPERACAO = T' +
        'B_OPERACAO.COD_OPERACAO'
      
        'INNER JOIN TB_FILIAL ON TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_FI' +
        'LIAL.COD_FILIAL'
      
        'LEFT JOIN TB_SERIE ON (TB_CONHECIMENTO_FRETE.COD_SERIE = TB_SERI' +
        'E.COD_SERIE AND TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_SERIE.COD_' +
        'FILIAL'
      
        #9'AND TB_CONHECIMENTO_FRETE.COD_SERIE_MODELO = TB_SERIE.COD_SERIE' +
        '_MODELO)'
      'INNER JOIN TB_PARAM_SISTEMA ON 1 = 1'
      'WHERE'
      '  TB_CONHECIMENTO_FRETE.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      
        '  TB_CONHECIMENTO_FRETE.COD_CONHECIMENTO_FRETE = :COD_CONHECIMEN' +
        'TO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY'
      '  '#39'0'#39',  '
      '  '#39'00'#39','
      
        '  DECODE(TB_OPERACAO.COD_BC_CREDITO_PISCOFINS, NULL, 14, TB_OPER' +
        'ACAO.COD_BC_CREDITO_PISCOFINS),  '
      '   TB_PARAM_SISTEMA.PERC_PIS,'
      '  0,'
      
        '  Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_CON' +
        'TABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB),'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  TB_OPERACAO.COD_BC_CREDITO_PISCOFINS'
      '  '
      'union all'
      ''
      'select'
      '  '#39'0'#39' AS IND_NAT_FRT,  '
      
        '  NVL(I.COD_CST_PIS, DECODE(N.IND_ENTRADA_SAIDA, '#39'E'#39', P.COD_CST_' +
        'PIS, P.COD_CST_PIS_SAIDA)) CST_PIS,'
      
        '  DECODE(O.COD_BC_CREDITO_PISCOFINS, NULL, 14, O.COD_BC_CREDITO_' +
        'PISCOFINS) AS NAT_BC_CRED,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,'
      '  NVL(SUM(I.VAL_PIS), 0) AS VL_PIS,'
      
        '  --Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_PIS_CRED, O.' +
        'COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  O.COD_BC_CREDITO_PISCOFINS,'
      '  SUM(I.VAL_TOTAL - I.VAL_DESCONTO) VL_BC_PIS,  '
      '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO) VL_ITEM,'
      '  '#39'N'#39' AS TIPO'
      'FROM'
      '  TB_NOTA_ITEM I'
      'INNER JOIN TB_NOTA_CAB N ON N.COD_NOTA_CAB = I.COD_NOTA_CAB'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE = TB_SERIE.COD_SERIE AND TB_' +
        'SERIE.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO)'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      'INNER JOIN TB_PRODUTO P ON I.COD_PRODUTO = P.COD_PRODUTO'
      'INNER JOIN TB_PARAM_SISTEMA ON 1 = 1'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  O.NUM_LIVROS = 10'
      'AND'
      '  I.COD_NOTA_CAB = :COD_CONHECIMENTO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY'
      '  '#39'0'#39',  '
      
        '  NVL(I.COD_CST_PIS, DECODE(N.IND_ENTRADA_SAIDA, '#39'E'#39', P.COD_CST_' +
        'PIS, P.COD_CST_PIS_SAIDA)),'
      '  TB_PARAM_SISTEMA.PERC_PIS,'
      
        '  DECODE(O.COD_BC_CREDITO_PISCOFINS, NULL, 14, O.COD_BC_CREDITO_' +
        'PISCOFINS),'
      '  0,'
      
        '  Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_PIS_CRED, O.CO' +
        'D_CONTABIL_PIS_DEB),'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  O.COD_BC_CREDITO_PISCOFINS'
      'union all'
      ''
      'select'
      '  '#39'0'#39' AS IND_NAT_FRT,  '
      '  DECODE(O.IND_TIPO_OPERACAO, '#39'E'#39','#39'50'#39','#39'01'#39') AS CST_PIS,'
      
        '  DECODE(O.COD_BC_CREDITO_PISCOFINS, NULL, 14, O.COD_BC_CREDITO_' +
        'PISCOFINS) AS NAT_BC_CRED,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,'
      '  (N.VAL_FRETE * TB_PARAM_SISTEMA.PERC_PIS) / 100 AS VL_PIS,'
      
        '  --Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_PIS_CRED, O.' +
        'COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  O.COD_BC_CREDITO_PISCOFINS,'
      '  N.VAL_FRETE VL_BC_PIS,  '
      '  N.VAL_FRETE VL_ITEM,'
      '  '#39'I'#39' AS TIPO -- Incluso'
      'FROM'
      '  TB_PARAM_SISTEMA,'
      '  TB_NOTA_CAB N'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO_CF = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE_CF = TB_SERIE.COD_SERIE AND ' +
        'TB_SERIE.COD_FILIAL = N.COD_FILIAL)'
      
        'INNER JOIN TB_TRIBUTACAO ON N.COD_TRIBUTACAO_FRETE = TB_TRIBUTAC' +
        'AO.COD_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_TRANSPORTADOR = TB_CADASTRO.COD_' +
        'CADASTRO'
      
        'INNER JOIN TB_OPERACAO O_NOTA ON N.COD_OPERACAO = O_NOTA.COD_OPE' +
        'RACAO'
      
        'INNER JOIN TB_SERIE TB_SERIE_NOTA ON (N.COD_SERIE = TB_SERIE_NOT' +
        'A.COD_SERIE AND TB_SERIE_NOTA.COD_FILIAL = N.COD_FILIAL)'
      
        'INNER JOIN TB_CADASTRO TB_CADASTRO_NOTA ON N.COD_TRANSPORTADOR =' +
        ' TB_CADASTRO_NOTA.COD_CADASTRO'
      'WHERE'
      '  N.IND_SITUACAO <> '#39'1'#39
      'AND'
      '  O_NOTA.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O_NOTA.NUM_LIVROS <> 10 or O_NOTA.NUM_LIVROS is null)'
      'AND'
      '  N.COD_NOTA_CAB = :COD_CONHECIMENTO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      ') T'
      'WHERE'
      '  T.TIPO = :TIPO')
    Variables.Data = {
      0300000002000000110000003A434F445F434F4E484543494D454E544F030000
      000000000000000000050000003A5449504F050000000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      040000000A0000000B000000494E445F4E41545F465254010000000000070000
      004353545F50495301000000000008000000414C49515F504953010000000000
      06000000564C5F50495301000000000007000000434F445F4354410100000000
      0009000000564C5F42435F50495301000000000007000000564C5F4954454D01
      0000000000040000005449504F0100000000000B0000004E41545F42435F4352
      454401000000000018000000434F445F42435F4352454449544F5F504953434F
      46494E53010000000000}
