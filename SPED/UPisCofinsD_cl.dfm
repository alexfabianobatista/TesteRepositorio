  object QReg201: TOracleDataSet1
    SQL.Strings = (
      'Select'
      
        '  NVL(TB_CONHECIMENTO.COD_CST_PIS, TB_PARAM_SISTEMA.COD_CST_PIS_' +
        'FRETE) CST_PIS,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,  '
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  --SUM(TB_CONHECIMENTO.VAL_PIS) AS VL_PIS,'
      
        '  (SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAG' +
        'IO,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0) - TB_CONHECIMENTO.VAL_' +
        'ICMS)'
      '    * (TB_PARAM_SISTEMA.PERC_PIS /100)) VL_PIS,'
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)) AS VL_ITEM, '
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0) - TB_CONHECIMENTO.VAL_I' +
        'CMS) AS VL_BC_PIS,'
      '  SUM(TB_CONHECIMENTO.VAL_ICMS) as VL_ICMS,'
      '  '#39'C'#39' as TIPO'
      'FROM'
      '  TB_CONHECIMENTO,'
      '  TB_CADASTRO,'
      '  TB_OPERACAO,'
      '  TB_TRIBUTACAO,'
      '  TB_FILIAL,'
      '  TB_SERIE,'
      '  TB_PARAM_SISTEMA'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO  '
      '  AND'
      '  TB_CONHECIMENTO.COD_TRIBUTACAO = TB_TRIBUTACAO.COD_TRIBUTACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      '  TB_CADASTRO.COD_CADASTRO = TB_CONHECIMENTO.COD_CADASTRO'
      '  AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO = '#39'2'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO = :DATA_REF  '
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = :COD_FILIAL'
      '  AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) = :CFOP'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      '  AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39')'
      'GROUP BY '
      
        '  NVL(TB_CONHECIMENTO.COD_CST_PIS, TB_PARAM_SISTEMA.COD_CST_PIS_' +
        'FRETE),'
      '  TB_PARAM_SISTEMA.PERC_PIS,  '
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  '#39'C'#39
      '  '
      'union all'
      ''
      'Select'
      
        '  NVL(TB_CONHECIMENTO.COD_CST_PIS, NVL(TB_OPERACAO.COD_CST_PIS,T' +
        'B_PARAM_SISTEMA.COD_CST_PIS_FRETE)) CST_PIS,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,  '
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  --SUM(TB_CONHECIMENTO.VAL_PIS) AS VL_PIS,'
      
        '  (SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAG' +
        'IO,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0) - TB_CONHECIMENTO.VAL_' +
        'ICMS)'
      '    * (TB_PARAM_SISTEMA.PERC_PIS/100))VL_PIS,'
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)) AS VL_ITEM, '
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0) - TB_CONHECIMENTO.VAL_I' +
        'CMS) as VL_BC_PIS,'
      '  SUM(TB_CONHECIMENTO.VAL_ICMS) as VL_ICMS,'
      '  '#39'CT-E'#39' as TIPO'
      'FROM'
      '  TB_CONHECIMENTO,'
      '  TB_CADASTRO,'
      '  TB_OPERACAO,'
      '  TB_TRIBUTACAO,'
      '  TB_FILIAL,'
      '  TB_SERIE,'
      '  TB_PARAM_SISTEMA'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO  '
      '  AND'
      '  TB_CONHECIMENTO.COD_TRIBUTACAO = TB_TRIBUTACAO.COD_TRIBUTACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      
        '  TB_CADASTRO.COD_CADASTRO = TB_CONHECIMENTO.COD_CADASTRO_TOMADO' +
        'R'
      '  AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO = '#39'2'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO = :DATA_REF  '
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = :COD_FILIAL'
      '  AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) = :CFOP'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO IN ('#39'57'#39')'
      'GROUP BY '
      
        '  NVL(TB_CONHECIMENTO.COD_CST_PIS, NVL(TB_OPERACAO.COD_CST_PIS,T' +
        'B_PARAM_SISTEMA.COD_CST_PIS_FRETE)),'
      '  TB_PARAM_SISTEMA.PERC_PIS,  '
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  '#39'CT-E'#39
      ''
      'union all'
      ''
      'Select'
      '  '#39'00'#39' CST_PIS,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,  '
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_PIS_CRED, TB_OPERACAO.COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  SUM(0) AS VL_PIS,'
      
        '  SUM(TB_CONHECIMENTO_FRETE.VAL_FRETE + TB_CONHECIMENTO_FRETE.VA' +
        'L_PEDAGIO) AS VL_ITEM,'
      
        '  SUM(TB_CONHECIMENTO_FRETE.VAL_FRETE + TB_CONHECIMENTO_FRETE.VA' +
        'L_PEDAGIO - TB_CONHECIMENTO_FRETE.VAL_ICMS) VL_BC_PIS,'
      '  SUM(TB_CONHECIMENTO_FRETE.VAL_ICMS) as VL_ICMS,'
      '  '#39'F'#39
      'FROM'
      '  TB_CONHECIMENTO_FRETE'
      
        'INNER JOIN TB_CADASTRO ON TB_CONHECIMENTO_FRETE.COD_CADASTRO = T' +
        'B_CADASTRO.COD_CADASTRO'
      
        'INNER JOIN TB_TRIBUTACAO ON TB_CONHECIMENTO_FRETE.COD_TRIBUTACAO' +
        ' = TB_TRIBUTACAO.COD_TRIBUTACAO'
      
        'INNER JOIN TB_OPERACAO ON TB_CONHECIMENTO_FRETE.COD_OPERACAO = T' +
        'B_OPERACAO.COD_OPERACAO'
      
        'INNER JOIN TB_FILIAL ON TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_FI' +
        'LIAL.COD_FILIAL'
      
        'LEFT JOIN TB_SERIE ON (TB_CONHECIMENTO_FRETE.COD_SERIE = TB_SERI' +
        'E.COD_SERIE AND TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_SERIE.COD_' +
        'FILIAL'
      
        #9'AND TB_CONHECIMENTO_FRETE.COD_SERIE_MODELO = TB_SERIE.COD_SERIE' +
        '_MODELO)'
      'INNER JOIN TB_PARAM_SISTEMA ON 1 = 1'
      'WHERE'
      '  TB_CONHECIMENTO_FRETE.IND_SITUACAO = '#39'2'#39
      'AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39
      'AND'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO = :DATA_REF'
      'AND'
      '  TB_CONHECIMENTO_FRETE.COD_FILIAL = :COD_FILIAL'
      'AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) = :CFOP'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY'
      '  '#39'00'#39','
      '  TB_PARAM_SISTEMA.PERC_PIS,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  '#39'F'#39
      '  '
      'union all'
      ''
      'SELECT'
      
        '  NVL(I.COD_CST_PIS, DECODE(N.IND_ENTRADA_SAIDA, '#39'E'#39', P.COD_CST_' +
        'PIS, P.COD_CST_PIS_SAIDA)) CST_PIS,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,  '
      
        '  --Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_PIS_CRED, O.' +
        'COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  --NVL(SUM(I.VAL_PIS), 0) AS VL_PIS,'
      
        '  NVL(SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO - I.VAL_' +
        'ICM)*(TB_PARAM_SISTEMA.PERC_PIS/100), 0) AS VL_PIS,'
      '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO) AS VL_ITEM,'
      
        '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO - I.VAL_ICM)' +
        ' VL_BC_PIS,  '
      '  SUM(I.VAL_ICM) as VL_ICMS,'
      '  '#39'N'#39
      'FROM'
      '  TB_NOTA_ITEM I'
      'INNER JOIN TB_NOTA_CAB N ON N.COD_NOTA_CAB = I.COD_NOTA_CAB'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE = TB_SERIE.COD_SERIE AND TB_' +
        'SERIE.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO)'
      
        'INNER JOIN TB_TRIBUTACAO ON I.COD_TRIBUTACAO = TB_TRIBUTACAO.COD' +
        '_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_CADASTRO = TB_CADASTRO.COD_CADAS' +
        'TRO'
      'INNER JOIN TB_PRODUTO P ON I.COD_PRODUTO = P.COD_PRODUTO'
      'INNER JOIN TB_PARAM_SISTEMA ON 1 = 1'
      'WHERE'
      '  N.IND_SITUACAO = '#39'2'#39
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  O.NUM_LIVROS = 10'
      'AND'
      '  O.IND_TIPO_OPERACAO = '#39'S'#39
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  N.DT_RECEBIMENTO = :DATA_REF'
      'AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, O.NU' +
        'M_NATUREZA_EST_NOVO, O.NUM_NATUREZA_INT_NOVO) as number(4)) = :C' +
        'FOP'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY'
      
        '  NVL(I.COD_CST_PIS, DECODE(N.IND_ENTRADA_SAIDA, '#39'E'#39', P.COD_CST_' +
        'PIS, P.COD_CST_PIS_SAIDA)),'
      '  TB_PARAM_SISTEMA.PERC_PIS,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  '#39'N'#39
      ''
      'union all'
      ''
      'SELECT'
      '  DISTINCT'
      '  '#39'50'#39' CST_PIS,'
      '  TB_PARAM_SISTEMA.PERC_PIS ALIQ_PIS,'
      
        '  --Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_PIS_CRED, O.' +
        'COD_CONTABIL_PIS_DEB) COD_CTA,'
      '  O.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      
        '  ((N.VAL_FRETE - N.VAL_ICM_FRETE * TB_PARAM_SISTEMA.PERC_PIS) /' +
        ' 100)  AS VL_PIS,'
      '  N.VAL_FRETE AS VL_ITEM,'
      '  N.VAL_FRETE - N.VAL_ICM_FRETE VL_BC_PIS,'
      '  N.VAL_ICM_FRETE VL_ICMS,'
      '  '#39'I'#39' -- Incluso'
      'FROM'
      '  TB_PARAM_SISTEMA,'
      '  TB_NOTA_CAB N'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO_CF = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE_CF = TB_SERIE.COD_SERIE AND ' +
        'TB_SERIE.COD_FILIAL = N.COD_FILIAL)'
      
        'INNER JOIN TB_TRIBUTACAO ON N.COD_TRIBUTACAO_FRETE = TB_TRIBUTAC' +
        'AO.COD_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_TRANSPORTADOR = TB_CADASTRO.COD_' +
        'CADASTRO'
      
        'INNER JOIN TB_OPERACAO O_NOTA ON N.COD_OPERACAO = O_NOTA.COD_OPE' +
        'RACAO'
      
        'INNER JOIN TB_SERIE TB_SERIE_NOTA ON (N.COD_SERIE_CF = TB_SERIE_' +
        'NOTA.COD_SERIE AND TB_SERIE_NOTA.COD_FILIAL = N.COD_FILIAL)'
      
        'INNER JOIN TB_CADASTRO TB_CADASTRO_NOTA ON N.COD_TRANSPORTADOR =' +
        ' TB_CADASTRO_NOTA.COD_CADASTRO'
      'WHERE'
      '  N.IND_SITUACAO = '#39'2'#39
      'AND'
      '  O_NOTA.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O_NOTA.NUM_LIVROS <> 10 or O_NOTA.NUM_LIVROS is null)'
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  N.DT_EMISSAO_CF = :DATA_REF '
      'AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, O.NU' +
        'M_NATUREZA_EST_NOVO, O.NUM_NATUREZA_INT_NOVO) as number(4)) = :C' +
        'FOP'
      'AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      'AND'
      
        '  TB_SERIE_NOTA.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39 +
        ', '#39'11'#39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'AND'
      '  N.NUM_CONHECIMENTO_FRETE IS NOT NULL'
      'AND'
      '  N.IND_ENTRADA_SAIDA = '#39'S'#39
      'AND'
      '  N.IND_TIPO_FRETE = '#39'CIF'#39)
    Variables.Data = {
      03000000040000000B0000003A434F445F46494C49414C030000000000000000
      000000090000003A444154415F5245460C000000000000000000000005000000
      3A43464F50030000000000000000000000110000003A434F445F53455249455F
      4D4F44454C4F050000000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      0400000008000000070000004353545F50495301000000000008000000414C49
      515F50495301000000000006000000564C5F5049530100000000000700000043
      4F445F43544101000000000007000000564C5F4954454D010000000000090000
      00564C5F42435F504953010000000000040000005449504F0100000000000700
      0000564C5F49434D53010000000000}
    Session = DMOracle.DBCemapa
    Left = 96
    Top = 80
    object QReg201CST_PIS: TStringField
      FieldName = 'CST_PIS'
      Size = 2
    end
    object QReg201ALIQ_PIS: TFloatField
      FieldName = 'ALIQ_PIS'
    end
    object QReg201VL_PIS: TFloatField
      FieldName = 'VL_PIS'
    end
    object QReg201COD_CTA: TStringField
      FieldName = 'COD_CTA'
      Size = 15
    end
    object QReg201VL_BC_PIS: TFloatField
      FieldName = 'VL_BC_PIS'
    end
    object QReg201TIPO: TStringField
      FieldName = 'TIPO'
      Size = 1
    end
    object QReg201VL_ITEM: TFloatField
      FieldName = 'VL_ITEM'
    end
    object QReg201VL_ICMS: TFloatField
      FieldName = 'VL_ICMS'
    end
  end
  object QReg205: TOracleDataSet1
    SQL.Strings = (
      'Select'
      
        '  NVL(TB_CONHECIMENTO.COD_CST_COFINS, NVL(TB_OPERACAO.COD_CST_CO' +
        'FINS,TB_PARAM_SISTEMA.COD_CST_COFINS_FRETE)) CST_COFINS,'
      '  TB_PARAM_SISTEMA.PERC_COFINS ALIQ_COFINS,'
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_COFINS_CRED, TB_OPERACAO.COD_CONTABIL_COFINS_DEB) COD_CT' +
        'A,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  --SUM(TB_CONHECIMENTO.VAL_COFINS) AS VL_COFINS,'
      
        '  (SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAG' +
        'IO,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)'
      '    - TB_CONHECIMENTO.VAL_ICMS)'
      '    * TB_PARAM_SISTEMA.PERC_COFINS) / 100 AS VL_COFINS,'
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)) AS VL_ITEM, '
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)) - SUM(TB_CONHECIMENTO.' +
        'VAL_ICMS) VL_BC_COFINS,'
      '  SUM(TB_CONHECIMENTO.VAL_ICMS) VL_ICMS,'
      '  '#39'C'#39' as TIPO'
      'FROM'
      '  TB_CONHECIMENTO,'
      '  TB_CADASTRO,'
      '  TB_OPERACAO,'
      '  TB_TRIBUTACAO,'
      '  TB_FILIAL,'
      '  TB_SERIE,'
      '  TB_PARAM_SISTEMA'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_TRIBUTACAO = TB_TRIBUTACAO.COD_TRIBUTACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      '  TB_CADASTRO.COD_CADASTRO = TB_CONHECIMENTO.COD_CADASTRO'
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO = '#39'2'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39'  '
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO = :DATA_REF'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = :COD_FILIAL'
      '  AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) = :CFOP'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      '  AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39')'
      'GROUP BY '
      '  NVL(TB_CONHECIMENTO.COD_CST_COFINS, '
      
        '  NVL(TB_OPERACAO.COD_CST_COFINS,TB_PARAM_SISTEMA.COD_CST_COFINS' +
        '_FRETE)), '
      '  TB_PARAM_SISTEMA.PERC_COFINS, '
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_COFINS_CRED, TB_OPERACAO.COD_CONTABIL_COFINS_DEB), '
      '  '#39'C'#39
      ''
      'union all'
      ''
      'Select'
      
        '  NVL(TB_CONHECIMENTO.COD_CST_COFINS, NVL(TB_OPERACAO.COD_CST_CO' +
        'FINS,TB_PARAM_SISTEMA.COD_CST_COFINS_FRETE)) CST_COFINS,'
      '  TB_PARAM_SISTEMA.PERC_COFINS ALIQ_COFINS,  '
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_COFINS_CRED, TB_OPERACAO.COD_CONTABIL_COFINS_DEB) COD_CT' +
        'A,'
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB AS COD_CTA,'
      '  --SUM(TB_CONHECIMENTO.VAL_COFINS) AS VL_COFINS,'
      
        '  (SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAG' +
        'IO,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)'
      '    - TB_CONHECIMENTO.VAL_ICMS)'
      '    * TB_PARAM_SISTEMA.PERC_COFINS) / 100 AS VL_COFINS,'
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0)) AS VL_ITEM, '
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + NVL(TB_CONHECIMENTO.VAL_PEDAGI' +
        'O,0) + NVL(TB_CONHECIMENTO.VAL_SEGURO,0) - TB_CONHECIMENTO.VAL_I' +
        'CMS) VL_BC_COFINS,'
      '  SUM(TB_CONHECIMENTO.VAL_ICMS) VL_ICMS,'
      '  '#39'CT-E'#39' as TIPO'
      'FROM'
      '  TB_CONHECIMENTO,'
      '  TB_CADASTRO,'
      '  TB_OPERACAO,'
      '  TB_TRIBUTACAO,'
      '  TB_FILIAL,'
      '  TB_SERIE,'
      '  TB_PARAM_SISTEMA'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_TRIBUTACAO = TB_TRIBUTACAO.COD_TRIBUTACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      
        '  TB_CADASTRO.COD_CADASTRO = TB_CONHECIMENTO.COD_CADASTRO_TOMADO' +
        'R'
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO = '#39'2'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39'  '
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO = :DATA_REF'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = :COD_FILIAL'
      '  AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) = :CFOP'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO IN ('#39'57'#39')'
      'GROUP BY '
      
        '  NVL(TB_CONHECIMENTO.COD_CST_COFINS, NVL(TB_OPERACAO.COD_CST_CO' +
        'FINS,TB_PARAM_SISTEMA.COD_CST_COFINS_FRETE)), '
      '  TB_PARAM_SISTEMA.PERC_COFINS, '
      
        '  --Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_C' +
        'ONTABIL_COFINS_CRED, TB_OPERACAO.COD_CONTABIL_COFINS_DEB), '
      '  TB_OPERACAO.COD_CONTABIL_NOTA_SPED_CONTRIB,'
      '  '#39'CT-E'#39
      ''
      'union all'
      ''
      'Select'
      '  '#39'00'#39' CST_COFINS,'
      '  TB_PARAM_SISTEMA.PERC_COFINS ALIQ_COFINS,  '
      
        '  Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_CON' +
        'TABIL_COFINS_CRED, TB_OPERACAO.COD_CONTABIL_COFINS_DEB) COD_CTA,'
      '  SUM(0) AS VL_COFINS,'
      
        '  SUM(TB_CONHECIMENTO_FRETE.VAL_FRETE + TB_CONHECIMENTO_FRETE.VA' +
        'L_PEDAGIO) AS VL_ITEM,'
      
        '  SUM(TB_CONHECIMENTO_FRETE.VAL_FRETE + TB_CONHECIMENTO_FRETE.VA' +
        'L_PEDAGIO - TB_CONHECIMENTO_FRETE.VAL_ICMS) VL_BC_COFINS,'
      '  SUM(TB_CONHECIMENTO_FRETE.VAL_ICMS) VL_ICMS,'
      '  '#39'F'#39
      'FROM'
      '  TB_CONHECIMENTO_FRETE'
      
        'INNER JOIN TB_CADASTRO ON TB_CONHECIMENTO_FRETE.COD_CADASTRO = T' +
        'B_CADASTRO.COD_CADASTRO'
      
        'INNER JOIN TB_TRIBUTACAO ON TB_CONHECIMENTO_FRETE.COD_TRIBUTACAO' +
        ' = TB_TRIBUTACAO.COD_TRIBUTACAO'
      
        'INNER JOIN TB_OPERACAO ON TB_CONHECIMENTO_FRETE.COD_OPERACAO = T' +
        'B_OPERACAO.COD_OPERACAO'
      
        'INNER JOIN TB_FILIAL ON TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_FI' +
        'LIAL.COD_FILIAL'
      
        'LEFT JOIN TB_SERIE ON (TB_CONHECIMENTO_FRETE.COD_SERIE = TB_SERI' +
        'E.COD_SERIE AND TB_CONHECIMENTO_FRETE.COD_FILIAL = TB_SERIE.COD_' +
        'FILIAL'
      
        #9'AND TB_CONHECIMENTO_FRETE.COD_SERIE_MODELO = TB_SERIE.COD_SERIE' +
        '_MODELO)'
      'INNER JOIN TB_PARAM_SISTEMA ON 1 = 1'
      'WHERE'
      '  TB_CONHECIMENTO_FRETE.IND_SITUACAO = '#39'2'#39
      'AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39
      'AND'
      '  TB_CONHECIMENTO_FRETE.DT_RECEBIMENTO = :DATA_REF'
      'AND'
      '  TB_CONHECIMENTO_FRETE.COD_FILIAL = :COD_FILIAL'
      'AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) = :CFOP'
      'AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY'
      '  '#39'00'#39','
      '  TB_PARAM_SISTEMA.PERC_COFINS,'
      
        '  Decode(TB_OPERACAO.IND_TIPO_OPERACAO, '#39'E'#39', TB_OPERACAO.COD_CON' +
        'TABIL_COFINS_CRED, TB_OPERACAO.COD_CONTABIL_COFINS_DEB),'
      '  '#39'F'#39
      '  '
      'union all'
      ''
      'SELECT'
      
        '  NVL(I.COD_CST_COFINS, DECODE(N.IND_ENTRADA_SAIDA, '#39'E'#39', P.COD_C' +
        'ST_COFINS, P.COD_CST_COFINS_SAIDA)) CST_COFINS,'
      '  TB_PARAM_SISTEMA.PERC_COFINS ALIQ_COFINS,'
      
        '  Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_COFINS_CRED, O' +
        '.COD_CONTABIL_COFINS_DEB) COD_CTA,'
      '  --NVL(SUM(I.VAL_CONFINS), 0) AS VL_COFINS,'
      
        '  (SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO - I.VAL_ICM' +
        ') * TB_PARAM_SISTEMA.PERC_COFINS) / 100 AS VL_COFINS, '
      '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO) AS VL_ITEM,'
      
        '  SUM(I.VAL_TOTAL + I.VAL_DESPESAS - I.VAL_DESCONTO - I.VAL_ICM)' +
        ' VL_BC_COFINS,  '
      '  SUM(I.VAL_ICM) VL_ICMS,'
      '  '#39'N'#39
      'FROM'
      '  TB_NOTA_ITEM I'
      'INNER JOIN TB_NOTA_CAB N ON N.COD_NOTA_CAB = I.COD_NOTA_CAB'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE = TB_SERIE.COD_SERIE AND TB_' +
        'SERIE.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO)'
      
        'INNER JOIN TB_TRIBUTACAO ON I.COD_TRIBUTACAO = TB_TRIBUTACAO.COD' +
        '_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_CADASTRO = TB_CADASTRO.COD_CADAS' +
        'TRO'
      'INNER JOIN TB_PRODUTO P ON I.COD_PRODUTO = P.COD_PRODUTO'
      'INNER JOIN TB_PARAM_SISTEMA ON 1 = 1'
      'WHERE'
      '  N.IND_SITUACAO = '#39'2'#39
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  O.NUM_LIVROS = 10'
      'AND'
      '  O.IND_TIPO_OPERACAO = '#39'S'#39
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  N.DT_RECEBIMENTO = :DATA_REF'
      'AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, O.NU' +
        'M_NATUREZA_EST_NOVO, O.NUM_NATUREZA_INT_NOVO) as number(4)) = :C' +
        'FOP'
      'AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      'AND'
      
        '  TB_SERIE.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39', '#39'11' +
        #39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'GROUP BY'
      
        '  NVL(I.COD_CST_COFINS, DECODE(N.IND_ENTRADA_SAIDA, '#39'E'#39', P.COD_C' +
        'ST_COFINS, P.COD_CST_COFINS_SAIDA)),'
      '  TB_PARAM_SISTEMA.PERC_COFINS,'
      
        '  Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_COFINS_CRED, O' +
        '.COD_CONTABIL_COFINS_DEB),'
      '  '#39'N'#39
      '  '
      'union all'
      ''
      'SELECT'
      '  DISTINCT'
      '  '#39'50'#39' CST_PIS,'
      '  TB_PARAM_SISTEMA.PERC_COFINS ALIQ_COFINS,'
      
        '  Decode(O.IND_TIPO_OPERACAO, '#39'E'#39', O.COD_CONTABIL_COFINS_CRED, O' +
        '.COD_CONTABIL_COFINS_DEB) COD_CTA,'
      
        '  ((N.VAL_FRETE - N.VAL_ICM_FRETE * TB_PARAM_SISTEMA.PERC_COFINS' +
        ') / 100)  AS VL_COFINS,'
      '  N.VAL_FRETE AS VL_ITEM,'
      '  N.VAL_FRETE - N.VAL_ICM_FRETE VL_BC_COFINS,'
      '  N.VAL_ICM_FRETE VL_ICMS,'
      '  '#39'I'#39' -- Incluso'
      'FROM'
      '  TB_PARAM_SISTEMA,'
      '  TB_NOTA_CAB N'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO_CF = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE_CF = TB_SERIE.COD_SERIE AND ' +
        'TB_SERIE.COD_FILIAL = N.COD_FILIAL)'
      
        'INNER JOIN TB_TRIBUTACAO ON N.COD_TRIBUTACAO_FRETE = TB_TRIBUTAC' +
        'AO.COD_TRIBUTACAO'
      'INNER JOIN TB_FILIAL ON N.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      
        'INNER JOIN TB_CADASTRO ON N.COD_TRANSPORTADOR = TB_CADASTRO.COD_' +
        'CADASTRO'
      
        'INNER JOIN TB_OPERACAO O_NOTA ON N.COD_OPERACAO = O_NOTA.COD_OPE' +
        'RACAO'
      
        'INNER JOIN TB_SERIE TB_SERIE_NOTA ON (N.COD_SERIE_CF = TB_SERIE_' +
        'NOTA.COD_SERIE AND TB_SERIE_NOTA.COD_FILIAL = N.COD_FILIAL)'
      
        'INNER JOIN TB_CADASTRO TB_CADASTRO_NOTA ON N.COD_TRANSPORTADOR =' +
        ' TB_CADASTRO_NOTA.COD_CADASTRO'
      'WHERE'
      '  N.IND_SITUACAO = '#39'2'#39
      'AND'
      '  O_NOTA.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O_NOTA.NUM_LIVROS <> 10 or O_NOTA.NUM_LIVROS is null)'
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  N.DT_EMISSAO_CF = :DATA_REF'
      'AND'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, O.NU' +
        'M_NATUREZA_EST_NOVO, O.NUM_NATUREZA_INT_NOVO) as number(4)) = :C' +
        'FOP'
      'AND'
      '  TB_SERIE.COD_SERIE_MODELO = :COD_SERIE_MODELO'
      'AND'
      
        '  TB_SERIE_NOTA.COD_SERIE_MODELO IN ('#39'07'#39','#39'08'#39', '#39'8B'#39', '#39'09'#39', '#39'10'#39 +
        ', '#39'11'#39', '#39'26'#39', '#39'27'#39', '#39'57'#39')'
      'AND'
      '  N.NUM_CONHECIMENTO_FRETE IS NOT NULL'
      'AND'
      '  N.IND_ENTRADA_SAIDA = '#39'S'#39
      'AND'
      '  N.IND_TIPO_FRETE = '#39'CIF'#39)
    Variables.Data = {
      03000000040000000B0000003A434F445F46494C49414C030000000000000000
      000000090000003A444154415F5245460C000000000000000000000005000000
      3A43464F50030000000000000000000000110000003A434F445F53455249455F
      4D4F44454C4F050000000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      04000000080000000A0000004353545F434F46494E530100000000000B000000
      414C49515F434F46494E5301000000000009000000564C5F434F46494E530100
      0000000007000000434F445F43544101000000000007000000564C5F4954454D
      0100000000000C000000564C5F42435F434F46494E5301000000000004000000
      5449504F01000000000007000000564C5F49434D53010000000000}
    Session = DMOracle.DBCemapa
    Left = 160
    Top = 80
    object QReg205CST_COFINS: TStringField
      FieldName = 'CST_COFINS'
      Size = 2
    end
    object QReg205ALIQ_COFINS: TFloatField
      FieldName = 'ALIQ_COFINS'
    end
    object QReg205VL_COFINS: TFloatField
      FieldName = 'VL_COFINS'
    end
    object QReg205COD_CTA: TStringField
      FieldName = 'COD_CTA'
      Size = 15
    end
    object QReg205VL_ITEM: TFloatField
      FieldName = 'VL_ITEM'
    end
    object QReg205VL_BC_COFINS: TFloatField
      FieldName = 'VL_BC_COFINS'
    end
    object QReg205TIPO: TStringField
      FieldName = 'TIPO'
      Size = 1
    end
    object QReg205VL_ICMS: TFloatField
      FieldName = 'VL_ICMS'
    end
  end
  object QReg500: TOracleDataSet1
    SQL.Strings = (
      'SELECT DISTINCT'
      '  TRUNC(N.COD_NOTA_CAB) COD_NOTA_CAB,'
      '  DECODE(N.IND_ENTRADA_SAIDA, '#39'S'#39', '#39'1'#39', '#39'0'#39') IND_OPER,'
      '  DECODE(N.IND_ENTRADA_SAIDA, '#39'S'#39', '#39'0'#39', '#39'1'#39') IND_EMIT,'
      '  N.COD_CADASTRO COD_PART, '
      '  TB_SERIE.COD_SERIE_MODELO COD_MOD,'
      '  DECODE(N.IND_SITUACAO, '#39'3'#39', '#39'02'#39', '#39'00'#39') COD_SIT,'
      '  TB_SERIE.NUM_SERIE_FISCAL SER,'
      '  N.NUM_NOTA NUM_DOC,   '
      '  N.DT_RECEBIMENTO DT_DOC,  '
      '  N.DT_RECEBIMENTO DT_A_P,'
      '  NVL(N.VAL_DESCONTO, 0) VL_DESC,'
      '  0 VL_TERC,'
      '  NVL(N.VAL_DESPESAS, 0) VL_DA,'
      '  M.COD_MENSAGEM  AS COD_INF,'
      
        '  DECODE(PS.COD_EMPRESA, '#39'CGS'#39', (SUM(I.VAL_TOTAL) + N.VAL_DESPES' +
        'AS + (CASE WHEN ((N.NUM_CONHECIMENTO_FRETE IS NOT NULL) AND (N.I' +
        'ND_ENTRADA_SAIDA = '#39'E'#39') AND (N.IND_TIPO_FRETE = '#39'FOB'#39')) THEN 0.0' +
        '0 ELSE N.VAL_FRETE END) + SUM(I.VAL_ICMS_SUBST) + SUM(CASE WHEN ' +
        '(I.COD_CST_IPI IN ('#39'00'#39', '#39'50'#39')) THEN I.VAL_IPI ELSE 0 END) - N.V' +
        'AL_DESCONTO), CASE WHEN(O.IND_FIXAR_EMPRESA = '#39'N'#39' AND O.IND_FIXA' +
        'R_OUTRAS_EMP = '#39'N'#39' AND O.IND_FIXAR_CONSUMO = '#39'N'#39') THEN SUM(I.VAL' +
        '_TOTAL) ELSE (SUM(I.VAL_TOTAL) + N.VAL_DESPESAS - N.VAL_DESCONTO' +
        ') END) VL_DOC,'
      '  SUM(I.VAL_TOTAL) VL_SERV,'
      '  SUM(I.VAL_TOTAL) VL_SERV_NT, '
      '  SUM(I.VAL_ICM_BASE)  VAL_BC_ICMS,'
      '  NVL(SUM(I.VAL_ICM), 0)  VL_ICMS,  '
      '  NVL(SUM(I.VAL_PIS), 0) VAL_PIS,'
      '  NVL(SUM(I.VAL_CONFINS), 0) VL_COFINS'
      'FROM'
      '  TB_NOTA_ITEM I'
      'INNER JOIN TB_NOTA_CAB N ON N.COD_NOTA_CAB = I.COD_NOTA_CAB'
      'INNER JOIN TB_CADASTRO C ON N.COD_CADASTRO = C.COD_CADASTRO'
      'INNER JOIN TB_OPERACAO O ON N.COD_OPERACAO = O.COD_OPERACAO'
      
        'INNER JOIN TB_SERIE ON (N.COD_SERIE = TB_SERIE.COD_SERIE AND TB_' +
        'SERIE.COD_FILIAL = N.COD_FILIAL'
      #9'AND N.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO)'
      'LEFT JOIN TB_MENSAGEM M ON N.COD_MENSAGEM = M.COD_MENSAGEM'
      'INNER JOIN TB_PARAM_SISTEMA PS ON 1 = 1'
      'WHERE'
      '  N.IND_SITUACAO = '#39'2'#39
      'AND'
      '  O.IND_LIVRO_FISCAL = '#39'S'#39
      'AND'
      '  (O.NUM_LIVROS <> 10 or O.NUM_LIVROS is null)'
      'AND'
      '  N.COD_FILIAL = :COD_FILIAL'
      'AND'
      '  N.DT_RECEBIMENTO between :DATA_INI AND :DATA_FIN'
      'AND'
      
        '  ((NVL(O.PERC_BASE_PIS,-1) >= 0) AND (NVL(O.PERC_BASE_COFINS,-1' +
        ') >= 0))'
      'AND'
      '  TB_SERIE.COD_SERIE_MODELO IN ('#39'21'#39','#39'22'#39') '
      '  '
      'GROUP BY '
      '  TRUNC(N.COD_NOTA_CAB),'
      '  DECODE(N.IND_ENTRADA_SAIDA, '#39'S'#39', '#39'1'#39', '#39'0'#39'),'
      '  DECODE(N.IND_ENTRADA_SAIDA, '#39'S'#39', '#39'0'#39', '#39'1'#39'),'
      '  N.COD_CADASTRO, '
