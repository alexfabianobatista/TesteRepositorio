      44545F5245460100000000000400000043464F500100000000000B0000004E55
      4D5F444F435F494E490100000000000B0000004E554D5F444F435F46494E0100
      0000000006000000564C5F444F4301000000000007000000564C5F4445534301
      0000000000040000005449504F010000000000}
