  object QReg200: TOracleDataSet1
    SQL.Strings = (
      'Select'
      '  TB_SERIE.COD_SERIE_MODELO AS COD_MOD,'
      '  TB_CONHECIMENTO.IND_SITUACAO,'
      '  TB_SERIE.NUM_SERIE_FISCAL AS SER,'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO DT_REF,'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) + 0.00 AS CFOP,'
      '  MIN(TB_CONHECIMENTO.NUM_CONHECIMENTO) NUM_DOC_INI,'
      '  MAX(TB_CONHECIMENTO.NUM_CONHECIMENTO) NUM_DOC_FIN, '
      
        '  SUM(TB_CONHECIMENTO.VAL_FRETE + TB_CONHECIMENTO.VAL_PEDAGIO + ' +
        'TB_CONHECIMENTO.VAL_SEGURO) AS VL_DOC,'
      '  SUM(0) VL_DESC,'
      '  '#39'CT-E'#39' as TIPO'
      'FROM'
      '  TB_CONHECIMENTO,'
      '  TB_CADASTRO,'
      '  TB_OPERACAO,'
      '  TB_TRIBUTACAO,'
      '  TB_FILIAL,'
      '  TB_SERIE,'
      '  TB_PARAM_SISTEMA'
      'WHERE'
      '  TB_CONHECIMENTO.COD_SERIE = TB_SERIE.COD_SERIE'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_SERIE.COD_FILIAL'
      '  AND'
      '  TB_CONHECIMENTO.COD_SERIE_MODELO = TB_SERIE.COD_SERIE_MODELO'
      '  AND'
      '  TB_CONHECIMENTO.COD_OPERACAO = TB_OPERACAO.COD_OPERACAO'
      '  AND'
      '  TB_OPERACAO.IND_TIPO_OPERACAO = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.COD_TRIBUTACAO = TB_TRIBUTACAO.COD_TRIBUTACAO'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = TB_FILIAL.COD_FILIAL'
      '  AND'
      
        '  (TB_CADASTRO.COD_CADASTRO = TB_CONHECIMENTO.COD_CADASTRO_TOMAD' +
        'OR'
      '   OR'
      '  TB_CONHECIMENTO.COD_CADASTRO_TOMADOR is null)'
      '  AND'
      '  TB_CONHECIMENTO.IND_SITUACAO = '#39'2'#39
      '  AND'
      '  TB_OPERACAO.IND_LIVRO_FISCAL = '#39'S'#39
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO >= :DATA_INI'
      '  AND'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO <= :DATA_FIN'
      '  AND'
      '  TB_CONHECIMENTO.COD_FILIAL = :COD_FILIAL'
      '  AND'
      '  TB_SERIE.COD_SERIE_MODELO IN ('#39'57'#39')'
      'GROUP BY'
      '  TB_SERIE.COD_SERIE_MODELO,'
      '  TB_CONHECIMENTO.IND_SITUACAO,'
      '  TB_SERIE.NUM_SERIE_FISCAL,'
      '  TB_CONHECIMENTO.DT_RECEBIMENTO,'
      
        '  cast(DECODE(TB_CADASTRO.COD_ESTADO, TB_FILIAL.COD_ESTADO, TB_O' +
        'PERACAO.NUM_NATUREZA_EST_NOVO, TB_OPERACAO.NUM_NATUREZA_INT_NOVO' +
        ') as number(4)) + 0.00,'
      '  '#39'CT-E'#39'  ')
    Variables.Data = {
      0300000003000000090000003A444154415F494E490C00000000000000000000
      00090000003A444154415F46494E0C00000000000000000000000B0000003A43
      4F445F46494C49414C030000000000000000000000}
