procedure TFLivroFiscalCad.calculaImpostosCab(notaCab: Integer);
var wAux: string;
begin
  DMNotaSaida.QTotalNota.Close;
  DMNotaSaida.QTotalNota.SetVariable('COD_NOTA_CAB', notaCab);
  DMNotaSaida.QTotalNota.Open;

  try
    wAliqIRRF := StrToFloat(DMOracle.FastSelect('I.PERC_ALIQUOTA', 'TB_NOTA_IMPOSTO_SERVICO N INNER JOIN TB_IMPOSTO I ON I.COD_IMPOSTO = N.COD_IMPOSTO', 'COD_NOTA_CAB = ' + IntToStr(notaCab) + ' AND UPPER(I.DESC_IMPOSTO) LIKE ' + QuotedStr('%IRRF%')));
    wBaseIRRF := DMNotaSaida.QTotalNotaVAL_TOTAL_NOTA.Value;
    wValIRRF := StrToFloat(DMOracle.FastSelect('N.VAL_IMPOSTO', 'TB_NOTA_IMPOSTO_SERVICO N INNER JOIN TB_IMPOSTO I ON I.COD_IMPOSTO = N.COD_IMPOSTO', 'COD_NOTA_CAB = ' + IntToStr(notaCab) + ' AND UPPER(I.DESC_IMPOSTO) LIKE ' + QuotedStr('%IRRF%')));
  except
    wAliqIRRF := 0;
    wBaseIRRF := 0;
    wValIRRF := 0;
  end;

  try
    wAliqCSLL := StrToFloat(DMOracle.FastSelect('I.PERC_ALIQUOTA', 'TB_NOTA_IMPOSTO_SERVICO N INNER JOIN TB_IMPOSTO I ON I.COD_IMPOSTO = N.COD_IMPOSTO', 'COD_NOTA_CAB = ' + IntToStr(notaCab) + ' AND UPPER(I.DESC_IMPOSTO) LIKE ' + QuotedStr('%CSLL%')));
    wBaseCSLL := DMNotaSaida.QTotalNotaVAL_TOTAL_NOTA.Value;
