procedure TFLivroFiscalCad.RelatrioRegimeEspecialPR1Click(Sender: TObject);
var
  wcont: integer;
  wclasses, westado: string;
  wfilial, woperacao, wproduto: integer;
  wquantidade: real;
  wdt_inicio, wdt_fim: TDateTime;
begin
  //Camila - 03/03/2008
  inherited;
  if FLivroFiscalParam = nil then
    FLivroFiscalParam := TFLivroFiscalParam.Create(Application);
  FLivroFiscalParam.PGRelatorio.Pages[21].TabVisible := True;
  if FLivroFiscalParam.ShowModal = mrOk then
    with DMLivroFiscal do
    begin
      wcont := 1;
      QRRegimeEspecialPR.Close;

    //Frames--------------------------------------------------------------------
      if (Trim(FLivroFiscalParam.FmFilial25.MeFilial.Text) <> '') then
      begin
        QRRegimeEspecialPR.SetVariable('FILIAL', Trim(FLivroFiscalParam.FmFilial25.MeFilial.Text));
        wfilial := strToInt(Trim(FLivroFiscalParam.FmFilial25.MeFilial.Text))
      end
      else
      begin
        QRRegimeEspecialPR.SetVariable('FILIAL', null);
        wfilial := 0;
      end;

      if (Trim(FLivroFiscalParam.FmOperacao25.MeOperacao.Text) <> '') then
      begin
        QRRegimeEspecialPR.SetVariable('OPERACAO', Trim(FLivroFiscalParam.FmOperacao25.MeOperacao.Text));
        woperacao := strToInt(Trim(FLivroFiscalParam.FmOperacao25.MeOperacao.Text))
      end
      else
      begin
        QRRegimeEspecialPR.SetVariable('OPERACAO', null);
        woperacao := 0;
      end;

      if (Trim(FLivroFiscalParam.FmProduto25.MeProduto.Text) <> '') then
      begin
        QRRegimeEspecialPR.SetVariable('PRODUTO', Trim(FLivroFiscalParam.FmProduto25.MeProduto.Text));
        wproduto := strToInt(Trim(FLivroFiscalParam.FmProduto25.MeProduto.Text))
      end
      else
      begin
        QRRegimeEspecialPR.SetVariable('PRODUTO', null);
        wproduto := 0;
      end;

      if (Trim(FLivroFiscalParam.FmEstado25.MeEstado.Text) <> '') then
      begin
        QRRegimeEspecialPR.SetVariable('ESTADO', Trim(FLivroFiscalParam.FmEstado25.MeEstado.Text));
        westado := Trim(FLivroFiscalParam.FmEstado25.MeEstado.Text)
      end
      else
      begin
        QRRegimeEspecialPR.SetVariable('ESTADO', null);
        westado := '';
      end;

      if (Trim(FLivroFiscalParam.MeClasses25.Text) <> '') then
        QRRegimeEspecialPR.SetVariable('CLASSES', 'TB_CLASSE.NUM_CLASSE IN (' + Trim(FLivroFiscalParam.MeClasses25.Text) + ')')
      else
        QRRegimeEspecialPR.SetVariable('CLASSES', '1 = 1');

      if (Trim(FLivroFiscalParam.MePesoMinimo25.Text) <> '') then
      begin
        QRRegimeEspecialPR.SetVariable('QT_MINIMO', Trim(FLivroFiscalParam.MePesoMinimo25.Text));
        wquantidade := strToFloat(Trim(FLivroFiscalParam.MePesoMinimo25.Text))
      end
      else
      begin
        QRRegimeEspecialPR.SetVariable('QT_MINIMO', 0);
        wquantidade := 0;
      end;

      if ((Trim(FLivroFiscalParam.FmDatas25.MeDtInicial.Text) = '') or (Trim(FLivroFiscalParam.FmDatas25.MeDtFinal.Text) = '')) then
        raise Exception.Create('Deve-se Informar uma Data Inicial e Final para o Relatório!')
      else
      begin
        QRRegimeEspecialPR.SetVariable('DT_INICIO', Trim(FLivroFiscalParam.FmDatas25.MeDtInicial.Text));
        QRRegimeEspecialPR.SetVariable('DT_FIM', Trim(FLivroFiscalParam.FmDatas25.MeDtFinal.Text));
        wdt_inicio := strToDate(Trim(FLivroFiscalParam.FmDatas25.MeDtInicial.Text));
        wdt_fim := strToDate(Trim(FLivroFiscalParam.FmDatas25.MeDtFinal.Text));
      end;
    //--------------------------------------------------------------------------

    //--------------------------------------------------------------------------
    //Grava as classes na TB_CLASSES_TEMP para ser acessada posteriormente pela funçao

      with DMOracle do
      begin
      //limpa os dados na TB_CLASSES_TEMP
        try
          DBCemapa.StartTransaction;
          QExecSQL.Close;
          QExecSQL.SQL.Clear;
          QExecSQL.SQL.Add('DELETE FROM TB_CLASSES_TEMP');
          QExecSQL.ExecSQL;
          DBCemapa.Commit;
        except
          DBCemapa.Rollback;
          raise Exception.Create('Não foi possível limpar a tabela de classes');
        end;

        while wcont <= length(Trim(FLivroFiscalParam.MeClasses25.Text)) + 1 do
        begin

          if (copy(Trim(FLivroFiscalParam.MeClasses25.Text), wcont, 1) <> ',') and
            (copy(Trim(FLivroFiscalParam.MeClasses25.Text), wcont, 1) <> '') then
            wclasses := wclasses + copy(Trim(FLivroFiscalParam.MeClasses25.Text), wcont, 1)
          else
          begin
          //grava os dados na tabela
            try
              DBCemapa.StartTransaction;
              QExecSQL.Close;
              QExecSQL.SQL.Clear;
              QExecSQL.SQL.Add('INSERT INTO TB_CLASSES_TEMP(NUM_CLASSE) VALUES (' + wclasses + ')');
              QExecSQL.ExecSQL;
              DBCemapa.Commit;
              wclasses := '';
            except
              DBCemapa.Rollback;
              raise Exception.Create('Operação não realizada');
            end;

          end;
          inc(wcont);
        end; //while

        OPLivros.CallProcedure('NOTAS_REGIME_ESPECIAL_PR', [wfilial, woperacao, westado, wproduto, wquantidade, wdt_inicio, wdt_fim]);

      end;

    //--------------------------------------------------------------------------

      QRRegimeEspecialPR.open;

      if FRRegimeEspecialPR = nil then
        FRRegimeEspecialPR := TFRRegimeEspecialPR.Create(Application);

    //Cabeçalho
    //----------------------
      FRRegimeEspecialPR.QRLFilial.Caption := Trim(FLivroFiscalParam.FmFilial25.EdFilial.Text);
      FRRegimeEspecialPR.QRLDt_Inicial.Caption := Trim(FLivroFiscalParam.FmDatas25.MeDtInicial.Text);
      FRRegimeEspecialPR.QRLDt_Final.Caption := Trim(FLivroFiscalParam.FmDatas25.MeDtFinal.Text);
    //----------------------

      if FLivroFiscalParam.RGPreview.ItemIndex = 0 then
        FRRegimeEspecialPR.QRPrimario.Preview
      else
        FRRegimeEspecialPR.QRPrimario.Print;

      QRRegimeEspecialPR.Close;
    //--------------------------------------------------------------------------
    end;
end;

