          QRNotasOperacao.SetVariable('OPERACAO', Null)
        else
          QRNotasOperacao.SetVariable('OPERACAO', FLivroFiscalParam.ME0Operacao.Text);
        if Trim(FLivroFiscalParam.ME0Departamento.Text) = '' then
          QRNotasOperacao.SetVariable('DEPARTAMENTO', Null)
        else
          QRNotasOperacao.SetVariable('DEPARTAMENTO', FLivroFiscalParam.ME0Departamento.Text);
        QRNotasOperacao.Open;
