procedure TFLivroFiscalCad.calculaImpostos(notaItem: Double; acumula: Boolean = False; tipo: string = 'NOTA');
var wOperacao: Integer;
  wNCM: string;
  wValor, wPISNota, wCOFINSNota, wISSNota: Double;
  wNotaCab : string;
begin
  if tipo = 'NOTA' then
  begin
    wNotaCab := DMOracle.FastSelect('COD_NOTA_CAB', 'TB_NOTA_ITEM', 'COD_NOTA_ITEM = ' + FloatToStr(notaItem));
    wOperacao := StrToInt(DMOracle.FastSelect('COD_OPERACAO', 'TB_NOTA_CAB', 'COD_NOTA_CAB = ' + wNotaCab));
    wNCM := DMOracle.FastSelect('TB_PRODUTO.NUM_GENERO_NCM', 'TB_NOTA_ITEM INNER JOIN TB_PRODUTO ON TB_PRODUTO.COD_PRODUTO = TB_NOTA_ITEM.COD_PRODUTO', 'COD_NOTA_ITEM = ' + FloatToStr(notaItem));
    wValor := StrToFloat(DMOracle.FastSelect('VAL_TOTAL', 'TB_NOTA_ITEM', 'COD_NOTA_ITEM = ' + FloatToStr(notaItem)));
//    wPISNota := StrToFloat(DMOracle.FastSelect('VAL_PIS', 'TB_NOTA_ITEM', 'COD_NOTA_ITEM = ' + FloatToStr(notaItem)));
//    wCOFINSNota := StrToFloat(DMOracle.FastSelect('VAL_CONFINS', 'TB_NOTA_ITEM', 'COD_NOTA_ITEM = ' + FloatToStr(notaItem)));

    //MessageDlg(IntToStr(wOperacao), mtWarning, [mbOK], 0);
    //MessageDlg(wNCM, mtWarning, [mbOK], 0);

    DMLivroFiscal.QCalculaImposto.Close;
    DMLivroFiscal.QCalculaImposto.SetVariable('COD_OPERACAO', wOperacao);
    if wNCM = '' then
      DMLivroFiscal.QCalculaImposto.SetVariable('NUM_NCM', Null)
    else
      DMLivroFiscal.QCalculaImposto.SetVariable('NUM_NCM', wNCM);
    DMLivroFiscal.QCalculaImposto.Open;

    try
      wAliqISS := StrToFloat(DMOracle.FastSelect('I.PERC_ALIQUOTA', 'TB_NOTA_IMPOSTO_SERVICO N INNER JOIN TB_IMPOSTO I ON I.COD_IMPOSTO = N.COD_IMPOSTO', 'COD_NOTA_CAB = (SELECT COD_NOTA_CAB FROM TB_NOTA_ITEM WHERE COD_NOTA_ITEM = ' + FloatToStr(notaItem) + ') AND UPPER(I.DESC_IMPOSTO) LIKE ' + QuotedStr('%ISS%')));
    except
      wAliqISS := 0;
    end;

    try
      wISSNota := StrToFloat(DMOracle.FastSelect('N.VAL_IMPOSTO', 'TB_NOTA_IMPOSTO_SERVICO N INNER JOIN TB_IMPOSTO I ON I.COD_IMPOSTO = N.COD_IMPOSTO', 'COD_NOTA_CAB = (SELECT COD_NOTA_CAB FROM TB_NOTA_ITEM WHERE COD_NOTA_ITEM = ' + FloatToStr(notaItem) + ') AND UPPER(I.DESC_IMPOSTO) LIKE ' + QuotedStr('%ISS%')));
    except
      wISSNota := 0;
    end;

    if acumula then
    begin
      if DMLivroFiscal.QCalculaImposto.IsEmpty then
      begin
        wStPIS := '00';
        wAliqPIS := DMParamSistema.QParamSistemaPERC_PIS.Value;
        wBasePIS := wBasePIS + wValor;

        wStCOFINS := '00';
        wAliqCOFINS := DMParamSistema.QParamSistemaPERC_COFINS.Value;
        wBaseCOFINS := wBaseCOFINS + wValor;
      end
      else
      begin
        DMLivroFiscal.QCalculaImposto.First;

        wStPIS := DMLivroFiscal.QCalculaImpostoCOD_CST_PIS.Value;
        wAliqPIS := DMLivroFiscal.QCalculaImpostoVAL_ALIQ_PIS.Value;
        wBasePIS := wBasePIS + (wValor * DMLivroFiscal.QCalculaImpostoVAL_BC_PIS.Value / 100);

        wStCOFINS := DMLivroFiscal.QCalculaImpostoCOD_CST_COFINS.Value;
        wAliqCOFINS := DMParamSistema.QParamSistemaPERC_COFINS.Value;
        wBaseCOFINS := wBaseCOFINS + (wValor * DMLivroFiscal.QCalculaImpostoVAL_BC_COFINS.Value / 100);
      end;
      wBaseISS := wBaseISS + wValor;
      wValISS := wValISS + wISSNota;

      wPISNota := (wValor * wBasePIS * wAliqPIS) / 10000;
      wCOFINSNota := (wValor * wBaseCOFINS * wAliqCOFINS) / 10000;

      wValPIS := wValPIS + wPISNota;
      wValCOFINS := wValCOFINS + wCOFINSNota;
    end
    else
    begin
      if DMLivroFiscal.QCalculaImposto.IsEmpty then
      begin
        wStPIS := '00';
        wAliqPIS := DMParamSistema.QParamSistemaPERC_PIS.Value;
        wBasePIS := wValor;

        wStCOFINS := '00';
        wAliqCOFINS := DMParamSistema.QParamSistemaPERC_COFINS.Value;
        wBaseCOFINS := wValor;
      end
      else
      begin
        DMLivroFiscal.QCalculaImposto.First;

        wStPIS := DMLivroFiscal.QCalculaImpostoCOD_CST_PIS.Value;
        wAliqPIS := DMLivroFiscal.QCalculaImpostoVAL_ALIQ_PIS.Value;
        wBasePIS := (wValor * DMLivroFiscal.QCalculaImpostoVAL_BC_PIS.Value / 100);;

        wStCOFINS := DMLivroFiscal.QCalculaImpostoCOD_CST_COFINS.Value;
        wAliqCOFINS := DMLivroFiscal.QCalculaImpostoVAL_ALIQ_COFINS.Value;
        wBaseCOFINS := (wValor * DMLivroFiscal.QCalculaImpostoVAL_BC_COFINS.Value / 100);;
      end;
      wBaseISS := wValor;
      wValISS := wISSNota;

      wValPIS := wPISNota;
      wValCOFINS := wCOFINSNota;

      if wValPIS = 0 then
      begin
        wAliqPIS := 0;
        wBasePIS := 0;
//        wStPIS := '';
      end;

      if wValCOFINS = 0 then
      begin
        wAliqCOFINS := 0;
        wBaseCOFINS := 0;
//        wStCOFINS := '';
      end;
//    wValPIS := wBasePIS * wAliqPIS / 100;
//    wValCOFINS := wBaseCOFINS * wAliqCOFINS / 100;
    end;
  end
  else
  begin
    wValor := StrToFloat(DMOracle.FastSelect('VAL_FRETE - VAL_DESCONTO', 'TB_CONHECIMENTO_FRETE', 'COD_CONHECIMENTO_FRETE = ' + FloatToStr(notaItem)));
    try
      wPISNota := StrToFloat(DMOracle.FastSelect('VAL_PIS', 'TB_CONHECIMENTO_FRETE', 'COD_CONHECIMENTO_FRETE = ' + FloatToStr(notaItem)));
    except
      wPISNota := 0;
    end;
    try
      wCOFINSNota := StrToFloat(DMOracle.FastSelect('VAL_COFINS', 'TB_CONHECIMENTO_FRETE', 'COD_CONHECIMENTO_FRETE = ' + FloatToStr(notaItem)));
    except
      wCOFINSNota := 0;
    end;

    if wPISNota > 0 then
      wStPIS := '01'
    else
      wStPIS := '99';
    wAliqPIS := 1.65;
    wBasePIS := wValor;

    if wCOFINSNota > 0 then
      wStCOFINS := '01'
    else
      wStCOFINS := '99';
    wAliqCOFINS := 7.6;
    wBaseCOFINS := wValor;

    wValPIS := wPISNota;
    wValCOFINS := wCOFINSNota;
  end;
end;

