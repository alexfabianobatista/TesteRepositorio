      begin
        while not QExportaNF_Sinco.EOF do
        begin
          S := S + QExportaNF_SincoIND_ENTRADA_SAIDA.Text + bib.AjustaStr(QExportaNF_SincoDESC_MODELO.Value, 2);
          S := S + Copy(QExportaNF_SincoCOD_SERIE.value + '     ', 1, 5);
          S := S + FormatFloat('000000000', QExportaNF_SincoNUM_NOTA.Value);
          S := S + Copy(QExportaNF_SincoDT_EMISSAO.Text, 1, 2) +
            Copy(QExportaNF_SincoDT_EMISSAO.Text, 4, 2) +
            Copy(QExportaNF_SincoDT_EMISSAO.Text, 7, 4);
          S := S + Copy(QExportaNF_SincoCOD_CADASTRO.Text + '              ', 1, 14);
          S := S + Copy(QExportaNF_SincoDT_RECEBIMENTO.Text, 1, 2) +
            Copy(QExportaNF_SincoDT_RECEBIMENTO.Text, 4, 2) +
            Copy(QExportaNF_SincoDT_RECEBIMENTO.Text, 7, 4);
          S := S + intdecimais(QExportaNF_SincoVAL_TOTAL_PRODUTOS.Text, 17, 2);
          S := S + intdecimais(QExportaNF_SincoVAL_DESCONTO.Text, 17, 2);
          S := S + intdecimais(QExportaNF_SincoSVAL_FRETE.Text, 17, 2) + '00000000000000000';
          S := S + intdecimais(QExportaNF_SincoSVAL_DESPESAS.Text, 17, 2);
          S := S + intdecimais(QExportaNF_SincoSVAL_IPI.Text, 17, 2) + '00000000000000000';
          S := S + intdecimais(QExportaNF_SincoVAL_TOTAL.Text, 17, 2) + '              ';
          S := S + bib.AjustaStr(QExportaNF_SincoDESC_TIPO_TRANSPORTE.Value, 15);
          S := S + Copy(QExportaNF_SincoCOD_TRANSPORTADOR.Text + '              ', 1, 14);
          S := S + intdecimais(QExportaNF_SincoQT_VOLUMES.Text, 17, 0);
          wUnidade := '';
          DMLivroFiscal.QUnidades.Close;
          DMLivroFiscal.QUnidades.SetVariable('COD_NOTA_CAB', QExportaNF_SincoCOD_NOTA_CAB.Value);
          DMLivroFiscal.QUnidades.Open;
          DMLivroFiscal.QUnidades.First;
          while not DMLivroFiscal.QUnidades.Eof do
          begin
            wUnidade := wUnidade + DMLivroFiscal.QUnidadesDESC_UNIDADE.Value;
            if DMLivroFiscal.QUnidades.RecNo <> DMLivroFiscal.QUnidades.RecordCount then
              wUnidade := wUnidade + '/';
            DMLivroFiscal.QUnidades.Next;
          end;
          S := S + bib.AjustaStr(wUnidade, 10);
          //S := S + bib.AjustaStr(QExportaNF_SincoDESC_UNIDADE.Value, 10);
          S := S + intdecimais(QExportaNF_SincoQT_PESO_BRUTO.Text, 17, 3);
          S := S + intdecimais(QExportaNF_SincoQT_PESO_LIQUIDO.Text, 17, 3);
          S := S + QExportaNF_SincoIND_TIPO_FRETE.Text;
          S := S + Copy(QExportaNF_SincoDESC_PLACA.Text + '               ', 1, 15);
          if QExportaNF_SincoIND_SITUACAO.Value = '2' then
            S := S + 'N'
          else
            S := S + 'S';
          S := S + QExportaNF_SincoIND_TIPO_PAGAMENTO.Text;
          S := S + Copy(QExportaNF_SincoDESC_OBS.Text + '                                             ', 1, 45);

          begin
            S := S + Bib.AjustaStr('', 50);
            S := S + Bib.AjustaStr('', 2);
            S := S + Bib.AjustaStr('', 5);
            S := S + '000000000';
            S := S + '00000000';
            S := S + Bib.AjustaStr('', 14);
          end;

          QExportaNF_Sinco.Next;
          if not QExportaNF_Sinco.Eof then
            S := S + Chr(13) + Chr(10);
        end;

        begin
          AssignFile(F, FLivroFiscalParam.Dlb18Diretorio.Directory + '\4.3.1.txt');
          Rewrite(F);
          Writeln(F, S);
          CloseFile(F);
        end;
        QExportaNF_Sinco.Close;
        DMLivroFiscal.QUnidades.Close;
      end
      else
        MessageDlg('Não há notas no período selecionado para o arquivo 4.3.1', mtError, [mbOK], 0);
    end;
  end;
end;

