procedure TDMImportaDados.ImportaProduto;
begin
end;

procedure TDMImportaDados.TCP_CabCalcFields(DataSet: TDataSet);
var wParcela: String;
begin
  TCP_Cabnum_titulo.Value := extraiNumTitulo(TCP_CabDUP_NUM.Value);
  wParcela := extraiNumTitulo(Copy(TCP_CabDUP_NUM.Value, length(TCP_Cabnum_titulo.Value)+1, length(TCP_CabDUP_NUM.Value) - length(TCP_Cabnum_titulo.Value)));
  if wParcela = '' then
    TCP_Cabnum_parcela.Clear
  else
    TCP_Cabnum_parcela.Value := StrToInt(wParcela);
end;

function TDMImportaDados.extraiNumTitulo(entrada: string): string;
var pos1, pos2, pos3, x: Integer;
  wNumero, original: string;
begin
  original := Trim(entrada);

  pos1 := Pos('-', original);
  pos2 := Pos('/', original);
  pos3 := Pos(' ', original);
  if pos1 = 1 then
    pos1 := Pos('-', copy(original, 2, length(original)-1));
  if pos2 = 1 then
    pos2 := Pos('/', copy(original, 2, length(original)-1));
  if pos3 = 1 then
    pos3 := Pos(' ', copy(original, 2, length(original)-1));
  if ((pos3 > 0) and (pos3 < pos1)) then
    pos1 := pos3;
  if ((pos1 > 0) and (pos2 > 0)) then
  begin
    if pos1 < pos2 then
      x := pos1
    else
      x := pos2;
  end
  else
  begin
    x := 0;
    if pos1 <= 0 then
      x := pos2;
    if pos2 <= 0 then
      x := pos1;
  end;
  if x = 0 then
    wNumero := original
  else
    wNumero := Copy(original, 1, x - 1);

  Result := Bib.LimpaNumero(wNumero);
end;

procedure TDMImportaDados.TCR_CabCalcFields(DataSet: TDataSet);
var wParcela: String;
begin
  TCR_Cabnum_titulo.Value := extraiNumTitulo(TCR_CabDUP_NUM.Value);
  wParcela := extraiNumTitulo(Copy(TCR_CabDUP_NUM.Value, length(TCR_Cabnum_titulo.Value)+1, length(TCR_CabDUP_NUM.Value) - length(TCR_Cabnum_titulo.Value)));
  if wParcela = '' then
    TCR_Cabnum_parcela.Clear
  else
    TCR_Cabnum_parcela.Value := StrToInt(wParcela);
end;

