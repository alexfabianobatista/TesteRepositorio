procedure TFCaixaCad.RelaodeMovimentodeCaixa1Click(Sender: TObject);
var
  i: Integer;
begin
  inherited;
  if FCaixaParam = nil then
    FCaixaParam := TFCaixaParam.Create(Application);
  FCaixaParam.PGRelatorio.Pages[2].TabVisible := True;
  if not DMUsuario.Privilegiado then
    FCaixaParam.ME2CodDepto.Text := IntToStr(DMUsuario.CodDepartamentoUsuario);
  if FCaixaParam.ShowModal = MrOk then
  begin
    DmUsuario.Checar_Filial_Usuario(Trim(FCaixaParam.ME2CodFilial.Text), 'CAIXA'); //Segurança de Filial
    with DMCaixaRel do
    begin
      // Detalhamento de Caixa
      QRCaixa_Det.ClearVariables;
      QRCaixa_Det.Close;
      QRCaixa_Det.ClearVariables;
      if Trim(FCaixaParam.ME2DtInicial.Text) = '' then
        raise Exception.Create('Campo Data Inicial Deve Ser Informado');
      if Trim(FCaixaParam.ME2DtFinal.Text) = '' then
        raise Exception.Create('Campo Data Final Deve Ser Informado');

      QRCaixa_Det.SetVariable('DT_INICIAL', FCaixaParam.ME2DtInicial.Text);
      QRCaixa_Det.SetVariable('DT_FINAL', FCaixaParam.ME2DtFinal.Text);

      if Trim(FCaixaParam.ME2CodFilial.Text) <> '' then
        QRCaixa_Det.SetVariable('COD_FILIAL', Trim(FCaixaParam.ME2CodFilial.Text))
      Else
        QRCaixa_Det.SetVariable('COD_FILIAL', Null);

      if Trim(FCaixaParam.ME2CodDepto.Text) <> '' then
        QRCaixa_Det.SetVariable('DEPARTAMENTOS', 'COD_DEPARTAMENTO IN (' + Trim(FCaixaParam.ME2CodDepto.Text) + ')')
      else
        QRCaixa_Det.SetVariable('DEPARTAMENTOS', '1=1');
      QRCaixa_Det.Open;

      DMCaixa.QSaldo.Close;
      DMCaixa.QSaldo.ClearVariables;
      DMCaixa.QSaldo.SetVariable('DT_FINAL', StrToDate(FCaixaParam.ME2DtInicial.Text) - 1);

      if Trim(FCaixaParam.ME2CodFilial.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME2CodFilial.Text)))
      Else
        DMCaixa.QSaldo.SetVariable('COD_FILIAL', Null);

      if Trim(FCaixaParam.ME2Departamento.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('DEPARTAMENTOS', 'TB_CAIXA_MOV.COD_DEPARTAMENTO IN (' + Trim(FCaixaParam.ME2CodDepto.Text) + ')')
      else
        DMCaixa.QSaldo.SetVariable('DEPARTAMENTOS', '1=1');

      if Trim(FCaixaParam.ME2CodHistorico.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO', StrToInt(Trim(FCaixaParam.ME2CodHistorico.Text)))
      Else
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO', Null);
      if Trim(FCaixaParam.ME2HistoricoFinal.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO_F', StrToInt(Trim(FCaixaParam.ME2HistoricoFinal.Text)))
      Else
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO_F', Null);

      DMCaixa.QSaldo.Open;

      QRCaixa_MovCaixa.Close;
      QRCaixa_MovCaixa.ClearVariables;
      if Trim(FCaixaParam.ME2CodFilial.Text) <> '' then
        QRCaixa_MovCaixa.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME2CodFilial.Text)))
      Else
        QRCaixa_MovCaixa.SetVariable('COD_FILIAL', Null);

      if Trim(FCaixaParam.ME2Departamento.Text) <> '' then
        QRCaixa_MovCaixa.SetVariable('DEPARTAMENTOS', 'TB_CAIXA_MOV.COD_DEPARTAMENTO IN (' + Trim(FCaixaParam.ME2CodDepto.Text) + ')')
      else
        QRCaixa_MovCaixa.SetVariable('DEPARTAMENTOS', '1=1');

      if Trim(FCaixaParam.ME2CodHistorico.Text) <> '' then
        QRCaixa_MovCaixa.SetVariable('COD_HISTORICO', StrToInt(Trim(FCaixaParam.ME2CodHistorico.Text)))
      Else
        QRCaixa_MovCaixa.SetVariable('COD_HISTORICO', Null);
      if Trim(FCaixaParam.ME2HistoricoFinal.Text) <> '' then
        QRCaixa_MovCaixa.SetVariable('COD_HISTORICO_F', StrToInt(Trim(FCaixaParam.ME2HistoricoFinal.Text)))
      Else
        QRCaixa_MovCaixa.SetVariable('COD_HISTORICO_F', Null);
      {Permitir consultas de historicos fora da sequencia - Junior 31-07-2013}
      if Trim(FCaixaParam.Me02Historico.Text) <> '' then
        QRCaixa_MovCaixa.SetVariable('HISTORICO', 'TB_CAIXA_MOV.COD_HISTORICO IN ('+Bib.Colocaaspanastring(Trim(FCaixaParam.Me02Historico.Text))+')')
      else
        QRCaixa_MovCaixa.SetVariable('HISTORICO','1=1');

