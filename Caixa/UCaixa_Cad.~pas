procedure TFCaixaCad.SBConfirmarClick(Sender: TObject);
var
  wLinhaMov, wNumDoc, wContaCred, wContaDeb, wTipoRecibo: string;
  wCodDoc, wCodHistorico, wVlrLancto, wCodCompl: Real;
  wDtLancto: TDateTime;
  wFilial: Integer;
begin
  DmUsuario.Checar_Filial_Usuario(DMCaixa.QCaixa_MovCod_Filial.Text, 'CAIXA');
  if DMParamSistema.QParamSistemaDt_Fechamento_Financeiro.Value >= DMCaixa.QCaixa_MovDt_Movimento.Value then
    raise Exception.Create('Não é Permitido Realizar Este Lançamento - Fechamento Contabil');
  if DMOracle.BuscaNome('SELECT IND_SITUACAO FROM TB_HISTORICO', 'COD_HISTORICO = ' + FloatToStr(DMCaixa.QCaixa_MovCod_Historico.Value)) = 'NAO' then
    raise Exception.Create('Histórico Não Liberado Para Uso');
  if (DMParamSistema.QParamSistemaCod_Empresa.Value <> 'ZADIMEL') and
     (DMParamSistema.QParamSistemaCod_Empresa.Value <> 'MOINHO') then
    if Trim(DMCaixa.QCaixa_MovCOD_CADASTRO.Text) <> '' then
      if Trim(DMOracle.BuscaNome('SELECT DT_CANCELAMENTO FROM TB_CADASTRO', ' COD_CADASTRO = ' + DMCaixa.QCaixa_MovCOD_CADASTRO.Text)) <> '' then
        raise exception.Create('ATENÇÃO - Cadastro Cancelado, Verifique!');
  if DMParamSistema.QParamSistemaCod_Empresa.Value = 'MOINHO' then
    if Trim(DMCaixa.QCaixa_MovCOD_CADASTRO.Text) = '' then
      raise exception.Create('ATENÇÃO - Preencher Cadastro, Verifique!');
  //  Lancto Contábil
  try
    DMCaixa.QCaixa_MovCOD_NOTA_CAB.Text := '';
    DMCaixa.QCaixa_MovCOD_CONTA_RECEBER_CAB.Text := '';
    DMCaixa.QCaixa_MovCOD_CONTA_PAGAR_CAB.Text := '';
    if DMHistorico.QHistoricoIND_ADIANTAMENTO.Text = 'NAO' then
      DMCaixa.QCaixa_MovCOD_ADIANTAMENTO.Text := '';
    dmcaixa.QCaixa_MovCOD_BCO_MOVIMENTO.Text := '';
    dmcaixa.QCaixa_MovCOD_CONHECIMENTO.Text := '';
    inherited;
    if DSPrimario.State in [DsEdit, DsInsert] then //Não deu certo pra salvar.
      Exit;
    DBPDescComplemento.DBEdit.SetFocus;
    with DMCaixa do
    begin
      if (DMParamSistema.QParamSistemaInd_Contabiliza.Value = 'S') then
      begin
        wCodDoc := QCaixa_MovCod_Caixa_Mov.Value;
        wNumDoc := FloatToStr(QCaixa_MovNum_Documento.Value) + '-' + Trim(QCaixa_MovDesc_Complemento.Value);
        wFilial := QCaixa_MovCod_Filial.Value;
        wContaCred := QCaixa_MovCod_Contabil_Cred.Value;
        wContaDeb := QCaixa_MovCod_Contabil_Deb.Value;
        wCodCompl := QCaixa_MovCod_Cadastro.Value;
        if Trim(Edit1.Text) <> '' then // Código Histórico informado na tela
          wCodHistorico := StrToFloat(Trim(Edit1.Text))
        else
          wCodHistorico := QCaixa_MovCod_Historico_Contabil.Value;
        if wCodHistorico <> 0 then
        begin
          wVlrLancto := QCaixa_MovVal_Movimento.Value;
          wDtLancto := QCaixa_MovDt_Movimento.Value;
          if FCaixa_Lanc_Cont = nil then
            FCaixa_Lanc_Cont := TFCaixa_Lanc_Cont.Create(Application);
          FCaixa_Lanc_Cont.MEContaCredito.text := wContaCred;
          if DMParamSistema.QParamSistemaInd_Tipo_Plano_Conta.Value = 'UNICO' then
            FCaixa_Lanc_Cont.pFilial := 1
          else
            FCaixa_Lanc_Cont.pFilial := wFilial;
          FCaixa_Lanc_Cont.MEContaDebito.Text := wContaDeb;
          FCaixa_Lanc_Cont.MEContaDebitoExit(Self);
          FCaixa_Lanc_Cont.MEContaCreditoExit(Self);
          FCaixa_Lanc_Cont.MeFilialDebito.Text := FloatToStr(wFilial);
          FCaixa_Lanc_Cont.MeFilialCredito.Text := FloatToStr(wFilial);
          FCaixa_Lanc_Cont.ShowModal;
          wContaCred := Bib.LimpaString(FCaixa_Lanc_Cont.MEContaCredito.text, '.');
          wContaDeb := Bib.LimpaString(FCaixa_Lanc_Cont.MEContaDebito.text, '.');
          DMPlanilha.GravaLanc('CX', wCodDoc, wNumDoc, {StrToFloat} strtoint(FCaixa_Lanc_Cont.MeFilialCredito.Text), wContaCred, 'CREDITO', wCodCompl, wCodHistorico, wVlrlancto, wDTLancto, wContaDeb);
          DMPlanilha.GravaLanc('CX', wCodDoc, wNumDoc, {StrToFloat} strtoint(FCaixa_Lanc_Cont.MeFilialDebito.Text), wContaDeb, 'DEBITO', wCodCompl, wCodHistorico, wVlrlancto, wDTLancto, wContaCred);
        end;
      end;
      DMOracle.DBCemapa.Commit;
      wLinhaMov := '';
      wLinhaMov := (FloatToStr(DMCaixa.QCaixa_MovCod_Caixa_Mov.value) + '  ' +
        DMCaixa.QCaixa_Movnome_filial.value + '   ' +
        DMCaixa.QCaixa_Movnome_departamento.value + '   ' +
        DMCaixa.QCaixa_Movnome_historico.value + '   ' +
        DMCaixa.QCaixa_Movnome_cadastro.value + '   ' +
        FormatFloat('#,##0.00', DMCaixa.QCaixa_MovVAL_MOVIMENTO.value));
      LBMovimentos.Items.Add(wLinhaMov);
    end;
  except
    DMOracle.DBCemapa.RollBack;
//    DMCaixa.QCaixa_Mov.Cancel;
    raise Exception.Create('Erro ao tentar Contabilizar.' + #13 + 'Verifique se existe um Histórico Contabil Cadastrado para este Histórico.');
  end;
  //Cadastra movimento de Custo de Veículo - PMC 01/04/2004
  if DMOracle.BuscaNome('SELECT IND_VEICULO FROM TB_HISTORICO', 'COD_HISTORICO = ' + DMCaixa.QCaixa_MovCOD_HISTORICO.Text) = 'S' then
  begin
    if FCustoVeiculo_CX = nil then
      FCustoVeiculo_CX := TFCustoVeiculo_CX.Create(Application);
    FCustoVeiculo_CX.ShowModal;
  end;
  //fim Cadastro movimento Custo Veículo


  // Emissão de Recibo ao registrar movimento no Caixa - Djeison A. Selzlein - 21/08/2013
  wTipoRecibo := DMOracle.BuscaNome('SELECT IND_TIPO_RECIBO FROM TB_HISTORICO',
    'COD_HISTORICO = ' + DMCaixa.QCaixa_MovCOD_HISTORICO.Text);

  if ( wTipoRecibo = 'M') then
    if MessageDlg('Deseja emitir recibo de movimentação de Caixa?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
      EmiteReciboEntrada40Col;
end;

procedure TFCaixaCad.SBExcluirClick(Sender: TObject);
var wNumDoc: Integer;
begin
  if DMParamSistema.QParamSistemaDt_Fechamento_Financeiro.Value >= DMCaixa.QCaixa_MovDt_Movimento.Value then
    raise Exception.Create('Não é Permitido Voltar Confirmação - Fechamento Contabil');

  if MessageDlg('Apagar este registro?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
  begin
    If (DMCaixa.QCaixa_MovCod_Nota_Cab.isNull)          and
       (DMCaixa.QCaixa_MovCod_Conta_Receber_Cab.IsNull) and
       (DMCaixa.QCaixa_MovCod_Conta_Pagar_Cab.IsNull)   and
       (DMCaixa.QCaixa_MovCOD_BCO_MOVIMENTO.IsNull)     and
       (DMCaixa.QCaixa_MovCOD_ORDEM_SERVICO_CAB.IsNull)   then
    begin
      if not (DMCaixa.QCaixa_MovCod_Caixa_Mov.IsNull) then
      begin
        if DMOracle.DBCemapa.InTransaction = false then
          DMOracle.DBCemapa.StartTransaction;
        try
          wNumDoc := DMCaixa.QCaixa_MovCod_Caixa_Mov.Value;
          DMPlanilha.Descontabiliza(wNumDoc, 'CX');
          //exclui cadastro de movimento de custo de veículo - PMC 31/03/2004

          if DMOracle.BuscaNome('SELECT IND_VEICULO FROM TB_HISTORICO', 'COD_HISTORICO = ' + DMCaixa.QCaixa_MovCOD_HISTORICO.Text) = 'S' then
             DMCustoVeiculoMov.ExcluiCustoVei('CAIXA MOV', DMCaixa.QCaixa_MovCOD_CAIXA_MOV.Value);
          //fim exclusão de movimento de custo de veídulo
          DSPrimario.DataSet.Delete;
          DMOracle.DBCemapa.Commit;
        except
          DMOracle.DBCemapa.RollBack;
        end;
      end;
