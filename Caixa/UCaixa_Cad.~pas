procedure TFCaixaCad.SBAlterarClick(Sender: TObject);
var
  wNumDoc: Integer;
begin
  if DMParamSistema.QParamSistemaDt_Fechamento_Financeiro.Value >= DMCaixa.QCaixa_MovDt_Movimento.Value then
    raise Exception.Create('Não é Permitido Voltar Confirmação - Fechamento Contabil');
//Solicitado pela Loja Kalce, devido as condicionais que são feitas retorno e não esta permitindo alterar o departamento. Junior solicitou. Alex 09/08/2023
  if (DMParamSistema.CodEmpresa <> 'JASOL') then
    if not (DMCaixa.QCaixa_MovCod_Nota_Cab.isNull) then
      raise Exception.Create('Não é Permitido Alterar Lançamento Feito Por uma Nota');
  if not (DMCaixa.QCaixa_MovCod_Conta_Receber_Cab.IsNull) then
    raise Exception.Create('Não é Permitido Alterar Lançamento Feito Pelo Contas a Receber');
  if not (DMCaixa.QCaixa_MovCod_Conta_Pagar_Cab.IsNull) then
    raise Exception.Create('Não é Permitido Alterar Lançamento Feito Pelo Contas a Pagar');
  if not (DMCaixa.QCaixa_MovCod_Caixa_Mov.IsNull) then
  begin
    if DMOracle.DBCemapa.InTransaction = false then
      DMOracle.DBCemapa.StartTransaction;
    try
      wNumDoc := DMCaixa.QCaixa_MovCod_Caixa_Mov.Value;
      DMPlanilha.Descontabiliza(wNumDoc, 'CX');
      //exclui cadastro de movimento de custo de veículo - PMC 01/04/2004
      if DMParamSistema.QParamSistemaCOD_EMPRESA.value = 'AB' then
        if DMOracle.BuscaNome('SELECT IND_VEICULO FROM TB_HISTORICO', 'COD_HISTORICO = ' + DMCaixa.QCaixa_MovCOD_HISTORICO.Text) = 'S' then
          DMCustoVeiculoMov.ExcluiCustoVei('CAIXA MOV', DMCaixa.QCaixa_MovCOD_CAIXA_MOV.Value);
      //fim exclusão de movimento de custo de veídulo
      DSPrimario.DataSet.Edit;
      DMOracle.DBCemapa.Commit;
    except
      DMOracle.DBCemapa.RollBack;
    end;
  end;
  Edit1.Text := '';
end;

