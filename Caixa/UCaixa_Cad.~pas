    DMOracle.QExecSQL.SQL.Add('    TB_CONTA_PAGAR_CAB.COD_FILIAL = ' + wCodFilial + ')');
    DMOracle.QExecSQL.open;
    FRResumoIndicadores.qrlContasPagar7.Caption := FormatFloat('#,##0.00', DMOracle.QExecSQL.Fields[0].AsFloat);
    FRResumoIndicadores.qrlMesPagar7.Caption := 'Tot. Pag. ' + mesExtenso(wMes);
    {*** fim ***}

    {*** calcula o total das contas a pagar no mes 8 ***}
    wMes := IncMonth(wMes, 1);
    wPrimeiroDiaMes := datetostr(primeiroDiaMes(wMes));
    wUltimoDiaMes := datetostr(ultimoDiaMes(wMes));

    DMOracle.QExecSQL.Close;
    DMOracle.QExecSQL.SQL.Clear;
    DMOracle.QExecSQL.SQL.Add('SELECT');
    DMOracle.QExecSQL.SQL.Add('  SUM(VAL_TITULO)');
    DMOracle.QExecSQL.SQL.Add('FROM');
    DMOracle.QExecSQL.SQL.Add('  TB_CONTA_PAGAR_CAB');
    DMOracle.QExecSQL.SQL.Add('WHERE');
    DMOracle.QExecSQL.SQL.Add('  TB_CONTA_PAGAR_CAB.DT_VENCIMENTO >= ''' + wPrimeiroDiaMes + ''' ');
    DMOracle.QExecSQL.SQL.Add('  AND');
    DMOracle.QExecSQL.SQL.Add('  (' + wCodFilial + ' IS NULL OR');
    DMOracle.QExecSQL.SQL.Add('    TB_CONTA_PAGAR_CAB.COD_FILIAL = ' + wCodFilial + ')');
    DMOracle.QExecSQL.open;
    FRResumoIndicadores.qrlContasPagar8.Caption := FormatFloat('#,##0.00', DMOracle.QExecSQL.Fields[0].AsFloat);
    FRResumoIndicadores.qrlMesPagar8.Caption := 'Tot. Rec. ' + mesExtenso(wMes) + '+';
    {*** fim ***}


    {*** calcula o saldo do caixa ***}
    DMCaixa.QSaldo.Close;
    DMCaixa.QSaldo.SetVariable('DT_FINAL', StrToDate(FCaixaParam.ME15DtHoje.Text));

    if Trim(FCaixaParam.ME15Filial.Text) <> '' then
      DMCaixa.QSaldo.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME15Filial.Text)))
    else
      DMCaixa.QSaldo.SetVariable('COD_FILIAL', Null);
    DMCaixa.QSaldo.SetVariable('DEPARTAMENTOS', '1=1');
    DMCaixa.QSaldo.SetVariable('COD_HISTORICO', Null);
    DMCaixa.QSaldo.SetVariable('COD_HISTORICO_F', Null);
    DMCaixa.QSaldo.Open;

    DMCaixaRel.QRCaixa_MovCaixa.Close;
    if Trim(FCaixaParam.ME15Filial.Text) <> '' then
      DMCaixaRel.QRCaixa_MovCaixa.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME15Filial.Text)))
    else
      DMCaixaRel.QRCaixa_MovCaixa.SetVariable('COD_FILIAL', Null);

    DMCaixaRel.QRCaixa_MovCaixa.SetVariable('DEPARTAMENTOS', '1=1');
    DMCaixaRel.QRCaixa_MovCaixa.SetVariable('COD_HISTORICO',Null);
    DMCaixaRel.QRCaixa_MovCaixa.SetVariable('COD_HISTORICO_F',Null);
    DMCaixaRel.QRCaixa_MovCaixa.SetVariable('COD_CADASTRO',Null);
    DMCaixaRel.QRCaixa_MovCaixa.SetVariable('DT_INICIAL', StrToDate(FCaixaParam.ME15DtReferencia.Text));
    DMCaixaRel.QRCaixa_MovCaixa.SetVariable('DT_FINAL', StrToDate(FCaixaParam.ME15DtReferencia.Text));

    DMCaixaRel.QRCaixa_MovCaixa.Open;

    wReceita := 0;
    wDespesa := 0;
    DMCaixaRel.QRCaixa_MovCaixa.first;
    for i := 1 to DMCaixaRel.QRCaixa_MovCaixa.recordcount do
    begin
      if DMCaixaRel.QRCaixa_MovCaixaInd_Operacao.Value = '+' then
        wReceita := wReceita + DMCaixaRel.QRCaixa_MovCaixaVal_Movimento.Value
      else
        wDespesa := wDespesa + DMCaixaRel.QRCaixa_MovCaixaVal_Movimento.Value;
      DMCaixaRel.QRCaixa_MovCaixa.Next;
    end;
    FRResumoIndicadores.qrlSaldoCaixa.Caption := FormatFloat('#,##0.00', DMCaixa.QSaldoCredito.Value - DMCaixa.QSaldoDebito.Value + wReceita - wDespesa);
    DMCaixaRel.QRCaixa_MovCaixa.close;
    {*** fim ***}

    {*** despesas comissoes, etc, estao em um subdetail no relatorio ***}
    DMCaixaRel.QRIndicadoresDesp.Close;
    if Trim(FCaixaParam.ME15Filial.Text) <> '' then
      DMCaixaRel.QRIndicadoresDesp.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME15Filial.Text)))
    else
      DMCaixaRel.QRIndicadoresDesp.SetVariable('COD_FILIAL', Null);

    DMCaixaRel.QRIndicadoresDesp.SetVariable('DT_MOVIMENTO_INI', StrToDate({wPrimeiroDiaMes}'01/01/1000'));
    DMCaixaRel.QRIndicadoresDesp.SetVariable('DT_MOVIMENTO_FIM', StrToDate({wUltimoDiaMes}'01/01/3000'));

    DMCaixaRel.QRIndicadoresDesp.Open;
    {*** fim ***}



    if FCaixaParam.RGPreview.ItemIndex = 0 then
      FRResumoIndicadores.QRPrimario.Preview
    else
      FRResumoIndicadores.QRPrimario.Print;
  end;
end;

