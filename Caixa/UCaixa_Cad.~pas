procedure TFCaixaCad.DBPHistoricoValidate(Sender: TObject; Value: Variant;
  var isValid: Boolean; var Msg: string);
var
  wDep: string;
begin
  inherited;
  if (DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'MOINHO') and
    (not DMCaixa.QCaixa_MovCOD_HISTORICO.IsNull) then
  begin
    wDep := DMOracle.BuscaNome('SELECT COD_DEPARTAMENTO FROM TB_HISTORICO',
      'COD_HISTORICO = ' + DMCaixa.QCaixa_MovCOD_HISTORICO.Text);
    isValid := (wDep = '') or (wDep = DMCaixa.QCaixa_MovCOD_DEPARTAMENTO.Text);
    if not isValid then
      Msg := 'Historico Não Permitido Para Este Departamento';
  end;
end;

