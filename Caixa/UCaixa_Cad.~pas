function primeiroDiaMes(dt: TDate): TDate;
var d, m, a: word;
begin
  DecodeDate(dt, a, m, d);
  result := strtodate('01/' + inttostr(m) + '/' + inttostr(a));
end;

function ultimoDiaMes(dt: TDate): TDate;
var d, m, a: word;
begin
  DecodeDate(dt, a, m, d);
  if m = 12 then m := 1 else m := m + 1;
  result := strtodate('01/' + inttostr(m) + '/' + inttostr(a)) - 1;
end;

function mesExtenso(dt: TDate): string;
var
  d, m, a: word;
begin
  DecodeDate(dt, a, m, d);
  if m = 1 then result := 'Jan/' + inttostr(a);
  if m = 2 then result := 'Fev/' + inttostr(a);
  if m = 3 then result := 'Mar/' + inttostr(a);
  if m = 4 then result := 'Abr/' + inttostr(a);
  if m = 5 then result := 'Mai/' + inttostr(a);
  if m = 6 then result := 'Jun/' + inttostr(a);
  if m = 7 then result := 'Jul/' + inttostr(a);
  if m = 8 then result := 'Ago/' + inttostr(a);
  if m = 9 then result := 'Set/' + inttostr(a);
  if m = 10 then result := 'Out/' + inttostr(a);
  if m = 11 then result := 'Nov/' + inttostr(a);
  if m = 12 then result := 'Dez/' + inttostr(a);
end;

procedure TFCaixaCad.ResumoIndicadores1Click(Sender: TObject);
var
  wCodFilial, wPrimeiroDiaMes, wUltimoDiaMes: string;
  wVendaBruta, wVendaVista, wCustoVenda: real;
  wMes: TDate;
  i: integer;
begin
  inherited;
  if FCaixaParam = nil then
    FCaixaParam := TFCaixaParam.Create(Application);
  FCaixaParam.PGRelatorio.Pages[15].TabVisible := True;
  if FCaixaParam.ShowModal = MrOk then
  begin
    if FRResumoIndicadores = nil then
      FRResumoIndicadores := TFRResumoIndicadores.create(application);

    if trim(FCaixaParam.ME15Filial.Text) = '' then
      wCodFilial := 'NULL'
    else
      wCodFilial := trim(FCaixaParam.ME15Filial.Text);

    wPrimeiroDiaMes := DateToStr(primeiroDiaMes(strtodate(FCaixaParam.ME15DtReferencia.Text)));
    wUltimoDiaMes := DateToStr(ultimoDiaMes(strtodate(FCaixaParam.ME15DtReferencia.Text)));

    {*** calcula o total em estoque ***}
    DMOracle.QExecSQL.Close;
    DMOracle.QExecSQL.SQL.Clear;
    DMOracle.QExecSQL.SQL.Add('SELECT');
    DMOracle.QExecSQL.SQL.Add('  SUM(VL_CUSTO_MEDIO * QT_QUANTIDADE)');
    DMOracle.QExecSQL.SQL.Add('FROM');
    DMOracle.QExecSQL.SQL.Add('  TB_ESTOQUE');
    DMOracle.QExecSQL.SQL.Add('WHERE');
    DMOracle.QExecSQL.SQL.Add('  (' + wCodFilial + ' IS NULL OR');
    DMOracle.QExecSQL.SQL.Add('    TB_ESTOQUE.COD_FILIAL = ' + wCodFilial + ')');
    DMOracle.QExecSQL.open;
    FRResumoIndicadores.qrlValorEstoque.Caption := FormatFloat('#,##0.00', DMOracle.QExecSQL.Fields[0].AsFloat);
    {*** fim ***}

    {*** calcula o total de itens em estoque ***}
    DMOracle.QExecSQL.Close;
    DMOracle.QExecSQL.SQL.Clear;
    DMOracle.QExecSQL.SQL.Add('SELECT');
    DMOracle.QExecSQL.SQL.Add('  SUM(QT_QUANTIDADE)');
    DMOracle.QExecSQL.SQL.Add('FROM');
    DMOracle.QExecSQL.SQL.Add('  TB_ESTOQUE');
    DMOracle.QExecSQL.SQL.Add('WHERE');
    DMOracle.QExecSQL.SQL.Add('  (' + wCodFilial + ' IS NULL OR');
    DMOracle.QExecSQL.SQL.Add('    TB_ESTOQUE.COD_FILIAL = ' + wCodFilial + ')');
    DMOracle.QExecSQL.open;
    FRResumoIndicadores.qrlTotalItensEstoque.Caption := FormatFloat('#,##0.00', DMOracle.QExecSQL.Fields[0].AsFloat);
    {*** fim ***}

    {*** calcula as vendas brutas acumulada ***}
    DMOracle.QExecSQL.Close;
    DMOracle.QExecSQL.SQL.Clear;
    DMOracle.QExecSQL.SQL.Add('SELECT');
    DMOracle.QExecSQL.SQL.Add('  SUM(Tb_nota_item.VAL_TOTAL-DECODE(TB_NOTA_CAB.VAL_DESCONTO,0,0,Tb_nota_item.VAL_DESCONTO)+Tb_nota_item.VAL_DESPESAS+Tb_nota_item.VAL_FRETE) AS SVAL_TOTAL');
    DMOracle.QExecSQL.SQL.Add('FROM');
    DMOracle.QExecSQL.SQL.Add('  TB_NOTA_CAB,');
    DMOracle.QExecSQL.SQL.Add('  TB_NOTA_ITEM');
    DMOracle.QExecSQL.SQL.Add('WHERE');
    DMOracle.QExecSQL.SQL.Add('  TB_NOTA_CAB.IND_ENTRADA_SAIDA = ''S''');
    DMOracle.QExecSQL.SQL.Add('  AND');
