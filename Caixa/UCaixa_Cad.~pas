procedure TFCaixaCad.EmiteReciboEntrada40Col;
var wVal : string;
    wContador : integer;
begin
  // Impressão de Recibo - Matricial - Modificado por Djeison A. Selzlein - 17/08/2013
  if Imp = Nil Then
     Imp := TImp.Create;

  wVal := DMOracle.BuscaNome('SELECT DESC_LPT_RECIBO FROM TB_FILIAL','COD_FILIAL = '
    + DMCaixa.QCaixa_MovCOD_FILIAL.Text);
  if wVal = 'LPT1' then
    imp.AbreImpressora;
  if wVal = 'LPT2' then
    imp.AbreImpressora_Lpt2;
  if wVal = 'LPT3' then
    imp.AbreImpressora_Lpt3;
  if wval = 'COM2' then
    imp.AbreImpressora_Com2;

  Imp.ConfiguraImpressora('CONDENSADO_OFF','SEXTOS',3);

  DMFilial.QFilial.close;
  DMFilial.QFilial.SetVariable('PK', DMCaixa.QCaixa_MovCOD_FILIAL.Text);
  DMFilial.QFilial.open;

  DMDepartamento.QDepartamento.close;
  DMDepartamento.QDepartamento.SetVariable('PK', DMCaixa.QCaixa_MovCOD_DEPARTAMENTO.Text);
  DMDepartamento.QDepartamento.open;

  DMHistorico.QHistorico.close;
  DMHistorico.QHistorico.SetVariable('PK', DMCaixa.QCaixa_MovCOD_HISTORICO.Text);
  DMHistorico.QHistorico.open;

  if (DMCaixa.QCaixa_MovCOD_CADASTRO.Text <> '') then
  begin
    DMCadastro.QCadastro.Close;
    DMCadastro.QCadastro.SetVariable('PK', DMCaixa.QCaixa_MovCOD_CADASTRO.Text);
    DMCadastro.QCadastro.Open;
  end;
  wContador := 7;
  Imp.WriteXY(0,wContador,Copy(DMFilial.QFilialDESC_FILIAL.Value,1,40));
  Inc(wContador);
  Imp.WriteXY(0,wContador,Copy(DMFilial.QFilialDESC_ENDERECO.Value,1,40));
  Inc(wContador);
  Imp.WriteXY(0,wContador,Copy(DMFilial.QFilialDESC_TELEFONE.Value,1,40));
  Inc(wContador);
  With DMCaixa do
  begin
    Imp.WriteXY(0,wContador,'RECIBO DE MOVIMENTO DE CAIXA');
    Inc(wContador);
    Imp.WriteXY(0,wContador,'----------------------------------------');
    Inc(wContador);
    Imp.WriteXY(0,wContador,DateToStr(DMOracle.DataServ) + '            N. Doc.:  ' + QCaixa_MovNUM_DOCUMENTO.Text);
    Inc(wContador);
    Imp.WriteXY(0,wContador,'----------------------------------------');
    Inc(wContador);
    Imp.WriteXY(0,wContador,'CLI.:' + copy(DMCadastro.QCadastroNOME.Value, 1, 35));
    Inc(wContador);
    Imp.WriteXY(0,wContador,'END.:' + copy(DMCadastro.QCadastroDESC_ENDERECO.Value,1,35));
    Inc(wContador);
    Imp.WriteXY(0,wContador,copy(DMCadastro.QCadastroDESC_CIDADE.Value,1,40));
    Inc(wContador);
    Imp.WriteXY(0,wContador,'----------------------------------------');
    Inc(wContador);
    Imp.WriteXY(0,wContador,'Historico...: ' + DMHistorico.QHistoricoDESC_HISTORICO.Value);
    Inc(wContador);
    Imp.WriteXY(0,wContador,'Departamento: ' + DMDepartamento.QDepartamentoDESC_DEPARTAMENTO.Value);
    Inc(wContador);
    Imp.WriteXY(0,wContador,'----------------------------------------');
    Inc(wContador);
    Imp.WriteXY(0,wContador,'  Num. Doc...: ' + Bib.NumToTexto(QCaixa_MovNUM_DOCUMENTO.Value,0,10));
    Inc(wContador);
    Imp.WriteXY(0,wContador,'  Dt. Emissao: ' + DateToStr(QCaixa_MovDT_MOVIMENTO.Value));
    Inc(wContador);
    Imp.WriteXY(0,wContador,'  Val. Mov...: ' + Bib.NumToTexto(QCaixa_MovVAL_MOVIMENTO.Value,2,10));
    Inc(wContador);

    Imp.WriteXY(0,wContador,'----------------------------------------');
    wContador := wContador + 6;
    Imp.WriteXY(0,wContador,' ');
  end;

  Imp.ConfiguraImpressora('CONDENSADO_OFF','SEXTOS',66);
  Imp.FechaImpressora;  // Finaliza os serviços de Impressao
end;

