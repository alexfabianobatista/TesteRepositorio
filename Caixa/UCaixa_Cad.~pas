procedure TFCaixaCad.RelaodeMovimentosSaldos1Click(Sender: TObject);
var
  wdt_inicial, wdt_final: string;
begin
  inherited;
  if FCaixaParam = nil then
    FCaixaParam := TFCaixaParam.Create(Application);
  FCaixaParam.PGRelatorio.Pages[0].TabVisible := True;
  if FCaixaParam.ShowModal = MrOk then
  begin
    DmUsuario.Checar_Filial_Usuario(Trim(FCaixaParam.ME0CodFilial.Text), 'CAIXA');
    with DMCaixaRel do
    begin
      DMCaixa.QSaldo.Close;
      if Trim(FCaixaParam.ME0DtInicial.Text) = '' then
        raise Exception.Create('Campo Data Inicial Deve Ser Informado');
      DMCaixa.QSaldo.SetVariable('DT_FINAL', StrToDate(FCaixaParam.ME0DtInicial.Text) - 1); //envia a SQL o Dia anterior ao informado

      if Trim(FCaixaParam.ME0CodFilial.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME0CodFilial.Text)))
      else
        DMCaixa.QSaldo.SetVariable('COD_FILIAL', Null);

      if Trim(FCaixaParam.ME0CodDepto.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('DEPARTAMENTOS', 'TB_CAIXA_MOV.COD_DEPARTAMENTO IN (' + Trim(FCaixaParam.ME0CodDepto.Text) + ')')
      else
        DMCaixa.QSaldo.SetVariable('DEPARTAMENTOS', '1=1');

      if Trim(FCaixaParam.ME0CodHistorico.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO', StrToInt(Trim(FCaixaParam.ME0CodHistorico.Text)))
      else
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO', Null);

      if Trim(FCaixaParam.ME0CodHistorico.Text) <> '' then
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO_F', StrToInt(Trim(FCaixaParam.ME0CodHistorico.Text)))
      else
        DMCaixa.QSaldo.SetVariable('COD_HISTORICO_F', Null);

      //DMCaixa.QSaldo.SetVariable('DEPARTAMENTOS', '1=1');

      DMCaixa.QSaldo.Open;
      QRCaixa_MovSaldos.Close;

      if Trim(FCaixaParam.ME0CodFilial.Text) <> '' then
        QRCaixa_MovSaldos.SetVariable('COD_FILIAL', StrToInt(Trim(FCaixaParam.ME0CodFilial.Text)))
      else
        QRCaixa_MovSaldos.SetVariable('COD_FILIAL', Null);

      if Trim(FCaixaParam.ME0CodDepto.Text) <> '' then
        QRCaixa_MovSaldos.SetVariable('DEPARTAMENTOS', 'TB_CAIXA_MOV.COD_DEPARTAMENTO IN (' + Trim(FCaixaParam.ME0CodDepto.Text) + ')')
      else
        QRCaixa_MovSaldos.SetVariable('DEPARTAMENTOS', '1=1');

      QRCaixa_MovSaldos.SetVariable('DT_INICIAL', StrToDate(FCaixaParam.ME0DtInicial.Text));
      wdt_inicial := DateToStr(StrToDate(FCaixaParam.ME0DtInicial.Text));

      QRCaixa_MovSaldos.SetVariable('DT_FINAL', StrToDate(FCaixaParam.ME0DtFinal.Text));
      wdt_final := DateToStr(StrToDate(FCaixaParam.ME0DtFinal.Text));

      if Trim(FCaixaParam.ME0CodHistorico.Text) <> '' then
        QRCaixa_MovSaldos.SetVariable('COD_HISTORICO', StrToInt(Trim(FCaixaParam.ME0CodHistorico.Text)))
      else
        QRCaixa_MovSaldos.SetVariable('COD_HISTORICO', Null);

      QRCaixa_MovSaldos.Open;

      if DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'CASACARNES' then
      begin
        if FRCaixa_MovSaldos40Colunas = nil then
          FRCaixa_MovSaldos40Colunas := TFRCaixa_MovSaldos40Colunas.Create(Application);
        FRCaixa_MovSaldos40Colunas.QRLSaldoAnterior.Caption := FormatFloat('#,##0.00', (DMCaixa.QSaldoCredito.Value - DMCaixa.QSaldoDebito.Value));
        FRCaixa_MovSaldos40Colunas.QRLPeriodo.Caption := 'Periodo de: ' + wdt_inicial + ' até: ' + wdt_Final;
        FRCaixa_MovSaldos40Colunas.QRPrimario.Height := 217;
        FRCaixa_MovSaldos40Colunas.QRPrimario.Height := FRCaixa_MovSaldos40Colunas.QRPrimario.Height + QRCaixa_MovSaldos.RecordCount * 19;
        if FCaixaParam.RGPreview.ItemIndex = 0 then
          FRCaixa_MovSaldos40Colunas.QRPrimario.Preview
        else
          FRCaixa_MovSaldos40Colunas.QRPrimario.Print;
      end
      else
      if DMParamSistema.QParamSistemaCOD_EMPRESA.Value = 'AVEMED' then
      begin
        if FRCaixa_MovSaldosAvemed = nil then
          FRCaixa_MovSaldosAvemed := TFRCaixa_MovSaldosAvemed.Create(Application);
        FRCaixa_MovSaldosAvemed.QRLSaldoAnterior.Caption := FormatFloat('#,##0.00', (DMCaixa.QSaldoCredito.Value - DMCaixa.QSaldoDebito.Value));
        FRCaixa_MovSaldosAvemed.QRLPeriodo.Caption := 'Periodo de: ' + wdt_inicial + ' até: ' + wdt_Final;
        if FCaixaParam.RGPreview.ItemIndex = 0 then
          FRCaixa_MovSaldosAvemed.QRPrimario.Preview
        else
          FRCaixa_MovSaldosAvemed.QRPrimario.Print;
      end
      else
      begin
        if FRCaixa_MovSaldos = nil then
          FRCaixa_MovSaldos := TFRCaixa_MovSaldos.Create(Application);
        FRCaixa_MovSaldos.QRLSaldoAnterior.Caption := FormatFloat('#,##0.00', (DMCaixa.QSaldoCredito.Value - DMCaixa.QSaldoDebito.Value));
        FRCaixa_MovSaldos.QRLPeriodo.Caption := 'Periodo de: ' + wdt_inicial + ' até: ' + wdt_Final;
        if FCaixaParam.RGPreview.ItemIndex = 0 then
          FRCaixa_MovSaldos.QRPrimario.Preview
        else
          FRCaixa_MovSaldos.QRPrimario.Print;
      end;

      QRCaixa_MovSaldos.Close;
      DMCaixa.QSaldo.Close;
    end;
  end;
end;

