procedure TFCaixaCad.BitBtn1Click(Sender: TObject);
var
  Stream : TStream;
  FileStream : TFileStream;
  PastaTemp : String;
  NomeArquivo : String;
begin
  inherited;
  PastaTemp := GetEnvironmentVariable('TEMP');
  if (PastaTemp = '') then begin
    MessageDlg('É preciso definir a variável TEMP, para armazenamento de arquivos temporários.' ,
      mtError, [mbOK], 0);
    Abort;
  end;
  FileStream.Free;
  Stream.Free;
  NomeArquivo := PastaTemp + '\' + DsCaixaDocumento.DataSet.FieldByName('NOME_ARQUIVO').AsString;
  Stream := DsCaixaDocumento.DataSet.CreateBlobStream(DsCaixaDocumento.DataSet.FieldByName('ARQUIVO'), bmRead);
  try
    Stream.Seek(0, soFromBeginning);
    FileStream := TFileStream.Create(NomeArquivo, fmCreate);
    try
      FileStream.CopyFrom(Stream, Stream.Size);
    finally
      FileStream.Free;
    end;
    If FPDFViewer = Nil Then
       FPDFViewer := TFPDFViewer.Create(Self);
    FPDFViewer.Caption := 'Visualizando arquivo ' + NomeArquivo;
    FPDFViewer.Pdf1.src := NomeArquivo;
    FPDFViewer.ShowModal;
//    FPDFViewer := Nil;
  finally
    Stream.Free;
  end;
end;

procedure TFCaixaCad.BitBtn3Click(Sender: TObject);
var
  Stream : TStream;
  FileStream : TFileStream;
  wNomeArquivo : String;
  wPosicaoBarra : Integer;
begin
  inherited;
  DmCaixa.QCaixa_Documento.Insert;
  Stream := DmCaixa.QCaixa_Documento.CreateBlobStream(DmCaixa.QCaixa_DocumentoARQUIVO, bmWrite);
  try
    Stream.Seek(0, soFromBeginning);
    FileStream := TFileStream.Create(MeArquivo.Text, fmOpenRead or fmShareDenyWrite);
    try
      Stream.CopyFrom(FileStream, FileStream.Size);
    finally
      FileStream.Free;
    end;
    wNomeArquivo := MeArquivo.Text;
    wPosicaoBarra := Pos('\', wNomeArquivo);
    while (wPosicaoBarra > 0) do begin
      wNomeArquivo := Copy(wNomeArquivo, (wPosicaoBarra+1), Length(wNomeArquivo));
      wPosicaoBarra := Pos('\', wNomeArquivo);
    end;
    DmCaixa.QCaixa_DocumentoNOME_ARQUIVO.AsString := wNomeArquivo;
    DmCaixa.QCaixa_DocumentoDESCRICAO.AsString := MeArquivo.Text;
    DmCaixa.QCaixa_DocumentoDT_INCLUSAO.AsDateTime := Now;
    DmCaixa.QCaixa_DocumentoCOD_CAIXA_MOV.Value := DmCaixa.QCaixa_MovCOD_CAIXA_MOV.Value;

    DmCaixa.QCaixa_Documento.Post;
    MessageDlg('Arquivo inserido com sucesso' ,
      MtError, [mbOK], 0);
  finally
    Stream.Free;
  end;
end;



