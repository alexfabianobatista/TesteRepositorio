procedure TFCaixaCad.Demonstrativo1Click(Sender: TObject);
var
  wPeriodo: string;
begin
  inherited;
  if FCaixaParam = nil then
    FCaixaParam := TFCaixaParam.Create(Application);
  FCaixaParam.PGRelatorio.Pages[23].TabVisible := True;
  FCaixaParam.Me23DtInicial.Text := DateToStr(DMOracle.DataServ-360);
  FCaixaParam.Me23DtFinal.Text := DateToStr(DMOracle.DataServ);
  if FCaixaParam.ShowModal = MrOk then
  begin
    with DMCaixaRel do
    begin
      QRDemonstrativo.Close;
      if trim(FCaixaParam.Me23DtInicial.Text) <> '' then
      begin
        QRDemonstrativo.SetVariable('DT_EMISSAO_INI',trim(FCaixaParam.Me23DtInicial.Text));
        QRDemonstrativo.SetVariable('DT_MOVIMENTO_INI',trim(FCaixaParam.Me23DtInicial.Text));
      end
      else
      begin
        QRDemonstrativo.SetVariable('DT_EMISSAO_INI',null);
        QRDemonstrativo.SetVariable('DT_EMISSAO_FIM',null);
        QRDemonstrativo.SetVariable('DT_MOVIMENTO_INI',null);
        QRDemonstrativo.SetVariable('DT_MOVIMENTO_FIM',null);
      end;
      if trim(FCaixaParam.Me23DtFinal.Text) <> '' then
      begin
        QRDemonstrativo.SetVariable('DT_EMISSAO_FIM',trim(FCaixaParam.Me23DtFinal.Text));
        QRDemonstrativo.SetVariable('DT_MOVIMENTO_FIM',trim(FCaixaParam.Me23DtFinal.Text));
      end
      else
      begin
        QRDemonstrativo.SetVariable('DT_EMISSAO_INI',null);
        QRDemonstrativo.SetVariable('DT_EMISSAO_FIM',null);
        QRDemonstrativo.SetVariable('DT_MOVIMENTO_INI',null);
        QRDemonstrativo.SetVariable('DT_MOVIMENTO_FIM',null);
      end;
      QRDemonstrativo.Open;

      if FRDemonstrativo = nil then
        FRDemonstrativo := TFRDemonstrativo.Create(Application);
      FRDemonstrativo.QRLEmpresa.Caption := 'Filial: ' + QRDemonstrativoDESC_FILIAL.Text;
      if (trim(FCaixaParam.Me23DtInicial.Text) <> ' / / ') and (trim(FCaixaParam.Me23DtFinal.Text) <> ' / / ') then
        wPeriodo := ' de ' + trim(FCaixaParam.Me23DtInicial.Text) + ' até ' + trim(FCaixaParam.Me23DtFinal.Text)
      else
        wPeriodo := ' da inaguração até hoje';
      FRDemonstrativo.QRLTitulo.Caption := 'Relatório Demonstrativo da Empresa no período ' + wPeriodo;
      if FCaixaParam.RGPreview.ItemIndex = 0 then
        FRDemonstrativo.QRPrimario.Preview
      else
        FRDemonstrativo.QRPrimario.Print;
    end;
  end;
end;

