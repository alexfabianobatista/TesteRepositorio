  object LMensagem: TLabel
    Left = 0
    Top = 240
    Width = 329
    Height = 145
    Anchors = [akLeft, akTop, akRight]
    AutoSize = False
    Caption = 
      'O sistema est'#225' tentando obter conex'#227'o com o banco de dados. Quan' +
      'do isto acontecer, esta tela fechar'#225' automaticamente.'#13#10'Por favor' +
      ', n'#227'o finalize o sistema quando esta tela aparecer, aguarde o m'#225 +
      'ximo poss'#237'vel.'#13#10'Se, no entanto, voc'#234' deseja finalizar, basta cli' +
      'car com o bot'#227'o direito do mouse nesta tela e escolher a op'#231#227'o.'#13 +
      #10'Fazendo isto, h'#225' uma grande possibilidade do sistema travar pos' +
      'teriormente sem motivo aparente. Portanto, opte por aguardar a r' +
      'econex'#227'o autom'#225'tica sempre que puder.'#13#10'Se, depois de desaparecer' +
      ' esta tela, o sistema n'#227'o funcionar corretamente, tente reinici'#225 +
      '-lo.'
    WordWrap = True
  end
