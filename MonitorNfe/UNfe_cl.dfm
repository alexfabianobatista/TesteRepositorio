  object QNfeEmissao: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.DESC_REPOSITORIO_NFE,'
      '  F.NUM_CGC,'
      '  F.IND_CONTINGENCIA,'
      '  F.IND_CONTINGENCIA_NFCE,'
      '  F.DESC_JUST_CONTINGENCIA_NFCE,'
      '  F.DT_CONTINGENCIA_NFCE,'
      '  F.IND_VIAS_DANFE,'
      '  F.NUM_VIAS_DANFE,'
      '  F.IND_VIAS_DANFE_NFCE,'
      '  F.NUM_VIAS_DANFE_NFCE,'
      
        '  DECODE(N.COD_SERIE_MODELO, '#39'65'#39',F.DESC_CERTIFICADO_NFCE, F.DES' +
        'C_CERTIFICADO) AS DESC_CERTIFICADO,'
      
        '  DECODE(N.COD_SERIE_MODELO, '#39'65'#39',F.DESC_LOGOTIPO_DANFE_NFCE, F.' +
        'DESC_LOGOTIPO_DANFE) AS DESC_LOGOTIPO_DANFE,'
      
        '  DECODE(N.COD_SERIE_MODELO, '#39'65'#39',F.IND_AMBIENTE_NFCE, F.IND_AMB' +
        'IENTE_NFE) AS IND_AMBIENTE_NFE,'
      '  F.DESC_VERSAO_NFE,'
      '  F.DESC_VERSAO_NFCE,'
      '  F.DESC_VERSAO_NFSE,'
      '  F.IND_IMPRIME_DANFE,'
      '  F.IND_IMPRIME_DANFE_NFCE,'
      '  N.DESC_CHAVE_ACESSO,'
      '  N.COD_NOTA_CAB,'
      '  N.DT_EMISSAO,'
      '  N.COD_SERIE,'
      '  N.COD_SERIE_MODELO,'
      '  N.NUM_NOTA,'
      '  N.COD_FILIAL,'
      '  N.IND_SITUACAO,'
      '  O.IND_EMITE,'
      '  O.IND_SERVICO,'
      '  S.COD_SERIE_MODELO AS DESC_MODELO,'
      '  E.COD_UF_IBGE,'
      '  E_FILIAL.COD_UF_IBGE AS COD_UF_IBGE_FILIAL,'
      '  NFE.DESC_RETORNO_PROCESSAMENTO,'
      '  NFE.ID_LOTE,'
      
        '  DECODE(N.COD_SERIE_MODELO, '#39'65'#39',U.DESC_IMPRESSORA_DANFE_NFCE, ' +
        'U.DESC_IMPRESSORA_DANFE) AS DESC_IMPRESSORA_DANFE,'
      '  CASE'
      '    WHEN PARAM.IND_NOTA_AUTOMATICA_WEB = '#39'SIM'#39' THEN'
      '      DECODE(V.DESC_E_MAIL, NULL, C.DESC_E_MAIL,'
      
        '        DECODE(C.DESC_E_MAIL, NULL, V.DESC_E_MAIL, C.DESC_E_MAIL' +
        ' || '#39';'#39' || V.DESC_E_MAIL)'
      '      )'
      '    ELSE'
      '      C.DESC_E_MAIL'
      '  END AS DESC_E_MAIL'
      'FROM'
      '  TB_PARAM_SISTEMA PARAM,'
      '  TB_NOTA_CAB N'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  N.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_SERIE S'
      'ON'
      
        '  (N.COD_SERIE = S.COD_SERIE AND N.COD_FILIAL = S.COD_FILIAL AND' +
        ' N.COD_SERIE_MODELO = S.COD_SERIE_MODELO)'
      'LEFT JOIN'
      '  TB_OPERACAO O'
      'ON'
      '  N.COD_OPERACAO = O.COD_OPERACAO'
      'LEFT JOIN'
      '  TB_ESTADO E'
      'ON'
      '  N.COD_ESTADO = E.COD_ESTADO'
      'LEFT JOIN'
      '  TB_ESTADO E_FILIAL'
      'ON'
      '  F.COD_ESTADO = E_FILIAL.COD_ESTADO'
      'LEFT JOIN'
      '  TB_NF_ELETRONICA NFE'
      'ON'
      '  N.COD_NOTA_CAB = NFE.COD_NOTA_CAB'
      'LEFT JOIN'
      '  TB_USUARIO U'
      'ON'
      '  (:COD_USUARIO = U.COD_USUARIO)'
      'INNER JOIN'
      '  TB_CADASTRO C'
      'ON'
      '  N.COD_CADASTRO = C.COD_CADASTRO'
      'LEFT JOIN '
      '  TB_VENDEDOR V'
      'ON'
      '  N.COD_VENDEDOR = V.COD_VENDEDOR'
      'WHERE'
      '  N.COD_NOTA_CAB = :NOTA_CAB'
      '')
    Variables.Data = {
      0300000001000000090000003A4E4F54415F4341420300000000000000000000
      00}
