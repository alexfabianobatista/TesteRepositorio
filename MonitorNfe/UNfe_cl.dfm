  object QCidadeDescarga: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '  CD.*,'
      '  E.COD_UF_IBGE || CID.COD_CIDADE_IBGE AS COD_IBGE,'
      '  CID.DESC_CIDADE,'
      '  CID.COD_ESTADO'
      'FROM'
      '  TB_CIDADE_DESCARGA CD'
      'LEFT JOIN'
      '  TB_CIDADE CID'
      'ON'
      '  CD.COD_CIDADE = CID.COD_CIDADE'
      'LEFT JOIN'
      '  TB_ESTADO E'
      'ON'
      '  CID.COD_ESTADO = E.COD_ESTADO'
      'where cod_manifesto = :cod_manifesto')
