  object QNfeEnviaEmail: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  C.DESC_E_MAIL DESC_EMAIL,'
      '  NF.NUM_NOTA,'
      '  NF.COD_SERIE,'
      '  NFE.DESC_CHAVE_ACESSO,'
      '  F.DESC_REPOSITORIO_NFE,'
      '  F.DESC_FILIAL,'
      '  F.NUM_CGC'
      'FROM'
      '  TB_NF_ELETRONICA NFE'
      'LEFT JOIN'
      '  TB_NOTA_CAB NF'
      'ON'
      '  SUBSTR(NF.DESC_CHAVE_ACESSO,4,47) = NFE.DESC_CHAVE_ACESSO'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  NF.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_CADASTRO C'
      'ON'
      '  NF.COD_CADASTRO = C.COD_CADASTRO'
      'WHERE'
      '  SUBSTR(NF.DESC_CHAVE_ACESSO,4,47) = :CHAVE'
      '')
    Variables.Data = {0300000001000000060000003A4348415645050000000000000000000000}
