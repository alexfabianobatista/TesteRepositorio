  object QInfDoc: TOracleDataSet
    SQL.Strings = (
      'SELECT '
      '  ID.COD_INF_DOC, '
      '  ID.COD_CIDADE_DESCARGA,'
      '  ID.IND_TIPO_DOC,      '
      '  ID.DESC_CHAVE_ACESSO,  '
      '  ID.DESC_SEG_COD_BARRA, '
      '  ID.NUM_DOC, '
      '  ID.DESC_SERIE,      '
      '  ID.DESC_SUBSERIE,       '
      '  ID.DT_EMISSAO,       '
      '  ID.VAL_CARGA, '
      '  ID.DESC_CNPJ_EMIT, '
      '  ID.COD_UF_DEST,      '
      '  ID.VAL_NF, '
      '  ID.DESC_PIN_SUFRAMA,   '
      '  ID.IND_SOMA_TOTAIS,    '
      '  ID.NUM_PESO,'
      '  ID.DESC_CIOT,'
      '  CT.IND_FORMA_PGTO,'
      '  CT.VAL_TOTAL_CTE,'
      '  NVL(CR.DT_VENCIMENTO,sysdate) as DT_VENCIMENTO,'
      '  TOM.NOME,'
      
        '  DECODE(NVL(ID.NUM_CPF_CNPJ_TOMADOR,'#39#39'), '#39#39', TOM.NUM_CGC_CPF, I' +
        'D.NUM_CPF_CNPJ_TOMADOR) CPF_CNPJ_TOMADOR,'
      '  TOM.IND_FISICA_JURIDICA,'
      '  BANCO.COD_BANCO,'
      '  BANCO.COD_AGENCIA'
      'FROM'
      '  TB_INF_DOC ID'
      'LEFT JOIN'
      '  TB_CONHECIMENTO CT'
      'ON'
      '  CT.COD_CONHECIMENTO = ID.COD_CONHECIMENTO'
      'LEFT JOIN'
      '  TB_CADASTRO TOM'
      'ON'
      '  TOM.COD_CADASTRO = CT.COD_CADASTRO_TOMADOR'
      'LEFT JOIN'
      '  TB_CONTA_RECEBER_CAB CR'
      'ON'
      '  CR.COD_CONTA_RECEBER_CAB = CT.COD_CONTA_RECEBER_CAB'
      'LEFT JOIN'
      '  TB_BANCO_AGENCIA BANCO'
      'ON'
      '  BANCO.IND_BANCO_PADRAO = '#39'SIM'#39
      'where cod_cidade_descarga = :cod_cidade_descarga')
    Variables.Data = {
      0300000001000000140000003A434F445F4349444144455F4445534341524741
      030000000000000000000000}
    SequenceField.Field = 'COD_INF_DOC'
    SequenceField.ApplyMoment = amOnNewRecord
