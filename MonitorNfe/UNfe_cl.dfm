  object QSomaNfe: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  NI.COD_NOTA_CAB,'
      '  SUM(NI.VAL_IPI) SVAL_IPI,'
      '  SUM(NI.VAL_II) SVAL_II,'
      '  SUM(NI.VAL_TOTAL) SVAL_TOTAL,              '
      
        '  SUM(NI.VAL_TOTAL * LS.PERC_TRIBUTO_NACIONAL/100) AS SVAL_TOTAL' +
        '_TRIB_NFSE,'
      
        '  ROUND(SUM((NI.VAL_DESCONTO * NI.QT_QUANTIDADE) + NI.VAL_DESCON' +
        'TO_RATEIO),2) SVAL_DESCONTO,'
      '  SUM(NI.VAL_FRETE) SVAL_FRETE,'
      
        '  SUM(DECODE(P.IND_TIPO_PRODUTO, '#39'SERVI'#199'O'#39', NI.VAL_TOTAL, 0)) AS' +
        ' SVAL_TOTAL_SERVICOS,'
      
        '  COUNT(DECODE(P.IND_TIPO_PRODUTO, '#39'SERVI'#199'O'#39', 1, 0)) AS SQT_TOTA' +
        'L_SERVICOS,'
      
        '  SUM(DECODE(P.IND_TIPO_PRODUTO, '#39'SERVI'#199'O'#39', (NI.VAL_DESCONTO * N' +
        'I.QT_QUANTIDADE) + NI.VAL_DESCONTO_RATEIO, 0)) AS SVAL_DESCONTO_' +
        'SERVICO,'
      
        '  SUM(DECODE(P.IND_TIPO_PRODUTO, '#39'SERVI'#199'O'#39', NI.VAL_DESPESAS, 0))' +
        ' AS SVAL_DESPESAS_SERVICO,'
      '  SUM(NI.VAL_DESPESAS) SVAL_DESPESAS,'
      '  SUM(NI.VAL_ICM_BASE) SVAL_ICM_BASE,'
      '  SUM('
      '    CASE'
      
        '      WHEN TRIB.DESC_SITUACAO_TRIB = '#39'060'#39' OR TRIB.DESC_CSOSN = ' +
        #39'500'#39' THEN 0'
      '      ELSE NI.VAL_BASE_SUBST'
      '    END) SVAL_BASE_SUBST/*,'
      '  SUM(NI.VAL_TOTAL+VAL_IPI-VAL_ICM_BASE) SVAL_ICM_BASE_ISENTO*/,'
      '  SUM(NI.VAL_ICM) AS SVAL_ICM,'
      '  SUM(NI.VAL_IBS_MUN) AS SVAL_IBS_MUN,'
      '  SUM(NI.VAL_IBS_EST) AS SVAL_IBS_EST,'
      '  SUM(NI.VAL_IS) AS SVAL_IS,'
      '  SUM(NI.VAL_CBS) AS SVAL_CBS,'
      '  SUM(NI.VAL_BC_IBS_CBS) AS SVAL_BC_IBS_CBS,'
      '  SUM('
      '    CASE'
      
        '      WHEN TRIB.DESC_SITUACAO_TRIB = '#39'060'#39' OR TRIB.DESC_CSOSN = ' +
        #39'500'#39' THEN 0'
      '      ELSE NI.VAL_ICMS_SUBST'
      '    END) SVAL_ICMS_SUBST,'
      '  SUM(NI.VAL_ICMS_SUBST_ANT) SVAL_ICMS_SUBST_ANT/*,'
      '  SUM(NI.VAL_TOTAL*NI.PERC_INSS/100) SVAL_INSS*/,'
      '  SUM(NI.VAL_PIS) SVAL_PIS,'
      '  SUM(NI.VAL_CONFINS) SVAL_COFINS,'
      '  SUM(NI.VAL_CSLL) SVAL_CSLL,'
      '  SUM(NI.VAL_IR) SVAL_IR,'
      '  SUM(NI.VAL_INSS) SVAL_INSS/*,'
      '  SUM(NI.QT_QUANTIDADE) AS SQT_TOTAL*/,'
      '  SUM(NI.VAL_ISS) AS SVAL_ISS,'
      '  SUM(NI.QT_QUANTIDADE * P.NUM_PESO_LIQUIDO) AS SQT_PESO_L,'
      '  SUM(NI.QT_QUANTIDADE * P.NUM_PESO_BRUTO) AS SQT_PESO_B,/*,'
      
        '  SUM(DECODE(P.IND_TIPO_PRODUTO,'#39'SERVI'#199'O'#39',NI.VAL_UNITARIO*NI.QT_' +
        'QUANTIDADE,0))'
      '    AS VAL_BRUTO_SERVICO,'
      
        '  SUM(DECODE(P.IND_TIPO_PRODUTO,'#39'SERVI'#199'O'#39',0,NI.VAL_UNITARIO*NI.Q' +
        'T_QUANTIDADE))'
      '    AS VAL_BRUTO_PRODUTO*/'
      '  SUM(CASE'
      
        '    WHEN ((NI.COD_CST_PIS = '#39'04'#39') OR (NI.COD_CST_COFINS = '#39'04'#39'))' +
        ' THEN'
      '      NI.VAL_TOTAL'
      '    ELSE'
      '      0'
      '    END) AS VAL_MONOFASICO,'
      '  SUM(NI.VAL_ICMS_DIFERENCIAL) AS SVAL_ICMS_DIFERENCIAL,'
      '  SUM(NI.VAL_DPI_TRANSGENICOS) SVAL_DPI_TRANSGENICOS,'
      '  SUM(NI.VAL_FACS) SVAL_FACS,'
      '  SUM(NI.VAL_FETHAB) SVAL_FETHAB,'
      
        '  SUM(NI.VAL_BASE_ST_ANTERIOR_RETIDO) SVAL_BASE_ST_ANTERIOR_RETI' +
        'DO,'
      '  SUM(NI.VAL_ST_ANTERIOR_RETIDO) SVAL_ST_ANTERIOR_RETIDO'
      'FROM'
      '  TB_NOTA_ITEM NI'
      'LEFT JOIN'
      '  TB_PRODUTO P'
      'ON'
      '  NI.COD_PRODUTO = P.COD_PRODUTO'
      'LEFT JOIN'
      '  TB_LISTA_SERVICO LS'
      'ON'
      '  P.COD_LISTA_SERVICO = LS.COD_LISTA_SERVICO'
      'LEFT JOIN'
      '  TB_NOTA_CAB N'
      'ON'
      '  N.COD_NOTA_CAB = NI.COD_NOTA_CAB'
      'LEFT JOIN'
      '  TB_FUNDO_COMBATE_POBREZA FCP'
      'ON'
      
        '  FCP.COD_PRODUTO = NI.COD_PRODUTO AND FCP.COD_ESTADO = N.COD_ES' +
        'TADO'
      'LEFT JOIN'
      '  TB_TRIBUTACAO TRIB'
      'ON'
      '  TRIB.COD_TRIBUTACAO = NI.COD_TRIBUTACAO'
      'WHERE'
      '  NI.COD_NOTA_CAB = :COD_NOTA_CAB'
      'GROUP BY'
      '  NI.COD_NOTA_CAB')
