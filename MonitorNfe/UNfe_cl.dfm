  object QMdfeEmissao: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.DESC_REPOSITORIO_NFE,'
      '  F.NUM_CGC,'
      '  F.IND_VIAS_DAMDFE,'
      '  F.NUM_VIAS_DAMDFE,'
      '  F.DESC_CERTIFICADO,'
      '  F.IND_AMBIENTE_MDFE,'
      '  F.DESC_VERSAO_MDFE,'
      '  F.IND_IMPRIME_DAMDFE,'
      '  M.DESC_CHAVE_ACESSO,'
      '  M.COD_MANIFESTO,'
      '  M.DT_EMISSAO,'
      '  M.COD_SERIE,'
      '  M.NUM_MANIFESTO,'
      '  M.COD_FILIAL,'
      '  M.IND_SITUACAO,'
      '  E_FILIAL.COD_UF_IBGE AS COD_UF_IBGE_FILIAL,'
      '  S.COD_SERIE_MODELO AS DESC_MODELO,'
      '  MDFE.DESC_RETORNO_PROCESSAMENTO,'
      '  MDFE.DESC_RETORNO_CANCELAMENTO,'
      '  MDFE.DESC_RETORNO_ENCERRAMENTO,'
      '  U.DESC_IMPRESSORA_DACTE'
      'FROM'
      '  TB_MANIFESTO M'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  M.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_SERIE S'
      'ON'
      
        '  (M.COD_SERIE = S.COD_SERIE AND M.COD_FILIAL = S.COD_FILIAL AND' +
        ' M.COD_SERIE_MODELO = S.COD_SERIE_MODELO)'
      'LEFT JOIN'
      '  TB_ESTADO E_FILIAL'
      'ON'
      '  F.COD_ESTADO = E_FILIAL.COD_ESTADO'
      'LEFT JOIN'
      '  TB_MDFE MDFE'
      'ON'
      '  M.COD_MANIFESTO = MDFE.COD_MANIFESTO'
      'LEFT JOIN'
      '  TB_USUARIO U'
      'ON'
      '  (:COD_USUARIO = U.COD_USUARIO)'
      'WHERE'
      '  M.COD_MANIFESTO = :COD_MANIFESTO')
    Variables.Data = {
      03000000010000000E0000003A434F445F4D414E49464553544F030000000000
      000000000000}
