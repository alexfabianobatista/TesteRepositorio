  object QGeraNfeItem: TOracleDataSet1
    SQL.Strings = (
      'SELECT * FROM ('
      '  SELECT'
      '    FAB.NUM_CGC_CPF NUM_CGC_CPF_FAB,'
      
        '    DECODE(NI.DESC_COMPLEMENTO,NULL, P.DESC_PRODUTO, NI.DESC_COM' +
        'PLEMENTO) DESC_PRODUTO,'
      '    P.NUM_ORIGEM,'
      '    P.COD_SERVICO_MUNICIPAL,'
      '    P.COD_PRODUTO_ANP,'
      '    ANP.DESC_ANP,'
      '    P.QT_TEMP,'
      '    P.PERC_MIXGN,'
      '    P.DESC_RECOPI,'
      '    P.COD_UF_CONSUMO,'
      '    P.PERC_GLP_PETROLEO,'
      '    P.PERC_GNI,'
      '    P.NUM_FABRICANTE,'
      '    P.DESC_UNIDADE,'
      '    P.DESC_COD_BARRA,'
      '    P.IND_TIPO_PRODUTO,'
      '    P.PERC_ISS,'
      '    P.IND_RETORNAVEL,'
      '    P.COD_EX_TIPI,'
      '    P.NUM_GENERO_NCM,'
      '    P.COD_LISTA_SERVICO,'
      '    P.COD_CADASTRO COD_CADASTRO_FAB,'
      '    P.NUM_PESO_BRUTO PESO_BRUTO_PRODUTO,'
      '    P.NUM_PESO_LIQUIDO PESO_LIQUIDO_PRODUTO, '
      '    REPLACE(P.COD_CEST,'#39'.'#39','#39#39') AS COD_CEST,'
      '    P.COD_BENEF_FISCAL_REDUCAO,'
      '    P.COD_BENEF_FISCAL_IMUNIDADE,'
      '    P.COD_BENEF_FISCAL_ISENCAO,'
      '    P.COD_BENEF_FISCAL_SUSPENSAO,'
      '    P.PERC_AD_REM_ICMS,'
      '    P.COD_BENEF_FISCAL_DIFERIMENTO,'
      '    COD_CST_IPI_ENQU_IMUNE,'
      '    COD_CST_IPI_ENQU_SUSPENSAO,'
      '    COD_CST_IPI_ENQU_ISENCAO/*,'
      
        '    P.DESC_COMPLEMENTO || '#39' '#39' || P.DESC_COMPLEMENTO_2 AS DESC_CO' +
        'MPLEMENTO,'
      '    P.NUM_EMBALAGEM,'
      '    P.NUM_VOLUMES,'
      '    P.DESC_CLASS_FISCAL,'
      '    P.IND_TIPO_EMBALAGEM,'
      '    P.IND_CESTA_BASICA,'
      '    P.VAL_PRECO_FRETE,'
      
        '    P.COD_NBM_SH,  //retirado o NVL, '#233' correto considerar 0 quan' +
        'do n'#227'o est'#225' informado? Deu problema na verifica'#231#227'o se o NCM est'#225 +
        ' preenchido. por: Alessandro em 07/01/13'
      '    P.DESC_FORMULACAO,'
      '    P.DESC_GRUPO_QUIMICO,'
      '    P.NUM_METROS_CUBICOS,'
      '    P.DESC_LOCALIZACAO,'
      '    P.IND_APLICA_DEDUCAO_BC_ISS,'
      '    NI.COD_NOTA_CAB,'
      '    P.COD_GENERO_PRODUTO*/,'
      '    P.COD_PRODUTO_ANVISA,'
      '    P.DESC_MOTIVO_ISENCAO_ANVISA,'
      '    P.VAL_PRECO_MAXIMO_CONSUMIDOR,'
      '    P.IND_IMPORT_COMB,'
      '    P.UF_ORIGEM_COMB,'
      '    P.PERC_ORIG_UF_COMB,'
      '    P.COD_NBS,'
      '    NI.COD_PRODUTO,'
      '    NI.VAL_DESPESAS,'
      '    NI.COD_NOTA_ITEM,'
      '    NI.COD_TRIBUTACAO,'
      '    NI.QT_QUANTIDADE,'
      '    NI.NUM_NOTA_PRODUTOR,'
      '    NI.VAL_UNITARIO,'
      '    NI.VAL_TOTAL,'
      '    (NI.VAL_TOTAL'
      '      + NI.VAL_IPI'
      '      + NI.VAL_DESPESAS'
      
        '      - ROUND(NI.VAL_DESCONTO * NI.QT_QUANTIDADE + VAL_DESCONTO_' +
        'RATEIO,2)'
      '      + NI.VAL_ICMS_SUBST'
      '      + NI.VAL_FRETE) SVAL_TOTAL_ITEM,'
      '    NCM.DESC_UN_MEDIDA UNIDADE_NCM,'
      '    CASE'
      '    WHEN OP.NUM_NATUREZA_INT_NOVO BETWEEN 3000 AND 4000 THEN'
      '      NI.VAL_TOTAL * NCM.PERC_TRIBUTO_IMPORTADO/100'
      '    ELSE'
      '      NI.VAL_TOTAL * NCM.PERC_TRIBUTO_NACIONAL/100'
      '    END AS VAL_TOTAL_TRIB,'
      '    NI.PERC_IPI/*,'
      '    NI.PERC_DESC,'
      '    NI.IND_TIPO_CONSUMO*/,'
      '    NI.VAL_IPI,'
      '    NI.VAL_ISS,'
      '    NI.VAL_ICM_BASE,'
      '    NI.VAL_ICM/*,'
      '    NI.VAL_TOTAL*NI.PERC_INSS/100 AS VAL_INSS*/,'
      
        '    ROUND(NI.VAL_DESCONTO * NI.QT_QUANTIDADE + VAL_DESCONTO_RATE' +
        'IO,2) AS VAL_DESCONTO,'
      '    NI.VAL_DPI_TRANSGENICOS/*,'
      '    NI.VAL_FACS,'
      '    NI.VAL_FETHAB*/,'
      '    NI.VAL_CONFINS AS VAL_COFINS/*,'
      '    NI.NUM_VOLUMES AS NUM_VOLUMES_NOTA,'
      '    NI.NUM_CABECAS,'
      '    NI.NUM_FABRICANTE AS NUM_FABRICANTE_ITEM*/,'
      '    NI.VAL_FRETE,'
      '    NI.VAL_PIS,'
      '    --NVL(NI.COD_CST_PIS,'#39'07'#39') AS COD_CST_PIS, --ISENTO'
      '    --NVL(NI.COD_CST_COFINS,'#39'07'#39') AS COD_CST_COFINS, --ISENTO'
      #9'NVL(NI.COD_CST_COFINS,'
      #9#9'NVL(OP.COD_CST_COFINS,'
      #9#9#9'NVL(P.COD_CST_COFINS,'#39'07'#39')'
      #9#9')'
      #9')'#9'COD_CST_COFINS,'
      #9'NVL(NI.COD_CST_PIS,'
      #9#9'NVL(OP.COD_CST_PIS,'
      #9#9#9'NVL(P.COD_CST_PIS,'#39'07'#39')'
      #9#9')'
      #9')COD_CST_PIS,'
      '    NI.COD_CST_IPI,'
      '    NI.VAL_BASE_SUBST,'
      '    NI.VAL_ICMS_SUBST,'
      '    NI.COD_CFOP/*,'
      '    NI.DESC_COMPLEMENTO AS DESC_COMPL_ITEM,'
      '    NI.DESC_RENDA*/,'
      '    NI.NUM_DI,'
      '    NI.DT_DI,'
      '    NI.DESC_LOCAL_DESEMB_DI,'
      '    NI.COD_UF_DESEMB_DI,'
      '    NI.DT_DESEMB_DI,'
      '    NI.IND_TIPO_VIA_TRANSP_DI,'
      '    NI.VAL_AFRMM_DI,'
      '    NI.IND_TIPO_INTERMEDIO_DI,'
      '    NI.DESC_CNPJ_ENCOMENDANTE_DI,'
      '    NI.DESC_UF_ENCOMENDANTE_DI,'
      '    NI.COD_EXPORTADOR,'
      '    NI.VAL_BC_II,'
      '    NI.VAL_DESPADU_II,'
      '    NI.VAL_II,'
      '    NI.VAL_IOF_II,'
      '    DECODE(PARAM.COD_EMPRESA,'#39'ABATE'#39','
      
        '    NI.NUM_VOLUMES ||'#39' - '#39'|| NI.DESC_INF_ADICIONAL, NI.DESC_INF_' +
        'ADICIONAL) DESC_INF_ADICIONAL,'
      '    NI.VAL_ICMS_DIFERENCIAL,'
      '    NI.PERC_ALIQ_ICMS_DIFERENCIAL,'
      '    NI.PERC_BASE_SUBST,'
      '    NI.NUM_PEDIDO_COMPRA,'
      '    NI.NUM_PEDIDO_COMPRA_ITEM,'
      '    NI.VAL_ST_ANTERIOR_RETIDO,'
      '    NI.VAL_BASE_ST_ANTERIOR_RETIDO,'
      '    NI.PERC_ST_ANTERIOR_RETIDO,'
      '    NI.VAL_IBS_MUN,'
      '    NI.VAL_IBS_EST,'
      '    NI.VAL_CBS,'
      '    NI.VAL_IS,'
      '    NI.VAL_BC_IBS_CBS,'
      '    NI.NUM_CST_IBS_CBS,'
      '    NI.NUM_CLASS_TRIB_IBS_CBS,'
      '    NI.VAL_IBS_MUN_REGULAR,'
      '    NI.VAL_IBS_EST_REGULAR,'
      '    NI.VAL_CBS_REGULAR,'
      '    NI.NUM_CST_IBS_CBS_REGULAR,'
      '    NI.NUM_CLASS_TRIB_IBS_CBS_REGULAR,'
      '    OS_ITEM.COD_ORDEM_SERVICO_CAB,'
      
        '    DECODE(SUBST.PERC_ALIQUOTA, NULL, E.PERC_ALIQ_SUBST, SUBST.P' +
        'ERC_ALIQUOTA) PERC_ALIQ_SUBST,'
      '    E.PERC_REDUCAO_ICMS_SUBST,'
      '    E.PERC_IBS_UF,'
      '    CID.PERC_IBS_MUN,'
      '    TRIB.NUM_CLASSIFICACAO,'
      '    TRIB.PERC_ALIQUOTA,'
      '    TRIB.PERC_TRIBUTADO_NOTA/*,'
      '    TRIB.PERC_TRIBUTADO_NOTA,'
      '    TRIB.NUM_CLASSIFICACAO*/,'
      '    TRIB.PERC_TRIBUTADO,'
      '    TRIB.PERC_DIFERIMENTO,'
      '    TRIB.PERC_CBS,'
      '    CASE'
      '      WHEN (CAD.IND_FISICA_JURIDICA = '#39'J'#39')'
      '        AND('
      '        (CAD.NUM_INSCRICAO IS NULL)'
      
        '        OR ((CAD. NUM_INSCRICAO = '#39'ISENTO'#39') AND (CAD.IND_CONTRIB' +
        'UINTE = '#39'NAO'#39'))'
      '        ) THEN'
      '        TRIB.DESC_SITUACAO_TRIB_NC'
      
        '      WHEN (CAD.IND_FISICA_JURIDICA = '#39'F'#39') AND ((CAD.DESC_INSCRI' +
        'CAO_MUNICIPAL IS NULL) OR (CAD.IND_CONTRIBUINTE = '#39'NAO'#39')) THEN'
      '        TRIB.DESC_SITUACAO_TRIB_NC'
      '      ELSE'
      '        TRIB.DESC_SITUACAO_TRIB'
      '    END AS CST,'
      '    CASE'
      '      WHEN (CAD.IND_FISICA_JURIDICA = '#39'J'#39')'
      '        AND('
      '        (CAD.NUM_INSCRICAO IS NULL)'
      
        '        OR ((CAD. NUM_INSCRICAO = '#39'ISENTO'#39') AND (CAD.IND_CONTRIB' +
        'UINTE = '#39'NAO'#39'))'
      '        ) THEN'
      '        TRIB.DESC_CSOSN_NC'
      '      WHEN CAD.IND_FISICA_JURIDICA = '#39'F'#39' THEN'
      '        TRIB.DESC_CSOSN_NC'
      '      ELSE'
      '        TRIB.DESC_CSOSN'
      '    END AS CSOSN,    '
      '    CASE'
      '      WHEN (CAD.IND_FISICA_JURIDICA = '#39'J'#39') '
      '        AND( '
      '        (CAD.NUM_INSCRICAO IS NULL)'
      
        '        OR ((CAD. NUM_INSCRICAO = '#39'ISENTO'#39') AND (CAD.IND_CONTRIB' +
        'UINTE = '#39'NAO'#39'))'
      '        ) THEN'
      '        TRIB.DESC_OBSERVACAO_NC'
      
        '      WHEN CAD.IND_FISICA_JURIDICA = '#39'F'#39' AND ((CAD.DESC_INSCRICA' +
        'O_MUNICIPAL IS NULL) OR (CAD.IND_CONTRIBUINTE = '#39'NAO'#39')) THEN'
      '        TRIB.DESC_OBSERVACAO_NC'
      '      ELSE'
      '        TRIB.DESC_OBSERVACAO'
      '    END AS DESC_OBSERVACAO_TR,'
      '    LT.DESC_LOTE,'
      '    LT.DT_VENCIMENTO AS DT_VENCIMENTO_LOTE,'
      '    LT.DT_FABRICACAO AS DT_FABRICACAO_LOTE,'
      '    LT.QT_LOTE,'
      '    /*    '
      '    TRIB.DESC_OBSERVACAO AS DESC_OBSERVACAO_TR,'
      '    LT.IND_IMPRIME_NF,'
      ''
      '    LT.DESC_GERMINACAO,'
      '    LT.DESC_PUREZA,'
      '    LT.DESC_ATESTADO,'
      '    LT.DESC_PENEIRA,'
      '    LT.DESC_RENASEN,'
      '    LT.DESC_VALIDADE,'
      '    LT.COD_LOTE_TIPO,    '
      '    LT.DESC_OBSERVACAO,'
      '    LT.DESC_TIPO_SEMENTE,'
      '    L_CLASPAR.NUM_CERTIFICADO,'
      '    ROM.NUM_ROMANEIO,'
      '    ROM.PERC_PH,'
      '    ROM.NUM_NOTA_PRODUTOR NUM_NOTA_PRODUTOR_ROM,'
      '    CLASSE.COD_MENSAGEM,'
      '    CLASSE.DESC_CLASSE*/'
      '    PARAM.PERC_COFINS,'
      '    PARAM.PERC_PIS,'
      '    PED.NUM_PEDIDO,'
      '    FCPDEST.PERC_FCP_UF_DEST,'
      '    FCPREM.PERC_FCP_UF_DEST PERC_FCP,'
      '    CLASS_TRIB.PERC_REDUCAO_IBS,'
      '    CLASS_TRIB.PERC_REDUCAO_CBS,'
      '    CLASS_TRIB.IND_GRUPO_TRIB_REGULAR,'
      '    CLASS_TRIB.IND_GRUPO_MONO_PADRAO,'
      '    CLASS_TRIB.IND_GRUPO_MONO_RETEN,'
      '    CLASS_TRIB.IND_GRUPO_MONO_RET,'
      '    CLASS_TRIB.IND_GRUPO_MONO_DIF,'
      '    CLASS_TRIB.IND_GRUPO_ESTORNO_CRED    '
      '  FROM'
      '    TB_NOTA_ITEM NI'
      '  INNER JOIN'
      
        '    (SELECT COD_EMPRESA, PERC_PIS, PERC_COFINS FROM TB_PARAM_SIS' +
        'TEMA) PARAM'
      '  ON'
      '    1=1'
      '  LEFT JOIN'
      '    TB_BAIXA_PEDIDO BP'
      '  ON'
      '    NI.COD_NOTA_ITEM = BP.COD_NOTA_ITEM'
      '  LEFT JOIN'
      '    TB_PEDIDO_ITEM PI'
      '  ON'
      '    BP.COD_PEDIDO_ITEM = PI.COD_PEDIDO_ITEM'
      '  LEFT JOIN'
      '    TB_PEDIDO_CAB PED'
      '  ON'
      '    PED.COD_PEDIDO_CAB = PI.COD_PEDIDO_CAB'
      '  LEFT JOIN'
      
        '    (SELECT COD_PRODUTO, COD_CLASSE, COD_CST_PIS, COD_CST_COFINS' +
        ', DESC_PRODUTO, NUM_ORIGEM, COD_SERVICO_MUNICIPAL, COD_PRODUTO_A' +
        'NP, QT_TEMP, PERC_MIXGN, DESC_RECOPI,'
      
        '    COD_UF_CONSUMO, PERC_GLP_PETROLEO, PERC_GNI, NUM_FABRICANTE,' +
        ' DESC_UNIDADE, DESC_COD_BARRA,'
      
        '    IND_TIPO_PRODUTO, PERC_ISS, IND_RETORNAVEL, COD_EX_TIPI, NUM' +
        '_GENERO_NCM, COD_LISTA_SERVICO,'
      
        '    COD_CADASTRO, NUM_PESO_BRUTO, NUM_PESO_LIQUIDO, COD_CEST, CO' +
        'D_BENEF_FISCAL_REDUCAO, COD_BENEF_FISCAL_IMUNIDADE,'
      
        '    COD_BENEF_FISCAL_ISENCAO, COD_BENEF_FISCAL_SUSPENSAO, COD_BE' +
        'NEF_FISCAL_DIFERIMENTO, COD_PRODUTO_ANVISA, DESC_MOTIVO_ISENCAO_' +
        'ANVISA,'
      
        '    VAL_PRECO_MAXIMO_CONSUMIDOR, PERC_AD_REM_ICMS, IND_IMPORT_CO' +
        'MB, UF_ORIGEM_COMB,'
      
        '    PERC_ORIG_UF_COMB,COD_CST_IPI_ENQU_IMUNE,COD_CST_IPI_ENQU_SU' +
        'SPENSAO,COD_CST_IPI_ENQU_ISENCAO,COD_NBS FROM TB_PRODUTO) P'
      '  ON'
      '    NI.COD_PRODUTO = P.COD_PRODUTO  '
      '  LEFT JOIN'
      '    TB_NCM NCM'
      '  ON'
      '    NCM.COD_NCM = to_number(REPLACE(P.NUM_GENERO_NCM,'#39'.'#39','#39#39'))'
      '  LEFT JOIN'
      '    TB_LOTE_TIPO LT'
      '  ON'
      '    NI.COD_LOTE_TIPO = LT.COD_LOTE_TIPO'
      '  LEFT JOIN'
      '    TB_LOTE_CLASPAR L_CLASPAR'
      '  ON'
      '    LT.COD_LOTE_TIPO = L_CLASPAR.COD_LOTE_TIPO'
      '  LEFT JOIN'
      '    TB_TRIBUTACAO TRIB'
      '  ON'
      '    NI.COD_TRIBUTACAO = TRIB.COD_TRIBUTACAO'
      '  LEFT JOIN'
      '    TB_CLASSE CLASSE'
      '  ON'
      '    P.COD_CLASSE = CLASSE.COD_CLASSE'
      '  LEFT JOIN'
      
        '    (SELECT COD_NOTA_CAB, COD_FILIAL, COD_ESTADO, COD_OPERACAO, ' +
        'COD_CADASTRO FROM TB_NOTA_CAB) NF'
      '  ON'
      '    NI.COD_NOTA_CAB = NF.COD_NOTA_CAB'
      '  LEFT JOIN'
      
        '    (SELECT IND_FISICA_JURIDICA, NUM_INSCRICAO, COD_CADASTRO, IN' +
        'D_CONTRIBUINTE, DESC_INSCRICAO_MUNICIPAL,COD_CIDADE FROM TB_CADA' +
        'STRO) CAD'
      '  ON'
      '    CAD.COD_CADASTRO = NF.COD_CADASTRO'
      '  LEFT JOIN'
      '    TB_CIDADE CID'
      '  ON'
      '    CID.COD_CIDADE = CAD.COD_CIDADE'
      '  LEFT JOIN'
      '    TB_FILIAL F'
      '  ON'
      '    F.COD_FILIAL = NF.COD_FILIAL'
      '  LEFT JOIN'
      '    TB_OPERACAO OP'
      '  ON'
      '    OP.COD_OPERACAO = NF.COD_OPERACAO'
      '  LEFT JOIN'
      '    TB_ESTADO E'
      '  ON'
      '    NF.COD_ESTADO = E.COD_ESTADO'
      '  LEFT JOIN'
      
        '    (SELECT COD_PRODUTO, COD_ESTADO, PERC_FCP_UF_DEST FROM TB_FU' +
        'NDO_COMBATE_POBREZA) FCPDEST'
      '  ON'
      
        '    FCPDEST.COD_PRODUTO = NI.COD_PRODUTO AND FCPDEST.COD_ESTADO ' +
        '= NF.COD_ESTADO'
      '  LEFT JOIN'
      
        '    (SELECT COD_PRODUTO, COD_ESTADO, PERC_FCP_UF_DEST FROM TB_FU' +
        'NDO_COMBATE_POBREZA) FCPREM'
      '  ON'
      
        '    FCPREM.COD_PRODUTO = NI.COD_PRODUTO AND FCPREM.COD_ESTADO = ' +
        'F.COD_ESTADO'
      '  LEFT JOIN'
      '    (SELECT COD_CADASTRO, NUM_CGC_CPF FROM TB_CADASTRO) FAB'
      '  ON'
      '    P.COD_CADASTRO = FAB.COD_CADASTRO'
      '  LEFT JOIN'
      
        '    TB_ROMANEIO_AGRICOLA ROM /* ESTA TABELA SERVE PARA CAMPOS DO' +
        ' ROMANEIO QUANDO EMITE NOTA FISCAL DOS ROMANEIOS */'
      '  ON'
      '    NI.COD_ROMANEIO_AGRICOLA = ROM.COD_ROMANEIO_AGRICOLA'
      '  LEFT JOIN'
      '    TB_ORDEM_SERVICO_ITEM OS_ITEM'
      '  ON'
      '    NI.COD_ORDEM_SERVICO_ITEM = OS_ITEM.COD_ORDEM_SERVICO_ITEM'
      '  LEFT JOIN'
      '    TB_ANP ANP'
      '  ON'
      '    ANP.COD_ANP = P.COD_PRODUTO_ANP'
      '  LEFT JOIN'
      
        '    (SELECT PERC_ALIQUOTA, COD_FILIAL, COD_ESTADO, COD_PRODUTO F' +
        'ROM TB_PRODUTO_SUBST_TRIB) SUBST'
      '  ON'
      '    SUBST.COD_PRODUTO = NI.COD_PRODUTO'
      '    AND NF.COD_ESTADO = SUBST.COD_ESTADO'
      '    AND NF.COD_FILIAL = SUBST.COD_FILIAL'
      '  LEFT JOIN '
      '    TB_CLASS_TRIB_IBS_CBS CLASS_TRIB'
      '  ON'
      '    CLASS_TRIB.NUM_CLASS_TRIB = NI.NUM_CLASS_TRIB_IBS_CBS'
      '  WHERE'
      '    NF.COD_CADASTRO = CAD.COD_CADASTRO    '
      '    AND'
      '    NI.COD_NOTA_CAB = :COD_NOTA_CAB'
      ')'
      'ORDER BY COD_NOTA_ITEM'
      ' '
      ' '
      ' '
      ' ')
