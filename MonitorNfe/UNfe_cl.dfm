  object QProdutoBD: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  COD_PRODUTO,'
      #9'PRODUTO,'
      #9'NCM,'
      #9'NUM_FABRICANTE,'
      #9'DESC_MARCA,'
      '  DESC_UNIDADE,'
      #9'CHECADO,'
      '  COD_TRIBUTACAO,'
      '  QT_ESTOQUE'
      'FROM('
      'SELECT'
      #9'COD_PRODUTO,'
      #9'DESC_PRODUTO PRODUTO,'
      #9'NUM_GENERO_NCM NCM,'
      #9'NUM_FABRICANTE,'
      #9'DESC_MARCA,'
      '  '#9'DESC_UNIDADE,'
      #9#39'NAO'#39' CHECADO,'
      '  '#9'COD_TRIBUTACAO,'
      '  NVL((SELECT SUM(E.QT_QUANTIDADE)'
      '         FROM TB_ESTOQUE E'
      '        WHERE E.COD_PRODUTO = TB_PRODUTO.COD_PRODUTO'
      '          AND E.COD_FILIAL = 0), 0) QT_ESTOQUE'
      'FROM'
      #9'TB_PARAM_SISTEMA PS,'
      #9'TB_PRODUTO, '
      #9'TB_MARCA'
      'WHERE'
      '       TB_PRODUTO.COD_MARCA = TB_MARCA.COD_MARCA(+)'
      '       AND'
      #9'(:NCM IS NULL'
      #9#9'OR NUM_GENERO_NCM = :NCM)'
      #9'AND'
      #9'(:PRODUTO IS NULL'
      #9#9'OR UPPER(DESC_PRODUTO) LIKE :PRODUTO)'
      #9'AND'
      #9'(:NUM_FABRICANTE IS NULL'
      #9#9'OR (UPPER(NUM_FABRICANTE) LIKE :NUM_FABRICANTE)'
      #9#9'OR (DESC_COD_BARRA = :NUM_FABRICANTE))'#9#9
      #9'AND'
      #9'(:COD_BARRA IS NULL'
      #9#9'OR UPPER(DESC_COD_BARRA) = UPPER(:COD_BARRA))'
      '     '#9'AND'
      '       (:COD_PRODUTO IS NULL'
      '    '#9#9'OR COD_PRODUTO = :COD_PRODUTO)'
      #9'AND'
      #9'IND_SITUACAO = '#39'ATIVO'#39
      ' '#9'AND'
      #9'PS.COD_EMPRESA <> '#39'CONCREFER'#39
      '  '
      'UNION'
      '  '
      'SELECT'
      #9'COD_PRODUTO,'
      #9'DESC_PRODUTO PRODUTO,'
      #9'NUM_GENERO_NCM NCM,'
      #9'CAST(COD_PRODUTO AS VARCHAR2(6)) AS NUM_FABRICANTE,'
      #9'DESC_MARCA,'
      #9'DESC_UNIDADE,'
      #9#39'NAO'#39' CHECADO,'
      ' '#9'COD_TRIBUTACAO,'
      '  NVL((SELECT SUM(E.QT_QUANTIDADE)'
      '         FROM TB_ESTOQUE E'
      '        WHERE E.COD_PRODUTO = TB_PRODUTO.COD_PRODUTO'
      '          AND E.COD_FILIAL = 0), 0) QT_ESTOQUE'
      'FROM'
      '  '#9'TB_PARAM_SISTEMA PS,'
      #9'TB_PRODUTO, TB_MARCA'
      'WHERE'
      ' '#9'TB_PRODUTO.COD_MARCA = TB_MARCA.COD_MARCA(+)'
      '       AND'
      #9'(:NCM IS NULL'
      #9#9'OR NUM_GENERO_NCM = :NCM)'
      #9'AND'
      #9'(:PRODUTO IS NULL'
      #9#9'OR UPPER(DESC_PRODUTO) LIKE :PRODUTO)'
      #9'AND'
      #9'(:NUM_FABRICANTE IS NULL'
      #9#9'OR (CAST(COD_PRODUTO AS VARCHAR2(20)) = :NUM_FABRICANTE))'
      #9'AND'
      '       (:COD_PRODUTO IS NULL'
      '    '#9#9'OR COD_PRODUTO = :COD_PRODUTO)'
      #9'AND'
      #9'NUM_GENERO_NCM IS NOT NULL'
      #9'AND'
      #9'IND_SITUACAO = '#39'ATIVO'#39
      '  '#9'AND'
      '  '#9'PS.COD_EMPRESA = '#39'CONCREFER'#39
      '  ) ORDER BY PRODUTO')
    Variables.Data = {
      03000000050000000F0000003A4E554D5F464142524943414E54450500000000
      00000000000000040000003A4E434D050000000000000000000000080000003A
      50524F4455544F0500000000000000000000000A0000003A434F445F42415252
      410500000000000000000000000C0000003A434F445F50524F4455544F030000
      000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      04000000080000000B000000434F445F50524F4455544F010000000000070000
      0050524F4455544F010000000000030000004E434D0100000000000E0000004E
      554D5F464142524943414E5445010000000000070000004348454341444F0100
      000000000C000000444553435F554E49444144450100000000000E000000434F
      445F5452494255544143414F0100000000000A000000444553435F4D41524341
      010000000000}
