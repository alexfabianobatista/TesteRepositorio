      '  F.NUM_CAIXA_POSTAL CXPOSTAL_FILIAL,'
      '  F.DESC_BAIRRO BAIRRO_FILIAL,'
      '  F.DESC_E_MAIL EMAIL_FILIAL,'
      '  F.NUM_ENDERECO NUM_ENDERECO_FILIAL,'
      '  F.DESC_COMPLEMENTO_ENDERECO COMPLEMENTO_FILIAL,'
      '  F.NUM_VIAS_DACTE,'
      '  F.IND_VIAS_DACTE,'
      '  F.IND_CONTINGENCIA_CTE IND_CONTINGENCIA_CTE_FILIAL,'
      '  F.IND_AMBIENTE_CTE IND_AMBIENTE_CTE_FILIAL,'
      '  F.DESC_CERTIFICADO,'
      '  F.DESC_LOGOTIPO_DANFE,'
      '  F.IND_REGIME_TRIBUTARIO,'
      '  F.DESC_VERSAO_CTE,'
      '  F.DT_CONTINGENCIA_CTE,'
      '  F.DESC_JUSTI_CONTINGENCIA_CTE,'
      '  F.DESC_CNAE,'
      '  F.DESC_RNTRC,'
      '  F.DESC_CIOT, '
      '  F.PERC_ALIQ_CRED_ICMSSN, '
      '  F.DESC_TAF,'
      
        '  F.DESC_NRO_REG_ESTADUAL,                                      ' +
        '                 '
      '  CT.DT_EMISSAO,                    '
      '  CT.NUM_CONHECIMENTO,                                  '
      '  CT.VAL_FRETE,                                     '
      
        '  CT.COD_SERIE,                                                 ' +
        '             '
      '  CT.COD_CONHECIMENTO,               '
      '  CT.DESC_SEGURADORA,                               '
      '  CT.DESC_OBS,                       '
      
        '  CT.VAL_PEDAGIO,                                               ' +
        '                 '
      '  CT.VAL_ICMS,                       '
      
        '  CT.COD_CONTA_PAGAR_CAB,                                       ' +
        '     '
      '  CT.COD_MENSAGEM,                                      '
      '  CT.IND_SITUACAO,                                          '
      '  CT.COD_USUARIO,                       '
      '  CT.DT_RECEBIMENTO,                 '
      '  CT.VAL_SEGURO,                                                '
      '  CT.COD_BCO_MOVIMENTO,                         '
      
        '  CT.VAL_CONTABIL,                                              ' +
        '                                                      '
      '  CT.COD_CONTA_RECEBER_CAB,                                    '
      '  CT.VAL_PIS,                        '
      '  CT.VAL_COFINS,                     '
      '  CT.COD_CST_PIS,                    '
      '  CT.COD_CST_COFINS,                 '
      '  CT.COD_SERIE_MODELO,               '
      '  CT.DESC_CHAVE_ACESSO_CTE,          '
      '  CT.IND_TIPO_SERVICO,               '
      '  CT.IND_TOMADOR_SERVICO,'
      
        '  DECODE(CT.COD_UF_ORIGEM, CT.COD_UF_DESTINO, OP.NUM_NATUREZA_ES' +
        'T_NOVO, OP.NUM_NATUREZA_INT_NOVO) AS NUM_CFOP,'
      '  CT.DT_PREVISAO_ENTREGA,            '
      '  CT.IND_FORMA_PGTO,                 '
      '  CT.COD_CIDADE_ORIGEM,              '
      '  CT.COD_CIDADE_DESTINO,             '
      '  CT.IND_RESP_SEGURO,                '
      '  CT.NUM_APOLICE_SEGURO,             '
      '  CT.NUM_AVERBACAO_SEGURO,           '
      '  CT.VAL_BASE_ICMS,                  '
      '  CT.VAL_ICMS_SUBST,                 '
      '  CT.VAL_BASE_ICMS_SUBST,            '
      '  CT.IND_LOTACAO,                                        '
      '  CT.DESC_LACRES,                    '
      '  CT.COD_FORN_VALE_PEDAGIO,          '
      '  CT.COD_RESP_VALE_PEDAGIO,          '
      '  CT.DESC_COMP_VALE_PEDAGIO,         '
      '  CT.IND_TIPO_CTE,                   '
      '  CT.DESC_OUT_CARAC_CARGA,'
      '  CT.DESC_CARAC_ADICIONAL_TRANSP,'
      '  CT.DESC_CARAC_ADICIONAL_SERV,'
      '  CT.DESC_FUNC_EMISSOR_CTE,'
      '  CT.DESC_INF_ADIC_FISCO,           '
      '  CT.NUM_PESO_BRUTO,                 '
      '  CT.QT_VOLUMES,                     '
      '  CT.VAL_TOTAL_CARGA,                '
      '  CT.NUM_PESO_BC,                    '
      '  CT.NUM_PESO_AFERIDO,               '
      '  CT.NUM_CUBAGEM,                    '
      '  CT.VAL_DESPACHO,                   '
      '  CT.VAL_GRIS,                       '
      '  CT.VAL_FRETE_PESO, '
      '  CT.COD_CADASTRO_REMETENTE,'
      '  CT.COD_CADASTRO_DESTINATARIO,'
      '  CT.COD_CADASTRO_EXPEDIDOR,'
      '  CT.COD_CADASTRO_RECEBEDOR,'
      '  CT.COD_CADASTRO_TOMADOR,'
      '  CT.VAL_TOTAL_CTE,  '
      '  CT.VAL_A_RECEBER,'
      '  DECODE(NBS.COD_NBS, 0, 0, (CT.VAL_PEDAGIO + CT.VAL_FRETE +'
      
        '  CT.VAL_GRIS + CT.VAL_DESPACHO + CT.VAL_FRETE_PESO)*NBS.PERC_TR' +
        'IBUTO_NACIONAL/100) AS SVAL_TOTAL_TRIBUTOS,    '
      '  CT.COD_CONHECIMENTO_REF,'
      '  CT.COD_CTE_ANULACAO_REF, '
      '  CT.DT_DECLARACAO_NAO_CONTRIB, '
      '  CT.DESC_CHAVE_ACESSO_REF,'
      '  CT.IND_TOMA_ICMS,'
      '  CT.VAL_FRETE_POR_TON,'
      '  CT.VAL_IR,'
      '  CT.VAL_INSS,'
      '  CT.VAL_CSLL,'
      '  CT.IND_GLOBALIZADO,'
      '  CT.DESC_SERVICO,'
      '  CT.IND_TIPO_FRETAMENTO,'
      '  CT.DT_VIAGEM,'
      '  CT.HORA_VIAGEM,'
      '  CT.VAL_IBS_MUN,'
      '  CT.VAL_IBS_EST,'
      '  CT.VAL_IBS_TOTAL,'
      '  CT.VAL_CBS_TOTAL,'
      '  CT.VAL_IS_TOTAL,'
      '  CT.VAL_BC_IBS_CBS,'
      '  CT.NUM_CST_IBS_CBS,'
      '  CT.NUM_CLASS_TRIB_IBS_CBS,'
      '  TOM.NOME NOME_TOM,'
      '  TOM.DESC_ENDERECO ENDERECO_TOM,'
      '  TOM.NUM_INSCRICAO INSCRICAO_TOM,'
      '  TOM.DESC_BAIRRO BAIRRO_TOM,'
      '  TOM.COD_ESTADO UF_TOM,'
      '  TOM.NUM_CGC_CPF CPF_CNPJ_TOM,'
      '  TOM.DESC_CIDADE CIDADE_TOM,'
      '  TOM.DESC_DESTRITO COMPLEMENTO_TOM,'
      '  TOM.DESC_TELEFONE TELEFONE_TOM,'
      '  TOM.DESC_FANTASIA FANTASIA_TOM,'
      '  TOM.IND_FISICA_JURIDICA IND_FISICA_JURIDICA_TOM,'
      '  TOM.DESC_CEP CEP_TOM,'
      '  TOM.DESC_E_MAIL EMAIL_TOM,'
      '  TOM.IND_CONTRIBUINTE IND_CONTRIBUINTE_TOM,'
      '  TOM.DESC_INSCRICAO_MUNICIPAL INSCRICAO_MUN_TOM,'
      '  REM.NOME NOME_REM,'
      '  REM.DESC_ENDERECO ENDERECO_REM,'
      '  REM.NUM_INSCRICAO INSCRICAO_REM,'
      '  REM.DESC_BAIRRO BAIRRO_REM,'
      '  REM.COD_ESTADO UF_REM,'
      '  REM.NUM_CGC_CPF CPF_CNPJ_REM,'
      '  REM.DESC_CIDADE CIDADE_REM,'
      '  REM.DESC_DESTRITO COMPLEMENTO_REM,'
      '  REM.DESC_TELEFONE TELEFONE_REM,'
      '  REM.DESC_FANTASIA FANTASIA_REM,'
      '  REM.IND_FISICA_JURIDICA IND_FISICA_JURIDICA_REM,'
      '  REM.DESC_CEP CEP_REM,'
      '  REM.DESC_E_MAIL EMAIL_REM,'
      '  REM.IND_CONTRIBUINTE IND_CONTRIBUINTE_REM,'
      '  REM.DESC_INSCRICAO_MUNICIPAL INSCRICAO_MUN_REM,'
      '  DEST.NOME NOME_DEST,'
      '  DEST.DESC_ENDERECO ENDERECO_DEST,'
      '  DEST.NUM_INSCRICAO INSCRICAO_DEST,'
      '  DEST.DESC_BAIRRO BAIRRO_DEST,'
      '  DEST.COD_ESTADO UF_DEST,'
      '  DEST.NUM_CGC_CPF CPF_CNPJ_DEST,'
      '  DEST.DESC_CIDADE CIDADE_DEST,'
      '  DEST.DESC_DESTRITO COMPLEMENTO_DEST,'
      '  DEST.DESC_TELEFONE TELEFONE_DEST,'
      '  DEST.DESC_FANTASIA FANTASIA_DEST,'
      '  DEST.IND_FISICA_JURIDICA IND_FISICA_JURIDICA_DEST,'
      '  DEST.DESC_CEP CEP_DEST,'
      '  DEST.DESC_E_MAIL EMAIL_DEST,'
      '  DEST.IND_CONTRIBUINTE IND_CONTRIBUINTE_DEST,'
      '  DEST.DESC_INSCRICAO_MUNICIPAL INSCRICAO_MUN_DEST,'
      '  EXP.NOME NOME_EXP,'
      '  EXP.DESC_ENDERECO ENDERECO_EXP,'
      '  EXP.NUM_INSCRICAO INSCRICAO_EXP,'
      '  EXP.DESC_BAIRRO BAIRRO_EXP,'
      '  EXP.COD_ESTADO UF_EXP,'
      '  EXP.NUM_CGC_CPF CPF_CNPJ_EXP,'
      '  EXP.DESC_CIDADE CIDADE_EXP,'
      '  EXP.DESC_DESTRITO COMPLEMENTO_EXP,'
      '  EXP.DESC_TELEFONE TELEFONE_EXP,'
      '  EXP.DESC_FANTASIA FANTASIA_EXP,'
      '  EXP.IND_FISICA_JURIDICA IND_FISICA_JURIDICA_EXP,'
      '  EXP.DESC_CEP CEP_EXP,'
      '  EXP.DESC_E_MAIL EMAIL_EXP,'
      '  EXP.IND_CONTRIBUINTE IND_CONTRIBUINTE_EXP,'
      '  REC.NOME NOME_REC,'
      '  REC.DESC_ENDERECO ENDERECO_REC,'
      '  REC.NUM_INSCRICAO INSCRICAO_REC,'
      '  REC.DESC_BAIRRO BAIRRO_REC,'
      '  REC.COD_ESTADO UF_REC,'
      '  REC.NUM_CGC_CPF CPF_CNPJ_REC,'
      '  REC.DESC_CIDADE CIDADE_REC,'
      '  REC.DESC_DESTRITO COMPLEMENTO_REC,'
      '  REC.DESC_TELEFONE TELEFONE_REC,'
      '  REC.DESC_FANTASIA FANTASIA_REC,'
      '  REC.IND_FISICA_JURIDICA IND_FISICA_JURIDICA_REC,'
      '  REC.DESC_CEP CEP_REC,'
      '  REC.DESC_E_MAIL EMAIL_REC,'
      '  REC.IND_CONTRIBUINTE IND_CONTRIBUINTE_REC,'
      '  SEG.DESC_E_MAIL EMAIL_SEGURADORA,'
      '  E_FILIAL.COD_UF_IBGE COD_UF_IBGE_FILIAL,'
      '  E_TOM.COD_UF_IBGE COD_UF_IBGE_TOM,'
      '  E_TOM.COD_ESTADO COD_ESTADO_TOM,'
      '  E_TOM.PERC_ALIQUOTA_DIFERENCIAL,'
      '  E_REM.COD_UF_IBGE COD_UF_IBGE_REM,'
      '  E_REM.COD_ESTADO COD_ESTADO_REM,'
      '  E_DEST.COD_UF_IBGE COD_UF_IBGE_DEST,'
      '  E_DEST.COD_ESTADO COD_ESTADO_DEST,'
      '  E_EXP.COD_UF_IBGE COD_UF_IBGE_EXP,'
      '  E_EXP.COD_ESTADO COD_ESTADO_EXP,'
      '  E_REC.COD_UF_IBGE COD_UF_IBGE_REC,'
      '  E_REC.COD_ESTADO COD_ESTADO_REC,'
      '  E_ORIG.COD_UF_IBGE COD_UF_IBGE_ORIG,'
      '  E_DESTINO.COD_UF_IBGE COD_UF_IBGE_DESTINO,'
      '  E_DESTINO.PERC_IBS_UF PERC_IBS_UF_DESTINO,'
      '  CID_FILIAL.COD_CIDADE_IBGE COD_CIDADE_IBGE_FILIAL,'
      '  CID_TOM.COD_CIDADE_IBGE COD_CIDADE_IBGE_TOM,'
      '  CID_REM.COD_CIDADE_IBGE COD_CIDADE_IBGE_REM,'
      '  CID_DEST.COD_CIDADE_IBGE COD_CIDADE_IBGE_DEST,'
      '  CID_EXP.COD_CIDADE_IBGE COD_CIDADE_IBGE_EXP,'
      '  CID_REC.COD_CIDADE_IBGE COD_CIDADE_IBGE_REC,'
      '  CID_ORIG.COD_CIDADE_IBGE COD_CIDADE_IBGE_ORIG,'
      '  CID_ORIG.DESC_CIDADE DESC_CIDADE_ORIG,'
      '  CID_ORIG.COD_ESTADO UF_ORIG,'
      '  CID_DESTINO.COD_CIDADE_IBGE COD_CIDADE_IBGE_DESTINO,'
      '  CID_DESTINO.DESC_CIDADE DESC_CIDADE_DESTINO,'
      '  CID_DESTINO.COD_ESTADO UF_DESTINO,'
      '  CID_DESTINO.PERC_IBS_MUN PERC_IBS_MUN_DESTINO,'
      '  PAIS_TOM.DESC_PAIS PAIS_TOM,'
      '  PAIS_TOM.COD_PAIS_IBGE COD_PAIS_IBGE_TOM,'
      '  PAIS_REM.DESC_PAIS PAIS_REM,'
      '  PAIS_REM.COD_PAIS_IBGE COD_PAIS_IBGE_REM,'
      '  PAIS_EXP.DESC_PAIS PAIS_EXP,'
      '  PAIS_EXP.COD_PAIS_IBGE COD_PAIS_IBGE_EXP,'
      '  PAIS_REC.DESC_PAIS PAIS_REC,'
      '  PAIS_REC.COD_PAIS_IBGE COD_PAIS_IBGE_REC,'
      '  PAIS_DEST.DESC_PAIS PAIS_DEST,'
      '  PAIS_DEST.COD_PAIS_IBGE COD_PAIS_IBGE_DEST,'
      
        '  '#39'BRASIL'#39' PAIS_FILIAL,      /* CAMPO EST'#193'TICO POR N'#195'O HAVER COD' +
        '_PAIS NA TB_FILIAL */'
      
        '  1058 COD_PAIS_IBGE_FILIAL, /* CAMPO EST'#193'TICO POR N'#195'O HAVER COD' +
        '_PAIS NA TB_FILIAL */'
      '  OP.DESC_OPERACAO,'
      '  SERIE.COD_SERIE_MODELO DESC_MODELO,'
      '  PROD.DESC_PRODUTO,'
      '  PROD.DESC_UNIDADE,'
      '  TRIB.DESC_SITUACAO_TRIB AS CST,'
      '  TRIB.PERC_ALIQUOTA,'
      '  TRIB.PERC_TRIBUTADO,'
      '  TRIB.PERC_TRIBUTADO_NOTA,'
      '  TRIB.DESC_OBSERVACAO AS OBS_TRIBUTACAO,'
      '  TRIB.PERC_CBS,'
      '  CTE.DESC_XML_CTE,'
      '  CTE.IND_AMBIENTE_CTE,'
      
        '  (SELECT PERC_REDUCAO_IBS FROM TB_CLASS_TRIB_IBS_CBS WHERE NUM_' +
        'CLASS_TRIB = CT.NUM_CLASS_TRIB_IBS_CBS) AS PERC_REDUCAO_IBS,'
      
        '  (SELECT PERC_REDUCAO_CBS FROM TB_CLASS_TRIB_IBS_CBS WHERE NUM_' +
        'CLASS_TRIB = CT.NUM_CLASS_TRIB_IBS_CBS) AS PERC_REDUCAO_CBS'
      'FROM'
      '  TB_CONHECIMENTO CT'
      'LEFT JOIN'
      '  TB_NBS NBS'
      'ON'
      '  CT.COD_NBS = NBS.COD_NBS'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  CT.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_ESTADO E_FILIAL'
      'ON'
      '  F.COD_ESTADO = E_FILIAL.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_FILIAL'
      'ON'
      '  F.COD_CIDADE = CID_FILIAL.COD_CIDADE'
      'LEFT JOIN'
      
        '  (SELECT COD_CADASTRO, NOME, DESC_ENDERECO, NUM_INSCRICAO, DESC' +
        '_BAIRRO,'
      '    COD_ESTADO, NUM_CGC_CPF, DESC_CIDADE, DESC_DESTRITO,'
      '    DESC_TELEFONE, DESC_FANTASIA, IND_FISICA_JURIDICA,'
      
        '    DESC_CEP, DESC_E_MAIL, COD_CIDADE, COD_PAIS, IND_CONTRIBUINT' +
        'E, DESC_INSCRICAO_MUNICIPAL FROM TB_CADASTRO) REM'
      'ON'
      '  CT.COD_CADASTRO_REMETENTE = REM.COD_CADASTRO'
      'LEFT JOIN'
      
        '  (SELECT COD_CADASTRO, NOME, DESC_ENDERECO, NUM_INSCRICAO, DESC' +
        '_BAIRRO,'
      '    COD_ESTADO, NUM_CGC_CPF, DESC_CIDADE, DESC_DESTRITO,'
      '    DESC_TELEFONE, DESC_FANTASIA, IND_FISICA_JURIDICA,'
      
        '    DESC_CEP, DESC_E_MAIL, COD_CIDADE, COD_PAIS, IND_CONTRIBUINT' +
        'E, DESC_INSCRICAO_MUNICIPAL FROM TB_CADASTRO) DEST'
      'ON'
      '  CT.COD_CADASTRO_DESTINATARIO = DEST.COD_CADASTRO'
      'LEFT JOIN'
      
        '  (SELECT COD_CADASTRO, NOME, DESC_ENDERECO, NUM_INSCRICAO, DESC' +
        '_BAIRRO,'
      '    COD_ESTADO, NUM_CGC_CPF, DESC_CIDADE, DESC_DESTRITO,'
      '    DESC_TELEFONE, DESC_FANTASIA, IND_FISICA_JURIDICA,'
      
        '    DESC_CEP, DESC_E_MAIL, COD_CIDADE, COD_PAIS, IND_CONTRIBUINT' +
        'E FROM TB_CADASTRO) EXP'
      'ON'
      '  CT.COD_CADASTRO_EXPEDIDOR = EXP.COD_CADASTRO'
      'LEFT JOIN'
      
        '  (SELECT COD_CADASTRO, NOME, DESC_ENDERECO, NUM_INSCRICAO, DESC' +
        '_BAIRRO,'
      '    COD_ESTADO, NUM_CGC_CPF, DESC_CIDADE, DESC_DESTRITO,'
      '    DESC_TELEFONE, DESC_FANTASIA, IND_FISICA_JURIDICA,'
      
        '    DESC_CEP, DESC_E_MAIL, COD_CIDADE, COD_PAIS, IND_CONTRIBUINT' +
        'E FROM TB_CADASTRO) REC'
      'ON'
      '  CT.COD_CADASTRO_RECEBEDOR = REC.COD_CADASTRO'
      'LEFT JOIN'
      '  (SELECT COD_CADASTRO, NOME, DESC_E_MAIL FROM TB_CADASTRO) SEG'
      'ON'
      '  CT.COD_SEGURADORA = SEG.COD_CADASTRO'
      'LEFT JOIN'
      '  TB_ESTADO E_REM'
      'ON'
      '  REM.COD_ESTADO = E_REM.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_REM'
      'ON'
      '  REM.COD_CIDADE = CID_REM.COD_CIDADE'
      'LEFT JOIN'
      '  TB_PAIS PAIS_REM'
      'ON'
      '  REM.COD_PAIS = PAIS_REM.COD_PAIS'
      'LEFT JOIN'
      '  TB_ESTADO E_DEST'
      'ON'
      '  DEST.COD_ESTADO = E_DEST.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_DEST'
      'ON'
      '  DEST.COD_CIDADE = CID_DEST.COD_CIDADE'
      'LEFT JOIN'
      '  TB_PAIS PAIS_DEST'
      'ON'
      '  DEST.COD_PAIS = PAIS_DEST.COD_PAIS'
      'LEFT JOIN'
      '  TB_ESTADO E_EXP'
      'ON'
      '  EXP.COD_ESTADO = E_EXP.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_EXP'
      'ON'
      '  EXP.COD_CIDADE = CID_EXP.COD_CIDADE'
      'LEFT JOIN'
      '  TB_PAIS PAIS_EXP'
      'ON'
      '  EXP.COD_PAIS = PAIS_EXP.COD_PAIS'
      'LEFT JOIN'
      '  TB_ESTADO E_REC'
      'ON'
      '  REC.COD_ESTADO = E_REC.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_REC'
      'ON'
      '  REC.COD_CIDADE = CID_REC.COD_CIDADE'
      'LEFT JOIN'
      '  TB_PAIS PAIS_REC'
      'ON'
      '  REC.COD_PAIS = PAIS_REC.COD_PAIS'
      'LEFT JOIN'
      '  TB_CIDADE CID_ORIG'
      'ON'
      '  CT.COD_CIDADE_ORIGEM = CID_ORIG.COD_CIDADE'
      'LEFT JOIN'
      '  TB_ESTADO E_ORIG'
      'ON'
      '  CT.COD_UF_ORIGEM = E_ORIG.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_DESTINO'
      'ON'
      '  CT.COD_CIDADE_DESTINO = CID_DESTINO.COD_CIDADE'
      'LEFT JOIN'
      '  TB_ESTADO E_DESTINO'
      'ON'
      '  CT.COD_UF_DESTINO = E_DESTINO.COD_ESTADO'
      'LEFT JOIN'
      '  TB_OPERACAO OP'
      'ON'
      '  CT.COD_OPERACAO = OP.COD_OPERACAO'
      'LEFT JOIN'
      '  TB_TRIBUTACAO TRIB'
      'ON'
      '  CT.COD_TRIBUTACAO = TRIB.COD_TRIBUTACAO'
      'LEFT JOIN'
      '  TB_PRODUTO PROD'
      'ON'
      '  CT.COD_PRODUTO = PROD.COD_PRODUTO'
      'LEFT JOIN'
      '  TB_SERIE SERIE'
      'ON'
      
        '  (CT.COD_SERIE = SERIE.COD_SERIE AND CT.COD_FILIAL = SERIE.COD_' +
        'FILIAL AND CT.COD_SERIE_MODELO = SERIE.COD_SERIE_MODELO)'
      'LEFT JOIN'
      
        '   (SELECT COD_CONHECIMENTO, DESC_XML_CTE, IND_AMBIENTE_CTE FROM' +
        ' TB_CTE) CTE'
      'ON'
      '  CT.COD_CONHECIMENTO = CTE.COD_CONHECIMENTO,'
      
        '  TB_CADASTRO TOM, TB_ESTADO E_TOM, TB_CIDADE CID_TOM, TB_PAIS P' +
        'AIS_TOM'
      'WHERE'
      
        '  CT.COD_CONHECIMENTO = :COD_CONHECIMENTO AND (CT.COD_CADASTRO_T' +
        'OMADOR IS NULL OR CT.COD_CADASTRO_TOMADOR = TOM.COD_CADASTRO) AN' +
        'D'
      
        '  TOM.COD_ESTADO = E_TOM.COD_ESTADO AND TOM.COD_CIDADE = CID_TOM' +
        '.COD_CIDADE AND TOM.COD_PAIS = PAIS_TOM.COD_PAIS'
      ' '
      ' '
      ' ')
