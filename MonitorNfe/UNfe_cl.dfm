  object QNotaImpostoServico: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  NIS.VAL_IMPOSTO,'
      '  I.PERC_ALIQUOTA'
      'FROM'
      '  TB_NOTA_IMPOSTO_SERVICO NIS'
      '  INNER JOIN TB_IMPOSTO I ON NIS.COD_IMPOSTO = I.COD_IMPOSTO'
      'WHERE'
      '  NIS.COD_NOTA_CAB = :COD_NOTA'
      '  AND'
      '  I.DESC_IMPOSTO LIKE '#39'%'#39'||:DESC_IMPOSTO||'#39'%'#39)
