  object QInutilizacaoCons: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.COD_FILIAL || '#39' - '#39' || F.DESC_FILIAL AS FILIAL,'
      '  NFEI.DESC_CNPJ,'
      '  NFEI.IND_AMBIENTE,'
      '  NFEI.DESC_PROTOCOLO,'
      '  NFEI.DESC_NUM_INI,'
      '  NFEI.DESC_NUM_FIM,'
      '  NFEI.DESC_UF,'
      '  NFEI.COD_SERIE,'
      '  NFEI.DESC_ANO,'
      '  NFEI.DESC_STATUS,'
      '  TO_CHAR(NFEI.DESC_MOTIVO) AS DESC_MOTIVO,'
      '  NFEI.DESC_SITUACAO'
      'FROM'
      '  TB_NF_ELETRONICA_INUT NFEI'
      'INNER JOIN'
      '  TB_FILIAL F'
      'ON'
      
        '  NFEI.DESC_CNPJ = REPLACE(TRANSLATE(NUM_CGC, '#39'.,-/'#39', '#39' '#39'), '#39' '#39',' +
        ' '#39#39')'
      'WHERE'
      '  (:FILIAL IS NULL OR F.COD_FILIAL = :FILIAL)'
      'AND'
      '  (:SERIE IS NULL OR NFEI.COD_SERIE = :SERIE)'
      'AND'
      
        '  (:NUMERO IS NULL OR :NUMERO BETWEEN TO_NUMBER(NFEI.DESC_NUM_IN' +
        'I) AND TO_NUMBER(NFEI.DESC_NUM_FIM))'
      'ORDER BY'
      '  NFEI.COD_SERIE,'
      '  NFEI.DESC_NUM_INI'
      '')
    Variables.Data = {
      0300000003000000070000003A46494C49414C03000000000000000000000006
      0000003A5345524945050000000000000000000000070000003A4E554D45524F
      030000000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      040000000C00000009000000444553435F434E504A0100000000000C00000049
      4E445F414D4249454E54450100000000000E000000444553435F50524F544F43
