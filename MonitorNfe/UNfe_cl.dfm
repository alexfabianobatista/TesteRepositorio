  object QNotaReferenciada: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '  NREF.DESC_CHAVE_ACESSO,'
      '  NREF.COD_SERIE,'
      '  NREF.COD_SERIE_MODELO,'
      '  NREF.DT_EMISSAO,'
      '  --N.NUM_NOTA,'
      '  NREF.NUM_NOTA,'
      '  C.NUM_CGC_CPF CPF_CNPJ_CADASTRO,'
      '  E.COD_UF_IBGE,'
      '  C.NUM_INSCRICAO INSCRICAO_CADASTRO,'
      '  C.DESC_INSCRICAO_MUNICIPAL,'
      '  C.IND_FISICA_JURIDICA,'
      '  N.NUM_COO,'
      '  F.NUM_CGC CNPJ_FILIAL,'
      '  F.DESC_INSCRICAO INSCRICAO_FILIAL'
      'FROM'
      '  TB_NOTA_REFERENCIADA NREF'
      'LEFT JOIN'
      '  TB_NOTA_CAB N'
      'ON'
      '  N.COD_NOTA_CAB = NREF.COD_NOTA_CAB_REF'
      'LEFT JOIN'
      '  TB_CADASTRO C'
      'ON'
      
        '  C.COD_CADASTRO = DECODE(NREF.COD_CADASTRO,NULL,N.COD_CADASTRO,' +
        'NREF.COD_CADASTRO)'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  F.COD_FILIAL = N.COD_FILIAL'
      'LEFT JOIN'
      '  TB_ESTADO E'
      'ON'
      '  E.COD_ESTADO = F.COD_ESTADO'
      'WHERE'
      '  NREF.COD_NOTA_CAB = :COD_NOTA_CAB')
    Variables.Data = {
      03000000010000000D0000003A434F445F4E4F54415F43414203000000000000
      0000000000}
