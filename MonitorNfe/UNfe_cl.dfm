  object QGeraNfe: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.COD_FILIAL,'
      '  F.DESC_FILIAL NOME_FILIAL,'
      '  F.DESC_ENDERECO ENDERECO_FILIAL,'
      '  F.DESC_CIDADE CIDADE_FILIAL,'
      '  F.DESC_TELEFONE TELEFONE_FILIAL,'
      '  F.DESC_CEP CEP_FILIAL,'
      '  F.COD_ESTADO UF_FILIAL,'
      '  F.NUM_CGC CPF_CNPJ_FILIAL,'
      '  F.DESC_INSCRICAO INSCRICAO_FILIAL,'
      '  F.DESC_INSCRICAO_MUNICIPAL INSCRICAO_MUN_FILIAL,'
      '  F.NUM_CAIXA_POSTAL CXPOSTAL_FILIAL,'
      '  F.DESC_BAIRRO BAIRRO_FILIAL,'
      '  F.DESC_E_MAIL EMAIL_FILIAL,'
      '  F.NUM_ENDERECO NUM_ENDERECO_FILIAL,'
      '  F.DESC_COMPLEMENTO_ENDERECO COMPLEMENTO_FILIAL,'
      '  F.NUM_VIAS_DANFE,'
      '  F.IND_VIAS_DANFE,'
      '  F.IND_CONTINGENCIA IND_CONTINGENCIA_FILIAL,'
      '  F.IND_AMBIENTE_NFE IND_AMBIENTE_NFE_FILIAL,'
      '  F.IND_AMBIENTE_NFSE IND_AMBIENTE_NFSE_FILIAL,'
      '  F.DESC_CERTIFICADO,'
      '  F.DESC_LOGOTIPO_DANFE,'
      '  F.IND_REGIME_TRIBUTARIO,'
      '  F.DESC_VERSAO_NFE,'
      '  F.DESC_VERSAO_NFSE,'
      '  F.DT_CONTINGENCIA,'
      '  F.DESC_JUST_CONTINGENCIA,'
      '  F.PERC_BC_NFSE,'
      
        '  DECODE(F.IND_CALCULA_ISS_CIDADE,'#39'NAO'#39',F.PERC_ISS,CID_CADASTRO.' +
        'PERC_ISS) PERC_ISS,'
      '  F.DESC_CNAE,'
      '  F.DESC_REPOSITORIO_NFE,'
      '  F.PERC_ALIQ_CRED_ICMSSN,'
      '  F.IND_ORIENTACAO_PAG_DANFE,'
      
        '  DECODE(NFE.IND_CONTINGENCIA, '#39'9'#39', NFE.IND_CONTINGENCIA, F.IND_' +
        'CONTINGENCIA_NFCE) IND_CONTINGENCIA_NFCE,'
      '  F.IND_AMBIENTE_NFCE,'
      '  F.IND_VIAS_DANFE_NFCE,'
      '  F.NUM_VIAS_DANFE_NFCE,'
      
        '  DECODE(NFE.IND_CONTINGENCIA, '#39'9'#39', NFE.DT_CONTINGENCIA, F.DT_CO' +
        'NTINGENCIA_NFCE) DT_CONTINGENCIA_NFCE,'
      
        '  DECODE(NFE.IND_CONTINGENCIA, '#39'9'#39', NFE.DESC_JUST_CONTINGENCIA, ' +
        'F.DESC_JUST_CONTINGENCIA_NFCE) DESC_JUST_CONTINGENCIA_NFCE,'
      '  F.DESC_VERSAO_NFCE,'
      '  F.DESC_CSC_NFCE,'
      '  F.DESC_IDENTIFICADOR_CSC_NFCE,'
      '  F.DESC_LOGOTIPO_DANFE_NFCE,'
      '  F.DESC_CERTIFICADO_NFCE,'
      '  F.IND_AMBIENTE_NFCE AS IND_AMBIENTE_NFCE_FILIAL,'
      '  F.IND_NOME_FANTASIA_DANFE,'
      '  F.COD_INC_TRIB,'
      '  NF.COD_NOTA_CAB,'
      '  NF.COD_NOTA_CAB_REF,'
      '  NF.COD_CADASTRO,'
      '  NF.COD_MOTIVO_CANC,'
      '  NF.VAL_FRETE,'
      '  NF.VAL_DESCONTO,'
      '  NF.VAL_FUNRURAL,'
      '  NF.IND_TIPO_FRETE,'
      '  NF.IND_ENTRADA_SAIDA,'
      '  NF.IND_SITUACAO,'
      '  CASE'
      
        '    WHEN NF.IND_CONDICAO_PAGTO IN ('#39'1'#39','#39'2'#39') THEN NF.IND_CONDICAO' +
        '_PAGTO'
      '    ELSE '#39'3'#39' END AS IND_CONDICAO_PAGTO,'
      '  NF.NUM_NOTA,'
      '  NF.DT_EMISSAO,'
      '  NF.DT_RECEBIMENTO,'
      '  NF.COD_ESTADO UF_NOTA,'
      '  NF.VAL_DESPESAS,'
      '  NF.COD_TRANSPORTADOR COD_CADASTRO_TRANSP,'
      '  NF.DESC_PLACA,'
      '  NF.NUM_VOLUMES,'
      '  NF.OBS,'
      '  NF.OBS_COMPLEMENTO,'
      '  NF.DESC_TRANSPORTADORA,'
      '  NF.DESC_OBS_CORPO_NOTA,'
      '  NF.VAL_AVISTA,'
      '  NF.COD_MOTORISTA,'
      '  NF.IND_IMPRIME_FRETE,'
      '  NF.VAL_IMPOSTO,                               '
      '  NF.VAL_DESCONTO_FITAS,'
      '  NF.NUM_PEDIDO,'
      '  NF.IND_IMPRIME_CAB,'
      '  NF.COD_CADASTRO_PARCEIRO,'
      '  NF.COD_SERIE,'
      '  NF.DESC_MARCA,'
      '  NF.DESC_ESPECIE,'
      '  NF.DESC_CHAVE_ACESSO,'
      '  NF.COD_NOTA_CAB_DEV_FIXAR,'
      '  NF.NUM_CONHECIMENTO_FRETE,'
      '  NF.VAL_SENAR,'
      '  NF.IND_CONTINGENCIA,'
      '  NF.VAL_SUBST_TRIBUT,'
      '  NF.COD_MENSAGEM,'
      '  NF.COD_ESTADO_EMBARQUE,'
      '  NF.DESC_LOCAL_EMBARQUE,'
      '  NF.DESC_LOCAL_DESPACHO,'
      '  NF.COD_UF_VEICULO,'
      '  NF.DESC_MD5_CUPOM_FISCAL,'
      '  NF.NUM_PESO_BRUTO,'
      '  NF.NUM_PESO_LIQUIDO,'
      '  NF.IND_FINALIDADE_NFE,'
      '  NF.IND_PRESENCA,'
      '  NF.IND_INTERMEDIADOR,'
      '  NF.COD_CIDADE_PRESTACAO,'
      '  NF.NUM_DCO,'
      '  NF.NUM_ART,'
      '  NF_REF.NUM_NOTA NUM_NOTA_REF,'
      '  NN.DESC_CGC_CPF CPF_CNPJ_INFORMADO,'
      '  NN.NOME NOME_INFORMADO,'
      
        '  NVL(NF.IND_CONSUMIDOR_FINAL, F.IND_CONSUMIDOR_FINAL) IND_CONSU' +
        'MIDOR_FINAL,'
      '  NF_DEV_FIXAR.NUM_NOTA NUM_NOTA_DEV_FIXAR,'
      '  C_NOTA.NOME NOME_CADASTRO,'
      '  C_NOTA.DESC_FANTASIA NOME_FANTASIA_CADASTRO,'
      '  NVL(NN.DESC_ENDERECO, C_NOTA.DESC_ENDERECO) ENDERECO_CADASTRO,'
      
        '  NVL(NN.DESC_INSCRICAO, C_NOTA.NUM_INSCRICAO) INSCRICAO_CADASTR' +
        'O,'
      '  C_NOTA.IND_CONTRIBUINTE,'
      '  C_NOTA.DESC_BAIRRO BAIRRO_CADASTRO,'
      '  NVL(NN.DESC_ESTADO, C_NOTA.COD_ESTADO) UF_CADASTRO,'
      '  C_NOTA.NUM_CGC_CPF CPF_CNPJ_CADASTRO,'
      '  NVL(NN.DESC_CIDADE, C_NOTA.DESC_CIDADE) CIDADE_CADASTRO,'
      '  C_NOTA.DESC_COMPLEMENTO COMPLEMENTO_CADASTRO,'
      '  DECODE(C_NOTA.DESC_TELEFONE,NULL,'
      
        '    DECODE(C_NOTA.DESC_TELEFONE_COMERCIAL, NULL, C_NOTA.DESC_CEL' +
        'ULAR, C_NOTA.DESC_TELEFONE_COMERCIAL),'
      '    C_NOTA.DESC_TELEFONE) TELEFONE_CADASTRO,'
      '  C_NOTA.DESC_CELULAR CELULAR_CADASTRO,'
      '  C_NOTA.DESC_FANTASIA FANTASIA_CADASTRO,'
      '  C_NOTA.IND_FISICA_JURIDICA,'
      '  C_NOTA.IND_ISS_RETIDO,'
      '  C_NOTA.IND_PIS_COFINS_RETIDO,'
      '  NVL(NN.DESC_CEP, C_NOTA.DESC_CEP) CEP_CADASTRO,'
      '  C_NOTA.DESC_ENDERECO_ENTREGA ENDERECO_ENTREGA_CADASTRO,'
      '  C_NOTA.DESC_CIDADE_ENTREGA CIDADE_ENTREGA_CADASTRO,'
      '  C_NOTA.DESC_BAIRRO_ENTREGA BAIRRO_ENTREGA_CADASTRO,'
      '  C_NOTA.DESC_INSCRICAO_MUNICIPAL INSCRICAO_MUN_CADASTRO,'
      '  C_NOTA.DESC_E_MAIL EMAIL_CADASTRO,'
      '  C_NOTA.IND_REGIME_TRIBUTARIO AS REGIME_TRIBUTARIO_CADASTRO,'
      '  C_NOTA.DESC_SUFRAMA,'
      
        '  DECODE(NVL(C_NOTA.PERC_DEDUCAO_NFSE,0),0,F.PERC_DEDUCAO_NFSE,C' +
        '_NOTA.PERC_DEDUCAO_NFSE) AS PERC_DEDUCAO_NFSE,'
      '  V.NOME NOME_VENDEDOR,'
      '  V.DESC_CELULAR CELULAR_VENDEDOR,'
      '  E_FILIAL.COD_UF_IBGE COD_UF_IBGE_FILIAL,'
      '  E_CADASTRO.COD_UF_IBGE COD_UF_IBGE_CADASTRO,'
      '  E_PRESTACAO.COD_UF_IBGE COD_UF_IBGE_PRESTACAO,'
      '  E_CADASTRO.COD_ESTADO COD_ESTADO_CADASTRO,'
      '  CASE'
      '    WHEN IEST.DESC_INSCRICAO_SUBST IS NOT NULL THEN'
      '      IEST.DESC_INSCRICAO_SUBST'
      '    WHEN F.IND_MOSTRA_IE_SUBST = '#39'S'#39' THEN'
      '      E_CADASTRO.DESC_INSCRICAO_SUBST'
      '  END AS DESC_INSCRICAO_SUBST,'
      '  E_NOTA.COD_UF_IBGE COD_UF_IBGE_NOTA,'
      '  E_NOTA.PERC_ALIQUOTA_DIFERENCIAL PERC_ICMS_UF_DEST,'
      '  CID_FILIAL.COD_CIDADE_IBGE COD_CIDADE_IBGE_FILIAL,'
      '  CID_CADASTRO.COD_CIDADE_IBGE COD_CIDADE_IBGE_CADASTRO,'
      '  CID_PRESTACAO.COD_CIDADE_IBGE COD_CIDADE_IBGE_PRESTACAO,'
      '  CID_PRESTACAO.DESC_CIDADE CIDADE_PRESTACAO,'
      '  PAIS_CADASTRO.DESC_PAIS PAIS_CADASTRO,'
      '  PAIS_CADASTRO.COD_PAIS_IBGE COD_PAIS_IBGE_CADASTRO,'
      
        '  '#39'BRASIL'#39' PAIS_FILIAL,      /* CAMPO EST'#193'TICO POR N'#195'O HAVER COD' +
        '_PAIS NA TB_FILIAL */'
      
        '  1058 COD_PAIS_IBGE_FILIAL, /* CAMPO EST'#193'TICO POR N'#195'O HAVER COD' +
        '_PAIS NA TB_FILIAL */'
      '  OP.DESC_OPERACAO,'
      '  OP.COD_BENEF_FISCAL,'
      '  SERIE.COD_SERIE_MODELO DESC_MODELO,'
      '  CASE'
      
        '    WHEN NF.COD_ESTADO = F.COD_ESTADO OR NF.COD_ESTADO = '#39'EX'#39' TH' +
        'EN'
      '      OP.NUM_NATUREZA_EST_NOVO'
      '    ELSE'
      '      OP.NUM_NATUREZA_INT_NOVO'
      '  END AS NUM_CFOP,'
      '  TRANSP.NUM_CGC_CPF NUM_CGC_CPF_TRANSP,'
      '  TRANSP.IND_FISICA_JURIDICA IND_FISICA_JURIDICA_TRANSP,'
      '  TRANSP.NOME NOME_TRANSP,'
      '  TRANSP.NUM_INSCRICAO INSCRICAO_TRANSP,'
      '  TRANSP.DESC_ENDERECO DESC_ENDERECO_TRANSP,'
      '  CID_TRANSP.DESC_CIDADE DESC_CIDADE_TRANSP,'
      '  TRANSP.COD_ESTADO UF_TRANSP,'
      '  V.COD_VENDEDOR,'
      '  MOTORISTA.NOME AS NOME_MOTORISTA,'
      '  NFE.DESC_XML_NFE,'
      '  NFE.IND_AMBIENTE_NFE'
      'FROM'
      '  TB_NOTA_CAB NF'
      'LEFT JOIN'
      
        '  (SELECT CAD.COD_CADASTRO,CAD.NOME, CAD.DESC_FANTASIA, CAD.DESC' +
        '_ENDERECO, CAD.NUM_INSCRICAO,'
      
        '    CAD.IND_CONTRIBUINTE, CAD.DESC_BAIRRO, CAD.COD_ESTADO, CAD.N' +
        'UM_CGC_CPF, CAD.DESC_CIDADE, '
      
        '    CAD.DESC_COMPLEMENTO,CAD.COD_CIDADE,CAD.COD_PAIS, CAD.PERC_D' +
        'EDUCAO_NFSE, CAD. DESC_TELEFONE_COMERCIAL,'
      
        '    CAD.DESC_TELEFONE, CAD.DESC_CELULAR, CAD.IND_FISICA_JURIDICA' +
        ','
      
        '    CAD.IND_ISS_RETIDO, CAD.IND_PIS_COFINS_RETIDO, CAD.DESC_CEP,' +
        'CAD.DESC_ENDERECO_ENTREGA,'
      
        '    CAD.DESC_CIDADE_ENTREGA,CAD.DESC_BAIRRO_ENTREGA,CAD.DESC_INS' +
        'CRICAO_MUNICIPAL,'
      
        '    CAD.DESC_E_MAIL, CAD.IND_REGIME_TRIBUTARIO, CAD.DESC_SUFRAMA' +
        ' FROM TB_CADASTRO CAD) C_NOTA'
      'ON'
      '  NF.COD_CADASTRO = C_NOTA.COD_CADASTRO'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  NF.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_ESTADO E_NOTA'
      'ON'
      '  NF.COD_ESTADO = E_NOTA.COD_ESTADO'
      'LEFT JOIN'
      '  TB_ESTADO E_CADASTRO'
      'ON'
      '  C_NOTA.COD_ESTADO = E_CADASTRO.COD_ESTADO'
      'LEFT JOIN'
      '  TB_ESTADO E_FILIAL'
      'ON'
      '  F.COD_ESTADO = E_FILIAL.COD_ESTADO'
      'LEFT JOIN'
      '  TB_NOME_NOTA NN'
      'ON'
      '  NF.COD_NOTA_CAB = NN.COD_NOTA_CAB'
      'LEFT JOIN'
      '  TB_VENDEDOR V'
      'ON'
      '  NF.COD_VENDEDOR = V.COD_VENDEDOR'
      'LEFT JOIN'
      '  TB_CIDADE CID_FILIAL'
      'ON'
      '  F.COD_CIDADE = CID_FILIAL.COD_CIDADE'
      'LEFT JOIN'
      '  TB_CIDADE CID_CADASTRO'
      'ON'
      '  C_NOTA.COD_CIDADE = CID_CADASTRO.COD_CIDADE'
      'LEFT JOIN'
      '  TB_CIDADE CID_PRESTACAO'
      'ON'
      '  NF.COD_CIDADE_PRESTACAO = CID_PRESTACAO.COD_CIDADE'
      'LEFT JOIN'
      '  TB_ESTADO E_PRESTACAO'
      'ON'
      '  CID_PRESTACAO.COD_ESTADO = E_PRESTACAO.COD_ESTADO'
      'LEFT JOIN'
      '  TB_PAIS PAIS_CADASTRO'
      'ON'
      '  C_NOTA.COD_PAIS = PAIS_CADASTRO.COD_PAIS'
      'LEFT JOIN'
      '  TB_OPERACAO OP'
      'ON'
      '  NF.COD_OPERACAO = OP.COD_OPERACAO'
      'LEFT JOIN'
      '  TB_SERIE SERIE'
      'ON'
      
        '  (NF.COD_SERIE = SERIE.COD_SERIE AND NF.COD_FILIAL = SERIE.COD_' +
        'FILIAL AND NF.COD_SERIE_MODELO = SERIE.COD_SERIE_MODELO)'
      'LEFT JOIN'
      
        '  (SELECT COD_CADASTRO, NUM_CGC_CPF, IND_FISICA_JURIDICA, NOME,N' +
        'UM_INSCRICAO,DESC_ENDERECO,COD_ESTADO, COD_CIDADE FROM TB_CADAST' +
        'RO) TRANSP'
      'ON'
      '  NF.COD_TRANSPORTADOR = TRANSP.COD_CADASTRO'
      'LEFT JOIN'
      '  TB_CIDADE CID_TRANSP'
      'ON'
      '  TRANSP.COD_CIDADE = CID_TRANSP.COD_CIDADE'
      'LEFT JOIN'
      '  (SELECT COD_NOTA_CAB, NUM_NOTA FROM TB_NOTA_CAB) NF_REF'
      'ON'
      '  NF.COD_NOTA_CAB_REF = NF_REF.COD_NOTA_CAB'
      'LEFT JOIN'
      '  TB_NOTA_CAB NF_DEV_FIXAR'
      'ON'
      '  NF.COD_NOTA_CAB_DEV_FIXAR = NF_DEV_FIXAR.COD_NOTA_CAB'
      'LEFT JOIN'
      
        '  (SELECT NOME, DESC_CGC_CPF, COD_NOTA_CAB FROM TB_NOME_NOTA) NO' +
        'ME_NOTA'
      'ON'
      '  NOME_NOTA.COD_NOTA_CAB = NF.COD_NOTA_CAB'
      'LEFT JOIN'
      '  (SELECT COD_CADASTRO, NOME FROM TB_CADASTRO) MOTORISTA'
      'ON'
      '  MOTORISTA.COD_CADASTRO = NF.COD_MOTORISTA '
      'LEFT JOIN'
      
        '  (SELECT DESC_CHAVE_ACESSO,DESC_XML_NFE, IND_AMBIENTE_NFE, IND_' +
        'CONTINGENCIA, DT_CONTINGENCIA, DESC_JUST_CONTINGENCIA FROM TB_NF' +
        '_ELETRONICA) NFE'
      'ON'
      '  REPLACE (NF.DESC_CHAVE_ACESSO,'#39'NFe'#39') = NFE.DESC_CHAVE_ACESSO'
      'LEFT JOIN'
      '  TB_INSCRICAO_SUBST_FILIAL IEST'
      'ON'
      
        '  IEST.COD_FILIAL = F.COD_FILIAL AND IEST.COD_ESTADO = E_CADASTR' +
        'O.COD_ESTADO'
      'WHERE'
      '  NF.COD_NOTA_CAB = :COD_NOTA_CAB')
    Variables.Data = {
      03000000010000000D0000003A434F445F4E4F54415F43414203000000040000
      00D235000000000000}
