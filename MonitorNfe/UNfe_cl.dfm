  object QNfeCons: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  *'
      'FROM'
      '('
      '  SELECT'
      '    NFEC.DESC_CHAVE_ACESSO,'
      '    NFE.DESC_RETORNO_PROCESSAMENTO AS SIT_NFE,'
      '    NFE.DESC_RETORNO_CANCELAMENTO AS SIT_CANC,'
      '    NFEC.DT_NF_ELETRONICA_CONS,'
      '    NFEC.NUM_CONT,'
      '    NFE.COD_FILIAL,'
      '    NFE.DESC_SERIE,'
      '    NFE.NUM_NF_ELETRONICA,'
      '    NFE.DESC_MSG_VALIDACAO,'
      '    NFE.DESC_MSG_VALIDACAO_LOTE'
      '  FROM'
      '    TB_NF_ELETRONICA_CONS NFEC'
      '  INNER JOIN'
      '    TB_NF_ELETRONICA NFE'
      '  ON'
      '    NFEC.DESC_CHAVE_ACESSO = NFE.DESC_CHAVE_ACESSO'
      '  LEFT JOIN'
      '    TB_FILIAL F'
      '  ON'
      '    NFE.COD_FILIAL = F.COD_FILIAL'
      '  WHERE'
      '    (:CHAVE IS NULL OR NFEC.DESC_CHAVE_ACESSO = :CHAVE)'
      '  AND'
      '    (:FILIAL IS NULL OR NFE.COD_FILIAL = :FILIAL)'
      '  AND'
      '    (:DT_MIN IS NULL OR NFEC.DT_NF_ELETRONICA_CONS >= :DT_MIN)'
      '  ORDER BY'
      '    NFE.COD_FILIAL,'
      '    NFE.DESC_SERIE,'
      '    NFE.NUM_NF_ELETRONICA'
      ')'
      'WHERE'
      
        '  (:MIN_SITUACAO IS NULL OR SIT_NFE >= :MIN_SITUACAO OR SIT_CANC' +
        ' >= :MIN_SITUACAO)'
      'AND'
      
        '  (:MAX_SITUACAO IS NULL OR SIT_NFE <= :MAX_SITUACAO OR SIT_CANC' +
        ' >= :MAX_SITUACAO)'
      '')
    Variables.Data = {
