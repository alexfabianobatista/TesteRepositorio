  object QPagamento: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  PAG.DESC_PAGAMENTO,'
      '  PAG.VAL_PAGAMENTO,'
      '  PAG.VAL_VALOR,'
      '  TEF.NSU,'
      '  TEF.DESC_REDE_AUTORIZADORA,'
      '  TEF.DESC_BANDEIRA_CARTAO'
      'FROM'
      '  TB_PAGAMENTO PAG'
      'LEFT JOIN'
      '  TB_TEF_PGTO TEF'
      'ON'
      '  TEF.COD_TEF_PGTO = PAG.COD_TEF_PGTO'
      'where cod_nota_cab = :cod_nota_cab'
      'ORDER BY'
      '  COD_PAGAMENTO'
