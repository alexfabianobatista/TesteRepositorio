  object QInfXmlSefaCons: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  INF.COD_INF_XML_SEFA,'
      '  INF.COD_FILIAL,'
      '  INF.DESC_CHAVE_ACESSO,'
      '  INF.DESC_CNPJ,'
      '  INF.DESC_NOME,'
      '  INF.DT_EMISSAO,'
      '  DECODE(INF.IND_ENTRADA_SAIDA,1,'#39'Entrada'#39', '#39'Sa'#237'da'#39') TIPO_NFE,'
      '  INF.VAL_TOTAL,'
      '  INF.DESC_PROTOCOLO,'
      
        '  DECODE(INF.IND_SITUACAO_NOTA,1,'#39'Uso autorizado'#39', DECODE(INF.IN' +
        'D_SITUACAO_NOTA,2,'#39'Uso denegado'#39', '#39'NF-e cancelada'#39')) SITUACAO_NO' +
        'TA,'
      '  INF.NUM_NSU,'
      '  INF.IND_SITUACAO,'
      '  INF.NUM_NOTA,'
      '  INF.NUM_SERIE'
      'FROM'
      #9'TB_INF_XML_SEFA INF'
      'where '
      '    (:DT_INICIAL IS NULL OR :DT_FINAL IS NULL'
      '  OR'
      '    (INF.DT_EMISSAO BETWEEN :DT_INICIAL AND :DT_FINAL))'
      '  AND '
      '    (:COD_FILIAL IS NULL OR INF.COD_FILIAL = :COD_FILIAL)'
      '  AND '
      '    (:IND_SITUACAO IS NULL OR INF.IND_SITUACAO = :IND_SITUACAO)'
      '  AND'
      '    (:NUM_NOTA IS NULL OR INF.NUM_NOTA = :NUM_NOTA)'
      'ORDER BY'
      #9'DT_EMISSAO DESC'
      ''
      ''
      '')
