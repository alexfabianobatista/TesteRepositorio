      '  F.IND_REGIME_TRIBUTARIO,'
      '  F.DESC_VERSAO_MDFE,'
      '  F.DESC_CNAE,'
      
        '  F.DESC_RNTRC,                                                 ' +
        '       '
      '  M.DT_EMISSAO,                    '
      '  M.NUM_MANIFESTO,'
      '  M.COD_MANIFESTO,'
      '  M.IND_SITUACAO,                                          '
      '  M.COD_USUARIO,'
      '  M.COD_SERIE,'
      '  M.COD_SERIE_MODELO,'
      '  M.DESC_CHAVE_ACESSO,'
      '  M.IND_MODAL,'
      '  M.COD_UF_CARREGA,'
      '  M.COD_UF_DESCARREGA,'
      '  M.VAL_CARGA,'
      '  M.NUM_PESO,'
      '  M.DESC_LACRES,'
      '  M.DESC_OBS,'
      '  M.IND_TIPO_EMITENTE,'
      '  M.IND_LOTACAO,'
      '  M.IND_TIPO_CARGA,'
      '  M.COD_PRODUTO,'
      '  M.DESC_CEP_CARREGA,'
      '  M.DESC_LATITUDE_CARREGA,'
      '  M.DESC_LONGITUDE_CARREGA,'
      '  M.DESC_CEP_DESCARREGA,'
      '  M.DESC_LATITUDE_DESCARREGA,'
      '  M.DESC_LONGITUDE_DESCARREGA,'
      '  PROD.DESC_PRODUTO,'
      '  PROD.NUM_GENERO_NCM,'
      '  PROD.DESC_COD_BARRA,'
      '  E_FILIAL.COD_UF_IBGE COD_UF_IBGE_FILIAL,'
      '  CID_FILIAL.COD_CIDADE_IBGE COD_CIDADE_IBGE_FILIAL,'
      
        '  '#39'BRASIL'#39' PAIS_FILIAL,      /* CAMPO EST'#193'TICO POR N'#195'O HAVER COD' +
        '_PAIS NA TB_FILIAL */'
      
        '  1058 COD_PAIS_IBGE_FILIAL, /* CAMPO EST'#193'TICO POR N'#195'O HAVER COD' +
        '_PAIS NA TB_FILIAL */'
      '  SERIE.COD_SERIE_MODELO DESC_MODELO,'
      '  MDFE.DESC_XML_MDFE'
      'FROM'
      '  TB_MANIFESTO M'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  M.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_ESTADO E_FILIAL'
      'ON'
      '  F.COD_ESTADO = E_FILIAL.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CIDADE CID_FILIAL'
      'ON'
      '  F.COD_CIDADE = CID_FILIAL.COD_CIDADE'
      'LEFT JOIN'
      '  TB_SERIE SERIE'
      'ON'
      
        '  (M.COD_SERIE = SERIE.COD_SERIE AND M.COD_FILIAL = SERIE.COD_FI' +
        'LIAL AND M.COD_SERIE_MODELO = SERIE.COD_SERIE_MODELO)'
      'LEFT JOIN'
      '   (SELECT COD_MANIFESTO, DESC_XML_MDFE FROM TB_MDFE) MDFE'
      'ON'
      '  M.COD_MANIFESTO = MDFE.COD_MANIFESTO'
      'LEFT JOIN'
      
        '   (SELECT COD_PRODUTO, DESC_PRODUTO, NUM_GENERO_NCM, DESC_COD_B' +
        'ARRA FROM TB_PRODUTO) PROD'
      'ON'
      '  M.COD_PRODUTO = PROD.COD_PRODUTO'
      'WHERE'
      '  M.COD_MANIFESTO = :COD_MANIFESTO')
    Variables.Data = {
