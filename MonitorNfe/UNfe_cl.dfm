  object QCondutorMDFe: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '  C.NOME,'
      '  C.NUM_CGC_CPF'
      'FROM'
      '  TB_CONDUTOR_MDFE CMDFE'
      'LEFT JOIN'
