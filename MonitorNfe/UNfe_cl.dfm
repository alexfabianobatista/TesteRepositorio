  object QNfe: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  NFE.DESC_CHAVE_ACESSO,'
      '  NFE.DESC_RETORNO_PROCESSAMENTO AS SIT_NFE,'
      '  NFE.DESC_RETORNO_CANCELAMENTO AS SIT_CANC,'
      '  NFE.DESC_MSG_VALIDACAO_LOTE,'
      '  NFE.DESC_MSG_VALIDACAO,'
      '  NFE.COD_FILIAL,'
      '  NFE.DESC_SERIE,'
      '  NFE.NUM_NF_ELETRONICA,'
      '  NFE.DESC_XML_NFE,'
      '  NFE.DESC_PROT_AUTORIZACAO,'
      '  NFE.DESC_CERTIFICADO,'
      '  NFE.DESC_LOGOTIPO,'
      '  NFE.IND_AMBIENTE_NFE,'
      '  NFE.ID_LOTE,'
      '  F.DESC_VERSAO_NFE,'
      '  NF.COD_SERIE_MODELO,'
      '  NVL(NFE.COD_NOTA_CAB, NF.COD_NOTA_CAB) COD_NOTA_CAB,'
      '  F.DESC_REPOSITORIO_NFE'
      'FROM'
      '  TB_NF_ELETRONICA NFE'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  NFE.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_NOTA_CAB NF'
      'ON'
      '  NFE.COD_NOTA_CAB = NF.COD_NOTA_CAB'
      'OR'
      '  ('#39'NFe'#39' || NFE.DESC_CHAVE_ACESSO) = NF.DESC_CHAVE_ACESSO'
      'WHERE'
      '  NFE.DESC_CHAVE_ACESSO = :PK'
      'ORDER BY'
      '  NFE.COD_FILIAL,'
      '  NFE.DESC_SERIE,'
      '  NFE.NUM_NF_ELETRONICA'
      '')
    Variables.Data = {0300000001000000030000003A504B050000000000000000000000}
