  object QCteEmissao: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.DESC_REPOSITORIO_NFE,'
      '  F.NUM_CGC,'
      '  F.IND_CONTINGENCIA_CTE,'
      '  F.IND_VIAS_DACTE,'
      '  F.NUM_VIAS_DACTE,'
      '  F.DESC_CERTIFICADO,'
      '  F.DESC_LOGOTIPO_DACTE,'
      '  F.IND_AMBIENTE_CTE,'
      '  F.DESC_VERSAO_CTE,'
      '  F.IND_IMPRIME_DACTE,'
      '  CT.DESC_CHAVE_ACESSO_CTE,'
      '  CT.COD_CONHECIMENTO,'
      '  CT.DT_EMISSAO,'
      '  CT.COD_SERIE,'
      '  CT.COD_SERIE_MODELO,'
      '  CT.NUM_CONHECIMENTO,'
      '  CT.COD_FILIAL,'
      '  CT.IND_SITUACAO,'
      '  O.IND_EMITE,'
      '  E_FILIAL.COD_UF_IBGE AS COD_UF_IBGE_FILIAL,'
      '  S.COD_SERIE_MODELO AS DESC_MODELO,'
      '  CTE.DESC_RETORNO_PROCESSAMENTO,'
      '  U.DESC_IMPRESSORA_DACTE'
      'FROM'
      '  TB_CONHECIMENTO CT'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  CT.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_SERIE S'
      'ON'
      
        '  (CT.COD_SERIE = S.COD_SERIE AND CT.COD_FILIAL = S.COD_FILIAL A' +
        'ND CT.COD_SERIE_MODELO = S.COD_SERIE_MODELO)'
      'LEFT JOIN'
      '  TB_OPERACAO O'
      'ON'
      '  CT.COD_OPERACAO = O.COD_OPERACAO'
      'LEFT JOIN'
      '  TB_ESTADO E_FILIAL'
      'ON'
      '  F.COD_ESTADO = E_FILIAL.COD_ESTADO'
      'LEFT JOIN'
      '  TB_CTE CTE'
      'ON'
      '  CT.COD_CONHECIMENTO = CTE.COD_CONHECIMENTO'
      'LEFT JOIN'
      '  TB_USUARIO U'
      'ON'
      '  (:COD_USUARIO = U.COD_USUARIO)'
      'WHERE'
      '  CT.COD_CONHECIMENTO = :COD_CONHECIMENTO')
    Variables.Data = {
      0300000001000000110000003A434F445F434F4E484543494D454E544F030000
      000000000000000000}
    QBEDefinition.QBEFieldDefs = {
      04000000170000000B000000444553435F4D4F44454C4F010000000000090000
      00494E445F454D495445010000000000070000004E554D5F4347430100000000
      000A00000044545F454D495353414F01000000000009000000434F445F534552
      49450100000000000A000000434F445F46494C49414C01000000000014000000
