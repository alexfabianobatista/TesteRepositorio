  object QCte: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  CTE.DESC_CHAVE_ACESSO,'
      '  CTE.DESC_RETORNO_PROCESSAMENTO AS SIT_CTE,'
      '  CTE.DESC_RETORNO_CANCELAMENTO AS SIT_CANC,'
      '  CTE.COD_FILIAL,'
      '  CTE.DESC_SERIE,'
      '  CTE.NUM_CTE,'
      '  CTE.DESC_XML_CTE,'
      '  CTE.DESC_PROT_AUTORIZACAO,'
      '  CTE.IND_AMBIENTE_CTE,'
      '  CTE.ID_LOTE,'
      
        '  NVL(CTE.COD_CONHECIMENTO, CT.COD_CONHECIMENTO) COD_CONHECIMENT' +
        'O,'
      '  F.DESC_REPOSITORIO_NFE'
      'FROM'
      '  TB_CTE CTE'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  CTE.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_CONHECIMENTO CT'
      'ON'
      '  CTE.COD_CONHECIMENTO = CT.COD_CONHECIMENTO'
      'WHERE'
      '  CTE.DESC_CHAVE_ACESSO = :PK'
      'ORDER BY'
      '  CTE.COD_FILIAL,'
      '  CTE.DESC_SERIE,'
      '  CTE.NUM_CTE'
      '')
    Variables.Data = {0300000001000000030000003A504B050000000000000000000000}
