  object QSomaPagamentos: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      
        '    SUM(DECODE(PG.IND_CONFIRMADO,'#39'S'#39', PG.VAL_PAGAMENTO,0)) AS VA' +
        'L_PAGAMENTOS_CONFIRMADOS,'
      '    SUM(PG.VAL_PAGAMENTO) AS VAL_PAGO'
      '  FROM'
      '    TB_NOTA_CAB N'
      '  INNER JOIN TB_PAGAMENTO PG ON'
      '    N.COD_NOTA_CAB = PG.COD_NOTA_CAB'
      '  INNER JOIN TB_FILIAL F ON'
      '    N.COD_FILIAL = F.COD_FILIAL'
      '  WHERE'
      '    N.COD_NOTA_CAB = :COD_NOTA_CAB')
