  object QGeraMdfeEvento: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '  ME.ROWID,'
      '  ME.ID_EVENTO,'
      '  ME.DESC_CHAVE_ACESSO,'
      '  ME.NSEQ_EVENTO,'
      '  ME.DT_EVENTO,'
      '  ME.TP_EVENTO,'
      '  ME.DESC_JUSTIFICATIVA,'
      '  ME.DESC_RETORNO_PROCESSAMENTO,'
      '  ME.DESC_MSG_VALIDACAO,'
      '  ME.DT_REG_EVENTO,'
      '  ME.DESC_PROTOCOLO,'
      '  ME.DESC_XML_EVENTO,'
      '  ME.DESC_XML_RETORNO,'
      '  ME.DT_ENCERRAMENTO,'
      '  ME.COD_CIDADE_ENC,'
      '  ME.COD_ESTADO_ENC,'
      '  ME.COD_CADASTRO_CONDUTOR'
      'FROM'
      '  TB_MDFE_EVENTO ME'
      'LEFT JOIN'
      '  TB_CADASTRO C'
      'ON'
      '  C.COD_CADASTRO = ME.COD_CADASTRO_CONDUTOR'
      'LEFT JOIN'
