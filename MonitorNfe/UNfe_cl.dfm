  object QTitulos: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  NUM_PARCELA,'
      '  DT_VENCIMENTO,'
      '  VAL_ORIGINAL,'
      '  NUM_TITULO'
      'FROM'
      '('
      '  SELECT'
      '    CR.NUM_PARCELA,'
      '    CR.DT_VENCIMENTO,'
      '    CR.VAL_ORIGINAL,'
      '    CR.NUM_TITULO'
      '  FROM'
      '    TB_NOTA_CAB NF'
      '  INNER JOIN'
      
        '    (SELECT NUM_PARCELA, DT_VENCIMENTO, VAL_ORIGINAL, NUM_TITULO' +
        ', COD_NOTA_CAB FROM TB_CONTA_RECEBER_CAB) CR'
      '  ON'
      '    NF.COD_NOTA_CAB = CR.COD_NOTA_CAB'
      '  WHERE'
      '    NF.COD_NOTA_CAB = :COD_NOTA_CAB'
      ''
      '  UNION'
      ''
      '  SELECT'
      '    CP.NUM_PARCELA,'
      '    CP.DT_VENCIMENTO,'
      '    CP.VAL_ORIGINAL,'
      '    CP.NUM_TITULO'
      '  FROM'
      '    TB_NOTA_CAB NF'
      '  INNER JOIN'
      
        '    (SELECT NUM_PARCELA, DT_VENCIMENTO, VAL_ORIGINAL, NUM_TITULO' +
        ', COD_NOTA_CAB FROM TB_CONTA_PAGAR_CAB) CP'
      '  ON'
      '    NF.COD_NOTA_CAB = CP.COD_NOTA_CAB'
      '  WHERE'
      '    NF.COD_NOTA_CAB = :COD_NOTA_CAB'
      ')'
      'ORDER BY'
      '  NUM_PARCELA'
      '')
    Variables.Data = {
      03000000010000000D0000003A434F445F4E4F54415F43414203000000000000
      0000000000}
    QBEDefinition.QBEFieldDefs = {
      04000000040000000B0000004E554D5F50415243454C410100000000000D0000
      0044545F56454E43494D454E544F0100000000000C00000056414C5F4F524947
      494E414C0100000000000A0000004E554D5F544954554C4F010000000000}
