  object QValeProduto: TOracleDataSet
    SQL.Strings = (
      'SELECT'
      '  F.COD_FILIAL,'
      '  C.COD_CADASTRO,'
      '  C.NOME,'
      '  VP.COD_VALE_PRODUTO,'
      '  VP.VAL_VALE_PRODUTO,'
      '  VP.DT_EMISSAO,'
      '  VP.COD_NOTA_CAB_TROCA,'
      
        '  DECODE(NFEDEV.DESC_RETORNO_PROCESSAMENTO, '#39'100'#39','#39'S'#39','#39'N'#39') IND_V' +
        'ALIDO,'
      
        '  DECODE(NFEDEV.DESC_RETORNO_CANCELAMENTO, '#39'101'#39','#39'S'#39','#39'N'#39') IND_CA' +
        'NCELADO,'
      
        '  DECODE(NFET.DESC_RETORNO_PROCESSAMENTO,'#39'100'#39','#39'S'#39','#39'N'#39') IND_UTIL' +
        'IZADO,'
      '  VP.COD_NOTA_CAB,'
      '  VP.COD_NOTA_CAB_DEV,'
      '  VP.DESC_TIPO_VALE'
      'FROM'
      '  TB_VALE_PRODUTO VP'
      'LEFT JOIN '
      '  TB_NOTA_CAB ND'
      'ON'
      '  ND.COD_NOTA_CAB = VP.COD_NOTA_CAB_DEV'
      'LEFT JOIN '
      '  TB_NF_ELETRONICA NFEDEV'
      'ON'
      '  NFEDEV.COD_NOTA_CAB = VP.COD_NOTA_CAB_DEV'
      'LEFT JOIN'
      '  TB_NOTA_CAB NT'
      'ON'
      '  NT.COD_NOTA_CAB = VP.COD_NOTA_CAB_TROCA'
      'LEFT JOIN'
      '  TB_NF_ELETRONICA NFET'
      'ON'
      '  NFET.COD_NOTA_CAB = NT.COD_NOTA_CAB'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  ND.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_CADASTRO C'
      'ON'
      '  C.COD_CADASTRO = ND.COD_CADASTRO'
      'WHERE'
      '   VP.COD_NOTA_CAB_TROCA = :COD_NOTA_CAB'
      'ORDER BY VP.COD_VALE_PRODUTO'
      ''
      '  ')
    Variables.Data = {
      03000000010000000D0000003A434F445F4E4F54415F43414203000000000000
      0000000000}
    SequenceField.ApplyMoment = amOnNewRecord
    QBEDefinition.QBEFieldDefs = {
