  object QNfeCancela: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  F.COD_FILIAL,'
      '  F.IND_AMBIENTE_NFE,'
      '  F.DESC_REPOSITORIO_NFE,'
      '  NFE.DESC_PROT_AUTORIZACAO,'
      '  M.DESC_MOTIVO,'
      '  E.COD_UF_IBGE'
      'FROM'
      '  TB_NF_ELETRONICA NFE'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  NFE.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_NOTA_CAB NF'
      'ON'
      '  INSTR(NF.DESC_CHAVE_ACESSO, NFE.DESC_CHAVE_ACESSO) > 0'
      'LEFT JOIN'
      '  TB_MOTIVO M'
      'ON'
      '  NF.COD_MOTIVO_CANC = M.COD_MOTIVO'
      'LEFT JOIN'
      '  TB_ESTADO E'
      'ON'
      '  NF.COD_ESTADO = E.COD_ESTADO'
      'WHERE'
      '  NFE.DESC_CHAVE_ACESSO = :CHAVE')
