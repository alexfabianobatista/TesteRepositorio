  object QMdfe: TOracleDataSet1
    SQL.Strings = (
      'SELECT'
      '  MDFE.DESC_CHAVE_ACESSO,'
      '  MDFE.DESC_RETORNO_PROCESSAMENTO AS SIT_MDFE,'
      '  MDFE.DESC_RETORNO_CANCELAMENTO AS SIT_CANC,'
      '  MDFE.DESC_RETORNO_ENCERRAMENTO AS SIT_ENC,'
      '  MDFE.COD_FILIAL,'
      '  MDFE.DESC_SERIE,'
      '  MDFE.NUM_MDFE,'
      '  MDFE.DESC_XML_MDFE,'
      '  MDFE.DESC_PROT_AUTORIZACAO,'
      '  MDFE.IND_AMBIENTE_MDFE,'
      '  MDFE.ID_LOTE,'
      '  NVL(MDFE.COD_MANIFESTO, M.COD_MANIFESTO) COD_MANIFESTO,'
      '  F.DESC_REPOSITORIO_NFE'
      'FROM'
      '  TB_MDFE MDFE'
      'LEFT JOIN'
      '  TB_FILIAL F'
      'ON'
      '  MDFE.COD_FILIAL = F.COD_FILIAL'
      'LEFT JOIN'
      '  TB_MANIFESTO M'
      'ON'
      '  MDFE.COD_MANIFESTO = M.COD_MANIFESTO'
      'WHERE'
      '  MDFE.DESC_CHAVE_ACESSO = :PK'
      'ORDER BY'
      '  MDFE.COD_FILIAL,'
      '  MDFE.DESC_SERIE,'
      '  MDFE.NUM_MDFE'
      '')
    Variables.Data = {0300000001000000030000003A504B050000000000000000000000}
