      object Label10: TLabel
        Left = 16
        Top = 16
        Width = 485
        Height = 13
        Caption = 
          '-Agora voc'#234' deve selecionar o e-mail do remetente, provavelmente' +
          ' ser'#225' o seu e-mail.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object Label11: TLabel
        Left = 16
        Top = 35
        Width = 594
        Height = 39
        Caption = 
          '-Um servidor SMTP '#233' respons'#225'vel por enviar e-mails, todos os ser' +
          'vidores SMTP possuem configura'#231#245'es espec'#237'ficas, um exemplo de se' +
          'rvidor SMTP popular '#233' o Gmail que se pode facilmente encontrar s' +
          'uas configura'#231#245'es na internet.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
        WordWrap = True
      end
      object Label21: TLabel
        Left = 16
        Top = 80
        Width = 567
        Height = 26
        Caption = 
          '-Como os servidores possuem limites de envio por tempo, voc'#234' pod' +
          'e utilizar varios servidores SMTP que possuir e o sistema se enc' +
          'arregar'#225' de utiliza-los para realizar o envio.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
        WordWrap = True
      end
      object Label22: TLabel
        Left = 16
        Top = 128
        Width = 139
        Height = 13
        Caption = 'Servidores a serem utilizados:'
      end
