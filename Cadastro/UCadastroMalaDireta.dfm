    object TabSheet1: TTabSheet
      Caption = 'Inicio'
      object Label1: TLabel
        Left = 16
        Top = 16
        Width = 337
        Height = 13
        Caption = '-Este passo-a-passo vai ajudar a cadastrar sua mala direta.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object Label2: TLabel
        Left = 16
        Top = 35
        Width = 585
        Height = 52
        Caption = 
          '-Mala direta '#233' um tipo de a'#231#227'o de marketing que consiste em um e' +
          'nvelope ou pacote f'#237'sico que uma empresa envia para o endere'#231'o d' +
          'os clientes/leads. Essa comunica'#231#227'o pode ter como objetivo infor' +
          'mar o seu p'#250'blico-alvo sobre alguma novidade ou lan'#231'amento ou co' +
          'nvenc'#234'-lo sobre a compra de algum produto ofertado pela empresa.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
        WordWrap = True
      end
      object Label3: TLabel
        Left = 16
        Top = 95
        Width = 205
        Height = 13
        Caption = '-Clique em avan'#231'ar para prosseguir.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
      end
    end
    object TabSheet2: TTabSheet
      Caption = 'Cabe'#231'alho'
      ImageIndex = 1
      object Label4: TLabel
        Left = 16
        Top = 16
        Width = 405
        Height = 13
        Caption = 
          '-Primeiro, '#233' necess'#225'rio dar uma descri'#231#227'o apenas para ficar regi' +
          'strado.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object Label5: TLabel
        Left = 16
        Top = 33
        Width = 573
        Height = 39
        Caption = 
          '-Ap'#243's isso configure sua mensagem de envio. A mensagem eletr'#244'nic' +
          'a cont'#233'm o corpo do e-mail que seus clientes ir'#227'o receber. Caso ' +
          'queira algo mais personalizado, voc'#234' pode utilizar elementos HTM' +
          'L e CSS, por'#233'm '#233' necess'#225'rio ter um pouco de conhecimento sobre o' +
          ' assunto.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
        WordWrap = True
      end
      object Label6: TLabel
        Left = 16
        Top = 77
        Width = 363
        Height = 13
        Caption = '-Quando selecionar a mensagem que deseja clique em avan'#231'ar.'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -11
        Font.Name = 'MS Sans Serif'
        Font.Style = [fsBold]
        ParentFont = False
      end
